{
  "name": "data-platform",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build-dispatch.cjs",
    "preview": "astro preview",
    "astro": "astro",
    "collect": "node scripts/run-python.cjs collector/run_all.py",
    "collect:realestate": "node scripts/run-python.cjs collector/collect_land_prices.py",
    "collect:living": "node scripts/run-python.cjs collector/collect_living_layers.py",
    "collect:housing-land-2023": "node scripts/run-python.cjs collector/collect_housing_land_2023.py",
    "collect:reinfolib-transactions": "node scripts/run-python.cjs collector/collect_reinfolib_transactions.py",
    "health": "node scripts/run-python.cjs collector/check_health.py",
    "release:check": "npm audit --omit=dev && npm run health && npm run audit:data && npm run build && npm run audit:html",
    "e2e": "node scripts/e2e-smoke.cjs && node scripts/e2e-deep.cjs",
    "e2e:smoke": "node scripts/e2e-smoke.cjs",
    "e2e:deep": "node scripts/e2e-deep.cjs",
    "audit:data": "npm run test:procurement-quality && npm run audit:wikipedia-topics && node scripts/run-python.cjs scripts/audit-metric-canonical.py && node scripts/run-python.cjs scripts/audit-social-population.py && npm run audit:housing-land-2023 && npm run audit:reinfolib-transactions && npm run audit:retail-prices-city && npm run audit:procurement-awards && node scripts/run-python.cjs scripts/audit-data-integrity.py && node scripts/run-python.cjs scripts/audit-living-history.py && node scripts/run-python.cjs scripts/audit-listed-normalized.py && node scripts/run-python.cjs scripts/audit-listed-public.py && npm run audit:company-registry && npm run test:gbiz-activity && npm run audit:gbiz-activity && npm run test:shokuba && npm run audit:shokuba && npm run audit:ipss-population && npm run audit:lodging-statistics && npm run audit:jma-weather",
    "audit:html": "node scripts/run-python.cjs scripts/audit-generated-html.py",
    "collect:listed-master": "node scripts/run-python.cjs -m collector.listed_companies.collect_master",
    "collect:listed-documents": "node scripts/run-python.cjs -m collector.listed_companies.collect_documents",
    "collect:listed-download": "node scripts/run-python.cjs -m collector.listed_companies.download_edinet_data",
    "collect:listed-bulk": "node scripts/run-python.cjs -m collector.listed_companies.bulk_download",
    "normalize:listed": "node scripts/run-python.cjs -m collector.listed_companies.normalize_financials",
    "build:listed-data": "node scripts/run-python.cjs -m collector.listed_companies.build_public_data",
    "audit:listed-xbrl": "node scripts/run-python.cjs scripts/audit-listed-xbrl-samples.py",
    "collect:listed-fallback": "node scripts/run-python.cjs -m collector.listed_companies.retry_xbrl_fallback",
    "report:listed-coverage": "node scripts/run-python.cjs scripts/report-listed-coverage.py",
    "normalize:listed-incremental": "node scripts/run-python.cjs -m collector.listed_companies.normalize_incremental",
    "validate:listed-salary": "node scripts/run-python.cjs -m collector.listed_companies.validate_salary_outliers",
    "validate:listed-counts": "node scripts/run-python.cjs -m collector.listed_companies.validate_count_outliers",
    "validate:listed-shareholders": "node scripts/run-python.cjs -m collector.listed_companies.validate_shareholder_outliers",
    "refresh:listed-daily": "npm run collect:listed-documents && npm run collect:listed-bulk && npm run normalize:listed-incremental && npm run validate:listed-salary && npm run validate:listed-shareholders && npm run validate:listed-financials && npm run audit:listed-cross-filing && npm run build:listed-data",
    "validate:listed-financials": "node scripts/run-python.cjs scripts/audit-listed-normalized.py",
    "audit:listed-cross-filing": "node scripts/run-python.cjs scripts/audit-listed-cross-filing.py",
    "audit:listed-source": "node scripts/run-python.cjs scripts/audit-listed-source-values.py",
    "collect:social-population": "node scripts/run-python.cjs collector/collect_social_population.py",
    "collect:retail-prices-city": "node scripts/run-python.cjs collector/collect_retail_prices_city.py",
    "backfill:retail-prices-city": "node scripts/run-python.cjs collector/backfill_retail_prices_city.py",
    "audit:retail-prices-city": "node scripts/run-python.cjs scripts/audit-retail-prices-city.py",
    "audit:housing-land-2023": "node scripts/run-python.cjs scripts/audit-housing-land-2023.py",
    "audit:reinfolib-transactions": "node scripts/run-python.cjs scripts/audit-reinfolib-transactions.py",
    "audit:procurement-awards": "node scripts/run-python.cjs scripts/audit-procurement-awards.py",
    "collect:company-registry-nta": "node scripts/run-python.cjs -m collector.company_registry.collect_nta --region 全国",
    "backfill:company-registry-procurement": "node scripts/run-python.cjs -m collector.company_registry.backfill_procurement_links",
    "build:company-registry": "node scripts/run-python.cjs -m collector.company_registry.build_registry",
    "audit:company-registry": "node scripts/run-python.cjs scripts/audit-company-registry.py",
    "audit:gbiz-activity": "node scripts/run-python.cjs scripts/audit-gbiz-activity.py",
    "test:gbiz-activity": "node scripts/run-python.cjs scripts/test-gbiz-activity.py",
    "e2e:gbiz-activity": "node scripts/e2e-gbiz-activity.cjs",
    "collect:company-registry-gbiz": "node scripts/run-python.cjs -m collector.company_registry.collect_gbiz_bulk --type all-activity",
    "collect:company-registry-gbiz-finance": "node scripts/run-python.cjs -m collector.company_registry.collect_gbiz_bulk --type finance",
    "bootstrap:company-registry-gbiz-finance": "node scripts/run-python.cjs -m collector.company_registry.bootstrap_gbiz_legacy",
    "ingest:company-registry-gbiz-finance": "node scripts/run-python.cjs -m collector.company_registry.ingest_gbiz_finance",
    "collect:company-registry-gbiz-statements": "node scripts/run-python.cjs -m collector.company_registry.collect_gbiz_bulk --type statements",
    "ingest:company-registry-gbiz-statements": "node scripts/run-python.cjs -m collector.company_registry.ingest_gbiz_statements",
    "collect:wikipedia-topics": "node scripts/run-python.cjs collector/collect_wikipedia_topics.py --days 14",
    "audit:wikipedia-topics": "node scripts/run-python.cjs scripts/audit-wikipedia-topics.py",
    "test:procurement-quality": "node scripts/run-python.cjs scripts/test-procurement-quality.py",
    "collect:shokuba": "node scripts/run-python.cjs -m collector.collect_shokuba",
    "collect:gbiz-subsidy": "node scripts/run-python.cjs -m collector.company_registry.collect_gbiz_bulk --type subsidy",
    "collect:gbiz-patent": "node scripts/run-python.cjs -m collector.company_registry.collect_gbiz_bulk --type patent",
    "audit:shokuba": "node scripts/run-python.cjs scripts/audit-shokuba.py",
    "test:shokuba": "node scripts/run-python.cjs scripts/test-shokuba.py",
    "e2e:workplace": "node scripts/e2e-workplace.cjs",
    "collect:ipss-population": "node scripts/run-python.cjs collector/collect_ipss_population.py",
    "audit:ipss-population": "node scripts/run-python.cjs scripts/audit-ipss-population.py",
    "e2e:ipss-population": "node scripts/e2e-ipss-population.cjs",
    "e2e:retail-history": "node scripts/e2e-retail-history.cjs",
    "collect:lodging-statistics": "node scripts/run-python.cjs collector/collect_lodging_statistics.py",
    "audit:lodging-statistics": "node scripts/run-python.cjs scripts/audit-lodging-statistics.py",
    "e2e:lodging-statistics": "node scripts/e2e-lodging-statistics.cjs",
    "collect:jma-weather": "node scripts/run-python.cjs collector/collect_jma_weather.py",
    "audit:jma-weather": "node scripts/run-python.cjs scripts/audit-jma-weather.py",
    "e2e:jma-weather": "node scripts/e2e-jma-weather.cjs"
  },
  "dependencies": {
    "astro": "^7.3.4",
    "echarts": "^6.1.0",
    "maplibre-gl": "^6.11.1"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
