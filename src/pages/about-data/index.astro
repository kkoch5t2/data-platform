---
import summary from '../../data/summary';
import { readFileSync } from 'node:fs';
import '../../styles/detail.css';

const firstDate = summary.firstDate ?? '2014-03-19';
const lastDate = summary.lastDate ?? '—';
const awardEligibleRecords = summary.awardEligibleRecords ?? summary.records ?? 0;
const awardCoverage = awardEligibleRecords ? (summary.awardRecords / awardEligibleRecords * 100) : 0;
const fmt = (v) => new Intl.NumberFormat('ja-JP').format(v || 0);
const fmtDate = (v) => v ? v.replace(/^(\d{4})-(\d{2})-(\d{2})$/, '$1年$2月$3日') : '—';
const transactions = JSON.parse(readFileSync('public/data/realestate-transactions.json', 'utf8'));
const companyRegistrySummary = JSON.parse(readFileSync('public/data/company-registry/summary.json', 'utf8'));
const gbizFinance = companyRegistrySummary.sources?.gbizFinance || {};
const gbizDate = gbizFinance.sourceDate || '—';
const gbizLegacy = gbizFinance.snapshotStatus === 'legacy';
const gbizLabel = gbizLegacy ? 'gBizINFO旧システム財務情報' : 'gBizINFO財務情報';
const gbizStatusNote = gbizLegacy ? '旧スナップショットで最新データではありません' : '現行配布データ';
const gbizStatements = companyRegistrySummary.sources?.gbizStatements || {};
const gbizStatementDate = gbizStatements.sourceDate || '—';
const financeCoverage = companyRegistrySummary.unlistedFinanceCompanies || 0;
const financeCsvCoverage = companyRegistrySummary.unlistedFinanceCsvCompanies || 0;
const statementCoverage = companyRegistrySummary.unlistedStatementCompanies || 0;
const ambiguousProcurementNames = companyRegistrySummary.ambiguousNames || 0;
---
<html lang="ja">
<head><link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width">
  <meta name="description" content="公共調達、不動産、防災、暮らし、都道府県トレンド、雇用・賃金、企業・産業、上場企業、未上場企業、経済・物価、エネルギー、話題のトピックの収録範囲、出典、集計方法、利用上の注意を説明します。">
  <link rel="canonical" href="https://datlume.com/about-data/">
  <meta property="og:url" content="https://datlume.com/about-data/">
  <title>データについて | DATLUME</title>
</head>
<body>
<header><div class="wrap">
  <div class="nav"><a class="brand" href="/" aria-label="DATLUME" style="display:inline-flex;align-items:center;gap:10px;text-decoration:none;color:#fff"><img src="/favicon.svg" alt="" width="24" height="24" style="display:block;width:24px;height:24px;filter:brightness(0) invert(1)"><span style="font-family:'Segoe UI Variable','Avenir Next','Helvetica Neue',system-ui,sans-serif;font-size:19px;font-weight:750;letter-spacing:.16em;line-height:1">DATLUME</span></a><a class="back" href="/">トップへ戻る</a></div>
  <div class="hero"><div class="eyebrow">About the data</div><h1>データについて</h1><p>収録範囲、分類方法、集計値の意味と限界を明示しています。</p></div>
</div></header><main class="wrap">
  <div class="stats">
    <div class="card"><div class="label">収録期間</div><div class="value" style="font-size:20px">{fmtDate(firstDate)}〜<br>{fmtDate(lastDate)}</div></div>
    <div class="card"><div class="label">収録レコード</div><div class="value">{fmt(summary.records)}件</div></div>
    <div class="card"><div class="label">総額を確認できる結果案件</div><div class="value">{fmt(summary.awardRecords)}件</div><div class="label">判定対象 {fmt(awardEligibleRecords)}件の約 {awardCoverage.toFixed(1)}%</div></div>
  </div>

  <section id="workplace" class="card section"><h2>企業の職場情報</h2><p>厚生労働省「しょくばらぼ」の全件CSVから、法人番号で既存の上場・未上場企業に照合し、残業・有給休暇・平均年齢・採用と定着の公開値を掲載しています。配布データは{companyRegistrySummary.sources?.shokuba?.sourceDate || "—"}時点。未上場企業{fmt(companyRegistrySummary.unlistedWorkplaceCompanies || 0)}社に職場情報を追加しています。</p><p>所定外労働と法定時間外・休日労働、全体と雇用管理区分別の有給取得率は別指標です。対象区分や企業の補足、企業情報の更新日時を保持します。企業グループ全体の値と記載される場合もあります。採用・離職の3列は原典の「前年度／2年度前／3年度前」で、暦年を推測しません。未掲載は0にしません。</p><p>出典：<a href="https://shokuba.mhlw.go.jp/shokuba/utilize/utilize010.do" target="_blank" rel="noreferrer">厚生労働省「しょくばらぼ」</a>のデータを加工して作成。</p></section>

  <section id="procurement" class="card section">
    <h2>国・自治体の案件データ</h2>
    <p>国・独立行政法人系の落札実績は、<strong>2014年3月〜2021年3月</strong>を調達ポータル（GEPS）の公式「落札実績オープンデータ」、<strong>2021年4月以降</strong>を調達ポータル公式の年度別落札実績データから取得しています。JETRO「政府公共調達データベース」も収録します。GEPSと同一契約を示す個々の証拠が不足するため、両ソースの掲載行を保持し、ソース横断の契約単位で完全には名寄せしていません。自治体系は各自治体の公式入札・契約結果を直接収集して補完しています。</p>
    <p>現在の収録内訳：国・独立行政法人系 <strong>{fmt(summary.nationalRecords ?? summary.records)}件</strong> / 地方政府系 <strong>{fmt(summary.localRecords ?? 0)}件</strong>。</p>
    <p>JETRO地方政府検索では都道府県・政令指定都市・地方独立行政法人などが対象です。これに加え、DATLUMEでは横浜市（2018年〜）、札幌市（2019年〜）、神戸市（2023年〜）、福岡市（1988年〜）、千葉市（2012年〜、区分により開始時期が異なる）、京都市（電子入札結果、2005年〜）の公式入札・契約公開情報を直接収集して補完しています。自治体ごとに公開期間や対象契約の範囲は異なり、<strong>全国すべての市区町村の入札・契約情報を網羅しているわけではありません。</strong></p>
    <p>国の落札実績は、公式GEPS全件データが存在する最古年度（FY2013、実データ最古2014年3月19日）から収録しています。2021年4月以降も調達ポータル公式の年度別落札実績を正本として継続し、JETROは公告・公示の補完ソースとして扱います。2012年度以前のGEPS全件ファイルは取得できません。</p>
    <p>データソースによって日付の意味が異なり、GEPS落札実績は<strong>落札決定日</strong>、JETROは主に<strong>公示日・公告日</strong>、福岡市の直接収集分は<strong>入札日</strong>と<strong>契約日</strong>です。福岡市の入札日を公告日、契約日を落札決定日として表示しません。落札実績と公告・公示を同一母集団として単純比較しないよう注意してください。</p>
    <p>「契約方式」は原典の細かな表記を一般競争入札・指名競争入札・随意契約などの大分類で集計します。「落札・選定基準」は最低価格・総合評価など基準を確認できた案件だけを数えます。自治体の公開項目に契約方式と同じ値が入っていても、基準が確認できない場合は後者の図に含めません。方式や基準が分からない案件も収録件数には含まれます。</p>
  </section>

  <section class="card section">
    <h2>分野分類について</h2>
    <p>「IT・デジタル」「建設・土木」「医療・福祉」「事務・BPO」「情報サービス」「法務・登記」「賃貸借・リース」などの分野は、案件名に含まれる複数の語句と文脈パターンを重み付けし、最も強い意味を主分類として自動判定しています。分類前に「電子調達システム対象案件」などの定型文を除外し、発注機関名や一般語だけで分野が決まりにくいよう優先ルールを設けています。</p>
    <p>そのため、複数分野にまたがる案件、表現が特殊な案件、案件名だけでは内容を判断しにくい案件では、誤分類や「その他」への分類が発生する場合があります。</p>
  </section>  <section class="card section">
    <h2>落札額・受注企業・契約方式について</h2>
    <p>GEPSの歴史データは落札価格・受注企業・入札方式を公式オープンデータから取得しています。2021年4月以降の国の落札実績も調達ポータル公式データから落札価格・受注企業・入札方式を取得しています。JETRO補完情報では、これらは詳細ページで確認できた案件だけに保持しています。</p>
    <p>公共調達の企業IDは、公開元の受注者表記をNFKCで整え、法人略記・空白をそろえ、英字の大小文字差を同一視した<strong>社名ベースの識別子</strong>です。法人番号を一意に確認できた企業だけを法的な1法人として照合します。未上場企業トップの受注額ランキングは社名ベースの調達集計で、該当法人へ案件を帰属させた値ではありません。企業情報ページの調達欄は、原典で法人番号を確認できた案件のみです。国税庁法人マスタへの正規化社名照合で複数法人候補となる社名IDは現在 <strong>{fmt(ambiguousProcurementNames)}件</strong>あり、これらは同名別法人を区別できない可能性があるため、社名ランキングを法人単位の厳密な企業ランキングとは扱いません。</p>
    <p>自治体公式結果の金額は各公開元の表示基準を保持しています。千葉市の直接収集分は公式ページの税込契約金額、京都市の電子入札結果は公式ページ掲載の税抜き落札額です。異なる公開元の金額を比較する場合は、この税区分の違いに注意してください。</p>
    <p><strong>「確認済み落札総額」は、金額を確認できた収録レコードの合計です。ソース横断の契約重複が残り得るため、ユニークな契約総額ではありません。また、日本の公共調達市場全体の総額や、その分野の完全な市場規模を示す数字ではありません。</strong></p>
  </section>

  <section class="card section">
    <h2>数字の読み方</h2>
    <table>
      <thead><tr><th>表示</th><th>意味</th></tr></thead>
      <tbody>
        <tr><td>収録レコード</td><td>当サイトに取り込んだ公開調達・落札実績情報の件数。データソースによって1レコードの意味は異なります。</td></tr>
        <tr><td>確認済み落札総額</td><td>落札額を取得できた収録レコードだけの合計。</td></tr>
        <tr><td>受注企業名</td><td>受注企業を確認できた収録レコードの正規化済みユニーク社名ID数。法人番号で一意確認した法人数ではありません。</td></tr>
        <tr><td>分野別件数</td><td>重み付きルールベース分類による件数。公的な産業分類ではありません。</td></tr>
      </tbody>
    </table>
  </section>

  <section class="card section">
    <h2>このサイトで言えること / 言えないこと</h2>
    <p><strong>言えること：</strong>収録された政府公共調達の傾向、案件数の推移、発注機関や確認済み受注企業名の社名ベース比較、分野ごとの相対的な動き。</p>
    <p><strong>そのままでは言えないこと：</strong>日本の公共調達全体の完全な市場規模、全国自治体を含む完全ランキング、法人番号で一意化した厳密な企業ランキング、未取得案件を含む真の受注総額。</p>
  </section>

  <section id="regional" class="card section">
    <h2><span aria-hidden="true">🗾</span> 都道府県別推移</h2>
    <p>独立行政法人 統計センター「SSDSE-B-2026（県別推移）」を使用し、47都道府県の2012〜2023年データを可視化しています。さらに総務省統計局「住民基本台帳人口移動報告」の都道府県別長期時系列を別JSONで保持し、転入・転出・転入超過を1954〜2025年まで必要時のみ読み込みます。</p>
    <p>対象指標には人口、高齢化、出生・死亡、人口移動、求人・求職、住宅着工、宿泊、地価、リサイクル率、待機児童などがあります。元統計の基準時点や定義は指標ごとに異なります。</p>
    <p><a href="/regional/projections/">市区町村の将来人口</a>は国立社会保障・人口問題研究所「日本の地域別将来推計人口（令和5（2023）年推計）」の結果表1・2-1～2-3を使用します。2020年は国勢調査の基準人口、2025～2050年は5年ごとの推計値です。1,884地域に加えて政令指定都市20市の区合計を比較候補として表示します（区合計を地域数へ重複計上しません）。福島県浜通り13市町村には個別推計がないため「浜通り地域」の合計のみを表示します。地図の点は別統計SSDSE-Aの自治体代表点とコード・名称が一致する地域のみです。2020年の年齢3区分には年齢不詳が含まれないため総人口との和が一致しない場合があります。</p>
    <p>「求人倍率（参考）」はSSDSE収録の月間有効求人数を月間有効求職者数で割って当サイトが算出した参考値で、公式に公表される有効求人倍率そのものとは限りません。</p>
  </section>

  <section id="transport" class="card section">
    <h2>公共交通</h2><p><a href="/transport/">公共交通データ</a>は国土数値情報・駅別乗降客数（2011〜2024年度、CC BY 4.0）、2020年国勢調査第17-2表、自動車輸送統計年報第4-2表、鉄道輸送統計月報第2-1表を加工して作成します。</p>
    <p>駅は原典の駅コード・駅名・事業者・路線で識別し、同じ識別情報の分割地物は値が一致する場合だけ統合します。他路線への重複記載は数えません。非公開・駅なし・データなしは0人として扱いません。大聖寺の2012〜2018年度は原典の分類コードが未定義の0のため、値を欠損として保持します。事業者ごとに集計方法が異なり、同名駅合算や実人数として解釈できません。</p>
    <p>通勤・通学手段は住んでいる地域別の15歳以上の通勤者・通学者が対象。不詳を含む総数を分母とし、単独・併用の排他的区分を使用します。バスは乗合（一般・高速）だけで貸切を含めず、地域は調査対象の支局で区分されます。北海道は7支局を合算。バスと鉄道の千人単位の値は原表の丸め精度を保持します。鉄道は月報と年次の実績を区別し、速報と混ぜません。</p>
  </section>
  <section id="business-industry" class="card section">
    <h2><span aria-hidden="true">🏭</span> 企業・産業</h2>
    <p>総務省統計局「令和6年経済センサス‐基礎調査 甲調査」の確報を使用し、47都道府県の2024年の民営事業所数・民営従業者数と、建設業、製造業、情報通信業、卸売業・小売業、宿泊業・飲食サービス業、生活関連サービス業・娯楽業、医療・福祉の主要7産業を可視化しています。</p>
    <p><strong>2024年甲調査は「雇用者のいない個人経営の事業所」を除く民営事業所が対象です。</strong> 公務を除く全産業を総数として使用しています。「1事業所あたり従業者数」と産業別構成比はDATLUMEで算出した参考値です。</p>
    <p>過去表示の2016年・2021年は統計センターSSDSE-Eに収録された経済センサス由来値です。2024年甲調査とは調査対象範囲が異なるため、2024年との単純な増減比較は行いません。産業別表示は2024年経済センサスの産業大分類から主要7産業を抜粋しており、表示比率の合計は100%になりません。</p>
  </section>

  <section id="listed-companies" class="card section">
    <h2><span aria-hidden="true">📈</span> 上場企業</h2>
    <p>企業マスタは日本取引所グループ「東証上場銘柄一覧」と金融庁「EDINETコードリスト」を突合しています。証券コード、企業名、市場、東証33業種・17業種、EDINETコード等を保持し、普通株を企業ページの主キーにしています。種類株式などの5桁銘柄コードは同一企業の重複ページを作らないよう企業数から除外します。</p>
    <p>財務情報は金融庁EDINETの有価証券報告書XBRL/CSVを使用します。原則として連結財務を優先し、連結がない場合だけ個別財務を使用します。会計基準、対象期間、コンテキスト、単位、訂正報告書を確認し、欠損値を推測で補完しません。</p>
    <p>銀行・保険・証券などの金融業は一般企業と財務構造が異なるため、負債の多さや営業利益率などを一般企業と同じ意味で評価しません。株価・PER・PBR・時価総額は配信条件・ライセンスが財務開示情報より複雑なため、初期版では対象外です。</p>
    <p>会社別の年齢階級ごとの給与分布や、全社共通定義の採用数・退職数は、一次公開データから安定して取得できないため推計値を作って表示しません。公開資料で確認できる平均年間給与・平均年齢・平均勤続年数・従業員数などを優先します。</p>
  </section>

<section id="unlisted-companies" class="card section">
<h2><span aria-hidden="true">🏢</span> 未上場企業</h2>
<p>国税庁「法人番号公表サイト」の全国全件データを法人マスタとして使用します。調達データの社名から法人候補を探しますが、名前だけの一致で受注実績を法人へ割り当てません。掲載対象は現存する株式会社・有限会社・合名会社・合資会社・合同会社です。</p>
<p>未上場判定では、日本取引所グループ「東証上場銘柄一覧」に加え、金融庁「EDINETコードリスト」の上場区分も照合して除外します。未上場企業一覧の法人基本情報は国税庁データに基づきます。法人別の公共調達実績は、同じ公式案件の受注者欄と法人番号を照合できる記録だけを集計します。名前だけ一致した案件は調達の社名別ページに残します。</p>
<p>企業別指標は公共調達の受注実績を中心に、{gbizLabel}（{gbizDate}時点）と、gBizINFO「決算情報」に収録された官報決算公告（{gbizStatementDate}時点）を法人番号で照合しています。公開財務を確認できる会社は現在 <strong>{fmt(financeCoverage)}社</strong>で、財務CSV {fmt(financeCsvCoverage)}社、決算公告 {fmt(statementCoverage)}社（重複あり）です。決算公告では主に貸借対照表の要旨を使い、売上・利益など公告に記載がない項目は推測で補完しません。</p>
</section>

  <section id="employment-economy" class="card section">
    <h2>雇用・賃金・地域経済</h2>
    <p>賃金は厚生労働省「2025年（令和7年）賃金構造基本統計調査」の一般労働者・都道府県別表を使用しています。都道府県別の賃金推移は2001〜2025年の一般労働者・男女計・産業計・企業規模10人以上の参考表を取得し、履歴タブを開いたときだけ読み込みます。各年の公表値を使い、2020年の方式による過去分の遡及再集計系列とは区別します。2004年・2009年の産業分類、2005年の調査項目・雇用形態区分、2018年の労働者定義、2019年の対象産業範囲、2020年の調査項目・推計方法の変更年では線をつなぎません。変更前後の差は賃金の増減だけでは解釈できません。月額の「きまって支給する現金給与額」「所定内給与額」「年間賞与その他特別給与額」に加え、都道府県×年齢階級（～19歳、20～24歳、…、65～69歳、70歳～）の男女計・企業規模10人以上も収録しています。</p>
    <p><strong>「推計年収」</strong>は、きまって支給する現金給与額×12＋年間賞与その他特別給与額をDATLUMEで計算した参考値です。月額は調査年6月分、賞与等は原則として前年1年間の値です。個人の年収、世帯所得、手取り額を意味しません。</p>
    <p>地域経済は統計センター「SSDSE-E-2026」を使用し、県内総生産・県民所得・1人当たり県民所得・民営事業所数・民営従業者数・産業別従業者数などを収録しています。元統計年は指標ごとに異なり、県内総生産・県民所得・事業所・従業者は2021年、人口は2024年です。</p>
    <p>求人は「SSDSE-B-2026」の月間有効求人数・月間有効求職者数を使用し、DATLUMEで割り算した<strong>求人倍率の参考値</strong>です。厚生労働省が公表する有効求人倍率そのものとは限りません。</p>
  </section>

  <section id="economy-prices" class="card section">
    <h2><span aria-hidden="true">💴</span> 経済・物価</h2>
    <p>総務省統計局「小売物価統計調査（構造編）」の消費者物価地域差指数を使用し、47都道府県の総合、家賃を除く総合、食料、住居、光熱・水道、家具・家事用品、被服及び履物、保健医療、交通・通信、教育、教養娯楽、諸雑費を可視化しています。2013〜2025年について同じ47都道府県表を年別に取得し、各年の全国平均=100に対する地域ポジションの推移も必要時のみ読み込みます。</p>
    <p>「実際の値段」には、同調査（動向編）の主要品目の都市別小売価格を使用します。選んだ13品目について2000年1月から月次の価格を表示し、最新月の安い都市・高い都市を比較できます。価格は調査都市と特定の品目・容量の値であり、都道府県平均や全商品の物価ではありません。米の旧10kg価格は5kg相当に半額換算し、その期間を画面に明記しています。鶏卵・電気・都市ガスなど、過去と現在の単位が揃わない月は線を空けて表示します。仕様や調査対象が変わるため、長期の増減は参考値です。</p>
    <p>地域差指数は<strong>全国平均の物価水準を100</strong>として地域間の価格水準を比較する指標です。指数の前年差を、その地域のインフレ率・物価上昇率として読むことはできません。また、「総合」と「住居」は持家の帰属家賃を含みません。</p>
    <p>「生活費換算」は、全国平均での支出額に総合地域差指数を掛けた単純換算です。「物価調整後 推計年収」は、賃金構造基本統計調査から算出した推計年収を地域差指数で割り戻したDATLUME独自の参考値で、個人の実質所得や可処分所得を示すものではありません。</p>
  </section>

  <section id="energy" class="card section">
    <h2><span aria-hidden="true">⚡</span> エネルギー</h2>
    <p>家計のエネルギー支出は、総務省統計局「家計調査」2025年年報の第7-1表と詳細結果表第1-1表を使用しています。対象は二人以上の世帯で、地域値は都道府県庁所在市（東京都は東京都区部）です。都道府県全体の平均ではありません。</p>
    <p>「エネルギー支出」は、電気代＋ガス代＋その他光熱をDATLUMEで合算した参考値です。上下水道料は分離しています。実際の支出は契約単価だけでなく、気候、住宅性能、使用量、世帯人数などにも左右されるため、支出額をそのまま地域の電気料金単価と解釈できません。</p>
    <p>「光熱・水道の価格水準」は小売物価統計調査（構造編）の消費者物価地域差指数（全国平均=100）です。2012〜2023年の推移には統計センター「SSDSE-B-2026」の都道府県別系列を使用しており、2025年の都道府県庁所在市データとは地域単位が異なります。</p>
    <p>日本全体の発電・需要・電源構成は資源エネルギー庁「電力調査統計」の2025年11月分の固定された過去の参考値を表示します。最新月への自動更新はしていません。都道府県別の長期比較には資源エネルギー庁「都道府県別エネルギー消費統計」を使用し、1990〜2023年度の1人あたり最終エネルギー消費・家庭・運輸・業務他に加え、同統計の炭素単位表を44/12倍して算出した1人あたりCO₂排出量（t-CO₂/人）も別JSONで保持し、必要時のみ読み込みます。最新統計表の更新時点と、結果概要に使う対象月が異なる場合は画面上で明示します。再エネ賦課金やエネルギー自給率も資源エネルギー庁の公表資料を出典としています。</p>
  </section>

  <section id="topics" class="card section">
    <h2><span aria-hidden="true">🔥</span> 話題のトピック</h2>
    <p>Wikimedia Foundationの「Wikimedia Analytics API - Pageviews」から、日本語版Wikipedia（<code>ja.wikipedia</code>）の日別閲覧上位を取得しています。対象はdesktop・mobile web・appを合わせた<code>all-access</code>です。メインページ、検索、Wikipedia内部運用ページなどはランキングから除外します。</p>
    <p>総合ランキングは取得できた最新日の閲覧数、急上昇は前日に3,000PV以上あった記事の前日比、週間ランキングは直近7日の日別上位データの合算です。Wikimedia側で最新日がまだ集計されていない場合は、取得可能な直近日を自動採用します。</p>
    <p>カテゴリ分類は、日本語版WikipediaのMediaWiki Action APIから取得するページカテゴリ・概要と、Wikidataのラベル・説明・instance of・occupation・genre・sport等の構造化情報を組み合わせたルールベース判定です。記事名だけで分類せず、分類根拠が弱い場合は「人物」「その他」に寄せます。自動分類のため誤分類は起こり得ます。</p>
    <p>「なぜ急上昇？」は、急上昇上位の記事名についてGoogle News RSSの日本向け検索で急上昇日の前後に公開された関連報道を探し、その見出しを<strong>背景候補</strong>として表示します。報道と閲覧増加の時期が重なることを示す補助情報であり、ニュースが閲覧増加の原因だと断定しません。ニュース取得に失敗してもWikipediaランキング自体の更新は継続します。</p>
    <p><strong>このページは「日本語版Wikipediaで何が読まれたか」を示すもので、日本国内ユーザーだけを集計したデータではありません。</strong> 日本全体の検索トレンド、SNS投稿量、ニュース重要度、世論を直接示す指標としては扱いません。</p>
  </section>

