---
const title='上場企業を比較 | DATLUME';
---
<!doctype html><html lang="ja"><head>
<link rel="icon" type="image/svg+xml" href="/favicon.svg"><meta charset="utf-8"><meta name="viewport" content="width=device-width">
<meta name="description" content="日本の上場企業を2〜5社選び、売上・利益・ROE・自己資本比率・キャッシュフロー・給与などを比較します。">
<link rel="canonical" href="https://datlume.com/listed-companies/compare/"><title>{title}</title>
<style is:global>
:root{--ink:#111827;--muted:#667085;--line:#e5e9f0;--bg:#f4f6f9;--nav:#0b1728;--blue:#1769e0;--red:#c92a2a}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Hiragino Kaku Gothic ProN","Yu Gothic","Noto Sans JP",sans-serif}.wrap{width:min(1200px,calc(100% - 32px));margin:auto}a{color:inherit}header{background:var(--nav);color:#fff;padding:20px 0 48px}.nav{display:flex;align-items:center;gap:14px}.brand{display:inline-flex;align-items:center;gap:10px;text-decoration:none;font-size:19px;font-weight:800;letter-spacing:.15em}.navlinks{margin-left:auto;display:flex;gap:8px;flex-wrap:wrap}.navlinks a{font-size:11px;color:#d7e1ee;text-decoration:none;border:1px solid #ffffff26;border-radius:999px;padding:7px 10px}.hero{margin-top:44px}.eyebrow{font-size:10px;color:#8ebcff;font-weight:900;letter-spacing:.16em}.hero h1{font-size:clamp(34px,5vw,58px);margin:8px 0 12px;letter-spacing:-.05em}.hero p{margin:0;max-width:760px;color:#c7d3e4;line-height:1.8;font-size:13px}main{padding:18px 0 64px}.card{background:#fff;border:1px solid var(--line);border-radius:16px}.picker{padding:16px}.picker-grid{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:end}.picker label{display:block;font-size:10px;color:var(--muted);font-weight:800;margin-bottom:5px}.picker input{width:100%;height:44px;border:1px solid #d8dee8;border-radius:10px;padding:0 12px;font:inherit}.add{height:44px;border:0;border-radius:10px;background:var(--blue);color:#fff;padding:0 18px;font-weight:850;cursor:pointer}.hint{font-size:10px;color:var(--muted);margin-top:8px}.matches{display:none;position:absolute;z-index:4;background:#fff;border:1px solid var(--line);border-radius:10px;box-shadow:0 12px 30px #10182820;width:min(700px,calc(100vw - 64px));max-height:280px;overflow:auto}.matches button{display:block;width:100%;text-align:left;border:0;background:#fff;padding:10px 12px;font:inherit;cursor:pointer}.matches button:hover{background:#f5f8fc}.selected{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.chip{display:flex;gap:7px;align-items:center;background:#eef5ff;color:#174ea6;border-radius:999px;padding:7px 10px;font-size:11px;font-weight:800}.chip button{border:0;background:transparent;color:inherit;cursor:pointer;font-size:14px}.section{margin-top:14px}.section h2{font-size:18px;margin:0 0 10px}.empty{padding:28px;text-align:center;color:var(--muted);font-size:11px;line-height:1.8}.table-wrap{overflow:auto}.compare-table{width:100%;border-collapse:collapse;min-width:760px}.compare-table th,.compare-table td{padding:12px 14px;border-bottom:1px solid #edf0f4;text-align:right;font-size:11px}.compare-table th:first-child,.compare-table td:first-child{text-align:left;position:sticky;left:0;background:#fff;z-index:1}.compare-table thead th{font-size:12px}.company-link{font-weight:900;text-decoration:none;color:var(--blue)}.mobile-company{display:none}.negative{color:var(--red)}.chart-card{padding:16px}.chart{height:380px}.controls{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px}.controls select{height:38px;border:1px solid #d8dee8;border-radius:9px;padding:0 10px;background:#fff;font:inherit;font-size:11px}.source{font-size:10px;color:var(--muted);line-height:1.8;margin-top:14px}@media(max-width:720px){.wrap{width:min(100% - 24px,1200px)}.nav{display:block}.navlinks{margin:14px 0 0;overflow:auto;flex-wrap:nowrap}.navlinks a{white-space:nowrap}.picker-grid{grid-template-columns:1fr}.add{width:100%}.table-wrap{overflow:visible}.compare-table{min-width:0;display:block}.compare-table thead{display:none}.compare-table tbody{display:block}.compare-table tr{display:grid;grid-template-columns:1fr 1fr;border-bottom:1px solid #e7ebf1}.compare-table th,.compare-table td{padding:10px 12px;border:0;text-align:left}.compare-table tbody th{grid-column:1/-1;position:static;background:#f7f9fc;font-size:12px}.compare-table td{min-width:0;font-weight:850}.compare-table td.empty{grid-column:1/-1}.mobile-company{display:block;font-size:9px;color:var(--muted);font-weight:700;margin-bottom:3px}.chart{height:330px}}
</style></head><body><header><div class="wrap"><nav class="nav"><a class="brand" href="/"><img src="/favicon.svg" alt="" width="24" height="24" style="filter:brightness(0) invert(1)"><span>DATLUME</span></a><div class="navlinks"><a href="/listed-companies/">上場企業</a><a href="/listed-companies/compare/">企業比較</a><a href="/business-industry/">企業・産業</a><a href="/about-data/">データについて</a></div></nav><div class="hero"><div class="eyebrow">COMPARE / LISTED COMPANIES</div><h1>会社を、横に並べて見る。</h1><p>2〜5社を選び、最新の財務指標と最大10年の推移を比較します。金融業は一般企業と同じ営業利益率では評価しません。</p></div></div></header>
<main class="wrap"><section class="card picker"><div class="picker-grid"><div style="position:relative"><label for="company-search">企業名 / 証券コード</label><input id="company-search" type="search" placeholder="例：トヨタ / 7203"><div id="matches" class="matches"></div></div><button id="add-company" class="add" type="button">追加</button></div><div class="hint">2〜5社まで。URLに選択企業を保存するので、そのまま共有できます。</div><div id="selected" class="selected"></div></section>
<section class="section card"><div class="table-wrap"><table id="compare-table" class="compare-table"><tbody><tr><td class="empty">比較する企業を2社以上選んでください。</td></tr></tbody></table></div></section>
<section class="section card chart-card"><div style="display:flex;justify-content:space-between;gap:12px;align-items:end;flex-wrap:wrap"><h2>10年推移</h2><div class="controls"><select id="metric"><option value="revenue">売上高</option><option value="operatingIncome">営業利益</option><option value="netIncome">純利益</option><option value="assets">総資産</option><option value="cash">現預金</option><option value="operatingCashFlow">営業CF</option><option value="roe">ROE</option><option value="equityRatio">自己資本比率</option><option value="averageSalary">平均年間給与</option></select></div></div><div id="history-chart" class="chart"></div></section>
<div class="source">出典：日本取引所グループ「東証上場銘柄一覧」、金融庁 EDINET。有価証券報告書で確認できた値のみ表示し、欠損値は推測で補完しません。</div></main><script src="https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.min.js"></script>
<script>
const yen=v=>{if(v==null)return'—';const a=Math.abs(v),s=v<0?'-':'';if(a>=1e12)return s+(a/1e12).toLocaleString('ja-JP',{maximumFractionDigits:2})+'兆円';if(a>=1e8)return s+(a/1e8).toLocaleString('ja-JP',{maximumFractionDigits:1})+'億円';if(a>=1e4)return s+(a/1e4).toLocaleString('ja-JP',{maximumFractionDigits:0})+'万円';return v.toLocaleString('ja-JP')+'円'};
const pct=v=>v==null?'—':Number(v).toLocaleString('ja-JP',{maximumFractionDigits:1})+'%';const num=v=>v==null?'—':Number(v).toLocaleString('ja-JP');const negative=v=>Number(v)<0?'negative':'';let index=[],selectedCodes=[],details=new Map(),chart=null,pending=null;
const search=document.getElementById('company-search'),matches=document.getElementById('matches'),selected=document.getElementById('selected'),table=document.getElementById('compare-table'),metric=document.getElementById('metric');
function findMatches(){const q=search.value.trim().toLocaleLowerCase('ja-JP');if(!q){matches.style.display='none';return[]}const rows=index.filter(c=>!selectedCodes.includes(c.securityCode)&&(c.name+c.securityCode).toLocaleLowerCase('ja-JP').includes(q)).slice(0,8);matches.innerHTML=rows.map(c=>`<button type="button" data-code="${c.securityCode}"><b>${c.name}</b> <small>${c.securityCode} · ${c.market}</small></button>`).join('');matches.style.display=rows.length?'block':'none';return rows}
search.addEventListener('input',findMatches);matches.addEventListener('click',e=>{const b=e.target.closest('button[data-code]');if(!b)return;pending=b.dataset.code;search.value=index.find(x=>x.securityCode===pending)?.name||pending;matches.style.display='none'});document.getElementById('add-company').addEventListener('click',()=>{const q=search.value.trim().toLocaleLowerCase('ja-JP');const code=pending||index.find(c=>(c.name+c.securityCode).toLocaleLowerCase('ja-JP').includes(q))?.securityCode;if(!code)return;if(selectedCodes.includes(code)||selectedCodes.length>=5)return;selectedCodes.push(code);pending=null;search.value='';syncUrl();render()});
selected.addEventListener('click',e=>{const b=e.target.closest('button[data-remove]');if(!b)return;selectedCodes=selectedCodes.filter(c=>c!==b.dataset.remove);details.delete(b.dataset.remove);syncUrl();render()});
function syncUrl(){const u=new URL(location.href);if(selectedCodes.length)u.searchParams.set('codes',selectedCodes.join(','));else u.searchParams.delete('codes');history.replaceState(null,'',u)}
function detailBucket(code){let v=0;for(const ch of code)v=(v*31+ch.charCodeAt(0))%64;return v.toString(16).padStart(2,'0')}async function ensureDetails(){const missing=selectedCodes.filter(c=>!details.has(c));const groups=new Map();for(const code of missing){const b=detailBucket(code);if(!groups.has(b))groups.set(b,[]);groups.get(b).push(code)}await Promise.all([...groups].map(async([b,codes])=>{try{const r=await fetch(`/data/listed-companies/details/${b}.json`);if(!r.ok)return;const payload=await r.json();for(const code of codes){const item=payload?.c?.[code];if(item)details.set(code,item)}}catch{}}))}
function formatMetric(key,v){return ['roe','equityRatio','operatingMargin','revenueGrowth'].includes(key)?pct(v):key==='employees'?num(v)+'人':yen(v)}
async function render(){selected.innerHTML=selectedCodes.map(c=>{const x=index.find(v=>v.securityCode===c);return `<span class="chip">${x?.name||c}<button type="button" data-remove="${c}" aria-label="${x?.name||c}を外す">×</button></span>`}).join('');if(selectedCodes.length<2){table.innerHTML='<tbody><tr><td class="empty">比較する企業を2社以上選んでください。</td></tr></tbody>';document.getElementById('history-chart').innerHTML='';return}await ensureDetails();const metrics=[['revenue','売上高'],['operatingIncome','営業利益'],['netIncome','純利益'],['assets','総資産'],['liabilities','負債'],['equity','純資産'],['cash','現預金'],['operatingCashFlow','営業CF'],['roe','ROE'],['equityRatio','自己資本比率'],['averageSalary','平均年間給与'],['employees','従業員数']];const heads=selectedCodes.map(c=>{const d=details.get(c),co=d?.company||index.find(v=>v.securityCode===c)||{};return `<th><a class="company-link" href="/listed-companies/${c}/">${co.name||c}</a><br><small>${c} · ${co.industry33||''}</small></th>`}).join('');const body=metrics.map(([k,label])=>`<tr><th>${label}</th>${selectedCodes.map(c=>{const d=details.get(c),v=d?.latest?.metrics?.[k];const name=d?.company?.name||c;return `<td class="${negative(v)}"><span class="mobile-company">${name}</span>${formatMetric(k,v)}</td>`}).join('')}</tr>`).join('');table.innerHTML=`<thead><tr><th>指標</th>${heads}</tr></thead><tbody>${body}</tbody>`;renderChart()}
function renderChart(){const el=document.getElementById('history-chart');if(!window.echarts||selectedCodes.length<2){el.innerHTML='';return}if(!chart)chart=echarts.init(el);const key=metric.value,percent=['roe','equityRatio'].includes(key);const labels={revenue:'売上高',operatingIncome:'営業利益',netIncome:'純利益',assets:'総資産',cash:'現預金',operatingCashFlow:'営業CF',roe:'ROE',equityRatio:'自己資本比率',averageSalary:'平均年間給与'};const years=[...new Set(selectedCodes.flatMap(c=>(details.get(c)?.financials||[]).map(r=>(r.periodEnd||'').slice(0,4))))].sort();const series=selectedCodes.map(c=>{const d=details.get(c),map=new Map((d?.financials||[]).map(r=>[(r.periodEnd||'').slice(0,4),r.metrics?.[key]]));return{name:d?.company?.name||c,type:'line',connectNulls:false,symbolSize:6,data:years.map(y=>map.get(y)??null)}});chart.setOption({tooltip:{trigger:'axis',valueFormatter:v=>percent?pct(v):yen(v)},legend:{top:0,type:'scroll'},grid:{left:68,right:22,top:48,bottom:38},xAxis:{type:'category',data:years},yAxis:{type:'value',axisLabel:{formatter:v=>percent?v+'%':v>=1e12?(v/1e12).toFixed(1)+'兆':v>=1e8?(v/1e8).toFixed(0)+'億':v}},series},true)}metric.addEventListener('change',renderChart);window.addEventListener('resize',()=>chart?.resize());
fetch('/data/listed-companies/index.json').then(r=>r.json()).then(data=>{index=data.records||[];const params=new URLSearchParams(location.search);selectedCodes=(params.get('codes')||'').split(',').filter(c=>index.some(x=>x.securityCode===c)).slice(0,5);render()}).catch(()=>{table.innerHTML='<tbody><tr><td class="empty">企業データを読み込めませんでした。</td></tr></tbody>'});
</script></body></html>
