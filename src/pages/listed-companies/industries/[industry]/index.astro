---
import fs from 'node:fs';import path from 'node:path';
export function getStaticPaths(){const master=JSON.parse(fs.readFileSync(path.join(process.cwd(),'public/data/listed-companies/master.json'),'utf8'));const names=[...new Set(master.records.map(c=>c.industry33).filter(x=>x&&x!=='-'))];return names.map(industry=>({params:{industry},props:{industry}}))}
const {industry}=Astro.props;
const index=JSON.parse(fs.readFileSync(path.join(process.cwd(),'public/data/listed-companies/index.json'),'utf8'));
const companies=(index.records||[]).filter(c=>c.industry33===industry);
const financial=['銀行業','保険業','証券、商品先物取引業','その他金融業'].includes(industry);
const revenueLike=c=>industry==='銀行業'?c.ordinaryRevenue:industry==='保険業'?(c.insuranceRevenue??c.ordinaryRevenue):c.revenue;
const profitLike=c=>industry==='銀行業'?c.ordinaryIncome:industry==='保険業'?c.profitBeforeTax:c.operatingIncome;
const revenueLabel=industry==='銀行業'?'経常収益':industry==='保険業'?'保険収益':'売上高';
const profitLabel=industry==='銀行業'?'経常利益':industry==='保険業'?'税引前利益':'営業利益';
const money=v=>{if(v==null)return'—';const a=Math.abs(v),s=v<0?'-':'';if(a>=1e12)return`${s}${(a/1e12).toLocaleString('ja-JP',{maximumFractionDigits:2})}兆円`;if(a>=1e8)return`${s}${(a/1e8).toLocaleString('ja-JP',{maximumFractionDigits:1})}億円`;if(a>=1e4)return`${s}${(a/1e4).toLocaleString('ja-JP',{maximumFractionDigits:0})}万円`;return`${v.toLocaleString('ja-JP')}円`};
const pct=v=>v==null?'—':`${Number(v).toLocaleString('ja-JP',{maximumFractionDigits:1})}%`;
const topBy=(getter,n=10)=>companies.filter(c=>Number.isFinite(getter(c))).sort((a,b)=>getter(b)-getter(a)).slice(0,n);
const revenueTop=topBy(revenueLike);const salaryTop=topBy(c=>c.averageSalary);const marginTop=financial?topBy(c=>c.roe):topBy(c=>c.operatingMargin);
---
<!doctype html><html lang="ja"><head><link rel="icon" type="image/svg+xml" href="/favicon.svg"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="description" content={`${industry}の上場企業を売上・利益率・給与などで比較。JPX・EDINETの公開データを使用。`}><link rel="canonical" href={`https://datlume.com/listed-companies/industries/${encodeURIComponent(industry)}/`}><title>{industry}の上場企業比較 | DATLUME</title>
<style>:root{--ink:#111827;--muted:#667085;--line:#e5e9f0;--bg:#f4f6f9;--nav:#0b1728;--blue:#1769e0;--red:#c92a2a}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Hiragino Kaku Gothic ProN","Yu Gothic","Noto Sans JP",sans-serif}.wrap{width:min(1180px,calc(100% - 32px));margin:auto}header{background:var(--nav);color:#fff;padding:20px 0 46px}.nav{display:flex;align-items:center;gap:12px}.brand{display:inline-flex;align-items:center;gap:9px;text-decoration:none;color:#fff;font-weight:800;letter-spacing:.14em}.navlinks{margin-left:auto;display:flex;gap:7px}.navlinks a{font-size:11px;color:#d7e1ee;border:1px solid #ffffff25;border-radius:999px;padding:7px 10px;text-decoration:none}.crumb{margin-top:30px;font-size:10px;color:#9fb0c4}.crumb a{color:inherit;text-decoration:none}.hero h1{font-size:clamp(34px,5vw,58px);margin:10px 0 10px;letter-spacing:-.05em}.hero p{margin:0;color:#c7d3e4;font-size:12px}.card{background:#fff;border:1px solid var(--line);border-radius:16px}main{padding:16px 0 64px}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.stat{padding:16px}.stat span{font-size:10px;color:var(--muted)}.stat b{display:block;font-size:23px;margin-top:5px}.section{margin-top:12px}.section-card{padding:18px}.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:11px}.section-head h2{margin:0;font-size:17px}.section-head p{margin:0;color:var(--muted);font-size:10px}.rank-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.rank{padding:15px}.rank h3{font-size:13px;margin:0 0 8px}.row{display:grid;grid-template-columns:24px 1fr auto;gap:7px;align-items:center;padding:7px 0;border-bottom:1px solid #f0f2f5;text-decoration:none;color:inherit;font-size:10px}.num{width:22px;height:22px;border-radius:6px;background:#eef5ff;color:var(--blue);display:grid;place-items:center;font-weight:900}.row b{font-size:11px}.row small{display:block;color:var(--muted);margin-top:2px}.value{font-weight:900}.negative{color:var(--red)}.companies{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.company{padding:13px;text-decoration:none;color:inherit}.company code{color:var(--blue);font-weight:800}.company h3{font-size:13px;margin:7px 0 4px}.company p{font-size:10px;color:var(--muted);margin:0}footer{border-top:1px solid var(--line);padding:26px 0 44px;color:var(--muted);font-size:10px}@media(max-width:850px){.rank-grid{grid-template-columns:1fr}.companies{grid-template-columns:1fr 1fr}}@media(max-width:600px){.wrap{width:min(100% - 24px,1180px)}.nav{display:block}.navlinks{margin:12px 0 0;overflow-x:auto}.navlinks a{white-space:nowrap}.stats{grid-template-columns:1fr}.companies{grid-template-columns:1fr}.section-head{display:block}.section-head p{margin-top:4px}}</style></head><body>
<header><div class="wrap"><nav class="nav"><a class="brand" href="/"><img src="/favicon.svg" alt="" width="24" height="24" style="filter:brightness(0) invert(1)"><span>DATLUME</span></a><div class="navlinks"><a href="/listed-companies/">企業検索</a><a href="/listed-companies/compare/">企業比較</a></div></nav><div class="crumb"><a href="/listed-companies/">上場企業</a> / 業種</div><div class="hero"><h1>{industry}</h1><p>{companies.length.toLocaleString('ja-JP')}社 · 東証33業種分類</p></div></div></header>
<main class="wrap"><section class="stats"><div class="card stat"><span>収録企業</span><b>{companies.length.toLocaleString('ja-JP')}社</b></div><div class="card stat"><span>財務データあり</span><b>{companies.filter(c=>c.hasFinancials).length.toLocaleString('ja-JP')}社</b></div><div class="card stat"><span>市場</span><b style="font-size:15px">{[...new Set(companies.map(c=>c.market))].join(' / ')}</b></div></section>
<section class="section"><div class="section-head"><h2>業種内ランキング</h2><p>欠損値は除外。金融業は一般企業と同じ営業利益率を使用しません。</p></div><div class="rank-grid"><div class="card rank"><h3>{revenueLabel}</h3>{revenueTop.map((c,i)=><a class="row" href={`/listed-companies/${c.securityCode}/`}><span class="num">{i+1}</span><span><b>{c.name}</b><small>{c.securityCode}</small></span><span class="value">{money(revenueLike(c))}</span></a>)}</div><div class="card rank"><h3>{financial?'ROE':'営業利益率'}</h3>{marginTop.map((c,i)=>{const v=financial?c.roe:c.operatingMargin;return <a class="row" href={`/listed-companies/${c.securityCode}/`}><span class="num">{i+1}</span><span><b>{c.name}</b><small>{c.securityCode}</small></span><span class={`value ${Number(v)<0?'negative':''}`}>{pct(v)}</span></a>})}</div><div class="card rank"><h3>平均年間給与</h3>{salaryTop.map((c,i)=><a class="row" href={`/listed-companies/${c.securityCode}/`}><span class="num">{i+1}</span><span><b>{c.name}</b><small>{c.securityCode}</small></span><span class="value">{money(c.averageSalary)}</span></a>)}</div></div></section>
<section class="section card section-card"><div class="section-head"><h2>{industry}の上場企業</h2><p>証券コード順</p></div><div class="companies">{companies.slice().sort((a,b)=>a.securityCode.localeCompare(b.securityCode)).map(c=><a class="card company" href={`/listed-companies/${c.securityCode}/`}><code>{c.securityCode}</code><h3>{c.name}</h3><p>{c.market}{c.hasFinancials?` · ${revenueLabel} ${money(revenueLike(c))}`:''}</p></a>)}</div></section>
<section class="section card section-card"><div class="section-head"><h2>見方</h2></div><p style="font-size:10px;line-height:1.8;color:var(--muted);margin:0">出典はJPX「東証上場銘柄一覧」と金融庁EDINET。有価証券報告書で確認できた値のみ表示します。{financial?'金融業は一般企業と財務構造が異なるため、営業利益率・負債比率を同じ意味で比較しません。':'利益率や成長率は会計基準・事業構成の違いにも注意してご覧ください。'}</p></section>
</main><footer><div class="wrap">DATLUME · 日本企業分析</div></footer></body></html>
