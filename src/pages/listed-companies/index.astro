---
import fs from 'node:fs';
import path from 'node:path';
const master=JSON.parse(fs.readFileSync(path.join(process.cwd(),'public/data/listed-companies/master.json'),'utf8'));
const summary=JSON.parse(fs.readFileSync(path.join(process.cwd(),'public/data/listed-companies/summary.json'),'utf8'));
const marketOrder=['プライム','スタンダード','グロース','TOKYO PRO Market'];
const markets=marketOrder.map(name=>({name,count:master.counts.byMarket[name]||0}));
const industryMap=new Map();
for(const c of master.records){if(c.industry33&&c.industry33!=='-')industryMap.set(c.industry33,(industryMap.get(c.industry33)||0)+1)}
const industries=[...industryMap.entries()].sort((a,b)=>b[1]-a[1]);
const fmt=n=>new Intl.NumberFormat('ja-JP').format(n||0);
---
<!doctype html><html lang="ja"><head><link rel="icon" type="image/svg+xml" href="/favicon.svg"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="description" content="日本の上場企業を、売上・利益・資産・キャッシュフロー・給与などの公開データから直感的に比較する企業分析ページ。JPXとEDINETの公式データを使用。"><link rel="canonical" href="https://datlume.com/listed-companies/"><meta property="og:title" content="日本企業分析 | DATLUME"><meta property="og:description" content="日本の上場企業を、数字とグラフでわかりやすく見る。"><meta property="og:type" content="website"><meta name="twitter:card" content="summary"><title>日本企業分析｜上場企業を数字とグラフで比較 | DATLUME</title>
<style is:global>
:root{--ink:#111827;--muted:#667085;--line:#e5e9f0;--bg:#f4f6f9;--card:#fff;--nav:#0b1728;--blue:#1769e0;--soft:#eef5ff;--red:#c92a2a;--black:#111827;--green:#087f5b}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Hiragino Kaku Gothic ProN","Yu Gothic","Noto Sans JP",sans-serif}.wrap{width:min(1240px,calc(100% - 32px));margin:auto}a{color:inherit}header{background:var(--nav);color:#fff;padding:20px 0 62px}.nav{display:flex;align-items:center;gap:16px}.brand{display:inline-flex;align-items:center;gap:10px;text-decoration:none}.navlinks{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end;margin-left:auto}.navlinks a{font-size:11px;color:#d7e1ee;border:1px solid #ffffff25;border-radius:999px;padding:7px 10px;text-decoration:none}.hero{padding-top:54px}.eyebrow{font-size:11px;color:#8ebcff;letter-spacing:.16em;font-weight:850}.hero h1{font-size:clamp(38px,6vw,72px);line-height:1.02;letter-spacing:-.055em;margin:10px 0 16px}.hero p{max-width:790px;color:#c7d3e4;font-size:15px;line-height:1.9;margin:0}.hero-meta{display:flex;gap:8px;flex-wrap:wrap;margin-top:20px}.hero-meta span{border:1px solid #ffffff26;border-radius:999px;padding:7px 10px;font-size:11px;color:#e1eaf5}
main{padding:18px 0 70px}.card{background:#fff;border:1px solid var(--line);border-radius:16px}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.stat{padding:16px 18px}.stat-label{font-size:10px;color:var(--muted);font-weight:750}.stat-value{font-size:25px;font-weight:900;letter-spacing:-.035em;margin-top:5px}.stat-sub{font-size:10px;color:var(--muted);margin-top:3px}.section{margin-top:16px}.section-head{display:flex;justify-content:space-between;gap:16px;align-items:end;margin-bottom:10px}.section-head h2{font-size:20px;margin:0}.section-head p{font-size:11px;color:var(--muted);line-height:1.6;margin:0}.search-card{padding:16px}.controls{display:grid;grid-template-columns:1.6fr .8fr 1fr;gap:10px}.control label{display:block;font-size:10px;font-weight:800;color:var(--muted);margin-bottom:5px}.control input,.control select{width:100%;height:43px;border:1px solid #d8dee8;border-radius:10px;background:#fff;padding:0 12px;font:inherit;font-size:13px;outline:none}.control input:focus,.control select:focus{border-color:#8ab7f5;box-shadow:0 0 0 3px #1769e012}.search-meta{display:flex;justify-content:space-between;gap:10px;margin-top:12px;font-size:10px;color:var(--muted)}.company-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:12px}.company-card{background:#fff;border:1px solid var(--line);border-radius:13px;padding:14px;text-decoration:none;min-height:125px;transition:.15s ease}.company-card:hover{border-color:#b9c8dc;transform:translateY(-1px);box-shadow:0 8px 24px #1018280d}.company-top{display:flex;justify-content:space-between;gap:8px;align-items:flex-start}.code{font-size:10px;font-weight:900;color:var(--blue);background:var(--soft);padding:4px 7px;border-radius:6px}.market{font-size:9px;color:var(--muted)}.company-card h3{font-size:15px;margin:12px 0 6px;line-height:1.35}.company-sub{font-size:10px;color:var(--muted)}.company-metrics{display:flex;gap:12px;margin-top:11px;font-size:10px}.company-metrics b{display:block;font-size:12px;color:var(--ink);margin-top:2px}.more-btn{display:none;margin:14px auto 0;border:1px solid #d8dee8;border-radius:10px;background:#fff;padding:10px 18px;font:inherit;font-weight:800;font-size:11px;cursor:pointer}.industry-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}.industry-btn{display:block;border:1px solid var(--line);background:#fff;border-radius:11px;padding:12px;text-align:left;cursor:pointer;font:inherit;text-decoration:none;color:inherit}.industry-btn b{display:block;font-size:12px}.industry-btn span{font-size:10px;color:var(--muted);margin-top:4px;display:block}
.finance-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:10px}.ranking-card,.scatter-card{padding:16px;min-height:380px}.rank-controls,.axis-controls{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0}.rank-controls select,.axis-controls select{height:37px;border:1px solid #d8dee8;border-radius:9px;background:#fff;padding:0 9px;font:inherit;font-size:11px}.rank-list{display:grid;gap:7px}.rank-row{display:grid;grid-template-columns:28px 1fr 100px;gap:8px;align-items:center;text-decoration:none;padding:7px 0;border-bottom:1px solid #f0f2f5}.rank-num{width:24px;height:24px;border-radius:7px;background:#eef4ff;color:#1769e0;display:grid;place-items:center;font-size:9px;font-weight:900}.rank-name{font-size:11px;font-weight:800}.rank-name small{display:block;font-size:9px;color:var(--muted);font-weight:500;margin-top:2px}.rank-value{text-align:right;font-size:11px;font-weight:900}.empty{height:250px;display:grid;place-items:center;text-align:center;color:var(--muted);font-size:11px;line-height:1.8;background:#fafbfd;border-radius:11px;padding:24px}.empty[hidden]{display:none!important}.scatter-note{font-size:9px;color:var(--muted);line-height:1.6;margin-top:7px}.scatter{height:300px}.source-note{font-size:10px;line-height:1.8;color:var(--muted);padding:14px 2px}.badge-red{color:var(--red)}.badge-black{color:var(--black)}footer{padding:26px 0 45px;border-top:1px solid var(--line);font-size:10px;color:var(--muted)}@media(max-width:980px){.company-grid{grid-template-columns:1fr 1fr}.industry-grid{grid-template-columns:repeat(3,1fr)}.finance-grid{grid-template-columns:1fr}}@media(max-width:720px){.wrap{width:min(100% - 24px,1240px)}.nav{display:block}.navlinks{margin:14px 0 0;overflow-x:auto;flex-wrap:nowrap;justify-content:flex-start;scrollbar-width:none}.navlinks a{white-space:nowrap}.hero{padding-top:42px}.stats{grid-template-columns:1fr 1fr}.controls{grid-template-columns:1fr}.company-grid{grid-template-columns:1fr}.industry-grid{grid-template-columns:1fr 1fr}.section-head{align-items:flex-start;flex-direction:column;gap:4px}.ranking-card,.scatter-card{padding:14px}}
</style></head><body>
<header><div class="wrap"><nav class="nav"><a class="brand" href="/"><img src="/favicon.svg" alt="" width="24" height="24" style="filter:brightness(0) invert(1)"><span style="font-size:19px;font-weight:750;letter-spacing:.16em">DATLUME</span></a><div class="navlinks"><a href="/">ホーム</a><a href="/listed-companies/">上場企業</a><a href="/listed-companies/compare/">企業比較</a><a href="/business-industry/">企業・産業</a><a href="/employment-economy/">雇用・賃金</a><a href="/economy-prices/">経済・物価</a><a href="/about-data/">データについて</a></div></nav><div class="hero"><div class="eyebrow">LISTED COMPANIES / JAPAN</div><h1>日本企業を、数字で見る。</h1><p>決算書を読み込まなくても、会社の大きさ、稼ぐ力、成長、資産・負債、キャッシュフロー、働く人のデータを一目でつかむ。JPX・EDINETなどの公開データを、日本人に馴染みのある「億円・兆円」で見やすく整理します。</p><div class="hero-meta"><span>{fmt(summary.companies)}社</span><span>JPX × EDINET</span><span>基準日 {master.sourceDate || '—'}</span><span>推測値で補完しない</span></div></div></div></header>
<main class="wrap"><section class="stats">{markets.map(m=><div class="card stat"><div class="stat-label">{m.name}</div><div class="stat-value">{fmt(m.count)}社</div><div class="stat-sub">企業マスタ収録</div></div>)}</section>
<section class="section card search-card"><div class="section-head"><div><h2>企業を探す</h2></div><p>企業名・証券コード、市場、業種で絞り込み</p></div><div class="controls"><div class="control"><label for="company-q">企業名 / 証券コード</label><input id="company-q" type="search" inputmode="search" placeholder="例：トヨタ / 7203"></div><div class="control"><label for="market-filter">市場</label><select id="market-filter"><option value="">すべて</option>{markets.map(m=><option value={m.name}>{m.name}</option>)}</select></div><div class="control"><label for="industry-filter">業種</label><select id="industry-filter"><option value="">すべて</option>{industries.map(([name])=><option value={name}>{name}</option>)}</select></div></div><div class="search-meta"><span id="result-count">企業データを読み込み中…</span><span>最大24件ずつ表示</span></div><div id="company-grid" class="company-grid"></div><button id="more-btn" class="more-btn" type="button">さらに表示</button></section>
<section class="section"><div class="section-head"><h2>業種から見る</h2><p>東証33業種分類</p></div><div class="industry-grid">{industries.map(([name,count])=><a class="industry-btn" href={`/listed-companies/industries/${encodeURIComponent(name)}/`}><b>{name}</b><span>{fmt(count)}社 →</span></a>)}</div></section>
<section id="finance" class="section"><div class="section-head"><div><h2>数字で比較する</h2></div><p>財務データがある企業のみ。金融業は一般企業と同じ利益率ランキングに混ぜません。</p></div><div class="finance-grid"><div class="card ranking-card"><h3 style="font-size:15px;margin:0">企業ランキング</h3><div class="rank-controls"><select id="ranking-metric"><option value="revenue">売上高</option><option value="operatingIncome">営業利益</option><option value="operatingMargin">営業利益率</option><option value="netIncome">純利益</option><option value="roe">ROE</option><option value="equityRatio">自己資本比率</option><option value="revenueGrowth">売上成長率</option><option value="averageSalary">平均年間給与</option></select></div><div id="rank-list" class="rank-list"><div class="empty">EDINET財務データを読み込み中…</div></div></div><div class="card scatter-card"><h3 style="font-size:15px;margin:0">競合ポジショニング</h3><div class="axis-controls"><select id="scatter-x"><option value="revenueGrowth">X：売上成長率</option><option value="operatingMargin">X：営業利益率</option><option value="roe">X：ROE</option><option value="averageSalary">X：平均年間給与</option></select><select id="scatter-y"><option value="operatingMargin">Y：営業利益率</option><option value="revenueGrowth">Y：売上成長率</option><option value="roe">Y：ROE</option><option value="averageSalary">Y：平均年間給与</option></select></div><div id="scatter" class="scatter"></div><div id="scatter-empty" class="empty" hidden>比較できる財務データがまだありません。</div><div id="scatter-note" class="scatter-note"></div></div></div></section>
<div class="source-note">出典：日本取引所グループ「東証上場銘柄一覧」、金融庁 EDINET。企業マスタと財務データでは更新タイミングが異なる場合があります。表示値は公開資料に存在する値のみを使用し、欠損値を推測で補いません。</div></main>
<footer><div class="wrap">DATLUME · <a href="/about-data/">データについて</a> · <a href="/privacy/">プライバシーポリシー</a> · <a href="https://github.com/kkoch5t2/data-platform" target="_blank" rel="noreferrer">GitHub ↗</a></div></footer>
<script src="https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.min.js" defer></script>
<script>
const yen=v=>{if(v==null)return'—';const a=Math.abs(v),s=v<0?'-':'';if(a>=1e12)return s+(a/1e12).toLocaleString('ja-JP',{maximumFractionDigits:2})+'兆円';if(a>=1e8)return s+(a/1e8).toLocaleString('ja-JP',{maximumFractionDigits:1})+'億円';if(a>=1e4)return s+(a/1e4).toLocaleString('ja-JP',{maximumFractionDigits:0})+'万円';return v.toLocaleString('ja-JP')+'円'};const pct=v=>v==null?'—':v.toLocaleString('ja-JP',{maximumFractionDigits:1})+'%';const financialIndustry=c=>['銀行業','保険業','証券、商品先物取引業','その他金融業'].includes(c.industry33);const revenueLike=c=>c.industry33==='銀行業'?c.ordinaryRevenue:c.industry33==='保険業'?(c.insuranceRevenue??c.ordinaryRevenue):c.revenue;const revenueLikeLabel=c=>c.industry33==='銀行業'?'経常収益':c.industry33==='保険業'?'保険収益':'売上高';let companies=[],filtered=[],shown=24,rankings={};const q=document.getElementById('company-q'),market=document.getElementById('market-filter'),industry=document.getElementById('industry-filter'),grid=document.getElementById('company-grid'),count=document.getElementById('result-count'),more=document.getElementById('more-btn');function renderCompanies(reset=true){if(reset)shown=24;const text=q.value.trim().toLocaleLowerCase('ja-JP');filtered=companies.filter(c=>(!text||(c.name+c.securityCode).toLocaleLowerCase('ja-JP').includes(text))&&(!market.value||c.market===market.value)&&(!industry.value||c.industry33===industry.value));count.textContent=filtered.length.toLocaleString('ja-JP')+'社';grid.innerHTML=filtered.slice(0,shown).map(c=>`<a class="company-card" href="/listed-companies/${encodeURIComponent(c.securityCode)}/"><div class="company-top"><span class="code">${c.securityCode}</span><span class="market">${c.market}</span></div><h3>${c.name}</h3><div class="company-sub">${c.industry33||'業種未設定'}</div>${c.hasFinancials?`<div class="company-metrics"><span>${revenueLikeLabel(c)}<b>${yen(revenueLike(c))}</b></span><span>${financialIndustry(c)?'ROE':'営業利益率'}<b class="${((financialIndustry(c)?c.roe:c.operatingMargin)??0)<0?'badge-red':'badge-black'}">${pct(financialIndustry(c)?c.roe:c.operatingMargin)}</b></span></div>`:''}</a>`).join('');more.style.display=shown<filtered.length?'block':'none'}for(const el of[q,market,industry])el.addEventListener(el===q?'input':'change',()=>renderCompanies(true));more.addEventListener('click',()=>{shown+=24;renderCompanies(false)});
const rankMetric=document.getElementById('ranking-metric'),rankList=document.getElementById('rank-list');function rankValue(metric,v){return ['operatingMargin','roe','equityRatio','revenueGrowth'].includes(metric)?pct(v):yen(v)}function renderRank(){const metric=rankMetric.value,rows=(rankings[metric]||[]).slice(0,10);if(!rows.length){rankList.innerHTML='<div class="empty">財務データ未取得です。企業マスタは利用できますが、ランキングはEDINET財務収集後に表示します。</div>';return}rankList.innerHTML=rows.map((r,i)=>`<a class="rank-row" href="/listed-companies/${r.securityCode}/"><span class="rank-num">${i+1}</span><span class="rank-name">${r.name}<small>${r.securityCode} · ${r.industry33||''}</small></span><span class="rank-value ${r.value<0?'badge-red':'badge-black'}">${rankValue(metric,r.value)}</span></a>`).join('')}rankMetric.addEventListener('change',renderRank);
let scatterChart=null;const xSel=document.getElementById('scatter-x'),ySel=document.getElementById('scatter-y');const axisLabel={revenueGrowth:'売上成長率 (%)',operatingMargin:'営業利益率 (%)',roe:'ROE (%)',averageSalary:'平均年間給与 (円)'};const quantile=(values,q)=>{const s=[...values].sort((a,b)=>a-b);return s[Math.max(0,Math.min(s.length-1,Math.round((s.length-1)*q)))]};function centralScatterRows(rows){if(rows.length<50)return rows;const xl=quantile(rows.map(r=>r[xSel.value]),.01),xh=quantile(rows.map(r=>r[xSel.value]),.99),yl=quantile(rows.map(r=>r[ySel.value]),.01),yh=quantile(rows.map(r=>r[ySel.value]),.99);const clipped=rows.filter(r=>r[xSel.value]>=xl&&r[xSel.value]<=xh&&r[ySel.value]>=yl&&r[ySel.value]<=yh);return clipped.length>=20?clipped:rows}function renderScatter(){const allRows=companies.filter(c=>Number.isFinite(c[xSel.value])&&Number.isFinite(c[ySel.value]));const rows=centralScatterRows(allRows);const empty=document.getElementById('scatter-empty'),target=document.getElementById('scatter'),note=document.getElementById('scatter-note');if(!rows.length||!window.echarts){target.style.display='none';empty.hidden=false;note.hidden=true;return}target.style.display='block';empty.hidden=true;note.hidden=rows.length===allRows.length;note.textContent=note.hidden?'':`見やすさのため上下1%の極端値を除外して ${rows.length.toLocaleString('ja-JP')} / ${allRows.length.toLocaleString('ja-JP')}社を表示しています。ランキング値は除外していません。`;if(!scatterChart)scatterChart=echarts.init(target);scatterChart.setOption({animationDuration:250,tooltip:{formatter:p=>`${p.data.name}<br>${axisLabel[xSel.value]}：${xSel.value==='averageSalary'?yen(p.value[0]):pct(p.value[0])}<br>${axisLabel[ySel.value]}：${ySel.value==='averageSalary'?yen(p.value[1]):pct(p.value[1])}`},grid:{left:54,right:18,top:18,bottom:46},xAxis:{type:'value',name:axisLabel[xSel.value],nameLocation:'middle',nameGap:30,axisLabel:{fontSize:9}},yAxis:{type:'value',name:axisLabel[ySel.value],nameLocation:'middle',nameGap:42,axisLabel:{fontSize:9}},series:[{type:'scatter',symbolSize:8,data:rows.map(c=>({name:c.name,value:[c[xSel.value],c[ySel.value]],code:c.securityCode}))}]},true)}for(const el of[xSel,ySel])el.addEventListener('change',renderScatter);Promise.all([fetch('/data/listed-companies/index.json').then(r=>r.json()),fetch('/data/listed-companies/rankings.json').then(r=>r.json())]).then(([idx,rnk])=>{companies=idx.records||[];rankings=rnk.rankings||{};const params=new URLSearchParams(location.search);if(params.get('industry'))industry.value=params.get('industry');renderCompanies(true);renderRank();setTimeout(renderScatter,50)}).catch(()=>{count.textContent='企業データを読み込めませんでした';rankList.innerHTML='<div class="empty">データ読み込みに失敗しました。</div>'});window.addEventListener('resize',()=>scatterChart?.resize());
</script></body></html>
