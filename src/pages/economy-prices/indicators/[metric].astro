---
import fs from 'node:fs';import path from 'node:path';import '../../../styles/detail.css';
const METRICS={overall:'総合',overallExRent:'家賃を除く総合',food:'食料',housing:'住居',utilities:'光熱・水道',household:'家具・家事用品',clothing:'被服及び履物',medical:'保健医療',transport:'交通・通信',education:'教育',recreation:'教養娯楽',misc:'諸雑費'};
export function getStaticPaths(){const m={overall:'総合',overallExRent:'家賃を除く総合',food:'食料',housing:'住居',utilities:'光熱・水道',household:'家具・家事用品',clothing:'被服及び履物',medical:'保健医療',transport:'交通・通信',education:'教育',recreation:'教養娯楽',misc:'諸雑費'};return Object.entries(m).map(([metric,label])=>({params:{metric},props:{label}}));}
const {label}=Astro.props,metric=Astro.params.metric;const data=JSON.parse(fs.readFileSync(path.join(process.cwd(),'public/data/economy-prices.json'),'utf8'));const rows=data.records.map(r=>({prefecture:r.prefecture,value:r[metric]})).sort((a,b)=>b.value-a.value);const fmt=v=>new Intl.NumberFormat('ja-JP',{maximumFractionDigits:1}).format(v);const description=label+'の消費者物価地域差指数を47都道府県で比較。全国平均=100。';const canonical='https://datlume.com/economy-prices/indicators/'+metric+'/';
---
<html lang="ja"><head><link rel="icon" type="image/svg+xml" href="/favicon.svg"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="description" content={description}><link rel="canonical" href={canonical}><meta property="og:title" content={label+' 物価ランキング | DATLUME'}><meta property="og:description" content={description}><meta property="og:type" content="website"><meta name="twitter:card" content="summary"><title>{label} 物価ランキング | DATLUME</title></head><body>
<header><div class="wrap"><div class="nav"><a class="brand" href="/" aria-label="DATLUME" style="display:inline-flex;align-items:center;gap:10px;text-decoration:none;color:#fff"><img src="/favicon.svg" alt="" width="24" height="24" style="display:block;width:24px;height:24px;filter:brightness(0) invert(1)"><span style="font-size:19px;font-weight:750;letter-spacing:.16em;line-height:1">DATLUME</span></a><a class="back" href="/economy-prices/">経済・物価へ戻る</a></div><div class="hero"><div class="eyebrow">Economy / Prices Ranking</div><h1>{label}</h1><p>{data.year}年 / 全国平均=100。高い都道府県から順に掲載。</p></div></div></header>
<main class="wrap"><section class="card table-card section"><div class="table-head"><h2>47都道府県ランキング</h2><div class="note">全国平均=100</div></div><table><thead><tr><th>順位</th><th>都道府県</th><th>指数</th><th>全国平均との差</th></tr></thead><tbody>{rows.map((r,i)=><tr><td>{i+1}</td><td><a href={'/economy-prices/prefectures/'+encodeURIComponent(r.prefecture)+'/'}>{r.prefecture}</a></td><td>{fmt(r.value)}</td><td>{r.value>=100?'+':''}{fmt(r.value-100)}%</td></tr>)}</tbody></table></section><div class="links"><a class="linkchip" href="/economy-prices/">経済・物価トップ</a><a class="linkchip" href="/economy-prices/indicators/overall/">総合</a><a class="linkchip" href="/economy-prices/indicators/food/">食料</a><a class="linkchip" href="/economy-prices/indicators/housing/">住居</a><a class="linkchip" href="/economy-prices/indicators/utilities/">光熱・水道</a></div><div class="data-note">出典：総務省統計局「小売物価統計調査（構造編）」{data.year}年結果。地域差指数は地域間比較の指標で、物価上昇率ではありません。</div></main>
<footer class="wrap">出典：総務省統計局 小売物価統計調査（構造編） · <a href="/privacy/">プライバシーポリシー</a></footer></body></html>
