---
import fs from 'node:fs'; import path from 'node:path';
const data=JSON.parse(fs.readFileSync(path.join(process.cwd(),'public/data/economy-prices.json'),'utf8'));
const wage=JSON.parse(fs.readFileSync(path.join(process.cwd(),'public/data/employment-economy-2026.json'),'utf8'));
const records=data.records, labels=data.labels, year=data.year;
const wageMap=Object.fromEntries(wage.records.map(r=>[r.prefecture,r.estimatedAnnualCashThousandYen*.1]));
const defs={overall:{label:'総合'},food:{label:'食料'},housing:{label:'住居'},utilities:{label:'光熱・水道'},household:{label:'家具・家事用品'},clothing:{label:'被服及び履物'},medical:{label:'保健医療'},transport:{label:'交通・通信'},education:{label:'教育'},recreation:{label:'教養娯楽'},misc:{label:'諸雑費'},overallExRent:{label:'家賃を除く総合'}};
const fmt=n=>new Intl.NumberFormat('ja-JP',{maximumFractionDigits:1}).format(n??0);
const jsonLd={"@context":"https://schema.org","@type":"Dataset","name":"都道府県別 経済・物価データ","description":"47都道府県の消費者物価地域差指数と賃金を生活者向けに比較できるデータセット。","url":"https://datlume.com/economy-prices/","creator":{"@type":"Organization","name":"DATLUME"}};
---
<!doctype html><html lang="ja"><head><link rel="icon" type="image/svg+xml" href="/favicon.svg"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="description" content="47都道府県の物価を、食料・住居・光熱水道など費目別に比較。生活費シミュレーター、賃金を物価で調整した参考年収も掲載。"><link rel="canonical" href="https://datlume.com/economy-prices/"><meta property="og:title" content="経済・物価 | DATLUME"><meta property="og:description" content="どこが高い？何が高い？暮らしにいくら効く？47都道府県の物価を生活者目線で比較。"><meta property="og:type" content="website"><meta name="twitter:card" content="summary"><script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script><title>経済・物価｜都道府県別の生活費・物価比較 | DATLUME</title>
<style>
:root{--ink:#142033;--muted:#667085;--line:#e4e9f0;--bg:#f4f6f9;--card:#fff;--nav:#0e1b2e;--blue:#1769e0;--green:#087f5b;--orange:#c76618}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,system-ui,-apple-system,"Noto Sans JP",sans-serif}.wrap{width:min(1240px,calc(100% - 32px));margin:auto}a{color:inherit}header{background:var(--nav);color:#fff;padding:20px 0 58px}.nav{display:flex;justify-content:space-between;align-items:center;gap:18px}.brand{text-decoration:none}.navlinks{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end;margin-left:auto}.navlinks a{font-size:12px;color:#d9e4f4;border:1px solid #ffffff2a;border-radius:999px;padding:7px 11px;text-decoration:none}.hero{margin-top:46px}.eyebrow{font-size:11px;letter-spacing:.16em;color:#91b9f1;font-weight:800}.hero h1{font-size:clamp(40px,5.6vw,70px);letter-spacing:-.05em;margin:8px 0 14px}.hero p{color:#c7d3e4;line-height:1.8;max-width:850px}.hero-meta{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}.hero-meta span{font-size:11px;border:1px solid #ffffff24;border-radius:999px;padding:7px 10px;color:#dce7f5}main.wrap{margin-top:18px;padding-bottom:72px}.card{background:#fff;border:1px solid var(--line);border-radius:16px}.controls{padding:16px;display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px}.control label{display:block;color:var(--muted);font-size:11px;font-weight:800;margin-bottom:6px}.control select,.control input{width:100%;height:42px;border:1px solid #d9dee7;border-radius:9px;background:#fff;padding:0 10px;font:inherit}.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:12px}.kpi{padding:17px;min-width:0}.kpi-label{font-size:11px;color:var(--muted)}.kpi-value{font-size:clamp(21px,2.4vw,29px);font-weight:900;letter-spacing:-.03em;margin-top:5px}.kpi-sub{font-size:10.5px;color:var(--muted);margin-top:4px;line-height:1.45}.tabs{display:flex;gap:7px;overflow:auto;margin-top:14px;padding-bottom:3px}.tab{border:1px solid var(--line);background:#fff;border-radius:999px;padding:9px 14px;font-size:12px;font-weight:800;white-space:nowrap;cursor:pointer;color:#475467}.tab[aria-selected="true"]{background:var(--nav);border-color:var(--nav);color:#fff}.panel{margin-top:8px}.panel[hidden]{display:none}.panel-controls{padding:14px 16px;display:flex;gap:12px;align-items:end;flex-wrap:wrap}.panel-controls .control{min-width:220px;flex:1}.grid{display:grid;grid-template-columns:1.35fr 1fr;gap:12px;margin-top:12px}.chart-card{padding:18px}.chart-card h2{font-size:16px;margin:0}.chart-sub{font-size:10.5px;color:var(--muted);margin:4px 0 10px;line-height:1.5}.chart{height:420px}#budget-chart{height:620px}.sim-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.sim-card{padding:18px}.sim-value{font-size:34px;font-weight:900;letter-spacing:-.04em;margin:8px 0}.sim-delta{display:inline-flex;border-radius:999px;background:#eef5ff;color:#1769e0;padding:6px 9px;font-size:11px;font-weight:850}.insights{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:12px}.insight{padding:16px}.insight b{display:block;font-size:12px}.insight strong{display:block;font-size:22px;margin-top:5px}.insight span{display:block;color:var(--muted);font-size:10.5px;margin-top:4px;line-height:1.5}.table-card{margin-top:12px;padding:18px;overflow:hidden}.table-wrap{overflow:auto;margin-top:12px}.table-wrap.table-collapsed tbody tr:nth-child(n+16){display:none}.table-toggle{display:block;margin:12px auto 0;border:1px solid #d9dee7;background:#fff;color:var(--ink);border-radius:10px;padding:9px 14px;font:inherit;font-size:11px;font-weight:800;cursor:pointer}table{border-collapse:collapse;width:100%;min-width:880px}th,td{padding:10px;border-bottom:1px solid #edf0f4;text-align:right;font-size:11px}th{font-size:10px;color:var(--muted);background:#fafbfd;position:sticky;top:0}th:first-child,td:first-child{text-align:left}td a{font-weight:850;color:#1769e0;text-decoration:none}.note{margin-top:12px;font-size:11px;color:var(--muted);line-height:1.75}.quick-links{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:12px}.quick-links a{background:#fff;border:1px solid var(--line);border-radius:11px;padding:13px;text-decoration:none;font-size:12px;font-weight:800}footer{padding:26px 0 46px;color:var(--muted);font-size:11px}@media(max-width:900px){.grid,.sim-grid{grid-template-columns:1fr}.kpis{grid-template-columns:1fr 1fr}.insights{grid-template-columns:1fr}.quick-links{grid-template-columns:1fr 1fr}}@media(max-width:720px){#budget-chart{height:540px}.nav{display:block}.navlinks{margin:14px -4px 0;overflow:auto;flex-wrap:nowrap;justify-content:flex-start}.navlinks a{white-space:nowrap}.controls{grid-template-columns:1fr}.chart{height:360px}}@media(max-width:480px){.wrap{width:min(100% - 24px,1240px)}.kpis{grid-template-columns:1fr 1fr}.kpi-value{font-size:20px}.quick-links{grid-template-columns:1fr 1fr}}

