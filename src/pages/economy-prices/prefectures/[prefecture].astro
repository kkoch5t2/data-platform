---
import fs from 'node:fs';import path from 'node:path';import '../../../styles/detail.css';
export function getStaticPaths(){const data=JSON.parse(fs.readFileSync(path.join(process.cwd(),'public/data/economy-prices.json'),'utf8'));return data.records.map(r=>({params:{prefecture:r.prefecture},props:{prefecture:r.prefecture}}));}
const {prefecture}=Astro.props;const data=JSON.parse(fs.readFileSync(path.join(process.cwd(),'public/data/economy-prices.json'),'utf8'));const wage=JSON.parse(fs.readFileSync(path.join(process.cwd(),'public/data/employment-economy-2026.json'),'utf8'));const r=data.records.find(x=>x.prefecture===prefecture);const labels=data.labels;const keys=['food','housing','utilities','household','clothing','medical','transport','education','recreation','misc'];const annual=(wage.records.find(x=>x.prefecture===prefecture)?.estimatedAnnualCashThousandYen||0)*.1;const adjusted=annual*100/r.overall;const overallRank=[...data.records].sort((a,b)=>b.overall-a.overall).findIndex(x=>x.prefecture===prefecture)+1;const high=keys.map(k=>[k,r[k]]).sort((a,b)=>b[1]-a[1])[0],low=keys.map(k=>[k,r[k]]).sort((a,b)=>a[1]-b[1])[0];const fmt=v=>new Intl.NumberFormat('ja-JP',{maximumFractionDigits:1}).format(v);const description=prefecture+'の物価水準を食料・住居・光熱水道など10大費目で比較。全国平均=100、生活費換算と物価調整後年収も掲載。';const canonical='https://datlume.com/economy-prices/prefectures/'+encodeURIComponent(prefecture)+'/';
---
<html lang="ja"><head><link rel="icon" type="image/svg+xml" href="/favicon.svg"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="description" content={description}><link rel="canonical" href={canonical}><meta property="og:title" content={prefecture+'の物価・生活費 | DATLUME'}><meta property="og:description" content={description}><meta property="og:type" content="website"><meta name="twitter:card" content="summary"><title>{prefecture}の物価・生活費 | DATLUME</title></head><body>
<header><div class="wrap"><div class="nav"><a class="brand" href="/">DATLUME</a><a class="back" href="/economy-prices/">経済・物価へ戻る</a></div><div class="hero"><div class="eyebrow">Economy / Prices</div><h1>{prefecture}の物価</h1><p>{data.year}年 / 全国平均=100。生活者が気になる主要費目をまとめて比較。</p></div></div></header>
<main class="wrap"><section class="stats"><div class="card"><div class="label">総合物価指数</div><div class="value">{fmt(r.overall)}</div><div class="note">全国平均比 {r.overall>=100?'+':''}{fmt(r.overall-100)}%</div></div><div class="card"><div class="label">全国順位（高い順）</div><div class="value">{overallRank}位</div><div class="note">47都道府県</div></div><div class="card"><div class="label">物価調整後 推計年収</div><div class="value">{fmt(adjusted)}万円</div><div class="note">名目 {fmt(annual)}万円 / 参考値</div></div></section>
<section class="card section"><h2>何が高い？何が安い？</h2><div class="barrow"><div>{labels[high[0]]}</div><div class="track"><div class="bar" style={'width:'+Math.min(100,high[1]/1.35)+'%'}></div></div><div class="amount">{fmt(high[1])}</div></div><div class="barrow"><div>{labels[low[0]]}</div><div class="track"><div class="bar" style={'width:'+Math.min(100,low[1]/1.35)+'%'}></div></div><div class="amount">{fmt(low[1])}</div></div><div class="data-note"><strong>最も高い費目：</strong>{labels[high[0]]}（{fmt(high[1])}） ／ <strong>最も低い費目：</strong>{labels[low[0]]}（{fmt(low[1])}）</div></section>
<section class="card table-card section"><div class="table-head"><h2>10大費目</h2><div class="note">全国平均=100</div></div><table><thead><tr><th>費目</th><th>指数</th><th>全国平均との差</th><th>全国順位</th></tr></thead><tbody>{keys.map(k=>{const rank=[...data.records].sort((a,b)=>b[k]-a[k]).findIndex(x=>x.prefecture===prefecture)+1;return <tr><td><a href={'/economy-prices/indicators/'+k+'/'}>{labels[k]}</a></td><td>{fmt(r[k])}</td><td>{r[k]>=100?'+':''}{fmt(r[k]-100)}%</td><td>{rank}位</td></tr>})}</tbody></table></section>
<section class="card section"><h2>生活費のざっくり換算</h2><div class="barrow"><div>全国平均 15万円</div><div class="track"><div class="bar" style="width:60%"></div></div><div class="amount">{fmt(150000*r.overall/100)}円</div></div><div class="barrow"><div>全国平均 20万円</div><div class="track"><div class="bar" style="width:80%"></div></div><div class="amount">{fmt(200000*r.overall/100)}円</div></div><div class="barrow"><div>全国平均 25万円</div><div class="track"><div class="bar" style="width:100%"></div></div><div class="amount">{fmt(250000*r.overall/100)}円</div></div><div class="data-note">同じ財・サービスの組み合わせを買うと仮定した単純換算です。世帯構成や家賃条件によって実際の生活費は異なります。</div></section>
<div class="links"><a class="linkchip" href="/economy-prices/">経済・物価トップ</a><a class="linkchip" href="/economy-prices/indicators/overall/">総合物価ランキング</a><a class="linkchip" href="/employment-economy/">雇用・賃金を見る</a></div></main><footer class="wrap">出典：総務省統計局 小売物価統計調査（構造編） / 厚生労働省 賃金構造基本統計調査</footer></body></html>
