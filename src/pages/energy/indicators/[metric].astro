---
import fs from 'node:fs';import path from 'node:path';import '../../../styles/detail.css';
const METRICS={electricity:{label:'電気代',field:'annualElectricityYen',unit:'円/年'},gas:{label:'ガス代',field:'annualGasYen',unit:'円/年'},kerosene:{label:'灯油代',field:'annualKeroseneYen',unit:'円/年'},'energy-total':{label:'エネルギー支出',field:'annualEnergyYen',unit:'円/年'},'energy-burden':{label:'エネルギー家計負担率',field:'energyBurdenRate',unit:'%'},'utility-price':{label:'光熱・水道の価格水準',field:'utilityPriceIndex',unit:''}};
export function getStaticPaths(){const m={electricity:{label:'電気代',field:'annualElectricityYen',unit:'円/年'},gas:{label:'ガス代',field:'annualGasYen',unit:'円/年'},kerosene:{label:'灯油代',field:'annualKeroseneYen',unit:'円/年'},'energy-total':{label:'エネルギー支出',field:'annualEnergyYen',unit:'円/年'},'energy-burden':{label:'エネルギー家計負担率',field:'energyBurdenRate',unit:'%'},'utility-price':{label:'光熱・水道の価格水準',field:'utilityPriceIndex',unit:''}};return Object.entries(m).map(([metric,def])=>({params:{metric},props:{def}}));}
const {def}=Astro.props,slug=Astro.params.metric;const data=JSON.parse(fs.readFileSync(path.join(process.cwd(),'public/data/energy.json'),'utf8'));const rows=data.records.map(r=>({prefecture:r.prefecture,capital:r.capital,value:r[def.field]})).filter(x=>Number.isFinite(x.value)).sort((a,b)=>b.value-a.value);const fmt=v=>new Intl.NumberFormat('ja-JP',{maximumFractionDigits:1}).format(v);const desc=def.label+'を47都道府県庁所在市で比較。家計調査などの公式データをもとに可視化。';const canonical='https://datlume.com/energy/indicators/'+slug+'/';
---
<html lang="ja"><head><link rel="icon" type="image/svg+xml" href="/favicon.svg"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="description" content={desc}><link rel="canonical" href={canonical}><meta property="og:title" content={def.label+' 地域ランキング | DATLUME'}><meta property="og:description" content={desc}><title>{def.label} 地域ランキング | DATLUME</title></head><body><header><div class="wrap"><div class="nav"><a class="brand" href="/" aria-label="DATLUME" style="display:inline-flex;align-items:center;gap:10px;text-decoration:none;color:#fff"><img src="/favicon.svg" alt="" width="24" height="24" style="display:block;width:24px;height:24px;filter:brightness(0) invert(1)"><span style="font-size:19px;font-weight:750;letter-spacing:.16em;line-height:1">DATLUME</span></a><a class="back" href="/energy/">エネルギーへ戻る</a></div><div class="hero"><div class="eyebrow">Energy Ranking</div><h1>{def.label}</h1><p>{data.householdYear}年 / 二人以上世帯。家計値は都道府県庁所在市（東京都は東京都区部）。</p></div></div></header><main class="wrap"><section class="card table-card section"><div class="table-head"><h2>高い順ランキング</h2><div class="note">47地域</div></div><table><thead><tr><th>順位</th><th>都道府県</th><th>対象都市</th><th>{def.label}</th></tr></thead><tbody>{rows.map((r,i)=><tr><td>{i+1}</td><td><a href={'/energy/prefectures/'+encodeURIComponent(r.prefecture)+'/' }>{r.prefecture}</a></td><td>{r.capital}</td><td>{fmt(r.value)}{def.unit}</td></tr>)}</tbody></table></section><div class="links"><a class="linkchip" href="/energy/">エネルギートップ</a><a class="linkchip" href="/energy/indicators/electricity/">電気代</a><a class="linkchip" href="/energy/indicators/energy-total/">エネルギー支出</a><a class="linkchip" href="/energy/indicators/energy-burden/">家計負担率</a><a class="linkchip" href="/energy/indicators/utility-price/">価格水準</a></div><div class="data-note">エネルギー支出は電気代＋ガス代＋その他光熱でDATLUMEが算出し、水道料は含みません。支出額は単価そのものではなく、使用量・気候・住宅条件などにも左右されます。</div></main><footer class="wrap">出典：総務省統計局 家計調査・小売物価統計調査</footer></body></html>
