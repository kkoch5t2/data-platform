---
import fs from 'node:fs';import path from 'node:path';
const data=JSON.parse(fs.readFileSync(path.join(process.cwd(),'public/data/energy.json'),'utf8'));
const records=data.records,year=data.householdYear,national=data.nationwide,snap=data.nationalSnapshot,security=data.security;
const defs={electricity:{label:'電気代',field:'annualElectricityYen',unit:'円/年'},gas:{label:'ガス代',field:'annualGasYen',unit:'円/年'},kerosene:{label:'灯油',field:'annualKeroseneYen',unit:'円/年'},'energy-total':{label:'エネルギー支出',field:'annualEnergyYen',unit:'円/年'},'energy-burden':{label:'家計負担率',field:'energyBurdenRate',unit:'%'},'utility-price':{label:'光熱・水道 物価水準',field:'utilityPriceIndex',unit:'指数'}};
const fmt=n=>Number.isFinite(n)?new Intl.NumberFormat('ja-JP',{maximumFractionDigits:1}).format(n):'—';
---
<!doctype html><html lang="ja"><head><link rel="icon" type="image/svg+xml" href="/favicon.svg"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="description" content="電気代・ガス代・灯油などの家計負担を47都道府県庁所在市で比較。価格水準、家計負担率、推移、日本の電源構成や再エネ賦課金まで生活者目線で可視化。"><link rel="canonical" href="https://datlume.com/energy/"><meta property="og:title" content="エネルギー｜電気代・光熱費・日本の電力 | DATLUME"><meta property="og:description" content="電気代はいくら？なぜ高い？地域差と日本のエネルギー事情を生活者目線で見る。"><meta property="og:type" content="website"><meta name="twitter:card" content="summary"><title>エネルギー｜電気代・光熱費・日本の電力 | DATLUME</title>
<style>
:root{--ink:#142033;--muted:#667085;--line:#e4e9f0;--bg:#f4f6f9;--card:#fff;--nav:#0e1b2e;--blue:#1769e0;--green:#087f5b;--amber:#b66a00}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,system-ui,-apple-system,"Noto Sans JP",sans-serif}.wrap{width:min(1240px,calc(100% - 32px));margin:auto}a{color:inherit}header{background:var(--nav);color:#fff;padding:20px 0 58px}.nav{display:flex;justify-content:space-between;align-items:center;gap:18px}.navlinks{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end;margin-left:auto}.navlinks a{font-size:12px;color:#d9e4f4;border:1px solid #ffffff2a;border-radius:999px;padding:7px 11px;text-decoration:none}.hero{margin-top:46px}.eyebrow{font-size:11px;letter-spacing:.16em;color:#91b9f1;font-weight:850}.hero h1{font-size:clamp(40px,5.6vw,70px);letter-spacing:-.05em;margin:8px 0 14px}.hero p{color:#c7d3e4;line-height:1.8;max-width:900px}.hero-meta{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}.hero-meta span{font-size:11px;border:1px solid #ffffff24;border-radius:999px;padding:7px 10px;color:#dce7f5}main.wrap{margin-top:18px;padding-bottom:72px}.card{background:#fff;border:1px solid var(--line);border-radius:16px}.controls{padding:16px;display:grid;grid-template-columns:1fr 1fr;gap:12px}.control label{display:block;color:var(--muted);font-size:11px;font-weight:800;margin-bottom:6px}.control select,.control input{width:100%;height:42px;border:1px solid #d9dee7;border-radius:9px;background:#fff;padding:0 10px;font:inherit}.scope{padding:12px 16px;margin-top:10px;background:#fff7e8;border:1px solid #f0d59e;border-radius:12px;color:#71520e;font-size:11px;line-height:1.65}.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:12px}.kpi{padding:17px}.kpi-label{font-size:11px;color:var(--muted)}.kpi-value{font-size:clamp(21px,2.3vw,30px);font-weight:900;letter-spacing:-.03em;margin-top:5px}.kpi-sub{font-size:10.5px;color:var(--muted);margin-top:4px;line-height:1.5}.tabs{display:flex;gap:7px;overflow:auto;margin-top:14px;padding-bottom:3px}.tab{border:1px solid var(--line);background:#fff;border-radius:999px;padding:9px 14px;font-size:12px;font-weight:800;white-space:nowrap;cursor:pointer;color:#475467}.tab[aria-selected="true"]{background:var(--nav);border-color:var(--nav);color:#fff}.panel{margin-top:8px}.panel[hidden]{display:none}.grid{display:grid;grid-template-columns:1.25fr 1fr;gap:12px;margin-top:12px}.chart-card{padding:18px}.chart-card h2,.info-card h2{font-size:16px;margin:0}.sub{font-size:10.5px;color:var(--muted);margin:4px 0 10px;line-height:1.55}.chart{height:420px}.panel-controls{padding:14px 16px;display:flex;gap:12px;align-items:end;flex-wrap:wrap}.panel-controls .control{min-width:220px;flex:1}.insights{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:12px}.insight{padding:16px}.insight b{display:block;font-size:12px}.insight strong{display:block;font-size:22px;margin-top:5px}.insight span{display:block;color:var(--muted);font-size:10.5px;margin-top:4px;line-height:1.5}.national-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.info-card{padding:18px}.callout{margin-top:12px;padding:16px;background:#eef5ff;border:1px solid #d4e5ff;border-radius:14px;font-size:12px;line-height:1.7}.calc{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px}.calc-result{font-size:32px;font-weight:900;margin-top:7px}.table-card{margin-top:12px;padding:18px;overflow:hidden}.table-wrap{overflow:auto;margin-top:12px}table{border-collapse:collapse;width:100%;min-width:920px}th,td{padding:10px;border-bottom:1px solid #edf0f4;text-align:right;font-size:11px}th{font-size:10px;color:var(--muted);background:#fafbfd}th:first-child,td:first-child{text-align:left}td a{font-weight:850;color:#1769e0;text-decoration:none}.quick-links{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:12px}.quick-links a{background:#fff;border:1px solid var(--line);border-radius:11px;padding:13px;text-decoration:none;font-size:12px;font-weight:800}.note{margin-top:12px;color:var(--muted);font-size:11px;line-height:1.75}footer{padding:26px 0 46px;color:var(--muted);font-size:11px}@media(max-width:900px){.grid,.calc{grid-template-columns:1fr}.kpis,.national-kpis{grid-template-columns:1fr 1fr}.insights{grid-template-columns:1fr}.quick-links{grid-template-columns:1fr 1fr}}@media(max-width:720px){.nav{display:block}.navlinks{margin:14px -4px 0;overflow:auto;flex-wrap:nowrap;justify-content:flex-start}.navlinks a{white-space:nowrap}.controls{grid-template-columns:1fr}.chart{height:380px}}@media(max-width:480px){.wrap{width:min(100% - 24px,1240px)}.kpis,.national-kpis{grid-template-columns:1fr 1fr}.quick-links{grid-template-columns:1fr}}
</style></head><body>
<header><div class="wrap"><div class="nav"><a href="/" style="display:inline-flex;align-items:center;gap:10px;text-decoration:none;color:#fff"><img src="/favicon.svg" alt="" width="24" height="24" style="filter:brightness(0) invert(1)"><span style="font-size:19px;font-weight:750;letter-spacing:.16em">DATLUME</span></a><div class="navlinks"><a href="/procurement/">国・自治体の案件</a><a href="/realestate/">不動産・暮らし</a><a href="/employment-economy/">雇用・賃金</a><a href="/business-industry/">企業・産業</a><a href="/economy-prices/">経済・物価</a><a href="/energy/">エネルギー</a><a href="/about-data/">データについて</a></div></div><div class="hero"><div class="eyebrow">ENERGY / HOUSEHOLD</div><h1>エネルギー</h1><p>「電気代はいくら？」「地域でなぜ違う？」「日本の電気は何でつくられている？」を一画面で。家計の電気・ガス・灯油から、価格水準、日本の電力需給・電源構成まで生活者目線で見ます。</p><div class="hero-meta"><span>家計 {year}年</span><span>47都道府県庁所在市</span><span>全国電力統計 最新表 {snap.latestTablePeriod}</span></div></div></div></header>
<main class="wrap"><section class="card controls"><div class="control"><label for="pref">地域 A</label><select id="pref">{records.map(r=><option value={r.prefecture}>{r.prefecture}（{r.capital}）</option>)}</select></div><div class="control"><label for="compare">地域 B</label><select id="compare"><option value="">比較なし</option>{records.map(r=><option value={r.prefecture}>{r.prefecture}（{r.capital}）</option>)}</select></div></section><div class="scope"><strong>地域データの範囲：</strong>家計調査の二人以上世帯。都道府県の名称で選びますが、家計の支出額は各都道府県庁所在市（東京都は東京都区部）の値です。県全体の平均ではありません。</div>
<section class="kpis"><div class="card kpi"><div class="kpi-label">月あたりエネルギー支出</div><div id="kpi-energy" class="kpi-value">—</div><div id="kpi-energy-sub" class="kpi-sub">電気＋ガス＋その他光熱</div></div><div class="card kpi"><div class="kpi-label">電気代</div><div id="kpi-electric" class="kpi-value">—</div><div id="kpi-electric-sub" class="kpi-sub">年間値から月換算</div></div><div class="card kpi"><div class="kpi-label">家計に占める負担</div><div id="kpi-burden" class="kpi-value">—</div><div class="kpi-sub">消費支出に対するエネルギー支出</div></div><div class="card kpi"><div class="kpi-label">光熱・水道の価格水準</div><div id="kpi-price" class="kpi-value">—</div><div id="kpi-price-sub" class="kpi-sub">全国平均=100</div></div></section>
<nav class="tabs"><button class="tab" data-tab="bill" aria-selected="true">電気代・光熱費</button><button class="tab" data-tab="ranking" aria-selected="false">地域ランキング</button><button class="tab" data-tab="trend" aria-selected="false">負担の推移</button><button class="tab" data-tab="japan" aria-selected="false">日本のエネルギー</button><button class="tab" data-tab="consumption-history" aria-selected="false">長期消費</button></nav>
<section class="panel" data-panel="bill"><section class="grid"><div class="card chart-card"><h2 id="breakdown-title">家計のエネルギー内訳</h2><div class="sub">年間の電気代・ガス代・その他光熱。水道はエネルギー支出から分離して表示。</div><div id="breakdown-chart" class="chart"></div></div><div class="card chart-card"><h2>支出が高いのは「価格」だけ？</h2><div class="sub">横軸＝光熱・水道の物価水準、縦軸＝月あたりエネルギー支出。気候・使用量・住宅条件などの影響も見えます。</div><div id="scatter-chart" class="chart"></div></div></section><section class="insights"><div class="card insight"><b>全国平均との支出差</b><strong id="bill-diff">—</strong><span>月あたりエネルギー支出</span></div><div class="card insight"><b>年間の灯油代</b><strong id="kerosene">—</strong><span>寒冷地差が出やすい項目</span></div><div class="card insight"><b>水道を含む光熱・水道</b><strong id="utility-total">—</strong><span>月あたり / 家計調査</span></div></section></section>
<section class="panel" data-panel="ranking" hidden><div class="card panel-controls"><div class="control"><label for="metric">比較したいもの</label><select id="metric">{Object.entries(defs).map(([k,v])=><option value={k}>{v.label}</option>)}</select></div><div class="control"><label for="direction">並び順</label><select id="direction"><option value="high">高い順</option><option value="low">低い順</option></select></div></div><section class="grid"><div class="card chart-card"><h2 id="ranking-title">地域ランキング</h2><div class="sub">家計支出は都道府県庁所在市ベース。</div><div id="ranking-chart" class="chart"></div></div><div class="card chart-card"><h2>A / B 比較</h2><div class="sub">電気・ガス・灯油・家計負担率・価格水準を並べて比較。</div><div id="compare-chart" class="chart"></div></div></section></section>
<section class="panel" data-panel="trend" hidden><section class="grid"><div class="card chart-card"><h2>光熱・水道費の推移</h2><div class="sub">2012〜2023年。SSDSE-Bの二人以上世帯、都道府県別系列。</div><div id="trend-cost-chart" class="chart"></div></div><div class="card chart-card"><h2>家計負担率の推移</h2><div class="sub">光熱・水道費 ÷ 消費支出。金額だけでなく家計への重さを見る。</div><div id="trend-rate-chart" class="chart"></div></div></section></section>
<section class="panel" data-panel="japan" hidden><section class="national-kpis"><div class="card kpi"><div class="kpi-label">発電電力量</div><div class="kpi-value">{fmt(snap.generation100mKwh)}億kWh</div><div class="kpi-sub">{snap.period} 結果概要</div></div><div class="card kpi"><div class="kpi-label">需要電力量</div><div class="kpi-value">{fmt(snap.demand100mKwh)}億kWh</div><div class="kpi-sub">前年同月比 {snap.demandYoY>=0?'+':''}{fmt(snap.demandYoY)}%</div></div><div class="card kpi"><div class="kpi-label">エネルギー自給率</div><div class="kpi-value">{fmt(security.energySelfSufficiency2024)}%</div><div class="kpi-sub">2024年度</div></div><div class="card kpi"><div class="kpi-label">再エネ賦課金</div><div class="kpi-value">{security.renewableSurchargeYenPerKwh.toFixed(2)}円/kWh</div><div class="kpi-sub">{security.renewableSurchargeFiscalYear}年度単価</div></div></section><section class="grid"><div class="card chart-card"><h2>日本の発電構成</h2><div class="sub">{snap.period}の電力調査統計「結果概要」。項目に重複があるため棒グラフで表示。</div><div id="mix-chart" class="chart"></div></div><div class="card chart-card"><h2>発電が多い地域 / 需要が多い地域</h2><div class="sub">「作る場所」と「使う場所」は同じではありません。</div><div id="supply-demand-chart" class="chart"></div></div></section><section class="calc"><div class="card info-card"><h2>再エネ賦課金の目安</h2><div class="sub">月の使用電力量を入れると、{security.renewableSurchargeFiscalYear}年度単価 {security.renewableSurchargeYenPerKwh.toFixed(2)}円/kWh で単純計算します。</div><div class="control"><label for="kwh">月間使用量（kWh）</label><input id="kwh" type="number" min="0" max="5000" step="10" value={security.renewableSurchargeExampleKwh}></div><div id="surcharge-result" class="calc-result">—</div><div class="kpi-sub">月あたりの再エネ賦課金</div></div><div class="card info-card"><h2>今の日本を3行で</h2><div class="callout"><strong>① 家計：</strong>地域差は単価だけでなく、気候や使用量でも大きく変わります。<br><strong>② 発電：</strong>{snap.period}は火力が報告値で{fmt(snap.mixReported.find(x=>x.key==='thermal')?.share)}%。<br><strong>③ 安定供給：</strong>自給率は{fmt(security.energySelfSufficiency2024)}%で、海外資源への依存が大きい状態です。</div><div class="note">{snap.note}</div></div></section></section>
<section class="panel" data-panel="consumption-history" hidden><div class="card panel-controls"><div class="control"><label for="consumption-history-metric">比較したい消費</label><select id="consumption-history-metric"><option value="finalEnergyPerCapita">最終エネルギー消費</option><option value="residentialPerCapita">家庭</option><option value="transportPerCapita">運輸</option><option value="commercialPerCapita">業務他</option></select></div></div><section class="card chart-card" style="margin-top:12px"><h2>1人あたりエネルギー消費の長期推移</h2><div class="sub">1990〜2023年度 / 資源エネルギー庁 都道府県別エネルギー消費統計。必要なときだけ履歴JSONを取得します。</div><div id="consumption-history-chart" class="chart"></div><p class="note">単位はGJ/人。1990年度、2005年度、2007年度以降の公表年を結んでいます。家計支出とは別の「実物エネルギー消費」の系列です。</p></section></section>
<section class="card table-card"><h2 style="margin:0;font-size:16px">地域別 家計エネルギー一覧</h2><div class="sub">{year}年 / 二人以上世帯 / 都道府県庁所在市</div><div class="table-wrap"><table><thead><tr><th>地域</th><th>対象都市</th><th>電気代/年</th><th>ガス代/年</th><th>灯油/年</th><th>エネルギー/月</th><th>家計負担率</th><th>価格水準</th></tr></thead><tbody>{records.map(r=><tr><td><a href={'/energy/prefectures/'+encodeURIComponent(r.prefecture)+'/' }>{r.prefecture}</a></td><td>{r.capital}</td><td>{Number.isFinite(r.annualElectricityYen)?fmt(r.annualElectricityYen)+'円':'—'}</td><td>{Number.isFinite(r.annualGasYen)?fmt(r.annualGasYen)+'円':'—'}</td><td>{Number.isFinite(r.annualKeroseneYen)?fmt(r.annualKeroseneYen)+'円':'—'}</td><td>{Number.isFinite(r.monthlyEnergyYen)?fmt(r.monthlyEnergyYen)+'円':'—'}</td><td>{Number.isFinite(r.energyBurdenRate)?fmt(r.energyBurdenRate)+'%':'—'}</td><td>{fmt(r.utilityPriceIndex)}</td></tr>)}</tbody></table></div></section>
<div class="quick-links">{Object.entries(defs).map(([k,v])=><a href={'/energy/indicators/'+k+'/'}>{v.label}ランキング →</a>)}</div>
<div class="note">家計支出：総務省統計局「家計調査」{year}年。地域値は都道府県庁所在市（東京都は東京都区部）の二人以上世帯で、県全体平均ではありません。エネルギー支出はDATLUMEで「電気代＋ガス代＋その他光熱」と定義し、水道料は除外しています。価格水準は小売物価統計調査（構造編）の「光熱・水道」地域差指数（全国平均=100）。実際の請求額は契約プラン、使用量、住宅性能、世帯人数、気候などで異なります。元統計で品目別内訳が欠損する地域は「—」で表示し、該当ランキングから除外します。</div>
</main><footer><div class="wrap">出典：総務省統計局 家計調査・小売物価統計調査 / 統計センター SSDSE / 資源エネルギー庁 電力調査統計 · <a href="https://github.com/kkoch5t2/data-platform" target="_blank" rel="noreferrer">GitHub ↗</a> · <a href="https://utility-tools-jp.com/" target="_blank" rel="noreferrer">無料WEB便利ツール集 ↗</a></div></footer>
<script id="energy-data" type="application/json" set:html={JSON.stringify({records,national,snap,security,defs})}></script>
<script>
import * as echarts from 'echarts';
const d=JSON.parse(document.getElementById('energy-data').textContent),records=d.records,national=d.national,snap=d.snap,security=d.security,defs=d.defs,byName=new Map(records.map(r=>[r.prefecture,r]));const nf=new Intl.NumberFormat('ja-JP',{maximumFractionDigits:1});const yf=new Intl.NumberFormat('ja-JP',{maximumFractionDigits:0});const pref=document.getElementById('pref'),compare=document.getElementById('compare'),metric=document.getElementById('metric'),direction=document.getElementById('direction'),kwh=document.getElementById('kwh'),consumptionHistoryMetric=document.getElementById('consumption-history-metric');const charts={};const ch=id=>charts[id]||(charts[id]=echarts.init(document.getElementById(id)));const money=v=>Number.isFinite(v)?yf.format(v)+'円':'—';
function renderKpis(){const a=byName.get(pref.value);document.getElementById('kpi-energy').textContent=money(a.monthlyEnergyYen);document.getElementById('kpi-energy-sub').textContent=a.capital+' / 全国 '+money(national.monthlyEnergyYen);document.getElementById('kpi-electric').textContent=money(Number.isFinite(a.annualElectricityYen)?Math.round(a.annualElectricityYen/12):null);document.getElementById('kpi-electric-sub').textContent='年 '+money(a.annualElectricityYen);document.getElementById('kpi-burden').textContent=Number.isFinite(a.energyBurdenRate)?nf.format(a.energyBurdenRate)+'%':'—';document.getElementById('kpi-price').textContent=nf.format(a.utilityPriceIndex);document.getElementById('kpi-price-sub').textContent='全国平均比 '+(a.utilityPriceIndex>=100?'+':'')+nf.format(a.utilityPriceIndex-100)+'%'}
function renderBill(){const a=byName.get(pref.value),b=compare.value?byName.get(compare.value):null;document.getElementById('breakdown-title').textContent=b?a.prefecture+' × '+b.prefecture+' 家計エネルギー':a.prefecture+'（'+a.capital+'）の家計エネルギー';const cats=['電気代','ガス代','その他光熱','水道料'],keys=['annualElectricityYen','annualGasYen','annualOtherHeatYen','annualWaterYen'];const series=[{name:'A · '+a.prefecture,type:'bar',data:keys.map(k=>a[k]),itemStyle:{color:'#1769e0'}}];if(b)series.push({name:'B · '+b.prefecture,type:'bar',data:keys.map(k=>b[k]),itemStyle:{color:'#087f5b'}});ch('breakdown-chart').setOption({tooltip:{trigger:'axis',valueFormatter:v=>money(v)},legend:{top:0},grid:{left:78,right:25,top:42,bottom:55},xAxis:{type:'category',data:cats,axisLabel:{rotate:18}},yAxis:{type:'value',axisLabel:{formatter:v=>Math.round(v/10000)+'万'}},series},true);const scat=records.filter(r=>Number.isFinite(r.utilityPriceIndex)&&Number.isFinite(r.monthlyEnergyYen)).map(r=>({name:r.prefecture,value:[r.utilityPriceIndex,r.monthlyEnergyYen,r.energyBurdenRate],capital:r.capital}));ch('scatter-chart').setOption({tooltip:{formatter:p=>p.data.name+'（'+p.data.capital+'）<br>価格水準 '+nf.format(p.value[0])+'<br>エネルギー '+money(p.value[1])+'/月<br>負担率 '+nf.format(p.value[2])+'%'},grid:{left:55,right:20,top:25,bottom:48},xAxis:{type:'value',name:'価格水準',nameLocation:'middle',nameGap:30,splitLine:{lineStyle:{color:'#eef2f6'}}},yAxis:{type:'value',name:'円/月',axisLabel:{formatter:v=>Math.round(v/1000)+'千'}},series:[{type:'scatter',symbolSize:10,data:scat}]},true);const diff=Number.isFinite(a.monthlyEnergyYen)?a.monthlyEnergyYen-national.monthlyEnergyYen:null;document.getElementById('bill-diff').textContent=Number.isFinite(diff)?(diff>=0?'+':'')+money(diff):'—';document.getElementById('kerosene').textContent=money(a.annualKeroseneYen);document.getElementById('utility-total').textContent=money(a.monthlyUtilityWaterYen)}
function renderRanking(){const def=defs[metric.value],rows=records.map(r=>({name:r.prefecture,value:r[def.field],capital:r.capital})).filter(x=>Number.isFinite(x.value)).sort((a,b)=>direction.value==='high'?b.value-a.value:a.value-b.value);document.getElementById('ranking-title').textContent=def.label+' '+(direction.value==='high'?'高い':'低い')+'地域';ch('ranking-chart').setOption({tooltip:{formatter:p=>p.name+'（'+p.data.capital+'）<br><b>'+nf.format(p.value)+(def.unit.startsWith('円')?'円':def.unit)+'</b>'},grid:{left:82,right:82,top:10,bottom:22},xAxis:{type:'value',axisLabel:{formatter:v=>def.field.includes('Yen')?Math.round(v/10000)+'万':nf.format(v)}},yAxis:{type:'category',inverse:true,data:rows.map(x=>x.name),axisLabel:{fontSize:9}},series:[{type:'bar',barWidth:8,data:rows.map(x=>({value:x.value,capital:x.capital})),label:{show:true,position:'right',fontSize:8,formatter:p=>def.field.includes('Yen')?Math.round(p.value/1000)/10+'万':nf.format(p.value)},itemStyle:{borderRadius:[0,5,5,0]}}]},true);const a=byName.get(pref.value),b=compare.value?byName.get(compare.value):null,labels=['電気代','ガス代','灯油','負担率','価格水準'];const norm=r=>[Number.isFinite(r.annualElectricityYen)?r.annualElectricityYen/national.annualElectricityYen*100:null,Number.isFinite(r.annualGasYen)?r.annualGasYen/national.annualGasYen*100:null,Number.isFinite(r.annualKeroseneYen)?r.annualKeroseneYen/national.annualKeroseneYen*100:null,Number.isFinite(r.energyBurdenRate)?r.energyBurdenRate/national.energyBurdenRate*100:null,r.utilityPriceIndex];const ss=[{name:'A · '+a.prefecture,type:'bar',data:norm(a),itemStyle:{color:'#1769e0'}}];if(b)ss.push({name:'B · '+b.prefecture,type:'bar',data:norm(b),itemStyle:{color:'#087f5b'}});ch('compare-chart').setOption({tooltip:{trigger:'axis',valueFormatter:v=>Number.isFinite(v)?nf.format(v):'—'},legend:{top:0},grid:{left:58,right:20,top:42,bottom:40},xAxis:{type:'category',data:labels,axisLabel:{fontSize:9}},yAxis:{type:'value',name:'全国=100',axisLabel:{fontSize:9}},series:ss.map(x=>({...x,markLine:{silent:true,symbol:'none',lineStyle:{type:'dashed',color:'#98a2b3'},data:[{yAxis:100}]}}))},true)}
function renderTrend(){const a=byName.get(pref.value),b=compare.value?byName.get(compare.value):null;const years=[...new Set(a.trend.map(x=>x.year))].sort();function line(r,key){const map=new Map(r.trend.map(x=>[x.year,x[key]]));return years.map(y=>map.get(y)??null)}const ss=[{name:'A · '+a.prefecture,type:'line',smooth:true,data:line(a,'monthlyUtilityWaterYen')}];if(b)ss.push({name:'B · '+b.prefecture,type:'line',smooth:true,data:line(b,'monthlyUtilityWaterYen')});ch('trend-cost-chart').setOption({tooltip:{trigger:'axis',valueFormatter:v=>money(v)},legend:{top:0},grid:{left:64,right:18,top:42,bottom:40},xAxis:{type:'category',data:years},yAxis:{type:'value',axisLabel:{formatter:v=>Math.round(v/1000)+'千'}},series:ss},true);const rs=[{name:'A · '+a.prefecture,type:'line',smooth:true,data:line(a,'utilityBurdenRate')}];if(b)rs.push({name:'B · '+b.prefecture,type:'line',smooth:true,data:line(b,'utilityBurdenRate')});ch('trend-rate-chart').setOption({tooltip:{trigger:'axis',valueFormatter:v=>nf.format(v)+'%'},legend:{top:0},grid:{left:55,right:18,top:42,bottom:40},xAxis:{type:'category',data:years},yAxis:{type:'value',axisLabel:{formatter:v=>v+'%'}},series:rs},true)}
function renderJapan(){ch('mix-chart').setOption({tooltip:{trigger:'axis',valueFormatter:v=>nf.format(v)+'%'},grid:{left:95,right:55,top:15,bottom:25},xAxis:{type:'value',axisLabel:{formatter:v=>v+'%'}},yAxis:{type:'category',inverse:true,data:snap.mixReported.map(x=>x.label)},series:[{type:'bar',barWidth:18,data:snap.mixReported.map(x=>x.share),label:{show:true,position:'right',formatter:p=>nf.format(p.value)+'%'},itemStyle:{borderRadius:[0,8,8,0]}}]},true);const names=[...snap.topGeneration.map(x=>x.prefecture),...snap.topDemand.map(x=>x.prefecture)].filter((v,i,a)=>a.indexOf(v)===i),gm=new Map(snap.topGeneration.map(x=>[x.prefecture,x.generation100mKwh])),dm=new Map(snap.topDemand.map(x=>[x.prefecture,x.demand100mKwh]));ch('supply-demand-chart').setOption({tooltip:{trigger:'axis',valueFormatter:v=>nf.format(v)+'億kWh'},legend:{top:0},grid:{left:72,right:18,top:42,bottom:40},xAxis:{type:'category',data:names,axisLabel:{fontSize:9}},yAxis:{type:'value'},series:[{name:'発電',type:'bar',data:names.map(n=>gm.get(n)||0)},{name:'需要',type:'bar',data:names.map(n=>dm.get(n)||0)}]},true);renderSurcharge()}
function renderSurcharge(){document.getElementById('surcharge-result').textContent=money(Math.round((Number(kwh.value)||0)*security.renewableSurchargeYenPerKwh))}
let consumptionHistoryData=null;async function renderConsumptionHistory(){if(!consumptionHistoryData){try{const r=await fetch('/data/energy-consumption-history.json');if(!r.ok)throw new Error('fetch');consumptionHistoryData=await r.json()}catch(e){ch('consumption-history-chart').clear();return}}const idx=consumptionHistoryData.fields.indexOf(consumptionHistoryMetric.value);const rec=name=>consumptionHistoryData.records.find(r=>r.prefecture===name);const mk=name=>({name,type:'line',smooth:.14,showSymbol:false,lineStyle:{width:3},data:(rec(name)?.values||[]).map(v=>[v[0],v[idx]])});const series=[mk(pref.value)];if(compare.value)series.push(mk(compare.value));ch('consumption-history-chart').setOption({tooltip:{trigger:'axis',valueFormatter:v=>nf.format(v)+' GJ/人'},legend:{top:0},grid:{left:68,right:24,top:44,bottom:40},xAxis:{type:'value',min:consumptionHistoryData.years[0],max:consumptionHistoryData.years.at(-1),axisLabel:{formatter:v=>String(v)}},yAxis:{type:'value',scale:true,axisLabel:{formatter:v=>nf.format(v)}},series},true)}
const renderers={bill:renderBill,ranking:renderRanking,trend:renderTrend,japan:renderJapan,'consumption-history':renderConsumptionHistory};let active='bill';function sync(){const q=new URLSearchParams({pref:pref.value,tab:active,metric:metric.value,order:direction.value,kwh:String(Number(kwh.value)||0)});if(compare.value)q.set('compare',compare.value);history.replaceState(null,'','?'+q)}function setTab(t,s=true){active=renderers[t]?t:'bill';document.querySelectorAll('.tab').forEach(x=>x.setAttribute('aria-selected',String(x.dataset.tab===active)));document.querySelectorAll('.panel').forEach(x=>x.hidden=x.dataset.panel!==active);requestAnimationFrame(()=>{renderKpis();renderers[active]();Object.values(charts).forEach(x=>x.resize())});if(s)sync()}function restore(){const q=new URLSearchParams(location.search);pref.value=q.get('pref')||'東京都';if(!byName.has(pref.value))pref.value='東京都';if(q.get('compare')&&byName.has(q.get('compare')))compare.value=q.get('compare');if(q.get('metric')&&defs[q.get('metric')])metric.value=q.get('metric');if(q.get('order'))direction.value=q.get('order');if(q.get('kwh'))kwh.value=q.get('kwh');active=q.get('tab')||'bill'}restore();document.querySelectorAll('.tab').forEach(x=>x.addEventListener('click',()=>setTab(x.dataset.tab)));[pref,compare,metric,direction].forEach(x=>x.addEventListener('change',()=>{renderKpis();renderers[active]();sync()}));consumptionHistoryMetric.addEventListener('change',()=>{if(active==='consumption-history'){renderConsumptionHistory();sync()}});kwh.addEventListener('input',()=>{renderSurcharge();sync()});setTab(active,false);window.addEventListener('resize',()=>Object.values(charts).forEach(x=>x.resize()));
</script></body></html>
