---
import fs from 'node:fs';import path from 'node:path';import '../../../styles/detail.css';
export function getStaticPaths(){const data=JSON.parse(fs.readFileSync(path.join(process.cwd(),'public/data/energy.json'),'utf8'));return data.records.map(r=>({params:{prefecture:r.prefecture},props:{prefecture:r.prefecture}}));}
const {prefecture}=Astro.props;const data=JSON.parse(fs.readFileSync(path.join(process.cwd(),'public/data/energy.json'),'utf8'));const r=data.records.find(x=>x.prefecture===prefecture),n=data.nationwide;const fmt=v=>Number.isFinite(v)?new Intl.NumberFormat('ja-JP',{maximumFractionDigits:1}).format(v):'—';const money=v=>Number.isFinite(v)?new Intl.NumberFormat('ja-JP',{maximumFractionDigits:0}).format(v)+'円':'—';const rank=f=>{if(!Number.isFinite(r[f]))return null;const i=[...data.records].filter(x=>Number.isFinite(x[f])).sort((a,b)=>b[f]-a[f]).findIndex(x=>x.prefecture===prefecture);return i>=0?i+1:null};const latest=r.trend?.[r.trend.length-1];const oldest=r.trend?.[0];const desc=prefecture+'（'+r.capital+'）の電気代・ガス代・灯油・エネルギー家計負担を比較。全国平均との差と推移も掲載。';const canonical='https://datlume.com/energy/prefectures/'+encodeURIComponent(prefecture)+'/';
---
<html lang="ja"><head><link rel="icon" type="image/svg+xml" href="/favicon.svg"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="description" content={desc}><link rel="canonical" href={canonical}><meta property="og:title" content={prefecture+'の電気代・光熱費 | DATLUME'}><meta property="og:description" content={desc}><title>{prefecture}の電気代・光熱費 | DATLUME</title></head><body><header><div class="wrap"><div class="nav"><a class="brand" href="/">DATLUME</a><a class="back" href="/energy/">エネルギーへ戻る</a></div><div class="hero"><div class="eyebrow">Energy / Household</div><h1>{prefecture}の電気代・光熱費</h1><p>{data.householdYear}年の{r.capital}・二人以上世帯。県全体平均ではありません。</p></div></div></header><main class="wrap">
<section class="stats"><div class="card"><div class="label">エネルギー支出 / 月</div><div class="value">{money(r.monthlyEnergyYen)}</div><div class="label">全国 {money(n.monthlyEnergyYen)} / {rank('annualEnergyYen')?rank('annualEnergyYen')+'位':'順位なし'}</div></div><div class="card"><div class="label">家計負担率</div><div class="value">{fmt(r.energyBurdenRate)}%</div><div class="label">消費支出に占める割合 / {rank('energyBurdenRate')?rank('energyBurdenRate')+'位':'順位なし'}</div></div><div class="card"><div class="label">光熱・水道 価格水準</div><div class="value">{fmt(r.utilityPriceIndex)}</div><div class="label">全国平均=100 / {rank('utilityPriceIndex')?rank('utilityPriceIndex')+'位':'順位なし'}</div></div></section>
<section class="card table-card section"><div class="table-head"><h2>年間の内訳</h2><div class="note">{data.householdYear}年</div></div><table><thead><tr><th>項目</th><th>{r.capital}</th><th>全国</th><th>全国との差</th></tr></thead><tbody>
<tr><td>電気代</td><td>{money(r.annualElectricityYen)}</td><td>{money(n.annualElectricityYen)}</td><td>{Number.isFinite(r.annualElectricityYen)?money(r.annualElectricityYen-n.annualElectricityYen):'—'}</td></tr>
<tr><td>ガス代</td><td>{money(r.annualGasYen)}</td><td>{money(n.annualGasYen)}</td><td>{Number.isFinite(r.annualGasYen)?money(r.annualGasYen-n.annualGasYen):'—'}</td></tr>
<tr><td>灯油</td><td>{money(r.annualKeroseneYen)}</td><td>{money(n.annualKeroseneYen)}</td><td>{Number.isFinite(r.annualKeroseneYen)?money(r.annualKeroseneYen-n.annualKeroseneYen):'—'}</td></tr>
<tr><td>その他光熱</td><td>{money(r.annualOtherHeatYen)}</td><td>{money(n.annualOtherHeatYen)}</td><td>{Number.isFinite(r.annualOtherHeatYen)?money(r.annualOtherHeatYen-n.annualOtherHeatYen):'—'}</td></tr>
<tr><td><strong>エネルギー計</strong></td><td><strong>{money(r.annualEnergyYen)}</strong></td><td>{money(n.annualEnergyYen)}</td><td>{Number.isFinite(r.annualEnergyYen)?money(r.annualEnergyYen-n.annualEnergyYen):'—'}</td></tr>
<tr><td>上下水道料</td><td>{money(r.annualWaterYen)}</td><td>{money(n.annualWaterYen)}</td><td>{Number.isFinite(r.annualWaterYen)?money(r.annualWaterYen-n.annualWaterYen):'—'}</td></tr>
</tbody></table></section>
<section class="card section"><h2>「高い」の中身</h2><p><strong>支出額：</strong>{Number.isFinite(r.monthlyEnergyYen)?<>月あたりエネルギー支出は全国平均比 {r.monthlyEnergyYen>=n.monthlyEnergyYen?'+':''}{money(r.monthlyEnergyYen-n.monthlyEnergyYen)}。</>:<>2025年の品目別年間内訳は元統計で欠損しているため、エネルギー計は表示していません。</>}</p><p><strong>価格水準：</strong>光熱・水道の地域差指数は {fmt(r.utilityPriceIndex)}（全国=100）。支出額が高くても、必ずしも単価・価格水準だけが原因ではありません。</p><p>電気・ガス・灯油の使用量、気候、住宅性能、世帯人数、契約プランなどが実際の支出を左右します。</p></section>
<section class="card section"><h2>光熱・水道費の推移</h2>{oldest&&latest?<><p>{oldest.year}年 {money(oldest.monthlyUtilityWaterYen)} → {latest.year}年 {money(latest.monthlyUtilityWaterYen)} / 月。</p><p>家計負担率は {fmt(oldest.utilityBurdenRate)}% → {fmt(latest.utilityBurdenRate)}%。</p></>:<p>推移データなし</p>}<div class="data-note">この推移はSSDSE-Bの都道府県別系列で、上の2025年都道府県庁所在市データとは地域単位が異なります。単純な連続系列として接続しないでください。</div></section>
<div class="links"><a class="linkchip" href="/energy/">エネルギートップ</a><a class="linkchip" href="/energy/indicators/electricity/">電気代ランキング</a><a class="linkchip" href="/energy/indicators/energy-burden/">家計負担率ランキング</a><a class="linkchip" href="/economy-prices/">経済・物価を見る</a></div></main><footer class="wrap">出典：総務省統計局 家計調査・小売物価統計調査 / 統計センター SSDSE</footer></body></html>
