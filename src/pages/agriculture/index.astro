---
import SiteFooter from '../../components/SiteFooter.astro';
import { readFileSync } from 'node:fs';
const info = JSON.parse(readFileSync('public/data/agriculture-output.json','utf8'));
const fmt = (n) => new Intl.NumberFormat('ja-JP').format(n);
---
<!doctype html><html lang="ja"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width"><link rel="icon" type="image/svg+xml" href="/favicon.svg">
<title>農業・食の産地｜市町村別・品目別の農業産出額 | DATLUME</title>
<meta name="description" content="米、野菜、果物、畜産など、何がどこで生産されているか。農水省の2024年市町村別農業産出額（推計）を品目と地域で比較。">
<link rel="canonical" href="https://datlume.com/agriculture/"><meta property="og:title" content="農業・食の産地 | DATLUME"><meta property="og:description" content="市町村×品目で日本の産地を見つける。"><meta property="og:type" content="website"><link rel="stylesheet" href="/brand/footer.css?v=20261010-2">
<style>
:root{--ink:#142033;--muted:#667085;--line:#dfe6eb;--bg:#f5f7f6;--green:#147d62;--deep:#0e1b2e}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,system-ui,-apple-system,"Noto Sans JP",sans-serif}a{color:inherit}.wrap{width:min(1180px,calc(100% - 32px));margin:auto}header{background:var(--deep);color:#fff;padding:18px 0 55px}.nav{display:flex;align-items:center;justify-content:space-between;gap:14px}.brand{display:inline-flex;align-items:center;gap:9px;text-decoration:none;font-size:19px;font-weight:750;letter-spacing:.16em;white-space:nowrap}.brand img{filter:brightness(0) invert(1)}.links{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:7px}.links a{font-size:12px;color:#dce6f3;border:1px solid #ffffff30;border-radius:99px;padding:7px 10px;text-decoration:none}.hero{padding-top:48px}.eyebrow{color:#9ee2bd;font-size:11px;letter-spacing:.15em;font-weight:800}.hero h1{font-size:clamp(34px,5vw,62px);letter-spacing:-.045em;margin:10px 0}.hero p{color:#d3e0e8;line-height:1.8;max-width:740px;margin:0}.tags{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}.tags span{border:1px solid #ffffff32;border-radius:99px;padding:7px 10px;font-size:11px}main.wrap{padding:20px 0 72px}.card{background:#fff;border:1px solid var(--line);border-radius:16px}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.stat{padding:18px}.stat small{color:var(--muted)}.stat b{display:block;font-size:27px;margin:4px 0}.stat span{font-size:11px;color:var(--muted)}.intro{margin:25px 0 12px}.intro h2{font-size:22px;margin:0 0 6px}.intro p{font-size:12px;color:var(--muted);margin:0;line-height:1.7}.controls{padding:18px;display:grid;grid-template-columns:1.3fr 1fr 1.2fr;gap:12px}.control label{display:block;font-size:12px;font-weight:750;margin-bottom:6px}.control select,.control input{width:100%;border:1px solid #cad5d4;border-radius:9px;background:#fff;height:44px;padding:0 10px;color:var(--ink);font:inherit;font-size:14px}.quick{display:flex;gap:7px;flex-wrap:wrap;margin:12px 0 0}.quick button,.more{border:1px solid #bed9ce;background:#fff;border-radius:99px;color:#17644f;padding:8px 12px;font:inherit;font-size:12px;font-weight:750;cursor:pointer}.quick button[aria-pressed=true]{background:#147d62;color:#fff}.layout{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(300px,.9fr);align-items:start;gap:14px;margin-top:14px}.panel{padding:20px;min-width:0}.panel h2{font-size:19px;margin:0}.sub{font-size:11px;color:var(--muted);line-height:1.6;margin:6px 0 14px}.rank-list{display:grid;gap:7px}.rank-row{width:100%;background:#fff;border:1px solid #e5ecea;border-radius:10px;text-align:left;padding:10px 12px;display:grid;grid-template-columns:24px minmax(0,1fr) auto;align-items:center;gap:10px;cursor:pointer;color:var(--ink);font:inherit}.rank-row:hover,.rank-row.selected{border-color:var(--green);background:#f4faf7}.num{font-size:11px;color:var(--green);font-weight:800}.place{min-width:0;font-size:13px;font-weight:800;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.place small{color:var(--muted);font-weight:500;margin-left:7px}.amount{font-size:13px;font-weight:800;white-space:nowrap}.track{grid-column:2/4;background:#e9f2ee;height:6px;border-radius:99px;overflow:hidden}.fill{display:block;height:100%;background:linear-gradient(90deg,#23aa72,#147d62);border-radius:99px}.more{display:block;margin:14px auto 0}.detail-title{font-size:24px;font-weight:850;letter-spacing:-.03em}.detail-total{font-size:24px;color:var(--green);font-weight:850;margin:12px 0 2px}.detail-label{font-size:11px;color:var(--muted)}.detail h3{font-size:14px;margin:22px 0 9px}.product-row{display:flex;justify-content:space-between;gap:12px;padding:9px 0;border-bottom:1px solid #eff2f2;font-size:12px}.product-row b{white-space:nowrap}.notes{margin-top:14px;padding:18px 20px;font-size:12px;line-height:1.8;color:#495a63}.notes h2{font-size:16px;margin:0 0 8px;color:var(--ink)}.notes p{margin:5px 0}.notes a{color:var(--green)}.empty{padding:22px;color:var(--muted);font-size:13px}@media(max-width:800px){.layout{grid-template-columns:1fr}#detail{order:-1}.controls{grid-template-columns:1fr 1fr}.controls .search{grid-column:1/-1}}@media(max-width:600px){.wrap{width:min(100% - 24px,1180px)}header{padding-bottom:35px}.nav{display:block}.links{justify-content:flex-start;overflow:auto;flex-wrap:nowrap;margin-top:12px}.links a{white-space:nowrap}.hero{padding-top:36px}.stats{grid-template-columns:1fr 1fr}.stat:last-child{grid-column:1/-1}.stat b{font-size:22px}.controls{grid-template-columns:1fr}.controls .search{grid-column:auto}.panel{padding:15px}.rank-row{gap:6px;padding:9px}.place{font-size:12px}.place small{display:block;margin-left:0;font-size:10px}.amount{font-size:12px}}
</style></head><body>
<header><div class="wrap"><nav class="nav"><a class="brand" href="/" aria-label="DATLUME"><img src="/favicon.svg" alt="" width="24" height="24">DATLUME</a><div class="links"><a href="/">ホーム</a><a href="/regional/">🗾 都道府県別推移</a><a href="/business-industry/">🏭 企業・産業</a><a href="/economy-prices/">💴 経済・物価</a><a href="/about-data/">データについて</a></div></nav>
<div class="hero"><div class="eyebrow">AGRICULTURE / FOOD ORIGINS</div><h1>🌾 農業・食の産地</h1><p>米、野菜、果物、畜産。品目を選ぶと、どの市町村の農業産出額が大きいかが分かります。地域を選んで、その土地で目立つ品目も見てみましょう。</p><div class="tags"><span>2024年の推計値</span><span>{fmt(info.municipalityCount)}市町村</span><span>{info.products.length}項目</span></div></div></div></header>
<main class="wrap"><section class="stats" aria-label="収録データ"><div class="card stat"><small>対象市町村</small><b>{fmt(info.municipalityCount)}</b><span>全国47都道府県</span></div><div class="card stat"><small>収録項目</small><b>{info.products.length}</b><span>合計・部門別・詳細品目を含む</span></div><div class="card stat"><small>出典の対象年</small><b>{info.year}年</b><span>農水省の市町村別推計</span></div></section>
<div class="intro"><h2>産地を探す</h2><p>金額の単位は千万円です。品目と都道府県を選ぶと公開値の大きい市町村から表示します。</p></div>
<section class="card controls" aria-label="絞り込み"><div class="control"><label for="item">品目</label><select id="item"><option>読み込み中…</option></select></div><div class="control"><label for="prefecture">都道府県</label><select id="prefecture"><option value="">全国</option></select></div><div class="control search"><label for="city-search">市町村を探す</label><input id="city-search" type="search" placeholder="例：帯広市" autocomplete="off"></div></section>
<div class="quick" aria-label="よく見る品目"><button type="button" data-item="米">🍚 米</button><button type="button" data-item="トマト">🍅 トマト</button><button type="button" data-item="いちご">🍓 いちご</button><button type="button" data-item="りんご">🍎 りんご</button><button type="button" data-item="生乳">🥛 生乳</button><button type="button" data-item="農業産出額">🌾 農業全体</button></div>
<div class="layout"><section class="card panel"><h2 id="ranking-title">市町村ランキング</h2><p class="sub" id="ranking-description" aria-live="polite">読み込み中…</p><div class="rank-list" id="ranking"></div><button type="button" class="more" id="more" hidden>さらに15件表示</button></section><section class="card panel detail" id="detail"><h2>市町村の内訳</h2><p class="sub">ランキングの市町村を選ぶと、品目別の公開値を表示します。</p></section></div>
<section class="card notes"><h2>この数字の読み方</h2><p>農水省「市町村別農業産出額（推計）」を使用。都道府県の産出額を収穫量や作付面積などで市町村に配分した<strong>推計額</strong>で、生産量・実際の販売額ではありません。千万円単位の丸めにより内訳と合計は一致しない場合があります。農業経営体の所在市町村で計上される品目もあり、生産場所を厳密に示すものではありません。</p><p>「0」は千万円未満、「x」は秘密保護のため非公開、「－」は該当なし、「…」は数値が示されていない箇所です。ランキングは公開された金額だけで並べています。非公開値を0として扱いません。</p><p>出典：<a href={info.sourcePage} target="_blank" rel="noopener noreferrer">農林水産省 市町村別農業産出額（推計）↗</a>。原典の対象年：{info.year}年。2025年農林業センサスの市町村別結果とは別の統計です。</p></section></main>
<SiteFooter>農業・食の産地｜出典：農林水産省 市町村別農業産出額（推計）</SiteFooter>
<script>
const $=id=>document.getElementById(id),format=new Intl.NumberFormat('ja-JP');
let items,rows,selected=null,shown=15,filtered=[];
function valueText(v){if(typeof v==='number')return format.format(v)+'千万円';return v==='x'?'非公開':v==='-'?'該当なし':'数値なし'}
function make(tag,cls,text){const el=document.createElement(tag);if(cls)el.className=cls;if(text!==undefined)el.textContent=text;return el}
function detail(row){selected=row?.code||null;const box=$('detail');box.replaceChildren();if(!row){box.append(make('h2','','市町村の内訳'),make('p','sub','ランキングから市町村を選んでください。'));return}box.append(make('div','detail-title',row.prefecture+' '+row.city),make('div','detail-total',valueText(row.values[0])),make('div','detail-label','農業産出額全体・2024年の推計値'),make('h3','','主な品目（公開額の上位）'));const entries=items.map((item,i)=>({item,val:row.values[i]})).filter(x=>!x.item.aggregate&&typeof x.val==='number'&&x.val>0).sort((a,b)=>b.val-a.val).slice(0,12);if(!entries.length)box.append(make('p','sub','公開されている品目別の金額はありません。'));for(const x of entries){const line=make('div','product-row');line.append(make('span','',x.item.name),make('b','',valueText(x.val)));box.append(line)}const i=Number($('item').value);box.append(make('p','sub','選択品目「'+items[i].name+'」：'+valueText(row.values[i])))}
function render(){const index=Number($('item').value),item=items[index],pref=$('prefecture').value,term=$('city-search').value.trim();filtered=rows.filter(r=>(!pref||r.prefecture===pref)&&(!term||r.city.includes(term)||r.prefecture.includes(term))&&typeof r.values[index]==='number').sort((a,b)=>b.values[index]-a.values[index]||a.code.localeCompare(b.code));$('ranking-title').textContent=item.name+'の市町村ランキング';$('ranking-description').textContent='2024年・'+(pref||'全国')+'／公開値 '+format.format(filtered.length)+'市町村。推計額が大きい順（千万円）。';const list=$('ranking');list.replaceChildren();const top=filtered.slice(0,shown),max=Math.max(1,top[0]?.values[index]||0);for(let i=0;i<top.length;i++){const r=top[i],button=make('button','rank-row');button.type='button';button.setAttribute('aria-label',r.prefecture+r.city+'、'+valueText(r.values[index])+'の内訳を見る');if(r.code===selected)button.classList.add('selected');button.append(make('span','num',String(i+1)));const p=make('span','place',r.city);p.append(make('small','',r.prefecture));button.append(p,make('span','amount',valueText(r.values[index])));const track=make('span','track'),bar=make('span','fill');bar.style.width=(r.values[index]/max*100)+'%';track.append(bar);button.append(track);button.addEventListener('click',()=>{detail(r);render();if(innerWidth<800)$('detail').scrollIntoView({behavior:'smooth',block:'start'})});list.append(button)}if(!filtered.length)list.append(make('p','empty','公開された金額に該当する市町村がありません。'));$('more').hidden=filtered.length<=shown;const current=filtered.find(r=>r.code===selected);detail(current||top[0]||null);document.querySelectorAll('[data-item]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.item===item.name)))}
async function start(){try{const res=await fetch('/data/agriculture-output.json');if(!res.ok)throw Error('HTTP '+res.status);const data=await res.json();items=data.products;rows=data.records;const select=$('item');select.replaceChildren();items.forEach((p,i)=>select.add(new Option(p.name+(p.aggregate?'（合計）':''),String(i))));select.value=String(items.findIndex(p=>p.name==='米'));for(const name of [...new Set(rows.map(r=>r.prefecture))])$('prefecture').add(new Option(name,name));const params=new URLSearchParams(location.search),chosen=items.findIndex(p=>p.name===params.get('item'));if(chosen>=0)select.value=String(chosen);if([...$('prefecture').options].some(o=>o.value===params.get('pref')))$('prefecture').value=params.get('pref');render()}catch(e){$('ranking-description').textContent='データを読み込めませんでした。ページを再読み込みしてください。';console.error(e)}}
function sync(){const q=new URLSearchParams({item:items[Number($('item').value)].name});if($('prefecture').value)q.set('pref',$('prefecture').value);history.replaceState(null,'','?'+q)}
$('item').addEventListener('change',()=>{shown=15;render();sync()});$('prefecture').addEventListener('change',()=>{shown=15;render();sync()});$('city-search').addEventListener('input',()=>{shown=15;render()});$('more').addEventListener('click',()=>{shown+=15;render()});document.querySelectorAll('[data-item]').forEach(b=>b.addEventListener('click',()=>{const i=items?.findIndex(p=>p.name===b.dataset.item);if(i<0)return;$('item').value=String(i);shown=15;render();sync()}));start();
</script></body></html>
