---
import SiteFooter from '../../components/SiteFooter.astro';
import { readFileSync } from 'node:fs';
const info = JSON.parse(readFileSync('public/data/agriculture-output.json','utf8'));
const fmt = (n) => new Intl.NumberFormat('ja-JP').format(n);
const picks = [
 {name:'米',icon:'🍚',color:'#1769e0',bg:'#eaf2ff'},
 {name:'トマト',icon:'🍅',color:'#d65143',bg:'#fff0ec'},
 {name:'いちご',icon:'🍓',color:'#c44871',bg:'#ffedf3'},
 {name:'りんご',icon:'🍎',color:'#ba6a20',bg:'#fff3e5'},
 {name:'生乳',icon:'🥛',color:'#7c58ba',bg:'#f2edff'},
 {name:'農業産出額',icon:'🌾',color:'#147d62',bg:'#e8f6ef'}
].map(p => {
 const i=info.products.findIndex(x=>x.name===p.name);
 const leader=info.records.filter(r=>typeof r.values[i]==='number').sort((a,b)=>b.values[i]-a.values[i]||a.code.localeCompare(b.code))[0];
 return {...p,leader};
});
---
<!doctype html><html lang="ja"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width"><link rel="icon" type="image/svg+xml" href="/favicon.svg">
<title>農業・食の産地｜市町村別・品目別の農業産出額 | DATLUME</title>
<meta name="description" content="米、野菜、果物、畜産など、何がどこで生産されているか。農水省の2024年市町村別農業産出額（推計）を品目と地域で比較。">
<link rel="canonical" href="https://datlume.com/agriculture/"><meta property="og:title" content="農業・食の産地 | DATLUME"><meta property="og:description" content="市町村×品目で日本の産地を見つける。"><meta property="og:type" content="website">
<link rel="stylesheet" href="/brand/footer.css?v=20261010-2">
<style is:global>
:root{--ink:#142033;--muted:#58677c;--line:#e1e7ef;--bg:#f4f6f9;--blue:#1769e0;--accent:#1769e0;--deep:#0e1b2e;color-scheme:light}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.6 system-ui,-apple-system,"Noto Sans JP",sans-serif}a{color:var(--blue)}button,input,select{font:inherit}button,select{cursor:pointer}[hidden]{display:none!important}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid #66a2fb;outline-offset:3px}.wrap{width:min(1200px,calc(100% - 32px));margin:auto}
header{background:var(--deep);color:#fff;padding:18px 0 30px}.nav{display:flex;align-items:center;justify-content:space-between;gap:14px}.brand{display:inline-flex;align-items:center;gap:9px;text-decoration:none;font-size:18px;font-weight:750;letter-spacing:.16em;color:white;white-space:nowrap}.brand img{filter:brightness(0) invert(1)}.links{display:flex;gap:18px}.links a{font-size:12px;color:#d3dff0;text-decoration:none}.hero{display:flex;align-items:center;justify-content:space-between;gap:30px;padding-top:28px}.eyebrow{color:#85c9af;font-size:10px;letter-spacing:.15em;font-weight:750}.hero h1{font-size:clamp(27px,3.2vw,40px);line-height:1.4;letter-spacing:-.04em;margin:7px 0}.hero p{font-size:13px;color:#c7d4e6;line-height:1.8;max-width:660px;margin:0}.hero-meta{display:flex;gap:12px;margin-top:14px;flex-wrap:wrap;color:#aabed7;font-size:11px}.hero-art{flex:none;width:148px;height:114px;border:1px solid #ffffff20;border-radius:16px;padding:17px;display:flex;align-items:flex-end;gap:8px;background:#ffffff06;transform:rotate(-4deg)}.hero-art span{flex:1;border-radius:4px 4px 0 0;background:#7bbf9a;height:36%}.hero-art span:nth-child(2){height:57%;background:#63a8df}.hero-art span:nth-child(3){height:83%;background:#e8c470}.hero-art span:nth-child(4){height:64%;background:#d78780}.hero-art span:nth-child(5){height:100%;background:#83a0e3}
main.wrap{padding:24px 0 45px}.section-heading{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px}.section-heading h2{font-size:19px;margin:0}.section-heading span{font-size:11px;color:var(--muted)}.quick{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px}.crop-card{position:relative;text-align:left;background:white;border:1px solid var(--line);border-radius:12px;padding:13px;color:var(--ink);transition:background .15s,border-color .15s;min-width:0;box-shadow:0 2px 6px #14203303}.crop-card:hover,.crop-card[aria-pressed=true]{border-color:var(--crop);background:var(--tint)}.crop-card[aria-pressed=true]{box-shadow:inset 0 -3px var(--crop)}.crop-head{display:flex;align-items:center;gap:8px;font-weight:750;font-size:14px;white-space:nowrap}.crop-icon{display:grid;place-items:center;width:32px;height:32px;border-radius:9px;background:var(--tint);font-size:22px}.crop-card small{display:block;color:var(--muted);font-size:10px;margin-top:9px}.crop-city{display:block;font-weight:750;font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.crop-pref{font-size:10px;color:var(--muted)}
.card{background:#fff;border:1px solid var(--line);border-radius:12px;min-width:0}.controls{padding:16px;display:grid;grid-template-columns:1.3fr 1fr 1.2fr;gap:12px;margin-top:16px}.control label{display:block;font-size:12px;font-weight:650;color:var(--muted);margin-bottom:5px}.control select,.control input{width:100%;min-width:0;border:1px solid #cbd5e1;border-radius:7px;background:#fff;height:42px;padding:0 10px;color:var(--ink);font-size:14px}
.stats{display:grid;grid-template-columns:1.25fr 1fr 1fr;gap:12px;margin-top:14px}.stat{padding:15px 18px;display:grid;grid-template-columns:1fr auto;gap:3px 12px;align-items:center}.stat small{color:var(--muted);font-size:11px}.stat b{display:block;font-size:25px;line-height:1.4;letter-spacing:-.03em;grid-column:1}.stat span{font-size:11px;color:var(--muted);grid-column:1}.stat-icon{grid-column:2;grid-row:1/4;display:grid;place-items:center;font-size:20px;width:42px;height:42px;background:#edf3fc;border-radius:12px}.stat:first-child{border-top:3px solid var(--accent)}.stat:first-child b{color:var(--accent);font-size:23px}
.layout{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);align-items:start;gap:14px;margin-top:14px}.panel{padding:20px}.panel h2{font-size:18px;line-height:1.4;margin:0}.sub{font-size:11px;color:var(--muted);line-height:1.7;margin:6px 0 12px}.panel-head{display:flex;align-items:center;justify-content:space-between;gap:12px}.badge{font-size:10px;color:var(--accent);background:color-mix(in srgb,var(--accent) 9%,white);padding:5px 9px;border-radius:99px;white-space:nowrap}.chart{height:350px;width:100%;min-width:0}.chart-hint{display:flex;align-items:center;gap:7px;font-size:11px;color:var(--muted);padding:8px 10px;background:#f5f8fc;border-radius:7px;margin:10px 0}.chart-hint span{color:var(--blue);font-size:15px}.result-heading{display:flex;justify-content:space-between;font-size:11px;color:var(--muted);padding:15px 0 9px;border-top:1px solid var(--line);margin-top:12px}.rank-list{max-height:340px;overflow:auto;overscroll-behavior:contain}.rank-row{width:100%;background:#fff;border:0;border-bottom:1px solid #edf1f6;text-align:left;padding:10px 8px;display:grid;grid-template-columns:25px minmax(0,1fr) auto;align-items:center;gap:9px;cursor:pointer;color:var(--ink);font:inherit;min-height:45px}.rank-row:hover,.rank-row.selected{background:#edf4ff;box-shadow:inset 3px 0 var(--accent)}.num{font-size:11px;color:var(--muted);font-weight:750}.rank-row:nth-child(-n+3) .num{color:var(--accent)}.place{min-width:0;font-size:12px;font-weight:700}.place small{color:var(--muted);font-weight:400;margin-left:8px;font-size:10px}.amount{font-size:12px;font-weight:700;white-space:nowrap;font-variant-numeric:tabular-nums}.more{display:block;width:100%;border:1px solid #ced8e6;border-radius:7px;padding:9px 12px;color:var(--blue);background:white;font-size:12px;margin-top:12px}.more:hover{background:#edf4ff}
.detail{position:sticky;top:16px;scroll-margin-top:15px}.detail-kicker{display:flex;justify-content:space-between;align-items:center;font-size:11px;color:var(--muted)}.detail-title{font-size:26px;font-weight:800;letter-spacing:-.04em;margin:5px 0 0}.detail-title small{font-size:12px;font-weight:500;margin-left:10px;color:var(--muted)}.detail-metrics{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:16px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin:16px 0}.detail-metrics small{display:block;color:var(--muted);font-size:10px}.detail-metrics strong{display:block;font-size:23px;line-height:1.6;font-variant-numeric:tabular-nums}.detail-metrics .picked{color:var(--accent)}.detail h3{font-size:14px;margin:18px 0 8px}.product-chart{display:grid;gap:13px;margin-top:14px}.product-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:5px 12px;font-size:12px}.product-row b{white-space:nowrap;font-variant-numeric:tabular-nums}.track{grid-column:1/-1;background:#eff2f7;height:8px;border-radius:99px;overflow:hidden}.fill{display:block;height:100%;background:var(--accent);border-radius:99px}.detail-note{font-size:10px;color:var(--muted);line-height:1.7;margin:16px 0 0}.empty{padding:20px;color:var(--muted);font-size:12px}.notes{margin-top:16px;padding:15px 20px;font-size:12px;line-height:1.8;color:#495a63}.notes summary{font-size:13px;font-weight:700;color:var(--ink);cursor:pointer}.notes p{margin:10px 0 0}.source-line{font-size:11px;color:var(--muted);line-height:1.8;margin:15px 2px}.load-error{padding:15px;border:1px solid #fecaca;background:#fff1f2;color:#b42318;border-radius:9px;margin-top:14px}
@media(max-width:1000px){.quick{grid-template-columns:repeat(3,minmax(0,1fr))}.hero-art{width:110px;height:100px}.layout{grid-template-columns:minmax(0,1.1fr) minmax(0,1fr)}.panel{padding:16px}}
@media(max-width:760px){.layout{grid-template-columns:1fr}.detail{position:static}.controls{grid-template-columns:1fr 1fr}.controls .search{grid-column:1/-1}.stats{gap:8px;grid-template-columns:1fr 1fr}.stat:first-child{grid-column:1/-1}.stat-icon{width:32px;height:32px;font-size:17px}.hero-art{display:none}.stat b{font-size:22px}.place small{display:block;margin:0}.links{gap:12px}}
@media(max-width:480px){.wrap{width:calc(100% - 24px)}header{padding-bottom:22px}.nav{align-items:start}.brand{font-size:16px}.links a{font-size:11px}.links a:nth-child(2){display:none}.hero{padding-top:24px}.hero h1{font-size:27px}.hero-meta{gap:6px 12px}.section-heading h2{font-size:17px}.section-heading span{display:none}main.wrap{padding-top:18px}.quick{gap:7px}.crop-card{padding:10px 8px}.crop-head{gap:4px;font-size:12px}.crop-icon{width:27px;height:27px;font-size:19px}.crop-city{font-size:12px}.crop-card small,.crop-pref{font-size:9px}.controls{padding:13px;gap:10px}.control select,.control input{font-size:13px}.stat{padding:12px}.stat b{font-size:21px}#public-count{font-size:18px;white-space:nowrap}.stat-icon{display:none}.stat:first-child b{font-size:23px}.panel{padding:14px}.panel h2{font-size:16px}.chart{height:335px}.detail-title{font-size:25px}.detail-metrics strong{font-size:22px}.notes{padding:14px}.rank-list{max-height:300px}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
</style></head><body>
<header><div class="wrap"><nav class="nav"><a class="brand" href="/" aria-label="DATLUME"><img src="/favicon.svg" alt="" width="24" height="24">DATLUME</a><div class="links"><a href="/">ホーム</a><a href="/regional/">地域データ</a><a href="/about-data/">出典・定義</a></div></nav>
<div class="hero"><div><div class="eyebrow">AGRICULTURE / FOOD ORIGINS</div><h1>🌾 農業・食の産地</h1><p>食卓のあの食材、どこが産地？<br>品目から探して、地域ごとの農業の特徴を比べてみましょう。</p><div class="hero-meta"><span>{info.year}年・農業産出額の推計</span><span>全国{fmt(info.municipalityCount)}市町村</span><span>{info.products.length}項目</span></div></div><div class="hero-art" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div></div></div></header>
<main class="wrap">
<div class="section-heading"><h2>食材から、産地を見つける</h2><span>各品目の全国1位・公開推計額で比較</span></div>
<div class="quick" aria-label="よく見る品目">{picks.map(p=><button class="crop-card" type="button" data-item={p.name} style={`--crop:${p.color};--tint:${p.bg}`} aria-pressed={p.name==='米'}><span class="crop-head"><span class="crop-icon" aria-hidden="true">{p.icon}</span>{p.name==='農業産出額'?'農業全体':p.name}</span><small>全国1位・公開推計額</small><span class="crop-city">{p.leader.city}</span><span class="crop-pref">{p.leader.prefecture}</span></button>)}</div>
<section class="card controls" aria-label="絞り込み"><div class="control"><label for="item">品目を選ぶ</label><select id="item" disabled><option>読み込み中…</option></select></div><div class="control"><label for="prefecture">地域を絞る</label><select id="prefecture" disabled><option value="">全国</option></select></div><div class="control search"><label for="city-search">市町村を探す</label><input id="city-search" type="search" placeholder="例：帯広市" autocomplete="off" disabled></div></section>
<p class="load-error" id="load-error" role="alert" hidden></p>
<section class="stats" aria-label="選択条件の概要" aria-live="polite"><div class="card stat"><small id="leader-label">推計額が最も大きい市町村</small><b id="leader-city">—</b><span id="leader-pref">読み込み中…</span><div class="stat-icon" aria-hidden="true">📍</div></div><div class="card stat"><small>1位の品目別推計額</small><b id="leader-amount">—</b><span id="leader-item">—</span><div class="stat-icon" aria-hidden="true">📊</div></div><div class="card stat"><small>比較できる市町村</small><b id="public-count">—</b><span>選択条件内の公開値</span><div class="stat-icon" aria-hidden="true">🗾</div></div></section>
<div class="layout"><section class="card panel"><div class="panel-head"><h2 id="ranking-title">市町村ランキング</h2><span class="badge">TOP 10</span></div><p class="sub" id="ranking-description" aria-live="polite">読み込み中…</p><div id="ranking-chart" class="chart" role="img" aria-label="市町村別農業産出額の上位10市町村"></div><p class="chart-hint"><span aria-hidden="true">↗</span>棒グラフや一覧の市町村を選ぶと、品目別の内訳を表示</p><div class="result-heading"><strong>市町村一覧</strong><span>推計額・億円</span></div><div class="rank-list" id="ranking" aria-label="市町村の公開額一覧"></div><button type="button" class="more" id="more" hidden>さらに15件表示</button></section><section class="card panel detail" id="detail" aria-label="選択した市町村の内訳"><h2>市町村の内訳</h2><p class="sub">ランキングの市町村を選んでください。</p></section></div>
<details class="card notes"><summary>この数字の読み方・非公開値について</summary><p>農水省「市町村別農業産出額（推計）」を使用。都道府県の産出額を収穫量や作付面積などで市町村に配分した<strong>推計額</strong>で、生産量・実際の販売額ではありません。千万円単位の丸めにより内訳と合計は一致しない場合があります。農業経営体の所在市町村で計上される品目もあり、生産場所を厳密に示すものではありません。</p><p>原典の「0」は千万円未満、「x」は秘密保護のため非公開、「－」は該当なし、「…」は数値が示されていない箇所です。ランキングは公開された金額だけで並べ、非公開値を0として扱いません。画面の金額は原典の千万円を億円に換算（原典値÷10）。2025年農林業センサスの市町村別結果とは別の統計です。</p></details>
<p class="source-line">出典：<a href={info.sourcePage} target="_blank" rel="noopener noreferrer">農林水産省 市町村別農業産出額（推計）↗</a> · 対象年：{info.year}年<br>表示する金額は農業産出額の推計値です。生産量・実際の販売額を示すものではありません。</p>
</main><SiteFooter>農業・食の産地｜出典：農林水産省 市町村別農業産出額（推計）</SiteFooter>
<script>
import * as echarts from 'echarts';
const $=id=>document.getElementById(id),format=new Intl.NumberFormat('ja-JP'),decimal=new Intl.NumberFormat('ja-JP',{maximumFractionDigits:1});
const colors={'米':'#1769e0','トマト':'#d65143','いちご':'#c44871','りんご':'#ba6a20','生乳':'#7c58ba','農業産出額':'#147d62'};
let items,rows,selected=null,shown=15,filtered=[],year,chart,chartRows=[];
function valueText(v){if(typeof v==='number')return v===0?'千万円未満':decimal.format(v/10)+'億円';return v==='x'?'非公開':v==='-'?'該当なし':'数値なし'}
function make(tag,cls,text){const el=document.createElement(tag);if(cls)el.className=cls;if(text!==undefined)el.textContent=text;return el}
function metric(label,value,cls=''){const el=make('div');el.append(make('small','',label),make('strong',cls,value));return el}
function detail(row){
 selected=row?.code||null;const box=$('detail');box.replaceChildren();
 if(!row){box.append(make('h2','','市町村の内訳'),make('p','sub','条件に合う公開値がありません。品目や地域を変更してください。'));return}
 const i=Number($('item').value),name=items[i].name;
 const kicker=make('div','detail-kicker','選択中の市町村');kicker.append(make('span','badge',year+'年・推計'));
 const title=make('h2','detail-title',row.city);title.append(make('small','',row.prefecture));
 const metrics=make('div','detail-metrics');metrics.append(metric('農業全体の産出額',valueText(row.values[0])),metric(name+'の産出額',valueText(row.values[i]),'picked'));
 box.append(kicker,title,metrics,make('h3','','この地域の主な品目'),make('p','sub','公開された品目別の推計額が大きい順'));
 const entries=items.map((item,i)=>({item,val:row.values[i]})).filter(x=>!x.item.aggregate&&typeof x.val==='number'&&x.val>0).sort((a,b)=>b.val-a.val).slice(0,8);
 const visual=make('div','product-chart');const max=Math.max(1,entries[0]?.val||0);
 for(const x of entries){const line=make('div','product-row');line.dataset.value=String(x.val);line.dataset.product=x.item.name;line.append(make('span','',x.item.name),make('b','',valueText(x.val)));const track=make('span','track'),bar=make('span','fill');bar.style.width=(x.val/max*100)+'%';track.append(bar);line.append(track);visual.append(line)}
 if(!entries.length)visual.append(make('p','empty','公開されている品目別の金額はありません。'));
 box.append(visual,make('p','detail-note','各棒は最大品目を基準に比較。合計・部門計を除く公開値の上位8項目で、全体の構成比ではありません。'));
}
function choose(row){detail(row);render();sync();if(innerWidth<760)$('detail').scrollIntoView({behavior:matchMedia('(prefers-reduced-motion:reduce)').matches?'instant':'smooth',block:'start'})}
function draw(){
 if(!chart){chart=echarts.init($('ranking-chart'));chart.on('click',p=>{if(p.componentType==='series'&&chartRows[p.dataIndex])choose(chartRows[p.dataIndex])});new ResizeObserver(()=>chart.resize()).observe($('ranking-chart'))}
 const index=Number($('item').value),accent=colors[items[index].name]||'#1769e0';chartRows=filtered.slice(0,10);
 chart.setOption({animation:false,tooltip:{trigger:'axis',axisPointer:{type:'shadow'},valueFormatter:v=>valueText(v*10)},grid:{left:8,right:65,top:12,bottom:30,containLabel:true},xAxis:{type:'value',name:'億円',nameTextStyle:{fontSize:10},axisLabel:{color:'#667085',fontSize:10},splitLine:{lineStyle:{color:'#edf1f6'}},min:0},yAxis:{type:'category',inverse:true,data:chartRows.map(r=>r.city),axisLabel:{color:'#344054',fontSize:11,width:innerWidth<480?72:110,overflow:'truncate'},axisLine:{show:false},axisTick:{show:false}},series:[{type:'bar',barMaxWidth:19,data:chartRows.map(r=>({name:r.prefecture+r.city,value:r.values[index]/10,itemStyle:{color:r.code===selected?accent:'#b9cee9',borderRadius:[0,4,4,0]}})),label:{show:true,position:'right',color:'#344054',fontSize:11,formatter:p=>p.value===0?'単位未満':decimal.format(p.value)}}],graphic:chartRows.length?[]:[{type:'text',left:'center',top:'middle',style:{text:'条件に合う公開値がありません',fill:'#667085',fontSize:12}}]},true);
 $('ranking-chart').setAttribute('aria-label',items[index].name+'・上位'+chartRows.length+'市町村の農業産出額（推計・億円）。'+chartRows.map(r=>r.city+' '+valueText(r.values[index])).join('、'));
}
function render(){
 const index=Number($('item').value),item=items[index],pref=$('prefecture').value,term=$('city-search').value.trim();
 filtered=rows.filter(r=>(!pref||r.prefecture===pref)&&(!term||r.city.includes(term)||r.prefecture.includes(term))&&typeof r.values[index]==='number').sort((a,b)=>b.values[index]-a.values[index]||a.code.localeCompare(b.code));
 document.documentElement.style.setProperty('--accent',colors[item.name]||'#1769e0');
 const current=filtered.find(r=>r.code===selected);detail(current||filtered[0]||null);
 $('ranking-title').textContent=item.name+'の産地ランキング';
 $('ranking-description').textContent=year+'年 · '+(pref||'全国')+' · 公開推計額の上位10市町村（億円）';
 $('leader-label').textContent=(pref||'全国')+'・'+item.name+'の公開額1位';$('leader-city').textContent=filtered[0]?.city||'該当なし';$('leader-pref').textContent=filtered[0]?.prefecture||'条件を変更してください';$('leader-amount').textContent=filtered[0]?valueText(filtered[0].values[index]):'—';$('leader-item').textContent=item.name+' · '+year+'年の推計';$('public-count').textContent=format.format(filtered.length)+'市町村';
 const list=$('ranking');list.replaceChildren();for(const [i,r] of filtered.slice(0,shown).entries()){const button=make('button','rank-row'+(r.code===selected?' selected':''));button.type='button';button.dataset.code=r.code;button.dataset.value=String(r.values[index]);button.setAttribute('aria-pressed',String(r.code===selected));button.setAttribute('aria-label',r.prefecture+r.city+'、'+valueText(r.values[index])+'の内訳を見る');button.append(make('span','num',String(i+1)));const place=make('span','place',r.city);place.append(make('small','',r.prefecture));button.append(place,make('span','amount',valueText(r.values[index])));button.addEventListener('click',()=>choose(r));list.append(button)}
 if(!filtered.length)list.append(make('p','empty','公開された金額に該当する市町村がありません。'));$('more').hidden=filtered.length<=shown;document.querySelectorAll('[data-item]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.item===item.name)));draw();
}
async function start(){try{const res=await fetch('/data/agriculture-output.json');if(!res.ok)throw Error('HTTP '+res.status);const data=await res.json();items=data.products;rows=data.records;year=data.year;const select=$('item');select.replaceChildren();items.forEach((p,i)=>select.add(new Option(p.name+(p.aggregate?'（合計）':''),String(i))));select.value=String(items.findIndex(p=>p.name==='米'));for(const name of [...new Set(rows.map(r=>r.prefecture))])$('prefecture').add(new Option(name,name));const params=new URLSearchParams(location.search),chosen=items.findIndex(p=>p.name===params.get('item'));if(chosen>=0)select.value=String(chosen);if([...$('prefecture').options].some(o=>o.value===params.get('pref')))$('prefecture').value=params.get('pref');selected=params.get('city');render();for(const id of ['item','prefecture','city-search'])$(id).disabled=false}catch(e){$('load-error').hidden=false;$('load-error').textContent='データを読み込めませんでした。ページを再読み込みしてください。';$('ranking-description').textContent='データ取得に失敗しました。';console.error(e)}}
function sync(){if(!items)return;const q=new URLSearchParams({item:items[Number($('item').value)].name});if($('prefecture').value)q.set('pref',$('prefecture').value);if(selected)q.set('city',selected);history.replaceState(null,'','?'+q)}
$('item').addEventListener('change',()=>{shown=15;selected=null;render();sync()});$('prefecture').addEventListener('change',()=>{shown=15;selected=null;render();sync()});$('city-search').addEventListener('input',()=>{shown=15;render()});$('more').addEventListener('click',()=>{shown+=15;render()});document.querySelectorAll('[data-item]').forEach(b=>b.addEventListener('click',()=>{if(!items)return;const i=items.findIndex(p=>p.name===b.dataset.item);if(i<0)return;$('item').value=String(i);shown=15;selected=null;render();sync()}));start();
</script></body></html>
