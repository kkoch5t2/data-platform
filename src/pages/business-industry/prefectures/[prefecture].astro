---
import fs from 'node:fs';import path from 'node:path';import '../../../styles/detail.css';
export function getStaticPaths(){const d=JSON.parse(fs.readFileSync(path.join(process.cwd(),'public/data/business-industry-2026.json'),'utf8'));return d.records.map(r=>({params:{prefecture:r.prefecture},props:{row:r,year:d.establishmentYear}}));}
const {row,year}=Astro.props;const pref=row.prefecture;const fmt=v=>new Intl.NumberFormat('ja-JP',{maximumFractionDigits:2}).format(v??0);const canonical='https://datlume.com/business-industry/prefectures/'+encodeURIComponent(pref)+'/';const metaDescription=pref+'の民営事業所数・従業者数・主要産業の構成比を公式統計からまとめた企業・産業データページです。';const maxIndustry=Math.max(...row.industries.map(x=>x.employees||0),1);const jsonLd={"@context":"https://schema.org","@type":"Dataset","name":pref+' 企業・産業データ',"description":metaDescription,"url":canonical,"spatialCoverage":pref,"creator":{"@type":"Organization","name":"DATLUME"}};
---
<html lang="ja"><head><link rel="icon" type="image/svg+xml" href="/favicon.svg"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="description" content={metaDescription}><link rel="canonical" href={canonical}><meta property="og:title" content={pref+'の企業・産業 | DATLUME'}><meta property="og:description" content={metaDescription}><meta property="og:type" content="website"><meta name="twitter:card" content="summary"><script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script><title>{pref}の企業・産業｜事業所・従業者・産業構造 | DATLUME</title></head><body>
<header><div class="wrap"><div class="nav"><a class="brand" href="/" aria-label="DATLUME" style="display:inline-flex;align-items:center;gap:10px;text-decoration:none;color:#fff"><img src="/favicon.svg" alt="" width="24" height="24" style="filter:brightness(0) invert(1)"><span style="font-size:19px;font-weight:750;letter-spacing:.16em">DATLUME</span></a><a class="back" href="/business-industry/">企業・産業へ戻る</a></div><div class="hero"><div class="eyebrow">Business / Industry</div><h1>{pref}</h1><p>事業所、従業者、主要産業の構成から地域の企業・産業を見る。</p></div></div></header>
<main class="wrap"><div class="stats"><div class="card"><div class="label">民営事業所数</div><div class="value">{fmt(row.establishments)}所</div></div><div class="card"><div class="label">民営従業者数</div><div class="value">{fmt(row.employees)}人</div></div><div class="card"><div class="label">1事業所あたり従業者</div><div class="value">{fmt(row.employeesPerEstablishment)}人</div></div></div>
<div class="data-note">{year}年の民営事業所・従業者データ。産業別内訳はSSDSE-Eで収録される主要7産業で、全産業の内訳ではありません。 <a href="/about-data/#business-industry">詳しい出典・注意点 →</a></div>
<section class="card section"><h2>主要産業の従業者数</h2>{row.industries.map(x=><div class="barrow"><div>{x.label}</div><div class="track"><div class="bar" style={'width:'+((x.employees||0)/maxIndustry*100)+'%'}></div></div><div class="amount">{fmt(x.employees)}人</div></div>)}</section>
<section class="card table-card section"><div class="table-head"><h2>産業構造</h2><div class="note">{year}年 / 民営</div></div><table><thead><tr><th>産業</th><th>事業所数</th><th>従業者数</th><th>従業者比率</th><th>従業者/事業所</th></tr></thead><tbody>{row.industries.map(x=><tr><td>{x.label}</td><td>{fmt(x.establishments)}</td><td>{fmt(x.employees)}</td><td>{fmt(x.employeeShare)}%</td><td>{fmt(x.employeesPerEstablishment)}人</td></tr>)}</tbody></table></section>
<section class="card section"><h2>この地域の特徴</h2><table><tbody><tr><th>最大の主要産業</th><td>{row.largestIndustry}</td></tr><tr><th>最大産業の従業者比率</th><td>{fmt(row.largestIndustryShare)}%</td></tr><tr><th>人口</th><td>{fmt(row.population)}人</td></tr><tr><th>15〜64歳人口</th><td>{fmt(row.workingAgePopulation)}人</td></tr></tbody></table></section>
<div class="links"><a class="linkchip" href="/business-industry/indicators/establishments/">事業所数ランキング</a><a class="linkchip" href="/business-industry/indicators/employees/">従業者数ランキング</a><a class="linkchip" href="/business-industry/">47都道府県を比較</a></div></main>
<footer class="wrap">出典：統計センター SSDSE-E-2026 · <a href="https://github.com/kkoch5t2/data-platform" target="_blank" rel="noreferrer" style="display:inline-flex;align-items:center;gap:5px"><img src="/brand/github.svg" alt="" width="14" height="14">GitHub ↗</a> · <a href="https://utility-tools-jp.com/" target="_blank" rel="noreferrer" style="display:inline-flex;align-items:center;gap:5px"><img src="/brand/utility-tools.ico" alt="" width="14" height="14" style="border-radius:3px">無料WEB便利ツール集 ↗</a> · <a href="/privacy/">プライバシーポリシー</a></footer></body></html>
