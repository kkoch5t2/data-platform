---
import fs from 'node:fs';import path from 'node:path';
const data=JSON.parse(fs.readFileSync(path.join(process.cwd(),'public/data/business-industry-2026.json'),'utf8'));
const records=data.records;const year=data.establishmentYear;
const defs={
  establishments:{label:'民営事業所数',field:'establishments',unit:'事業所'},
  employees:{label:'民営従業者数',field:'employees',unit:'人'},
  employeesPerEstablishment:{label:'1事業所あたり従業者数',field:'employeesPerEstablishment',unit:'人/所'},
  manufacturingShare:{label:'製造業 従業者比率',industry:'manufacturing',unit:'%',share:true},
  informationShare:{label:'情報通信業 従業者比率',industry:'information',unit:'%',share:true},
  medicalWelfareShare:{label:'医療・福祉 従業者比率',industry:'medicalWelfare',unit:'%',share:true},
  wholesaleRetailShare:{label:'卸売・小売業 従業者比率',industry:'wholesaleRetail',unit:'%',share:true}
};
const fmt=n=>new Intl.NumberFormat('ja-JP',{maximumFractionDigits:2}).format(n??0);
const jsonLd={"@context":"https://schema.org","@type":"Dataset","name":"都道府県別 企業・産業データ","description":"47都道府県の民営事業所数、従業者数、主要産業の構成を比較できるデータセット。","url":"https://datlume.com/business-industry/","creator":{"@type":"Organization","name":"DATLUME"}};
---
<!doctype html><html lang="ja"><head><link rel="icon" type="image/svg+xml" href="/favicon.svg"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="description" content="47都道府県の企業・産業構造を、民営事業所数・従業者数・主要産業の構成比から比較。統計センターSSDSEの公式データを可視化。"><link rel="canonical" href="https://datlume.com/business-industry/"><meta property="og:title" content="企業・産業 | DATLUME"><meta property="og:description" content="47都道府県の事業所・従業者・主要産業を比較。"><meta property="og:type" content="website"><meta name="twitter:card" content="summary"><script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script><title>企業・産業｜都道府県別の事業所・従業者・産業構造 | DATLUME</title>
<style>
:root{--ink:#142033;--muted:#667085;--line:#e4e9f0;--bg:#f4f6f9;--card:#fff;--nav:#0e1b2e;--blue:#1769e0;--green:#087f5b}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,system-ui,-apple-system,"Noto Sans JP",sans-serif}.wrap{width:min(1240px,calc(100% - 32px));margin:auto}a{color:inherit}header{background:var(--nav);color:#fff;padding:20px 0 56px}.nav{display:flex;justify-content:space-between;align-items:center;gap:18px}.brand{text-decoration:none}.navlinks{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end;margin-left:auto}.navlinks a{font-size:12px;color:#d9e4f4;border:1px solid #ffffff2a;border-radius:999px;padding:7px 11px;text-decoration:none}.hero{margin-top:42px}.eyebrow{font-size:11px;letter-spacing:.16em;color:#91b9f1;font-weight:800;text-transform:uppercase}.hero h1{font-size:clamp(38px,5.5vw,68px);letter-spacing:-.05em;margin:8px 0 14px}.hero p{color:#c7d3e4;line-height:1.8;max-width:820px}.hero-meta{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}.hero-meta span{font-size:11px;border:1px solid #ffffff24;border-radius:999px;padding:7px 10px;color:#dce7f5}
main.wrap{margin-top:18px;padding-bottom:68px}.card{background:#fff;border:1px solid var(--line);border-radius:16px}.controls{padding:16px;display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:12px}.control label{display:block;color:var(--muted);font-size:11px;font-weight:750;margin-bottom:6px}.control select{width:100%;height:42px;border:1px solid #d9dee7;border-radius:9px;background:#fff;padding:0 10px;font:inherit}.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:12px}.kpi{padding:17px}.kpi-label{font-size:11px;color:var(--muted)}.kpi-value{font-size:clamp(21px,2.5vw,29px);font-weight:850;letter-spacing:-.03em;margin-top:5px}.kpi-sub{font-size:10.5px;color:var(--muted);margin-top:4px}.grid{display:grid;grid-template-columns:1.35fr 1fr;gap:12px;margin-top:12px}.chart-card{padding:18px}.chart-card h2,.table-card h2{font-size:16px;margin:0}.chart-sub{font-size:10.5px;color:var(--muted);margin:4px 0 10px}.chart{height:440px}.industry-list{display:grid;gap:10px;margin-top:14px}.industry-row{display:grid;grid-template-columns:105px 1fr 86px;gap:10px;align-items:center}.industry-name{font-size:11px;font-weight:800}.track{height:10px;background:#edf1f6;border-radius:99px;overflow:hidden}.bar{height:100%;background:linear-gradient(90deg,#1769e0,#80afea);border-radius:99px}.industry-val{text-align:right;font-size:11px;font-weight:800}.industry-share{color:var(--muted);font-size:9px}.table-card{margin-top:12px;padding:18px;overflow:hidden}.table-wrap{overflow:auto;margin-top:12px}table{border-collapse:collapse;width:100%;min-width:700px}th,td{padding:11px 10px;border-bottom:1px solid #edf0f4;text-align:right;font-size:12px}th{font-size:10px;color:var(--muted);background:#fafbfd;position:sticky;top:0}th:first-child,td:first-child{text-align:left}td a{font-weight:800;color:#1769e0;text-decoration:none}.rank{display:inline-grid;place-items:center;width:24px;height:24px;border-radius:8px;background:#eef4ff;color:#1769e0;font-size:10px;font-weight:900;margin-right:8px}.section-title{margin:30px 0 10px;font-size:20px}.quick-links{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.quick-links a{background:#fff;border:1px solid var(--line);border-radius:11px;padding:13px;text-decoration:none;font-size:12px;font-weight:800}.note{margin-top:12px;font-size:11px;line-height:1.7;color:var(--muted)}footer{padding:26px 0 46px;color:var(--muted);font-size:11px}@media(max-width:900px){.grid{grid-template-columns:1fr}.kpis{grid-template-columns:1fr 1fr}.quick-links{grid-template-columns:1fr 1fr}}@media(max-width:720px){.nav{display:block}.navlinks{margin:14px -4px 0;overflow:auto;flex-wrap:nowrap;justify-content:flex-start}.navlinks a{white-space:nowrap}.controls{grid-template-columns:1fr}.chart{height:390px}}@media(max-width:480px){.wrap{width:min(100% - 24px,1240px)}.kpis{grid-template-columns:1fr 1fr}.industry-row{grid-template-columns:88px 1fr 72px}.quick-links{grid-template-columns:1fr 1fr}}
</style></head><body>
<header><div class="wrap"><div class="nav"><a class="brand" href="/" aria-label="DATLUME" style="display:inline-flex;align-items:center;gap:10px;color:#fff"><img src="/favicon.svg" alt="" width="24" height="24" style="filter:brightness(0) invert(1)"><span style="font-size:19px;font-weight:750;letter-spacing:.16em">DATLUME</span></a><div class="navlinks"><a href="/procurement/">公共調達</a><a href="/business-industry/">企業・産業</a><a href="/employment-economy/">雇用・賃金</a><a href="/regional/">都道府県</a><a href="/about-data/">データについて</a></div></div><div class="hero"><div class="eyebrow">Business / Industry</div><h1>企業・産業</h1><p>どの地域に事業所と雇用が集まり、どの産業が地域を支えているのか。47都道府県の企業活動と産業構造を、事業所数・従業者数・主要産業の構成から比較します。</p><div class="hero-meta"><span>47都道府県</span><span>{year}年 民営事業所</span><span>主要7産業</span></div></div></div></header>
<main class="wrap">
<section class="card controls"><div class="control"><label for="metric">全国ランキング指標</label><select id="metric">{Object.entries(defs).map(([k,v])=><option value={k}>{v.label}</option>)}</select></div><div class="control"><label for="pref">都道府県 A</label><select id="pref">{records.map(r=><option value={r.prefecture}>{r.prefecture}</option>)}</select></div><div class="control"><label for="compare">都道府県 B</label><select id="compare"><option value="">比較なし</option>{records.map(r=><option value={r.prefecture}>{r.prefecture}</option>)}</select></div></section>
<section class="kpis"><div class="card kpi"><div class="kpi-label">全国の民営事業所</div><div class="kpi-value">{fmt(data.totals.establishments)}所</div><div class="kpi-sub">{year}年 / 47都道府県合計</div></div><div class="card kpi"><div class="kpi-label">全国の民営従業者</div><div class="kpi-value">{fmt(data.totals.employees)}人</div><div class="kpi-sub">{year}年 / 47都道府県合計</div></div><div class="card kpi"><div class="kpi-label">1事業所あたり従業者</div><div class="kpi-value">{fmt(data.totals.employeesPerEstablishment)}人</div><div class="kpi-sub">全国合計から算出</div></div><div class="card kpi"><div class="kpi-label">産業内訳</div><div class="kpi-value">7産業</div><div class="kpi-sub">SSDSE-E収録の主要産業</div></div></section>
<section class="grid"><div class="card chart-card"><h2 id="rank-title">都道府県ランキング</h2><div id="rank-sub" class="chart-sub">{year}年 / 上位20都道府県</div><div id="ranking" class="chart"></div></div><div class="card chart-card"><h2 id="industry-title">産業構造</h2><div id="industry-sub" class="chart-sub">選択都道府県の従業者構成</div><div id="industry-chart" class="chart"></div></div></section>
<section class="card table-card"><h2>都道府県一覧</h2><div class="chart-sub">事業所数の多い順。都道府県名から詳細ページを開けます。</div><div class="table-wrap"><table><thead><tr><th>都道府県</th><th>事業所数</th><th>従業者数</th><th>従業者/事業所</th><th>最大の主要産業</th><th>構成比</th></tr></thead><tbody>{[...records].sort((a,b)=>b.establishments-a.establishments).map((r,i)=><tr><td><span class="rank">{i+1}</span><a href={`/business-industry/prefectures/${encodeURIComponent(r.prefecture)}/`}>{r.prefecture}</a></td><td>{fmt(r.establishments)}</td><td>{fmt(r.employees)}</td><td>{fmt(r.employeesPerEstablishment)}</td><td>{r.largestIndustry}</td><td>{fmt(r.largestIndustryShare)}%</td></tr>)}</tbody></table></div></section>
<h2 class="section-title">指標から見る</h2><div class="quick-links"><a href="/business-industry/indicators/establishments/">事業所数ランキング →</a><a href="/business-industry/indicators/employees/">従業者数ランキング →</a><a href="/business-industry/indicators/employees-per-establishment/">従業者/事業所 →</a><a href="/business-industry/indicators/information-share/">情報通信業比率 →</a></div>
<div class="note">出典：{data.source}。産業別内訳は主要7産業で、全産業の内訳ではありません。元統計の定義・収録範囲は <a href="/about-data/#business-industry">データについて</a> を確認してください。</div>
</main>
<footer><div class="wrap">出典：統計センター SSDSE-E-2026 · <a href="https://github.com/kkoch5t2/data-platform" target="_blank" rel="noreferrer" style="display:inline-flex;align-items:center;gap:5px"><img src="/brand/github.svg" alt="" width="14" height="14">GitHub ↗</a> · <a href="https://utility-tools-jp.com/" target="_blank" rel="noreferrer" style="display:inline-flex;align-items:center;gap:5px"><img src="/brand/utility-tools.ico" alt="" width="14" height="14" style="border-radius:3px">無料WEB便利ツール集 ↗</a></div></footer>
<script src="https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.min.js"></script>
<script type="application/json" id="dataset" set:html={JSON.stringify({records,defs,year})}></script>
<script>
const data=JSON.parse(document.getElementById('dataset').textContent),records=data.records,defs=data.defs,byName=new Map(records.map(r=>[r.prefecture,r]));const nf=new Intl.NumberFormat('ja-JP',{maximumFractionDigits:2});const metric=document.getElementById('metric'),pref=document.getElementById('pref'),compare=document.getElementById('compare');const rankChart=echarts.init(document.getElementById('ranking')),industryChart=echarts.init(document.getElementById('industry-chart'));
function value(r,k){const d=defs[k];if(d.share){const x=(r.industries||[]).find(i=>i.key===d.industry);return x?.employeeShare??null}return r[d.field]??null}
function render(){const k=metric.value,d=defs[k],rows=records.map(r=>({name:r.prefecture,value:value(r,k)})).filter(x=>Number.isFinite(x.value)).sort((a,b)=>b.value-a.value).slice(0,20);document.getElementById('rank-title').textContent=d.label+' 都道府県ランキング';document.getElementById('rank-sub').textContent=data.year+'年 / 上位20都道府県';rankChart.setOption({animationDuration:300,tooltip:{trigger:'item',formatter:p=>p.name+'<br><b>'+nf.format(p.value)+(d.unit||'')+'</b>'},grid:{left:86,right:92,top:12,bottom:20},xAxis:{type:'value',show:false},yAxis:{type:'category',inverse:true,data:rows.map(x=>x.name),axisTick:{show:false},axisLine:{show:false},axisLabel:{fontSize:11,color:'#475467'}},series:[{type:'bar',barWidth:12,data:rows.map(x=>x.value),itemStyle:{borderRadius:[0,7,7,0]},label:{show:true,position:'right',fontSize:10,fontWeight:700,formatter:p=>nf.format(p.value)+(d.unit||'')}}]},true);renderIndustry()}
function renderIndustry(){const a=byName.get(pref.value),b=compare.value?byName.get(compare.value):null,industries=a.industries||[];document.getElementById('industry-title').textContent=b?a.prefecture+' × '+b.prefecture:a.prefecture+'の産業構造';document.getElementById('industry-sub').textContent='主要7産業の従業者数。棒の末尾に全民営従業者に占める比率を表示';const series=[{name:'A · '+a.prefecture,type:'bar',barWidth:16,itemStyle:{color:'#1769e0',borderRadius:[0,8,8,0]},data:industries.map(x=>({value:x.employees||0,share:x.employeeShare||0})),label:{show:true,position:'right',fontSize:10,fontWeight:700,color:'#344054',formatter:p=>nf.format(p.value)+'人  '+nf.format(p.data.share)+'%'}}];if(b)series.push({name:'B · '+b.prefecture,type:'bar',barWidth:16,itemStyle:{color:'#087f5b',borderRadius:[0,8,8,0]},data:industries.map(x=>{const y=(b.industries||[]).find(i=>i.key===x.key);return{value:y?.employees||0,share:y?.employeeShare||0}}),label:{show:true,position:'right',fontSize:10,fontWeight:700,color:'#344054',formatter:p=>nf.format(p.value)+'人  '+nf.format(p.data.share)+'%'}});industryChart.setOption({animationDuration:350,tooltip:{trigger:'axis',axisPointer:{type:'shadow'},formatter:params=>params.map(p=>p.marker+p.seriesName+'<br><b>'+nf.format(p.value)+'人</b> · '+nf.format(p.data.share)+'%').join('<br>')},legend:{top:0,left:0,itemWidth:10,itemHeight:10,textStyle:{fontSize:10,color:'#667085'}},grid:{left:92,right:118,top:44,bottom:22},xAxis:{type:'value',axisLabel:{fontSize:9,color:'#98a2b3',formatter:v=>v>=10000?nf.format(v/10000)+'万':nf.format(v)},splitLine:{lineStyle:{color:'#eef2f6'}}},yAxis:{type:'category',inverse:true,data:industries.map(x=>x.label),axisTick:{show:false},axisLine:{show:false},axisLabel:{fontSize:11,fontWeight:700,color:'#344054'}},series},true)}
function restore(){const q=new URLSearchParams(location.search);for(const [el,k] of [[metric,'metric'],[pref,'pref'],[compare,'compare']]){const v=q.get(k);if(v&&[...el.options].some(o=>o.value===v))el.value=v}if(!q.get('pref')&&[...pref.options].some(o=>o.value==='東京都'))pref.value='東京都'}
function sync(){const q=new URLSearchParams({metric:metric.value,pref:pref.value});if(compare.value)q.set('compare',compare.value);history.replaceState(null,'','?'+q.toString())}
restore();for(const el of [metric,pref,compare])el.addEventListener('change',()=>{render();sync()});render();window.addEventListener('resize',()=>{rankChart.resize();industryChart.resize()});
</script></body></html>
