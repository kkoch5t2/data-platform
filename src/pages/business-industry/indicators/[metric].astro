---
import fs from 'node:fs';import path from 'node:path';import '../../../styles/detail.css';
const METRICS={establishments:{label:'民営事業所数',unit:'所',field:'establishments'},employees:{label:'民営従業者数',unit:'人',field:'employees'},'employees-per-establishment':{label:'1事業所あたり従業者数',unit:'人',field:'employeesPerEstablishment'},'information-share':{label:'情報通信業 従業者比率',unit:'%',industry:'information'},'manufacturing-share':{label:'製造業 従業者比率',unit:'%',industry:'manufacturing'},'medical-welfare-share':{label:'医療・福祉 従業者比率',unit:'%',industry:'medicalWelfare'},'wholesale-retail-share':{label:'卸売・小売業 従業者比率',unit:'%',industry:'wholesaleRetail'}};
export function getStaticPaths(){const m={establishments:{label:'民営事業所数',unit:'所',field:'establishments'},employees:{label:'民営従業者数',unit:'人',field:'employees'},'employees-per-establishment':{label:'1事業所あたり従業者数',unit:'人',field:'employeesPerEstablishment'},'information-share':{label:'情報通信業 従業者比率',unit:'%',industry:'information'},'manufacturing-share':{label:'製造業 従業者比率',unit:'%',industry:'manufacturing'},'medical-welfare-share':{label:'医療・福祉 従業者比率',unit:'%',industry:'medicalWelfare'},'wholesale-retail-share':{label:'卸売・小売業 従業者比率',unit:'%',industry:'wholesaleRetail'}};return Object.entries(m).map(([metric,def])=>({params:{metric},props:{def}}));}
const {def}=Astro.props;const slug=Astro.params.metric;const data=JSON.parse(fs.readFileSync(path.join(process.cwd(),'public/data/business-industry-2026.json'),'utf8'));const value=r=>def.industry?(r.industries.find(x=>x.key===def.industry)?.employeeShare??null):(r[def.field]??null);const rows=data.records.map(r=>({prefecture:r.prefecture,value:value(r)})).filter(x=>Number.isFinite(x.value)).sort((a,b)=>b.value-a.value);const fmt=v=>new Intl.NumberFormat('ja-JP',{maximumFractionDigits:2}).format(v);const canonical='https://datlume.com/business-industry/indicators/'+slug+'/';const description=def.label+'を47都道府県で比較するランキング。統計センターSSDSE-E-2026をもとにDATLUMEが可視化しています。';
---
<html lang="ja"><head><link rel="icon" type="image/svg+xml" href="/favicon.svg"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="description" content={description}><link rel="canonical" href={canonical}><meta property="og:title" content={def.label+' 都道府県ランキング | DATLUME'}><meta property="og:description" content={description}><meta property="og:type" content="website"><meta name="twitter:card" content="summary"><title>{def.label} 都道府県ランキング | DATLUME</title></head><body>
<header><div class="wrap"><div class="nav"><a class="brand" href="/" aria-label="DATLUME" style="display:inline-flex;align-items:center;gap:10px;text-decoration:none;color:#fff"><img src="/favicon.svg" alt="" width="24" height="24" style="filter:brightness(0) invert(1)"><span style="font-size:19px;font-weight:750;letter-spacing:.16em">DATLUME</span></a><a class="back" href="/business-industry/">企業・産業へ戻る</a></div><div class="hero"><div class="eyebrow">Business / Industry Ranking</div><h1>{def.label}</h1><p>{data.establishmentYear}年の47都道府県ランキング。</p></div></div></header>
<main class="wrap"><section class="card table-card section"><div class="table-head"><h2>47都道府県ランキング</h2><div class="note">出典：統計センター SSDSE-E-2026</div></div><table><thead><tr><th>順位</th><th>都道府県</th><th>{def.label}</th></tr></thead><tbody>{rows.map((r,i)=><tr><td>{i+1}</td><td><a href={'/business-industry/prefectures/'+encodeURIComponent(r.prefecture)+'/' }>{r.prefecture}</a></td><td>{fmt(r.value)}{def.unit}</td></tr>)}</tbody></table></section><div class="links"><a class="linkchip" href="/business-industry/">企業・産業トップ</a><a class="linkchip" href="/business-industry/indicators/establishments/">事業所数</a><a class="linkchip" href="/business-industry/indicators/employees/">従業者数</a><a class="linkchip" href="/business-industry/indicators/information-share/">情報通信業比率</a></div></main>
<footer class="wrap">出典：統計センター SSDSE-E-2026 · <a href="https://github.com/kkoch5t2/data-platform" target="_blank" rel="noreferrer" style="display:inline-flex;align-items:center;gap:5px"><img src="/brand/github.svg" alt="" width="14" height="14">GitHub ↗</a> · <a href="https://utility-tools-jp.com/" target="_blank" rel="noreferrer" style="display:inline-flex;align-items:center;gap:5px"><img src="/brand/utility-tools.ico" alt="" width="14" height="14" style="border-radius:3px">無料WEB便利ツール集 ↗</a> · <a href="/privacy/">プライバシーポリシー</a></footer></body></html>
