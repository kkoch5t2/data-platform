---
import records from '../../../data/procurements';
import '../../../styles/detail.css';
export function getStaticPaths(){const slugMap={'生成AI':'generative-ai','クラウド':'cloud','セキュリティ':'security','ネットワーク':'network','システム開発':'system-development','データ':'data','IT機器':'it-hardware'};const tags=[...new Set(records.flatMap(r=>r.tags||[]))];return tags.map(tag=>({params:{tag:slugMap[tag]||encodeURIComponent(tag)},props:{label:tag}}));}
const {label}=Astro.props; const rows=records.filter(r=>r.isIt&&(r.tags||[]).includes(label)); const awards=rows.filter(r=>r.awardAmount); const total=awards.reduce((a,r)=>a+r.awardAmount,0); const oku=(v)=>(v/100000000).toFixed(v>=1000000000?1:2)+'億円';
const agency=new Map();for(const r of rows)agency.set(r.agency,(agency.get(r.agency)||0)+1);const top=[...agency.entries()].sort((a,b)=>b[1]-a[1]).slice(0,8);const max=Math.max(...top.map(([,v])=>v),1);
const metaDescription=`${label}に関連すると判定された公共IT案件を、件数・発注機関・確認済み落札額から見られるデータページです。`;const tagSlug=Astro.params.tag;const yearCounts=new Map();for(const r of rows){const y=(r.noticeDate||'').slice(0,4);if(y)yearCounts.set(y,(yearCounts.get(y)||0)+1)}const years=[...yearCounts].filter(([,count])=>count>=10).sort((a,b)=>b[0].localeCompare(a[0]));const canonical=`https://datlume.pages.dev/procurement/technologies/${tagSlug}/`;
---
<html lang="ja"><head><link rel="icon" type="image/svg+xml" href="/favicon.svg"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="description" content={metaDescription}><link rel="canonical" href={canonical}><meta property="og:description" content={metaDescription}><meta property="og:type" content="website"><meta name="twitter:card" content="summary"><title>{label} 公共調達データ | DATLUME</title></head><body><header><div class="wrap"><div class="nav"><a class="brand" href="/" aria-label="DATLUME" style="display:inline-flex;align-items:center;gap:10px;text-decoration:none;color:#fff"><img src="/favicon.svg" alt="" width="24" height="24" style="display:block;width:24px;height:24px;filter:brightness(0) invert(1)"><span style="font-family:'Segoe UI Variable','Avenir Next','Helvetica Neue',system-ui,sans-serif;font-size:19px;font-weight:750;letter-spacing:.16em;line-height:1">DATLUME</span></a><a class="back" href="/procurement/technologies/">技術カテゴリ一覧</a></div><div class="hero"><div class="eyebrow">Technology / Category</div><h1>{label}</h1><p>{label}に関連すると判定された公共IT案件。</p></div></div></header><main class="wrap"><div class="stats"><div class="card"><div class="label">案件数</div><div class="value">{rows.length}</div></div><div class="card"><div class="label">確認済み落札総額</div><div class="value">{total?oku(total):'—'}</div></div><div class="card"><div class="label">金額確認済み</div><div class="value">{awards.length}</div></div></div>{years.length>0&&<section class="card section"><h2>年別に見る</h2><div class="links">{years.map(([year,count])=><a class="linkchip" href={`/procurement/years/${year}/technologies/${tagSlug}/`}>{year}年 ({count}件)</a>)}</div></section>}<section class="card section"><h2>発注機関</h2>{top.map(([name,val])=><div class="barrow"><div>{name}</div><div class="track"><div class="bar" style={`width:${val/max*100}%`}></div></div><div class="amount">{val}件</div></div>)}</section><section class="card table-card section"><div class="table-head"><h2>案件一覧</h2></div><div style="overflow-x:auto"><table><thead><tr><th>日付</th><th>発注機関</th><th>案件</th><th>金額</th></tr></thead><tbody>{rows.slice(0,120).map(r=><tr><td>{r.noticeDate}</td><td>{r.agency}</td><td class="title"><a href={r.sourceUrl}>{r.title}</a></td><td>{r.awardAmount?new Intl.NumberFormat('ja-JP').format(r.awardAmount)+'円':'—'}</td></tr>)}</tbody></table></div></section></main><footer class="wrap">出典：JETRO 政府公共調達データベース / 調達ポータル（GEPS） ・ <a href="/about-data/#procurement">収録範囲と集計上の注意</a> · <a href="https://github.com/kkoch5t2/data-platform" target="_blank" rel="noreferrer">GitHub ↗</a></footer></body></html>
