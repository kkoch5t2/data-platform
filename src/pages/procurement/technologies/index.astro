---
import records from '../../../data/procurements'; import '../../../styles/detail.css';
const slugMap={'生成AI':'generative-ai','クラウド':'cloud','セキュリティ':'security','ネットワーク':'network','システム開発':'system-development','データ':'data','IT機器':'it-hardware'};const tags=[...new Set(records.flatMap(r=>r.tags||[]))].map(name=>{const rs=records.filter(r=>r.isIt&&(r.tags||[]).includes(name));return{name,slug:slugMap[name]||encodeURIComponent(name),count:rs.length,total:rs.reduce((a,r)=>a+(r.awardAmount||0),0)}}).sort((a,b)=>b.count-a.count);const oku=(v)=>(v/100000000).toFixed(v>=1000000000?1:2)+'億円';
---
<html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="description" content="クラウド、セキュリティ、ネットワーク、システム開発など、公共IT案件を技術カテゴリ別に集計しています。"><meta property="og:title" content="技術カテゴリ | DATA"><meta property="og:description" content="クラウド、セキュリティ、ネットワーク、システム開発など、公共IT案件を技術カテゴリ別に集計しています。"><meta property="og:type" content="website"><meta name="twitter:card" content="summary"><title>技術カテゴリ | DATA</title></head><body><header><div class="wrap"><div class="nav"><a class="brand" href="/">DATA</a></div><div class="hero"><div class="eyebrow">Technology</div><h1>技術・案件カテゴリ</h1><p>公共IT案件を技術キーワードから分類。</p></div></div></header><main class="wrap"><section class="card table-card"><table><thead><tr><th>カテゴリ</th><th>案件数</th><th>確認済み落札額</th></tr></thead><tbody>{tags.map(t=><tr><td class="title"><a href={`/procurement/technologies/${t.slug}/`}>{t.name}</a></td><td>{t.count}</td><td>{t.total?oku(t.total):'—'}</td></tr>)}</tbody></table></section></main><footer class="wrap">分類はルールベース。出典：JETRO ・ <a href="/about-data/#procurement">収録範囲と集計上の注意</a></footer></body></html>
