---
import records from '../../../data/procurements'; import '../../../styles/detail.css';
const slugMap={'生成AI':'generative-ai','クラウド':'cloud','セキュリティ':'security','ネットワーク':'network','システム開発':'system-development','データ':'data','IT機器':'it-hardware'};const tags=[...new Set(records.flatMap(r=>r.tags||[]))].map(name=>{const rs=records.filter(r=>r.isIt&&(r.tags||[]).includes(name));return{name,slug:slugMap[name]||encodeURIComponent(name),count:rs.length,total:rs.reduce((a,r)=>a+(r.awardAmount||0),0)}}).sort((a,b)=>b.count-a.count);const oku=(v)=>(v/100000000).toFixed(v>=1000000000?1:2)+'億円';
---
<html lang="ja"><head><link rel="icon" type="image/svg+xml" href="/favicon.svg"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><link rel="canonical" href="https://datlume.com/procurement/technologies/"><meta name="description" content="クラウド、セキュリティ、ネットワーク、システム開発など、公共IT案件を技術カテゴリ別に集計しています。"><meta property="og:title" content="技術カテゴリ | DATLUME"><meta property="og:description" content="クラウド、セキュリティ、ネットワーク、システム開発など、公共IT案件を技術カテゴリ別に集計しています。"><meta property="og:type" content="website"><meta name="twitter:card" content="summary"><title>技術カテゴリ | DATLUME</title></head><body><header><div class="wrap"><div class="nav"><a class="brand" href="/" aria-label="DATLUME" style="display:inline-flex;align-items:center;gap:10px;text-decoration:none;color:#fff"><img src="/favicon.svg" alt="" width="24" height="24" style="display:block;width:24px;height:24px;filter:brightness(0) invert(1)"><span style="font-family:'Segoe UI Variable','Avenir Next','Helvetica Neue',system-ui,sans-serif;font-size:19px;font-weight:750;letter-spacing:.16em;line-height:1">DATLUME</span></a></div><div class="hero"><div class="eyebrow">Technology</div><h1>技術・案件カテゴリ</h1><p>公共IT案件を技術キーワードから分類。</p></div></div></header><main class="wrap"><section class="card table-card"><table><thead><tr><th>カテゴリ</th><th>案件数</th><th>確認済み落札額</th></tr></thead><tbody>{tags.map(t=><tr><td class="title"><a href={`/procurement/technologies/${t.slug}/`}>{t.name}</a></td><td>{t.count}</td><td>{t.total?oku(t.total):'—'}</td></tr>)}</tbody></table></section></main><footer class="wrap">分類はルールベース。出典：JETRO ・ <a href="/about-data/#procurement">収録範囲と集計上の注意</a> · <a href="https://github.com/kkoch5t2/data-platform" target="_blank" rel="noreferrer" style="display:inline-flex;align-items:center;gap:5px"><img src="/brand/github.svg" alt="" width="14" height="14" style="display:block;width:14px;height:14px">GitHub ↗</a> · <a href="https://utility-tools-jp.com/" target="_blank" rel="noreferrer" style="display:inline-flex;align-items:center;gap:5px"><img src="/brand/utility-tools.ico" alt="" width="14" height="14" style="display:block;width:14px;height:14px;border-radius:3px">無料WEB便利ツール集 ↗</a></footer></body></html>
