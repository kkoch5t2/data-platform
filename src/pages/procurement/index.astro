const categoryGroupOf=category=>CATEGORY_GROUP_BY_DETAIL.get(category||'その他')||'手続・その他';
const chartPalette=['#2563EB','#16A34A','#D97706','#7C3AED','#0891B2','#EA580C','#4F46E5','#DC2626','#0F766E','#DB2777','#9333EA','#65A30D'];
const stableColor=name=>{if(categoryColors[name])return categoryColors[name];let h=2166136261;for(const ch of String(name||'')){h^=ch.charCodeAt(0);h=Math.imul(h,16777619)}return chartPalette[Math.abs(h) % chartPalette.length]};

function date8(v){return v&&v.length===8?v.slice(0,4)+'-'+v.slice(4,6)+'-'+v.slice(6,8):''}
function decodeDashboard(data){
  if(Array.isArray(data))return data;
  if(!data||data.v!==1||!Array.isArray(data.r))throw new Error('unsupported dashboard data');
  return data.r.map(r=>{
    const parts=String(r[0]||'').split(':');
    const mask=Number(r[5]||0);
    const sourceKind=Number(r[11]||0);
    return {
      title:r[1]||'', noticeDate:date8(String(r[2]||'')),
      agency:data.a[r[3]]||'', category:data.c[r[4]]||'その他',
      tags:(data.t||[]).filter((_,i)=>(mask&(1<<i))!==0),
      awardDate:date8(String(r[6]||'')), contractMethod:data.m[r[7]]||'',
