---
import summary from '../../data/summary';
const amountCoverage = summary.records ? (summary.awardRecords / summary.records * 100) : 0;
const updatedAt = summary.generatedAt ? new Intl.DateTimeFormat('ja-JP',{timeZone:'Asia/Tokyo',year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit'}).format(new Date(summary.generatedAt)) : '—';
---
<!doctype html>
<html lang="ja">
<head><link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <link rel="canonical" href="https://datlume.com/procurement/"><meta name="description" content="日本の公共調達を、分野・企業・発注機関・年度・落札額から横断的に可視化するデータページ。" />
  <title>国・自治体の案件データ | DATLUME</title>
  <style is:global>
    :root{color-scheme:light;--ink:#142033;--muted:#667085;--line:#e5e9f0;--bg:#f4f6f9;--card:#fff;--nav:#0e1b2e;--blue:#1769e0}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Noto Sans JP",sans-serif}a{color:inherit}.wrap{width:min(1320px,calc(100% - 32px));margin:auto}
    header{background:var(--nav);color:#fff;padding:20px 0 50px}.nav{display:flex;justify-content:space-between;gap:18px;align-items:center}.brand{font-weight:850;letter-spacing:.06em;text-decoration:none}.navlinks{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end;margin-left:auto}.navlinks a{font-size:12px;color:#d9e4f4;border:1px solid #ffffff2a;border-radius:999px;padding:7px 11px;text-decoration:none}.hero{margin-top:38px}.hero h1{font-size:clamp(34px,4.2vw,58px);line-height:1.05;letter-spacing:-.045em;margin:0 0 16px}.hero p{margin:0;color:#c7d3e4;font-size:16px;line-height:1.8;max-width:880px}
    main.wrap{margin-top:18px;padding-bottom:64px}.card{background:var(--card);border:1px solid var(--line);border-radius:16px}.filter-panel{overflow:hidden}.filter-panel-head{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:15px 18px;border-bottom:1px solid var(--line)}.filter-panel-title{font-size:14px;font-weight:800}.filter-panel-sub{margin-top:2px;color:var(--muted);font-size:11px}.filter-toggle{border:1px solid #d6dce6;background:#fff;border-radius:9px;height:36px;padding:0 11px;font:inherit;font-size:11px;font-weight:750;cursor:pointer}.filters{padding:16px 18px 17px;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;align-items:end}.filters[hidden]{display:none}.filter{min-width:0}.filter-wide{grid-column:span 2}.filter label{display:block;font-size:11px;font-weight:700;color:var(--muted);margin:0 0 6px}.filter select,.filter input{width:100%;height:40px;border:1px solid #d9dee7;border-radius:9px;background:#fff;color:var(--ink);padding:0 10px;font:inherit;font-size:13px;outline:none}.filter select:focus,.filter input:focus{border-color:#8cb7f4;box-shadow:0 0 0 3px #1769e015}.advanced-filters{grid-column:1/-1;border-top:1px solid #eef1f5;padding-top:10px}.advanced-filters summary{cursor:pointer;list-style:none;font-size:11px;font-weight:800;color:var(--blue);width:max-content}.advanced-filters summary::-webkit-details-marker{display:none}.advanced-filters summary::after{content:' ＋'}.advanced-filters[open] summary::after{content:' −'}.advanced-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px;margin-top:12px}.btn{height:36px;padding:0 12px;border:1px solid #d6dce6;background:#fff;border-radius:9px;font-weight:700;font-size:11px;cursor:pointer}.btn:hover{background:#f7f9fc}.filter-status{grid-column:1/-1;display:flex;justify-content:flex-start;gap:10px;align-items:center;border-top:1px solid #eef1f5;padding-top:12px;color:var(--muted);font-size:12px}.filter-status .btn{margin-left:auto}.active-filters{display:flex;gap:6px;flex-wrap:wrap;min-width:0}.chip{background:#eef5ff;color:#185fb9;border-radius:999px;padding:5px 9px}
    .kpis{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-top:12px}.kpi{padding:18px;min-width:0}.kpi-label{font-size:12px;color:var(--muted)}.kpi-value{font-size:clamp(22px,2.6vw,32px);font-weight:800;letter-spacing:-.03em;margin-top:7px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.kpi-sub{font-size:11px;color:var(--muted);margin-top:5px;line-height:1.4}
    .yoy-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px}.yoy-card{padding:16px 18px;display:flex;align-items:center;justify-content:space-between;gap:16px}.yoy-label{font-size:11px;color:var(--muted)}.yoy-value{font-size:24px;font-weight:820;letter-spacing:-.03em;margin-top:4px}.yoy-value.up{color:#067647}.yoy-value.down{color:#b42318}.yoy-meta{text-align:right;font-size:11px;color:var(--muted);line-height:1.55}.filter-actions{margin-left:auto;display:flex;gap:8px}.share-feedback{font-size:11px;color:#067647;font-weight:700}
    .quality-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:12px}.quality-item{padding:14px 16px}.quality-label{font-size:10px;font-weight:750;color:var(--muted);letter-spacing:.04em;text-transform:uppercase}.quality-value{font-size:16px;font-weight:800;margin-top:5px;letter-spacing:-.02em}.quality-sub{font-size:10.5px;color:var(--muted);margin-top:4px;line-height:1.45}.quality-note{margin-top:10px;padding:12px 14px;border:1px dashed #cfd8e6;border-radius:12px;color:var(--muted);font-size:11px;line-height:1.65}.quality-note strong{color:var(--ink)}
    .section-title{display:flex;justify-content:space-between;gap:12px;align-items:flex-end;margin:28px 2px 10px}.section-title h2{font-size:19px;margin:0}.section-title p{margin:0;color:var(--muted);font-size:12px}.section-title-actions{display:flex;align-items:center;justify-content:flex-end;gap:10px;flex-wrap:wrap}.graph-clear{height:32px;padding:0 10px;border:1px solid #cfd8e6;background:#fff;color:var(--ink);border-radius:9px;font:inherit;font-size:11px;font-weight:750;cursor:pointer;white-space:nowrap}.graph-clear:hover{background:#f7f9fc}.graph-clear[hidden]{display:none}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.chart-card{padding:18px;min-width:0;overflow:hidden}.card-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;margin-bottom:8px}.card-head h3{font-size:15px;margin:0}.card-head span{font-size:11px;color:var(--muted);text-align:right}.chart{height:330px;width:100%;min-width:0}.chart.tall{height:390px}.chart.small{height:300px}
    .data-note{margin:10px 2px 0;color:var(--muted);font-size:11px;line-height:1.65}.data-note a{color:var(--blue);font-weight:750;text-decoration:none}.data-note a:hover{text-decoration:underline}
    .view-tabs{display:flex;gap:8px;overflow-x:auto;margin:18px 0 4px;padding:2px 1px 6px;scrollbar-width:none;-webkit-overflow-scrolling:touch}.view-tabs::-webkit-scrollbar{display:none}.view-tab{flex:0 0 auto;border:1px solid #d9dee7;background:#fff;color:var(--muted);border-radius:999px;padding:9px 14px;font:inherit;font-size:12px;font-weight:750;cursor:pointer;white-space:nowrap}.view-tab[aria-selected="true"]{background:var(--ink);border-color:var(--ink);color:#fff}.view-tab:focus-visible{outline:3px solid #1769e026;outline-offset:2px}
    .drill-card{grid-column:1/-1;margin-top:0;padding:14px 16px;display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:10px 14px}.drill-card[hidden]{display:none}.drill-copy{min-width:0}.drill-kicker{font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--blue);margin-bottom:3px}.drill-title{font-size:14px;font-weight:800;overflow-wrap:anywhere}.drill-meta{margin-top:3px;color:var(--muted);font-size:11px}.drill-actions{display:flex;gap:8px;flex:0 0 auto}.drill-actions button{height:36px;border-radius:9px;border:1px solid #d6dce6;background:#fff;padding:0 11px;font:inherit;font-size:11px;font-weight:750;cursor:pointer}.drill-actions .primary{background:var(--blue);border-color:var(--blue);color:#fff}.drill-cases{grid-column:1/-1;width:100%;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:10px}.drill-case{min-width:0;border:1px solid #e7ebf1;border-radius:10px;padding:10px 11px;background:#fbfcfe}.drill-case a{display:block;font-size:12px;font-weight:750;line-height:1.45;text-decoration:none;overflow-wrap:anywhere}.drill-case a:hover{text-decoration:underline}.drill-case-meta{font-size:10px;color:var(--muted);margin-top:5px;line-height:1.45}.drill-case-money{font-weight:750;color:var(--ink)}
    .table-card{overflow:hidden}.table-head{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:17px 18px;border-bottom:1px solid var(--line)}.table-head h3{font-size:15px;margin:0}.table-head span{font-size:11px;color:var(--muted)}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;min-width:940px}th,td{padding:12px 14px;border-bottom:1px solid #eef1f5;text-align:left;vertical-align:top;font-size:12px}th{font-size:10px;letter-spacing:.05em;text-transform:uppercase;color:var(--muted);background:#fbfcfd}.money{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}.title-link{font-weight:650;text-decoration:none}.title-link:hover{text-decoration:underline}.badge{display:inline-block;border:1px solid #dce4ef;border-radius:999px;padding:3px 7px;background:#f8fafc;white-space:nowrap}.empty{padding:40px;text-align:center;color:var(--muted)}
    footer{padding:26px 0 50px;color:var(--muted);font-size:11px;line-height:1.7}
    @media(max-width:1100px){.filters{grid-template-columns:repeat(3,1fr)}.filter-wide{grid-column:span 1}.advanced-grid{grid-template-columns:repeat(2,1fr)}.kpis{grid-template-columns:repeat(3,1fr)}.grid3{grid-template-columns:1fr 1fr}}
    @media(max-width:780px){
      .wrap{width:min(100% - 28px,1320px)}
      header{padding:18px 0 34px}
      .nav{display:block}
      .brand{display:block;font-size:17px;margin-bottom:16px}
      .navlinks{display:flex;width:calc(100% + 14px);margin-right:-14px;margin-left:0;gap:7px;flex-wrap:nowrap;justify-content:flex-start;overflow-x:auto;padding:0 14px 3px 0;scrollbar-width:none;-webkit-overflow-scrolling:touch}
      .navlinks::-webkit-scrollbar{display:none}
      .navlinks a{flex:0 0 auto;white-space:nowrap;padding:7px 12px;font-size:12px;background:#ffffff08}
      .hero{margin-top:32px}
      .hero h1{font-size:36px;line-height:1.12;letter-spacing:-.04em;margin-bottom:14px}
      .hero p{font-size:14px;line-height:1.8;max-width:none}
      main.wrap{margin-top:18px;padding-bottom:48px}
      .card{border-radius:14px}
      .filter-panel-head{padding:13px 14px}.filter-panel-title{font-size:13px}.filter-panel-sub{font-size:10px}.filter-toggle{height:34px}
      .filters{grid-template-columns:1fr;gap:13px;padding:14px}
      .filters .filter{grid-column:1/-1!important}
      .advanced-grid{grid-template-columns:1fr;gap:11px}
      .filter label{font-size:12px;margin-bottom:7px}
      .filter select,.filter input{height:46px;border-radius:11px;font-size:14px;padding:0 12px}
      .btn{width:100%;height:42px;border-radius:11px}
      .filter-status{align-items:flex-start;flex-direction:column;padding-top:14px}.filter-status .btn{margin-left:0}
      .kpis{grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}
      .yoy-grid{grid-template-columns:1fr}.yoy-card{align-items:flex-start}.yoy-meta{text-align:left}.filter-actions{width:100%;margin-left:0}.filter-actions .btn{flex:1;width:auto}
      .quality-grid{grid-template-columns:1fr 1fr}.quality-item{padding:13px}
      .kpi{padding:15px}
      .grid2,.grid3{grid-template-columns:1fr}
      .section-title{align-items:flex-start;flex-direction:column;gap:6px;margin-top:24px}.section-title-actions{width:100%;justify-content:space-between;gap:8px}.graph-clear{height:34px;flex:0 0 auto}
      .chart{height:300px}
      .chart-card{padding:15px}
      .data-note{margin-top:8px;font-size:10.5px}
      .view-tabs{position:sticky;top:0;z-index:5;background:var(--bg);margin:14px -2px 2px;padding:8px 2px 8px}
      .drill-card{grid-template-columns:1fr;align-items:flex-start;padding:13px 14px}
      .drill-actions{width:100%}.drill-actions button{flex:1;height:40px}
      .drill-cases{grid-column:1;grid-template-columns:1fr}
    }
    @media(max-width:480px){
      .wrap{width:min(100% - 24px,1320px)}
      header{padding-top:16px;padding-bottom:30px}
      .brand{font-size:16px;margin-bottom:14px}
      .navlinks{width:calc(100% + 12px);margin-right:-12px;padding-right:12px}
      .hero{margin-top:27px}
      .hero h1{font-size:32px;line-height:1.14;margin-bottom:13px}
      .hero p{font-size:13.5px;line-height:1.78}
      main.wrap{margin-top:18px}
      .filters{padding:14px;gap:12px}
      .kpis{grid-template-columns:1fr 1fr}
      .quality-grid{grid-template-columns:1fr}
      .kpi{padding:13px}
      .kpi-label{font-size:11px}
      .kpi-value{font-size:21px}
      .kpi-sub{font-size:10px}
      .chart{height:280px}
      .chart-card{padding:14px}
    }

.navlinks,.tabs,.view-tabs{scrollbar-width:none;-ms-overflow-style:none}.navlinks::-webkit-scrollbar,.tabs::-webkit-scrollbar,.view-tabs::-webkit-scrollbar{display:none}
</style>
</head>
<body>
<header><div class="wrap"><div class="nav"><a class="brand" href="/" aria-label="DATLUME" style="display:inline-flex;align-items:center;gap:10px;text-decoration:none;color:#fff"><img src="/favicon.svg" alt="" width="24" height="24" style="display:block;width:24px;height:24px;filter:brightness(0) invert(1)"><span style="font-family:'Segoe UI Variable','Avenir Next','Helvetica Neue',system-ui,sans-serif;font-size:19px;font-weight:750;letter-spacing:.16em;line-height:1">DATLUME</span></a><div class="navlinks"><a href="/procurement/markets/">分野</a><a href="/procurement/companies/">企業</a><a href="/procurement/organizations/">発注機関</a><a href="/procurement/technologies/">IT技術</a><a href="/procurement/years/">年別</a><a href="/realestate/">不動産・暮らし</a><a href="/employment-economy/">雇用・賃金</a><a href="/business-industry/">企業・産業</a><a href="/listed-companies/">上場企業</a><a href="/about-data/#procurement">データについて</a><a href="https://github.com/kkoch5t2/data-platform" target="_blank" rel="noreferrer">GitHub ↗</a></div></div><div class="hero"><h1>国・自治体の案件を、データで見渡す。</h1><p>国・独立行政法人に加え、都道府県・政令指定都市・地方独立行政法人などの公開調達を横断分析。IT、建設、医療、調査、教育、施設管理などの分野から市場を見渡せます。</p></div></div></header>
<main class="wrap">
  <section class="card filter-panel" aria-label="ダッシュボードフィルター">
    <div class="filter-panel-head">
      <div><div class="filter-panel-title">条件を絞る</div><div class="filter-panel-sub">グラフ・KPI・案件一覧がすべて連動します</div></div>
      <button id="filter-toggle" class="filter-toggle" type="button" aria-expanded="true">条件を閉じる</button>
    </div>
    <div id="filter-body" class="filters">
      <div class="filter"><label for="f-year">年</label><select id="f-year"><option value="">全期間（読み込み多め）</option></select></div>
      <div class="filter"><label for="f-scope">対象区分</label><select id="f-scope"><option value="">すべて</option><option value="national">国・独法</option><option value="local">地方政府系</option></select></div>
      <div class="filter"><label for="f-category">分野（細分類）</label><select id="f-category"><option value="">すべて</option></select></div>
      <div class="filter"><label for="f-agency">発注機関</label><select id="f-agency"><option value="">すべて</option></select></div>
      <div class="filter filter-wide"><label for="f-query">案件名キーワード</label><input id="f-query" type="search" placeholder="例: 医療、工事、クラウド、調査" /></div>

      <details class="advanced-filters">
        <summary>詳細条件</summary>
        <div class="advanced-grid">
          <div class="filter"><label for="f-source">データソース</label><select id="f-source"><option value="">すべて</option><option value="jetro">JETRO</option><option value="geps">調達ポータル</option><option value="yokohama">横浜市（直取得）</option></select></div>
          <div class="filter"><label for="f-tag">IT技術カテゴリ</label><select id="f-tag"><option value="">すべて</option></select></div>
          <div class="filter"><label for="f-method">契約方式</label><select id="f-method"><option value="">すべて</option></select></div>
          <div class="filter"><label for="f-company">受注企業</label><select id="f-company"><option value="">すべて</option></select></div>
          <div class="filter"><label for="f-amount">落札金額</label><select id="f-amount"><option value="">すべて</option><option value="0-10000000">1,000万円未満</option><option value="10000000-50000000">1,000万〜5,000万円</option><option value="50000000-100000000">5,000万〜1億円</option><option value="100000000-500000000">1億〜5億円</option><option value="500000000-1000000000">5億〜10億円</option><option value="1000000000-">10億円以上</option></select></div>
        </div>
      </details>

      <div class="filter-status"><div><strong id="result-count">—</strong> 件を表示</div><div id="active-filters" class="active-filters"></div><span id="share-feedback" class="share-feedback" aria-live="polite"></span><div class="filter-actions"><button id="share" class="btn" type="button">条件URLをコピー</button><button id="reset" class="btn" type="button">条件をリセット</button></div></div>
    </div>
  </section>

  <section class="kpis" aria-label="主要指標">
    <div class="card kpi"><div class="kpi-label">収録レコード</div><div id="kpi-count" class="kpi-value">—</div><div class="kpi-sub">フィルター後の件数</div></div>
    <div class="card kpi"><div class="kpi-label">確認済み落札総額</div><div id="kpi-total" class="kpi-value">—</div><div id="kpi-awards" class="kpi-sub">—</div></div>
    <div class="card kpi"><div class="kpi-label">平均落札額</div><div id="kpi-avg" class="kpi-value">—</div><div class="kpi-sub">金額確認済み案件のみ</div></div>
    <div class="card kpi"><div class="kpi-label">受注企業</div><div id="kpi-companies" class="kpi-value">—</div><div class="kpi-sub">確認済みユニーク企業数</div></div>
    <div class="card kpi"><div class="kpi-label">発注機関</div><div id="kpi-agencies" class="kpi-value">—</div><div class="kpi-sub">ユニーク機関数</div></div>
  </section>
  <section class="yoy-grid" aria-label="前年同期比較">
    <div class="card yoy-card"><div><div class="yoy-label">収録件数・前年同期比</div><div id="yoy-count" class="yoy-value">—</div></div><div id="yoy-count-meta" class="yoy-meta">—</div></div>
    <div class="card yoy-card"><div><div class="yoy-label">落札額が分かる案件</div><div id="yoy-amount" class="yoy-value">—</div></div><div id="yoy-amount-meta" class="yoy-meta">—</div></div>
  </section>
  <div class="data-note">前年同期比は、選択中の条件を前年にも適用して比較します。最新年は最新収録日までの同期間比較です。国・独立行政法人系は2014年3月〜2021年3月のGEPS公式落札実績と2021年4月以降のJETRO公開情報を中心に収録。自治体系は各自治体の公式入札・契約結果を直接補完しており、福岡市は1988年、京都市は2005年、千葉市は2012年まで遡ります。分野は自動分類、確認済み落札総額は取得済み案件のみです。 <a href="/about-data/#procurement">データの範囲と注意 →</a></div>
  <section class="quality-grid" aria-label="データ品質">
    <div class="card quality-item"><div class="quality-label">最新案件日</div><div class="quality-value">{summary.lastDate}</div><div class="quality-sub">収録中の案件で最も新しい公告日</div></div>
    <div class="card quality-item"><div class="quality-label">最終データ更新</div><div class="quality-value">{updatedAt}</div><div class="quality-sub">収集・再集計した時刻（日本時間）</div></div>
    <div class="card quality-item"><div class="quality-label">データソース内訳</div><div class="quality-value">JETRO {new Intl.NumberFormat('ja-JP').format(summary.jetroRecords ?? 0)}件</div><div class="quality-sub">GEPS {new Intl.NumberFormat('ja-JP').format(summary.gepsRecords ?? 0)}件 / 横浜 {new Intl.NumberFormat('ja-JP').format(summary.yokohamaRecords ?? 0)} / 札幌 {new Intl.NumberFormat('ja-JP').format(summary.sapporoRecords ?? 0)} / 神戸 {new Intl.NumberFormat('ja-JP').format(summary.kobeRecords ?? 0)} / 福岡 {new Intl.NumberFormat('ja-JP').format(summary.fukuokaRecords ?? 0)} / 千葉 {new Intl.NumberFormat('ja-JP').format(summary.chibaRecords ?? 0)} / 京都 {new Intl.NumberFormat('ja-JP').format(summary.kyotoRecords ?? 0)}</div></div>
    <div class="card quality-item"><div class="quality-label">落札額カバー率</div><div class="quality-value">{amountCoverage.toFixed(1)}%</div><div class="quality-sub">{new Intl.NumberFormat('ja-JP').format(summary.awardRecords)} / {new Intl.NumberFormat('ja-JP').format(summary.records)}件</div></div>
  </section>
