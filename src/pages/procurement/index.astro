            ? 'https://keiyaku.city.yokohama.lg.jp/epco/servlet/p?job=KokokuAnkenList&kokoku_no='+encodeURIComponent(parts[0]||'')
            : (sourceKind===4
              ? 'https://www.city.sapporo.jp/zaisei/keiyaku-kanri/anken/kekka.html'
              : (sourceKind===5
                ? 'https://nyusatsukekka.city.kobe.lg.jp/search'+encodeURIComponent(parts[0]||'k')+'.php'
                : (sourceKind===6
                  ? 'https://keiyaku.city.fukuoka.lg.jp/php/fkks1010.php'
                  : (sourceKind===7
                    ? 'https://www.city.chiba.jp/business/hatchu/nyusatsujoho/kohyo/index.html'
                    : (sourceKind===8
