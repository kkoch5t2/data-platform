function fillSelect(select,values){for(const v of values){const o=document.createElement('option');o.value=v;o.textContent=v;select.appendChild(o)}}
function resetSelect(select){while(select.options.length>1)select.remove(1)}
function initFiltersFromMeta(){
  fillSelect(controls.year,metaData.years||[]);
  fillSelect(controls.category,(metaData.c||[]).filter(Boolean));
  fillSelect(controls.tag,(metaData.t||[]).filter(Boolean));
  fillSelect(controls.method,(metaData.m||[]).filter(Boolean));
}
function rebuildDynamicFilters(){
  const agencyValue=controls.agency.value, companyValue=controls.company.value;
  resetSelect(controls.agency); resetSelect(controls.company);
  fillSelect(controls.agency,sorted(countBy(all,r=>r.agency),999).map(([k])=>k));
  fillSelect(controls.company,sorted(countBy(all,r=>r.winnerName),999).map(([k])=>k));
  if(agencyValue&&[...controls.agency.options].some(o=>o.value===agencyValue))controls.agency.value=agencyValue;
  if(companyValue&&[...controls.company.options].some(o=>o.value===companyValue))controls.company.value=companyValue;
}
function applyUrlState(){const params=new URLSearchParams(location.search);for(const [key,param] of Object.entries(controlParams)){let value=params.get(param);if(value==null)continue;if(key==='year'&&value==='all')value='';const el=controls[key];if(el instanceof HTMLSelectElement){if([...el.options].some(o=>o.value===value))el.value=value}else el.value=value}}
function currentView(){return document.querySelector('.view-tab[aria-selected="true"]')?.dataset.viewTarget||'overview'}
function syncUrl(view=currentView()){const params=new URLSearchParams();for(const [key,param] of Object.entries(controlParams)){const value=controls[key].value.trim();if(key==='year'){params.set(param,value||'all');continue}if(value)params.set(param,value)}const query=params.toString();history.replaceState(null,'',(query?'?'+query:'')+'#'+view)}
async function fetchShard(name){if(shardCache.has(name))return shardCache.get(name);const promise=fetch('/data/'+name).then(r=>{if(!r.ok)throw new Error('shard load failed: '+name);return r.json()});shardCache.set(name,promise);return promise}
function shardNamesForYear(year,includePrevious=false){if(!year)return metaData.shards||[];const needed=new Set([year]);if(includePrevious)needed.add(String(Number(year)-1));const info=Array.isArray(metaData.shardInfo)?metaData.shardInfo:[];if(!info.length)return metaData.shards||[];return info.filter(s=>(s.years||[]).some(y=>needed.has(y))).map(s=>s.name)}
async function loadRowsForYear(year,includePrevious=false,{quiet=false}={}){const seq=++loadSequence;if(!quiet)$('result-count').textContent='読込中…';const names=shardNamesForYear(year,includePrevious);const shards=await Promise.all(names.map(fetchShard));if(seq!==loadSequence)return false;all=decodeDashboard({...metaData,r:shards.flat()});comparisonReady=!year||includePrevious;rebuildDynamicFilters();return true}
async function loadComparisonInBackground(year){if(!year)return;const ok=await loadRowsForYear(year,true,{quiet:true});if(ok)render()}function scheduleComparisonLoad(year){if(!year)return;const run=()=>loadComparisonInBackground(year);if('requestIdleCallback' in window)requestIdleCallback(run,{timeout:4000});else setTimeout(run,1800)}
function amountMatch(r,range){if(!range)return true;const a=r.awardAmount;if(!a)return false;const [lo,hi]=range.split('-');return a>=Number(lo||0)&&(!hi||a<Number(hi))}
function matchesControls(r,{ignoreYear=false}={}){
  const q=controls.query.value.trim().toLowerCase();
  return (ignoreYear||!controls.year.value||(r.noticeDate||'').startsWith(controls.year.value))&&(!controls.scope.value||r.scope===controls.scope.value)&&(!controls.source.value||r.source===controls.source.value)&&(!controls.category.value||(r.category||'その他')===controls.category.value)&&(!controls.agency.value||r.agency===controls.agency.value)&&(!controls.tag.value||(r.tags||[]).includes(controls.tag.value))&&(!controls.method.value||r.contractMethod===controls.method.value)&&(!controls.company.value||r.winnerName===controls.company.value)&&amountMatch(r,controls.amount.value)&&(!q||(r.title||'').toLowerCase().includes(q)||(r.agency||'').toLowerCase().includes(q)||(r.winnerName||'').toLowerCase().includes(q));
}
function baseFiltered(){return all.filter(r=>matchesControls(r))}
function comparisonBase(){return all.filter(r=>matchesControls(r,{ignoreYear:true}))}
function selectionMatch(r,s){if(!s)return true;switch(s.kind){case'monthNotice':return(r.noticeDate||'').startsWith(s.value);case'monthAward':return(r.awardDate||r.noticeDate||'').startsWith(s.value);case'category':return(r.category||'その他')===s.value;case'categoryGroup':return categoryGroupOf(r.category)===s.value;case'company':return r.winnerName===s.value;case'agency':return r.agency===s.value;case'method':return r.contractMethod===s.value;case'awardMethod':return r.awardMethod===s.value;case'amount':return amountMatch(r,s.value);case'tag':return(r.tags||[]).includes(s.value);case'yearCategory':return(r.noticeDate||'').startsWith(s.year)&&(r.category||'その他')===s.category;case'yearCategoryGroup':return(r.noticeDate||'').startsWith(s.year)&&categoryGroupOf(r.category)===s.category;default:return true}}
function filtered(){const rows=baseFiltered();return crossSelection?rows.filter(r=>selectionMatch(r,crossSelection)):rows}
function setKpis(rows){const awards=rows.filter(r=>r.awardAmount);const total=awards.reduce((a,r)=>a+r.awardAmount,0),coverage=rows.length?awards.length/rows.length*100:0;$('kpi-count').textContent=fmtInt(rows.length);$('kpi-total').textContent=awards.length?fmtMoney(total):'—';$('kpi-awards').textContent='金額確認済み '+fmtInt(awards.length)+'件（'+coverage.toFixed(1)+'%）';$('kpi-avg').textContent=awards.length?fmtMoney(total/awards.length):'—';$('kpi-companies').textContent=fmtInt(new Set(rows.map(r=>r.winnerName).filter(Boolean)).size);$('kpi-agencies').textContent=fmtInt(new Set(rows.map(r=>r.agency).filter(Boolean)).size);$('result-count').textContent=fmtInt(rows.length)}
function setDelta(el,value){el.classList.remove('up','down');if(value==null){el.textContent='—';return}el.textContent=(value>0?'+':'')+value.toFixed(1)+'%';if(value>0)el.classList.add('up');if(value<0)el.classList.add('down')}
function setYoy(){
  if(controls.year.value&&!comparisonReady){setDelta($('yoy-count'),null);setDelta($('yoy-amount'),null);$('yoy-count-meta').textContent='前年データを読込中…';$('yoy-amount-meta').textContent='前年データを読込中…';return}
  const base=comparisonBase();
  const years=[...new Set(base.map(r=>(r.noticeDate||'').slice(0,4)).filter(Boolean))].sort();
  if(!years.length){setDelta($('yoy-count'),null);setDelta($('yoy-amount'),null);$('yoy-count-meta').textContent='比較対象なし';$('yoy-amount-meta').textContent='比較対象なし';return}
  const latestYear=years.at(-1);const target=controls.year.value||latestYear;const prev=String(Number(target)-1);
  const targetRows=base.filter(r=>(r.noticeDate||'').startsWith(target));
  let cutoff='12-31';if(target===latestYear&&targetRows.length){const dates=targetRows.map(r=>r.noticeDate).filter(Boolean).sort();cutoff=(dates.at(-1)||target+'-12-31').slice(5,10)}
  const cur=targetRows.filter(r=>(r.noticeDate||'').slice(5,10)<=cutoff);
  const prv=base.filter(r=>(r.noticeDate||'').startsWith(prev)&&(r.noticeDate||'').slice(5,10)<=cutoff);
  const curAward=cur.filter(r=>r.awardAmount),prevAward=prv.filter(r=>r.awardAmount);
  const curCoverage=cur.length?curAward.length/cur.length*100:0,prevCoverage=prv.length?prevAward.length/prv.length*100:0;
  const pct=(a,b)=>b?((a-b)/b*100):null;
  setDelta($('yoy-count'),pct(cur.length,prv.length));
  const amountEl=$('yoy-amount');
  const coverageDiff=curCoverage-prevCoverage;
  amountEl.classList.remove('up','down');
  amountEl.textContent=curCoverage.toFixed(1)+'%';
  if(coverageDiff>0)amountEl.classList.add('up');
  if(coverageDiff<0)amountEl.classList.add('down');
  const period=cutoff==='12-31'?'通年':'〜'+cutoff.replace('-','/');
  $('yoy-count-meta').textContent=target+'年 '+fmtInt(cur.length)+'件 / '+prev+'年 '+fmtInt(prv.length)+'件 / '+period;
  $('yoy-amount-meta').textContent=fmtInt(curAward.length)+'件 / '+fmtInt(cur.length)+'件で金額確認済み（前年 '+prevCoverage.toFixed(1)+'%、'+(coverageDiff>=0?'+':'')+coverageDiff.toFixed(1)+'pt） / '+period;
}
function setActiveChips(){const labels=[['年',controls.year],['対象区分',controls.scope],['データソース',controls.source],['細分類',controls.category],['発注機関',controls.agency],['IT技術',controls.tag],['契約方式',controls.method],['企業',controls.company],['金額',controls.amount],['検索',controls.query]];const box=$('active-filters');box.innerHTML='';if(crossSelection){const span=document.createElement('span');span.className='chip';span.textContent='グラフ選択: '+crossSelection.label;box.appendChild(span)}for(const [label,el] of labels){if(!el.value)continue;const span=document.createElement('span');span.className='chip';span.textContent=label+': '+(el.options?el.options[el.selectedIndex]?.textContent:el.value);box.appendChild(span)}}
function monthRange(start,end){if(!start||!end)return[];const out=[];let [y,m]=start.split('-').map(Number);const [ey,em]=end.split('-').map(Number);while(y<ey||(y===ey&&m<=em)){out.push(String(y).padStart(4,'0')+'-'+String(m).padStart(2,'0'));m++;if(m===13){y++;m=1}}return out}
function timelineMonths(rows,dateFn=(r)=>r.noticeDate){if(!rows.length)return[];const vals=rows.map(dateFn).filter(Boolean).map(v=>v.slice(0,7)).sort();return vals.length?monthRange(vals[0],vals.at(-1)):[]}
function renderMonthly(countRows,amountRows=countRows){if(!countRows.length){charts['chart-month-count'].setOption(emptyOption(),true)}else{const countMonths=timelineMonths(countRows,r=>r.noticeDate);const cm=countBy(countRows,r=>(r.noticeDate||'').slice(0,7));charts['chart-month-count'].setOption({tooltip:baseTooltip,grid:{left:48,right:18,top:18,bottom:45},xAxis:{type:'category',data:countMonths,axisLabel:{...axisText,interval:Math.max(0,Math.ceil(countMonths.length/(window.innerWidth<600?6:10))-1),formatter:v=>window.innerWidth<600?String(v).slice(5)+'月':v},axisLine:{lineStyle:{color:'#dfe4eb'}}},yAxis:{type:'value',min:0,minInterval:1,axisLabel:axisText,splitLine:{lineStyle:{color:'#eef1f5'}}},series:[{type:'line',data:countMonths.map(m=>cm.get(m)||0),smooth:.2,showSymbol:true,symbol:'circle',triggerLineEvent:true,lineStyle:{width:3},emphasis:{focus:'series',scale:1.5},areaStyle:{opacity:.08}}]},true)}if(!amountRows.length){charts['chart-month-amount'].setOption(emptyOption('該当案件なし'),true);return}if(!amountRows.some(r=>r.awardAmount)){charts['chart-month-amount'].setOption(emptyOption('収録データに落札額情報なし'),true);return}const amountMonths=timelineMonths(amountRows,r=>r.awardDate||r.noticeDate);const am=sumBy(amountRows,r=>(r.awardDate||r.noticeDate||'').slice(0,7),r=>r.awardAmount||0);charts['chart-month-amount'].setOption({tooltip:{...baseTooltip,valueFormatter:fmtMoney},grid:{left:60,right:18,top:18,bottom:45},xAxis:{type:'category',data:amountMonths,axisLabel:{...axisText,interval:Math.max(0,Math.ceil(amountMonths.length/(window.innerWidth<600?6:10))-1),formatter:v=>window.innerWidth<600?String(v).slice(5)+'月':v}},yAxis:{type:'value',min:0,axisLabel:{...axisText,formatter:v=>v>=1e8?(v/1e8)+'億':fmtInt(v)},splitLine:{lineStyle:{color:'#eef1f5'}}},series:[{type:'bar',data:amountMonths.map(m=>am.get(m)||0),barMaxWidth:24,itemStyle:{borderRadius:[4,4,0,0]}}]},true)}
function horizontalBar(chart,items,{money=false,emptyText='収録データに該当情報なし'}={}){if(!items.length){chart.setOption(emptyOption(emptyText),true);return}const mobile=window.innerWidth<600;chart.setOption({tooltip:{trigger:'item',formatter:p=>p.name+'<br><strong>'+(money?fmtMoney(p.value):fmtInt(p.value)+'件')+'</strong>'},grid:{left:mobile?105:175,right:money?85:45,top:8,bottom:12},xAxis:{type:'value',show:false},yAxis:{type:'category',inverse:true,data:items.map(x=>x[0]),axisTick:{show:false},axisLine:{show:false},axisLabel:{...axisText,width:mobile?90:155,overflow:'truncate'}},series:[{type:'bar',data:items.map(x=>x[1]),barWidth:12,itemStyle:{borderRadius:8},label:{show:true,position:'right',distance:7,color:'#667085',fontSize:10,formatter:p=>money?fmtMoney(p.value):fmtInt(p.value)}}]},true)}
function pie(chart,map,emptyText='収録データに該当情報なし',limit=12,{plainLegend=false}={}){const data=sorted(map,limit).map(([name,value])=>{const color=stableColor(name);return{name,value,itemStyle:{color},emphasis:{itemStyle:{color}},select:{itemStyle:{color}}}});if(!data.length){chart.setOption(emptyOption(emptyText),true);return}chart.setOption({tooltip:{trigger:'item',formatter:p=>p.name+'<br><strong>'+fmtInt(p.value)+'件</strong> ('+p.percent+'%)'},legend:{bottom:0,left:plainLegend?'center':undefined,type:plainLegend?'plain':'scroll',width:plainLegend?'96%':undefined,textStyle:axisText},series:[{type:'pie',selectedMode:false,radius:['45%','70%'],center:['50%',plainLegend?'39%':'43%'],label:{show:false},emphasis:{label:{show:true,fontSize:12,fontWeight:700}},data}]},true)}
function renderCategory(rows){pie(charts['chart-category'],countBy(rows,r=>categoryGroupOf(r.category)),'収録データに該当情報なし',Infinity,{plainLegend:true});if(!rows.length){charts['chart-year-category'].setOption(emptyOption(),true);return}const years=controls.year.value?[controls.year.value]:[...new Set(rows.map(r=>(r.noticeDate||'').slice(0,4)).filter(Boolean))].sort();const categoryCounts=countBy(rows,r=>categoryGroupOf(r.category));const categories=sorted(categoryCounts,Infinity).map(([k])=>k);const matrix=new Map();for(const r of rows){const y=(r.noticeDate||'').slice(0,4),c=categoryGroupOf(r.category);if(!y)continue;const key=y+'\u0000'+c;matrix.set(key,(matrix.get(key)||0)+1)}const series=categories.map(category=>{const color=stableColor(category);return{name:category,type:'bar',stack:'total',data:years.map(y=>matrix.get(y+'\u0000'+category)||0),itemStyle:{color},emphasis:{focus:'series',itemStyle:{color}},select:{disabled:true,itemStyle:{color}}}});charts['chart-year-category'].setOption({tooltip:{trigger:'axis',axisPointer:{type:'shadow'}},legend:{bottom:0,type:'scroll',textStyle:axisText},grid:{left:48,right:14,top:18,bottom:58},xAxis:{type:'category',data:years,axisLabel:axisText},yAxis:{type:'value',min:0,minInterval:1,axisLabel:axisText,splitLine:{lineStyle:{color:'#eef1f5'}}},series},true)}
function renderRankings(rows){horizontalBar(charts['chart-companies'],sorted(sumBy(rows,r=>r.winnerName,r=>r.awardAmount||0),10),{money:true,emptyText:rows.length?'収録データに受注企業・落札額情報なし':'該当案件なし'});horizontalBar(charts['chart-agencies'],sorted(countBy(rows,r=>r.agency),10),{emptyText:'該当案件なし'})}
function renderMethods(rows){pie(charts['chart-method'],countBy(rows,r=>r.contractMethod),rows.length?'収録データに契約方式情報なし':'該当案件なし');pie(charts['chart-award-method'],countBy(rows,r=>r.awardMethod),rows.length?'収録データに落札方式情報なし':'該当案件なし')}
function renderAmountDist(rows){const awards=rows.filter(r=>r.awardAmount);if(!awards.length){charts['chart-amount-dist'].setOption(emptyOption(rows.length?'収録データに落札額情報なし':'該当案件なし'),true);return}const bands=[['<1,000万',0,1e7],['1,000万〜5,000万',1e7,5e7],['5,000万〜1億',5e7,1e8],['1億〜5億',1e8,5e8],['5億〜10億',5e8,1e9],['10億以上',1e9,Infinity]];const vals=bands.map(([,lo,hi])=>awards.filter(r=>r.awardAmount>=lo&&r.awardAmount<hi).length);charts['chart-amount-dist'].setOption({tooltip:{...baseTooltip,valueFormatter:v=>fmtInt(v)+'件'},grid:{left:45,right:10,top:18,bottom:58},xAxis:{type:'category',data:bands.map(b=>b[0]),axisLabel:{...axisText,rotate:24}},yAxis:{type:'value',axisLabel:axisText,splitLine:{lineStyle:{color:'#eef1f5'}}},series:[{type:'bar',data:vals,barMaxWidth:34,itemStyle:{borderRadius:[5,5,0,0]}}]},true)}
function renderTable(rows){const data=[...rows].sort((a,b)=>String(b.noticeDate||b.awardDate||'').localeCompare(String(a.noticeDate||a.awardDate||''))||(b.awardAmount||0)-(a.awardAmount||0)).slice(0,100);$('table-note').textContent=fmtInt(rows.length)+'件中 '+fmtInt(data.length)+'件';const body=$('top-awards');body.innerHTML='';if(!data.length){body.innerHTML='<tr><td colspan="6" class="empty">該当する案件がありません</td></tr>';return}for(const r of data){const tr=document.createElement('tr');const date=document.createElement('td');date.textContent=r.awardDate||r.noticeDate||'—';const cat=document.createElement('td');const badge=document.createElement('span');badge.className='badge';badge.textContent=r.category||'その他';cat.appendChild(badge);const agency=document.createElement('td');agency.textContent=r.agency||'—';const title=document.createElement('td');const a=document.createElement('a');a.className='title-link';a.target='_blank';a.rel='noreferrer';a.href=r.sourceUrl||'#';a.textContent=r.title||'名称未取得';title.appendChild(a);const winner=document.createElement('td');winner.textContent=r.winnerName||'—';const money=document.createElement('td');money.className='money';money.textContent=r.awardAmount?fmtYen(r.awardAmount):'—';tr.append(date,cat,agency,title,winner,money);body.appendChild(tr)}}
function setView(view){const valid=['overview','trend','players','contract','records'];const next=valid.includes(view)?view:'overview';document.querySelectorAll('[data-view]').forEach(el=>{el.hidden=el.dataset.view!==next});document.querySelectorAll('.view-tab').forEach(btn=>btn.setAttribute('aria-selected',String(btn.dataset.viewTarget===next)));if(crossSelection){const host=document.querySelector('[data-view="'+next+'"]');if(host)host.appendChild($('drill-card'))}syncUrl(next);if(all.length)render();requestAnimationFrame(()=>Object.values(charts).forEach(c=>c.resize()))}
function renderDrillCases(rows){const box=$('drill-cases');box.innerHTML='';const sample=[...rows].sort((a,b)=>(b.awardAmount||0)-(a.awardAmount||0)||String(b.noticeDate||'').localeCompare(String(a.noticeDate||''))).slice(0,6);if(!sample.length){const d=document.createElement('div');d.className='drill-case';d.textContent='該当案件がありません';box.appendChild(d);return}for(const r of sample){const card=document.createElement('div');card.className='drill-case';const a=document.createElement('a');a.href=r.sourceUrl||'#';a.target='_blank';a.rel='noreferrer';a.textContent=r.title||'名称未取得';const meta=document.createElement('div');meta.className='drill-case-meta';const parts=[r.noticeDate||r.awardDate||'',r.agency||'',r.winnerName||''].filter(Boolean);meta.textContent=parts.join(' / ');card.appendChild(a);card.appendChild(meta);if(r.awardAmount){const money=document.createElement('div');money.className='drill-case-meta drill-case-money';money.textContent=fmtMoney(r.awardAmount);card.appendChild(money)}box.appendChild(card)}}
function showDrill(kicker,title,meta,rows){const detailed=rows.filter(r=>r.awardAmount||r.winnerName||r.contractMethod||r.awardMethod).length;$('drill-kicker').textContent=kicker;$('drill-title').textContent=title;$('drill-meta').textContent=(meta?meta+' / ':'')+'該当 '+fmtInt(rows.length)+'件 / 詳細項目あり '+fmtInt(detailed)+'件';renderDrillCases(rows);$('drill-card').hidden=false}
function syncSelectionClearButtons(){document.querySelectorAll('[data-clear-selection]').forEach(btn=>{btn.hidden=!crossSelection})}
function clearCrossSelection(){crossSelection=null;$('drill-card').hidden=true;render()}
function selectSegment(selection,kicker,title,meta){crossSelection=selection;const rows=filtered();render();const card=$('drill-card');const host=document.querySelector('[data-view]:not([hidden])');if(host)host.appendChild(card);showDrill(kicker,title,meta,rows);requestAnimationFrame(()=>card.scrollIntoView({behavior:'smooth',block:'nearest'}))}
function bindChartClicks(){
  charts['chart-month-count'].on('click',p=>selectSegment({kind:'monthNotice',value:p.name,label:p.name},'月別収録件数',p.name,fmtInt(p.value)+'件'));
  charts['chart-month-amount'].on('click',p=>selectSegment({kind:'monthAward',value:p.name,label:p.name},'月別確認済み落札額',p.name,fmtMoney(p.value)));
  charts['chart-category'].on('click',p=>selectSegment({kind:'categoryGroup',value:p.name,label:p.name},'大分類',p.name,fmtInt(p.value)+'件'));
  charts['chart-companies'].on('click',p=>selectSegment({kind:'company',value:p.name,label:p.name},'受注企業',p.name,'確認済み落札額 '+fmtMoney(p.value)));
  charts['chart-agencies'].on('click',p=>selectSegment({kind:'agency',value:p.name,label:p.name},'発注機関',p.name,fmtInt(p.value)+'件'));
  charts['chart-method'].on('click',p=>selectSegment({kind:'method',value:p.name,label:p.name},'契約方式',p.name,fmtInt(p.value)+'件'));
  charts['chart-award-method'].on('click',p=>selectSegment({kind:'awardMethod',value:p.name,label:p.name},'落札方式',p.name,fmtInt(p.value)+'件'));
  charts['chart-amount-dist'].on('click',p=>selectSegment({kind:'amount',value:amountRanges[p.name]||'',label:p.name},'落札金額帯',p.name,fmtInt(p.value)+'件'));
  charts['chart-year-category'].on('click',p=>selectSegment({kind:'yearCategoryGroup',year:p.name,category:p.seriesName,label:p.name+'年 / '+p.seriesName},'年 × 大分類',p.name+'年 / '+p.seriesName,fmtInt(p.value)+'件'));
}

function render(){syncSelectionClearButtons();const rows=filtered();setKpis(rows);setYoy();setActiveChips();const view=currentView();if(view==='overview'||view==='trend'){renderMonthly(rows,rows);renderCategory(rows)}else if(view==='players'){renderRankings(rows)}else if(view==='contract'){renderMethods(rows);renderAmountDist(rows)}else if(view==='records'){renderTable(rows)}}
function setFiltersOpen(open){const body=$('filter-body');const btn=$('filter-toggle');body.hidden=!open;btn.setAttribute('aria-expanded',String(open));btn.textContent=open?'条件を閉じる':'条件を開く'}
$('filter-toggle').addEventListener('click',()=>setFiltersOpen($('filter-body').hidden));
setFiltersOpen(window.innerWidth>=780);
fetch('/data/dashboard-meta.json').then(r=>{if(!r.ok)throw new Error('data load failed');return r.json()}).then(async meta=>{
  if(!Array.isArray(meta.shards))throw new Error('dashboard shards missing');metaData=meta;initFiltersFromMeta();
  const params=new URLSearchParams(location.search);const requestedYear=params.get('year');controls.year.value=requestedYear==='all'?'':((requestedYear&&[...controls.year.options].some(o=>o.value===requestedYear))?requestedYear:(meta.latestYear||''));
  await loadRowsForYear(controls.year.value,false);applyUrlState();bindChartClicks();const initial=(location.hash||'#overview').slice(1);setView(initial);scheduleComparisonLoad(controls.year.value);
  let queryTimer;for(const [key,el] of Object.entries(controls)){if(key==='year'){el.addEventListener('change',async()=>{crossSelection=null;$('drill-card').hidden=true;await loadRowsForYear(el.value,false);render();syncUrl();scheduleComparisonLoad(el.value)});continue}if(el===controls.query){el.addEventListener('input',()=>{clearTimeout(queryTimer);queryTimer=setTimeout(()=>{crossSelection=null;$('drill-card').hidden=true;render();syncUrl()},180)});continue}el.addEventListener('change',()=>{crossSelection=null;$('drill-card').hidden=true;render();syncUrl()})}
  document.querySelectorAll('.view-tab').forEach(btn=>btn.addEventListener('click',()=>setView(btn.dataset.viewTarget)));document.querySelectorAll('[data-clear-selection]').forEach(btn=>btn.addEventListener('click',clearCrossSelection));$('drill-clear').addEventListener('click',clearCrossSelection);$('drill-more').addEventListener('click',()=>{setView('records');document.querySelector('[data-view="records"]')?.scrollIntoView({behavior:'smooth',block:'start'})});$('share').addEventListener('click',async()=>{syncUrl();const feedback=$('share-feedback');try{await navigator.clipboard.writeText(location.href);feedback.textContent='コピーしました'}catch{feedback.textContent='URLをアドレスバーからコピーしてください'}setTimeout(()=>feedback.textContent='',2200)});$('reset').addEventListener('click',async()=>{for(const [key,el] of Object.entries(controls))el.value=key==='year'?(meta.latestYear||''):'';crossSelection=null;$('drill-card').hidden=true;await loadRowsForYear(controls.year.value,false);render();syncUrl();scheduleComparisonLoad(controls.year.value)})
}).catch(err=>{console.error(err);$('result-count').textContent='読み込み失敗';for(const c of Object.values(charts))c.setOption(emptyOption('データを読み込めませんでした'),true)});
let resizeTimer;window.addEventListener('resize',()=>{clearTimeout(resizeTimer);resizeTimer=setTimeout(()=>{Object.values(charts).forEach(c=>c.resize())},120)});
</script>
</body></html>
