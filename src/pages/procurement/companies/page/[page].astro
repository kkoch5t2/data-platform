---
import CompanyRankingPage from '../../../../components/CompanyRankingPage.astro';
import { rankedCompanies, pageSize, pageCount } from '../../../../lib/procurement-company-pages';
export function getStaticPaths() {
  return Array.from({ length: pageCount - 1 }, (_, index) => ({
    params: { page: String(index + 2) },
    props: { page: index + 2 },
  }));
}
const { page } = Astro.props;
---
<CompanyRankingPage rows={rankedCompanies.slice((page - 1) * pageSize, page * pageSize)} total={rankedCompanies.length} page={page} pageCount={pageCount} />
