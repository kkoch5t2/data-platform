---
import records from '../../../data/procurements';
import companies from '../../../data/companies';
import '../../../styles/detail.css';
export function getStaticPaths(){ return companies.map((c) => ({params:{id:c.id},props:{company:c}})); }
const { company } = Astro.props;
const rows = records.filter((r) => r.companyId === company.id && r.awardAmount).sort((a,b)=>(b.awardDate||'').localeCompare(a.awardDate||''));
const agency = new Map(); for(const r of rows) agency.set(r.agency,(agency.get(r.agency)||0)+(r.awardAmount||0));
const topAgency=[...agency.entries()].sort((a,b)=>b[1]-a[1]).slice(0,8); const max=Math.max(...topAgency.map(([,v])=>v),1);
const fmt=(v)=>new Intl.NumberFormat('ja-JP').format(v||0); const oku=(v)=>(v/100000000).toFixed(v>=1000000000?1:2)+'億円';
const metaDescription=`${company.name}の公共調達における落札件数、確認済み受注額、主な案件をまとめたデータページです。`;
const canonical=`https://datlume.com/procurement/companies/${company.id}/`;
---
<html lang="ja"><head><link rel="icon" type="image/svg+xml" href="/favicon.svg"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="description" content={metaDescription}><link rel="canonical" href={canonical}><meta property="og:description" content={metaDescription}><meta property="og:type" content="website"><meta name="twitter:card" content="summary"><title>{company.name} 公共調達データ | DATLUME</title></head><body>
<header><div class="wrap"><div class="nav"><a class="brand" href="/" aria-label="DATLUME" style="display:inline-flex;align-items:center;gap:10px;text-decoration:none;color:#fff"><img src="/favicon.svg" alt="" width="24" height="24" style="display:block;width:24px;height:24px;filter:brightness(0) invert(1)"><span style="font-family:'Segoe UI Variable','Avenir Next','Helvetica Neue',system-ui,sans-serif;font-size:19px;font-weight:750;letter-spacing:.16em;line-height:1">DATLUME</span></a><a class="back" href="/procurement/companies/">企業一覧</a></div><div class="hero"><div class="eyebrow">Vendor</div><h1>{company.name}</h1><p>公開調達情報から集計した分野横断の落札実績。</p></div></div></header>
<main class="wrap"><div class="stats"><div class="card"><div class="label">受注総額</div><div class="value">{oku(company.awardTotal)}</div></div><div class="card"><div class="label">落札件数</div><div class="value">{company.awardCount}</div></div><div class="card"><div class="label">平均受注額</div><div class="value">{rows.length?oku(company.awardTotal/rows.length):'—'}</div></div></div>
<section class="card section"><h2>主な発注機関</h2>{topAgency.map(([name,val])=><div class="barrow"><div>{name}</div><div class="track"><div class="bar" style={`width:${val/max*100}%`}></div></div><div class="amount">{oku(val)}</div></div>)}</section>
<section class="card table-card section"><div class="table-head"><h2>落札案件</h2><div class="note">{rows.length}件</div></div><div style="overflow-x:auto"><table><thead><tr><th>落札日</th><th>発注機関</th><th>案件</th><th>金額</th></tr></thead><tbody>{rows.map(r=><tr><td>{r.awardDate||'—'}</td><td>{r.agency}</td><td class="title"><a href={r.sourceUrl}>{r.title}</a></td><td>{fmt(r.awardAmount)}円</td></tr>)}</tbody></table></div></section></main><footer class="wrap">出典：JETRO 政府公共調達データベース / 調達ポータル（GEPS） ・ <a href="/about-data/#procurement">収録範囲と集計上の注意</a> · <a href="https://github.com/kkoch5t2/data-platform" target="_blank" rel="noreferrer" style="display:inline-flex;align-items:center;gap:5px"><img src="/brand/github.svg" alt="" width="14" height="14" style="display:block;width:14px;height:14px">GitHub ↗</a> · <a href="https://utility-tools-jp.com/" target="_blank" rel="noreferrer" style="display:inline-flex;align-items:center;gap:5px"><img src="/brand/utility-tools.ico" alt="" width="14" height="14" style="display:block;width:14px;height:14px;border-radius:3px">無料WEB便利ツール集 ↗</a></footer></body></html>
