---
import records from '../../../data/procurements';
import organizations from '../../../data/organizations';
import '../../../styles/detail.css';
export function getStaticPaths(){ return organizations.map((o)=>({params:{id:o.id},props:{org:o}})); }
const {org}=Astro.props;
const rows=records.filter((r)=>r.organizationId===org.id);
const awards=rows.filter((r)=>r.awardAmount);
const vendor=new Map(); for(const r of awards){const n=r.winnerName||'不明';vendor.set(n,(vendor.get(n)||0)+r.awardAmount)}
const top=[...vendor.entries()].sort((a,b)=>b[1]-a[1]).slice(0,8); const max=Math.max(...top.map(([,v])=>v),1);
const total=awards.reduce((a,r)=>a+(r.awardAmount||0),0); const oku=(v)=>(v/100000000).toFixed(v>=1000000000?1:2)+'億円';
const metaDescription=`${org.name}の公共調達を、収録件数、確認済み落札額、主な受注企業から見られるデータページです。`;
---
<html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="description" content={metaDescription}><meta property="og:description" content={metaDescription}><meta property="og:type" content="website"><meta name="twitter:card" content="summary"><title>{org.name} 公共調達データ | DATA</title></head><body><header><div class="wrap"><div class="nav"><a class="brand" href="/">DATA</a><a class="back" href="/procurement/organizations/">発注機関一覧</a></div><div class="hero"><div class="eyebrow">Organization</div><h1>{org.name}</h1><p>公共調達の収録件数・落札額・主な受注企業を分野横断で集計。</p></div></div></header>
<main class="wrap"><div class="stats"><div class="card"><div class="label">収録レコード</div><div class="value">{rows.length}</div></div><div class="card"><div class="label">確認済み落札総額</div><div class="value">{total?oku(total):'—'}</div></div><div class="card"><div class="label">金額確認済み</div><div class="value">{awards.length}件</div></div></div>
<section class="card section"><h2>主な受注企業</h2>{top.map(([name,val])=><div class="barrow"><div>{name}</div><div class="track"><div class="bar" style={`width:${val/max*100}%`}></div></div><div class="amount">{oku(val)}</div></div>)}</section>
<section class="card table-card section"><div class="table-head"><h2>案件一覧</h2><div class="note">{rows.length}件</div></div><div style="overflow-x:auto"><table><thead><tr><th>日付</th><th>案件</th><th>落札企業</th><th>金額</th></tr></thead><tbody>{rows.slice(0,100).map(r=><tr><td>{r.noticeDate}</td><td class="title"><a href={r.sourceUrl}>{r.title}</a></td><td>{r.winnerName||'—'}</td><td>{r.awardAmount?new Intl.NumberFormat('ja-JP').format(r.awardAmount)+'円':'—'}</td></tr>)}</tbody></table></div></section></main><footer class="wrap">出典：JETRO 政府公共調達データベース / 調達ポータル（GEPS） ・ <a href="/about-data/#procurement">収録範囲と集計上の注意</a></footer></body></html>
