---
import records from '../../../data/procurements';
import '../../../styles/detail.css';
const slugMap={'IT・デジタル':'it-digital','建設・土木':'construction','医療・福祉':'healthcare','研究・調査・コンサル':'research-consulting','教育・研修':'education','交通・物流':'transport-logistics','施設管理・清掃':'facility-management','広報・広告・制作':'communications','エネルギー・環境':'energy-environment','食品・給食':'food','科学・研究機器':'science-equipment','出版・情報資料':'publishing-information','化学・素材':'chemicals-materials','衣類・装備品':'apparel-equipment','機械・設備':'machinery-equipment','製造・製作':'manufacturing','人材・業務委託':'outsourcing-staffing','一般物品・備品':'goods','その他':'other'};
export function getStaticPaths(){const slugs={'IT・デジタル':'it-digital','建設・土木':'construction','医療・福祉':'healthcare','研究・調査・コンサル':'research-consulting','教育・研修':'education','交通・物流':'transport-logistics','施設管理・清掃':'facility-management','広報・広告・制作':'communications','エネルギー・環境':'energy-environment','食品・給食':'food','科学・研究機器':'science-equipment','出版・情報資料':'publishing-information','化学・素材':'chemicals-materials','衣類・装備品':'apparel-equipment','機械・設備':'machinery-equipment','製造・製作':'manufacturing','人材・業務委託':'outsourcing-staffing','一般物品・備品':'goods','その他':'other'};const cats=[...new Set(records.map(r=>r.category||'その他'))];return cats.map(label=>({params:{category:slugs[label]||encodeURIComponent(label)},props:{label}}));}
const {label}=Astro.props;const rows=records.filter(r=>(r.category||'その他')===label);const awards=rows.filter(r=>r.awardAmount);const total=awards.reduce((a,r)=>a+(r.awardAmount||0),0);const oku=(v)=>(v/100000000).toFixed(v>=1000000000?1:2)+'億円';
const agency=new Map();for(const r of rows)agency.set(r.agency,(agency.get(r.agency)||0)+1);const top=[...agency.entries()].sort((a,b)=>b[1]-a[1]).slice(0,10);const max=Math.max(...top.map(([,v])=>v),1);
const metaDescription=`${label}に分類された公共調達を、発注機関・案件数・確認済み落札額から見られるデータページです。`;const categorySlug=Astro.params.category;const yearCounts=new Map();for(const r of rows){const y=(r.noticeDate||'').slice(0,4);if(y)yearCounts.set(y,(yearCounts.get(y)||0)+1)}const years=[...yearCounts].filter(([,count])=>count>=10).sort((a,b)=>b[0].localeCompare(a[0]));const canonical=`https://datlume.pages.dev/procurement/markets/${categorySlug}/`;
---
<html lang="ja"><head><link rel="icon" type="image/svg+xml" href="/favicon.svg"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="description" content={metaDescription}><link rel="canonical" href={canonical}><meta property="og:description" content={metaDescription}><meta property="og:type" content="website"><meta name="twitter:card" content="summary"><title>{label} 公共調達データ | DATLUME</title></head><body><header><div class="wrap"><div class="nav"><a class="brand" href="/" aria-label="DATLUME" style="display:inline-flex;align-items:center;gap:10px;text-decoration:none;color:#fff"><img src="/favicon.svg" alt="" width="24" height="24" style="display:block;width:24px;height:24px;filter:brightness(0) invert(1)"><span style="font-family:'Segoe UI Variable','Avenir Next','Helvetica Neue',system-ui,sans-serif;font-size:19px;font-weight:750;letter-spacing:.16em;line-height:1">DATLUME</span></a><a class="back" href="/procurement/markets/">分野一覧</a></div><div class="hero"><div class="eyebrow">Market</div><h1>{label}</h1><p>{label}に分類された公共調達を、発注機関・件数・確認済み落札額から見る。</p></div></div></header><main class="wrap"><div class="stats"><div class="card"><div class="label">収録レコード</div><div class="value">{rows.length}</div></div><div class="card"><div class="label">確認済み落札総額</div><div class="value">{total?oku(total):'—'}</div></div><div class="card"><div class="label">金額確認済み</div><div class="value">{awards.length}件</div></div></div><div class="data-note">この分野は<strong>案件名をもとにしたルールベース分類</strong>です。誤分類を含む可能性があります。確認済み落札総額は金額取得済み案件のみの合計で、市場全体の総額ではありません。収録対象も全国自治体を網羅していません。 <a href="/about-data/#procurement">詳しいデータ仕様 →</a></div>{years.length>0&&<section class="card section"><h2>年別に見る</h2><div class="links">{years.map(([year,count])=><a class="linkchip" href={`/procurement/years/${year}/markets/${categorySlug}/`}>{year}年 ({count}件)</a>)}</div></section>}<section class="card section"><h2>主な発注機関</h2>{top.map(([name,val])=><div class="barrow"><div>{name}</div><div class="track"><div class="bar" style={`width:${val/max*100}%`}></div></div><div class="amount">{val}件</div></div>)}</section><section class="card table-card section"><div class="table-head"><h2>案件一覧</h2><div class="note">{rows.length}件</div></div><div style="overflow-x:auto"><table><thead><tr><th>日付</th><th>発注機関</th><th>案件</th><th>落札企業</th><th>金額</th></tr></thead><tbody>{rows.slice(0,200).map(r=><tr><td>{r.noticeDate}</td><td>{r.agency}</td><td class="title"><a href={r.sourceUrl}>{r.title}</a></td><td>{r.winnerName||'—'}</td><td>{r.awardAmount?new Intl.NumberFormat('ja-JP').format(r.awardAmount)+'円':'—'}</td></tr>)}</tbody></table></div></section></main><footer class="wrap">出典：JETRO 政府公共調達データベース / 調達ポータル（GEPS） · <a href="https://github.com/kkoch5t2/data-platform" target="_blank" rel="noreferrer">GitHub ↗</a></footer></body></html>
