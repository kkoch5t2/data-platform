---
import records from '../../../data/procurements';
import '../../../styles/detail.css';
const slugMap={'IT・デジタル':'it-digital','建設・土木':'construction','医療・福祉':'healthcare','研究・調査・コンサル':'research-consulting','教育・研修':'education','交通・物流':'transport-logistics','施設管理・清掃':'facility-management','広報・広告・制作':'communications','エネルギー・環境':'energy-environment','食品・給食':'food','一般物品・備品':'goods','その他':'other'};
const cats=[...new Set(records.map(r=>r.category||'その他'))].map(name=>{const rs=records.filter(r=>(r.category||'その他')===name);const awards=rs.filter(r=>r.awardAmount);return{name,slug:slugMap[name]||encodeURIComponent(name),count:rs.length,awards:awards.length,total:awards.reduce((a,r)=>a+(r.awardAmount||0),0)}}).sort((a,b)=>b.count-a.count);
const oku=(v)=>(v/100000000).toFixed(v>=1000000000?1:2)+'億円';
---
<html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="description" content="公共調達をIT・デジタル、建設・土木、医療・福祉などの分野別に集計。案件数と確認済み落札額から市場を比較できます。"><meta property="og:title" content="分野別データ | DATA"><meta property="og:description" content="公共調達をIT・デジタル、建設・土木、医療・福祉などの分野別に集計。案件数と確認済み落札額から市場を比較できます。"><meta property="og:type" content="website"><meta name="twitter:card" content="summary"><title>分野別データ | DATA</title></head><body><header><div class="wrap"><div class="nav"><a class="brand" href="/">DATA</a><a class="back" href="/about-data/#procurement">データについて</a></div><div class="hero"><div class="eyebrow">Markets</div><h1>公共調達を、分野から見る。</h1><p>IT・デジタル、建設・土木、医療・福祉、調査・コンサルなど、案件名からルールベースで分類した市場別集計。</p></div></div></header><main class="wrap"><div class="data-note">分野は<strong>案件名から自動分類</strong>しているため、誤分類や「その他」への分類を含む場合があります。また収録対象は主に国・政府機関・独立行政法人の公開調達で、全国自治体を網羅していません。確認済み落札額は金額取得済み案件のみの合計です。 <a href="/about-data/#procurement">詳しいデータ仕様 →</a></div><section class="card table-card section"><div class="table-head"><h2>分野一覧</h2><div class="note">{cats.length}分野</div></div><table><thead><tr><th>分野</th><th>収録レコード</th><th>金額確認済み</th><th>確認済み落札額</th></tr></thead><tbody>{cats.map(c=><tr><td class="title"><a href={`/procurement/markets/${c.slug}/`}>{c.name}</a></td><td>{c.count}</td><td>{c.awards}</td><td>{c.total?oku(c.total):'—'}</td></tr>)}</tbody></table></section></main><footer class="wrap">出典：JETRO 政府公共調達データベース / 調達ポータル（GEPS）</footer></body></html>
