---
import records from '../../../data/procurements'; import '../../../styles/detail.css';
const years=[...new Set(records.map(r=>(r.noticeDate||'').slice(0,4)).filter(Boolean))].sort().reverse().map(year=>{const rs=records.filter(r=>(r.noticeDate||'').startsWith(year));return{year,count:rs.length,total:rs.reduce((a,r)=>a+(r.awardAmount||0),0)}});const oku=(v)=>(v/100000000).toFixed(v>=1000000000?1:2)+'億円';
---
<html lang="ja"><head><link rel="icon" type="image/svg+xml" href="/favicon.svg"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><link rel="canonical" href="https://datlume.com/procurement/years/"><meta name="description" content="2014年以降の公共調達データを年別に集計し、収録件数と確認済み落札額を比較できます。"><meta property="og:title" content="年別データ | DATLUME"><meta property="og:description" content="2014年以降の公共調達データを年別に集計し、収録件数と確認済み落札額を比較できます。"><meta property="og:type" content="website"><meta name="twitter:card" content="summary"><title>年別データ | DATLUME</title></head><body><header><div class="wrap"><div class="nav"><a class="brand" href="/" aria-label="DATLUME" style="display:inline-flex;align-items:center;gap:10px;text-decoration:none;color:#fff"><img src="/favicon.svg" alt="" width="24" height="24" style="display:block;width:24px;height:24px;filter:brightness(0) invert(1)"><span style="font-family:'Segoe UI Variable','Avenir Next','Helvetica Neue',system-ui,sans-serif;font-size:19px;font-weight:750;letter-spacing:.16em;line-height:1">DATLUME</span></a></div><div class="hero"><div class="eyebrow">Years</div><h1>年別データ</h1><p>公共調達の年別集計。</p></div></div></header><main class="wrap"><section class="card table-card"><table><thead><tr><th>年</th><th>収録レコード</th><th>確認済み落札額</th></tr></thead><tbody>{years.map(y=><tr><td class="title"><a href={`/procurement/years/${y.year}/`}>{y.year}年</a></td><td>{y.count}</td><td>{y.total?oku(y.total):'—'}</td></tr>)}</tbody></table></section></main><footer class="wrap">出典：JETRO 政府公共調達データベース / 調達ポータル（GEPS） ・ <a href="/about-data/#procurement">収録範囲と集計上の注意</a> · <a href="https://github.com/kkoch5t2/data-platform" target="_blank" rel="noreferrer">GitHub ↗</a></footer></body></html>
