---
import records from '../../../../../data/procurements';
import '../../../../../styles/detail.css';
export function getStaticPaths(){
  const slugs={'生成AI':'generative-ai','クラウド':'cloud','セキュリティ':'security','ネットワーク':'network','システム開発':'system-development','データ':'data','IT機器':'it-hardware'};
  const counts=new Map();
  for(const r of records){if(!r.isIt)continue;const year=(r.noticeDate||'').slice(0,4);if(!year)continue;for(const label of r.tags||[]){if(!slugs[label])continue;const key=year+'\u0000'+label;counts.set(key,(counts.get(key)||0)+1)}}
  return [...counts.entries()].filter(([,count])=>count>=10).map(([key])=>{const [year,label]=key.split('\u0000');return{params:{year,tag:slugs[label]},props:{year,label}}});
}
const {year,label}=Astro.props;const slug=Astro.params.tag;
const rows=records.filter(r=>r.isIt&&(r.noticeDate||'').startsWith(year)&&(r.tags||[]).includes(label)).sort((a,b)=>(b.noticeDate||'').localeCompare(a.noticeDate||''));
const awards=rows.filter(r=>r.awardAmount),total=awards.reduce((a,r)=>a+(r.awardAmount||0),0),avg=awards.length?total/awards.length:0;const oku=v=>(v/100000000).toFixed(v>=1000000000?1:2)+'億円';const fmt=v=>new Intl.NumberFormat('ja-JP').format(v||0);
const agency=new Map(),vendors=new Map();for(const r of rows){if(r.agency)agency.set(r.agency,(agency.get(r.agency)||0)+1);if(r.winnerName&&r.awardAmount)vendors.set(r.winnerName,(vendors.get(r.winnerName)||0)+r.awardAmount)}const topAgency=[...agency.entries()].sort((a,b)=>b[1]-a[1]).slice(0,8),maxAgency=Math.max(...topAgency.map(([,v])=>v),1),topVendors=[...vendors.entries()].sort((a,b)=>b[1]-a[1]).slice(0,8),maxVendor=Math.max(...topVendors.map(([,v])=>v),1);
const canonical=`https://datlume.pages.dev/procurement/years/${year}/technologies/${slug}/`;const metaDescription=`${year}年の${label}関連の公共IT調達を、案件数・発注機関・受注企業・確認済み落札額から集計したデータページです。`;
const jsonLd={"@context":"https://schema.org","@type":"Dataset","name":`${year}年 ${label} 公共IT調達データ`,"description":metaDescription,"url":canonical,"temporalCoverage":year,"creator":{"@type":"Organization","name":"DATLUME"},"isBasedOn":["JETRO 政府公共調達データベース","調達ポータル（GEPS）"]};
---
<html lang="ja"><head><link rel="icon" type="image/svg+xml" href="/favicon.svg"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="description" content={metaDescription}><link rel="canonical" href={canonical}><meta property="og:title" content={`${year}年 ${label} 公共IT調達データ | DATLUME`}><meta property="og:description" content={metaDescription}><meta property="og:type" content="website"><meta property="og:url" content={canonical}><meta name="twitter:card" content="summary"><script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script><title>{year}年 {label} 公共IT調達データ | DATLUME</title></head><body>
<header><div class="wrap"><div class="nav"><a class="brand" href="/" aria-label="DATLUME" style="display:inline-flex;align-items:center;gap:10px;text-decoration:none;color:#fff"><img src="/favicon.svg" alt="" width="24" height="24" style="display:block;width:24px;height:24px;filter:brightness(0) invert(1)"><span style="font-family:'Segoe UI Variable','Avenir Next','Helvetica Neue',system-ui,sans-serif;font-size:19px;font-weight:750;letter-spacing:.16em;line-height:1">DATLUME</span></a><a class="back" href={`/procurement/years/${year}/`}>{year}年へ戻る</a></div><div class="hero"><div class="eyebrow">Year × Technology</div><h1>{year}年 {label}</h1><p>{year}年の公共IT調達から、{label}に関連すると判定された案件を集計。</p></div></div></header>
<main class="wrap"><div class="stats"><div class="card"><div class="label">案件数</div><div class="value">{fmt(rows.length)}件</div></div><div class="card"><div class="label">確認済み落札総額</div><div class="value">{total?oku(total):'—'}</div></div><div class="card"><div class="label">平均落札額</div><div class="value">{avg?oku(avg):'—'}</div></div></div>
<div class="data-note">技術カテゴリは<strong>案件名からのルールベース判定</strong>です。同一案件が複数タグに含まれることがあります。金額は取得できた案件のみ集計しています。 <a href="/about-data/#procurement">データ仕様 →</a></div>
<section class="card section"><h2>主な発注機関</h2>{topAgency.map(([name,val])=><div class="barrow"><div>{name}</div><div class="track"><div class="bar" style={`width:${val/maxAgency*100}%`}></div></div><div class="amount">{val}件</div></div>)}</section>
{topVendors.length>0&&<section class="card section"><h2>主な受注企業</h2>{topVendors.map(([name,val])=><div class="barrow"><div>{name}</div><div class="track"><div class="bar" style={`width:${val/maxVendor*100}%`}></div></div><div class="amount">{oku(val)}</div></div>)}</section>}
<section class="card table-card section"><div class="table-head"><h2>案件一覧</h2><div class="note">新しい順 / 最大200件</div></div><table><thead><tr><th>日付</th><th>発注機関</th><th>案件</th><th>落札企業</th><th>金額</th></tr></thead><tbody>{rows.slice(0,200).map(r=><tr><td>{r.noticeDate}</td><td>{r.agency}</td><td class="title"><a href={r.sourceUrl}>{r.title}</a></td><td>{r.winnerName||'—'}</td><td>{r.awardAmount?fmt(r.awardAmount)+'円':'—'}</td></tr>)}</tbody></table></section>
<div class="links"><a class="linkchip" href={`/procurement/years/${year}/`}>{year}年の全案件</a><a class="linkchip" href={`/procurement/technologies/${slug}/`}>{label}の全期間</a><a class="linkchip" href="/procurement/">ダッシュボード</a></div></main><footer class="wrap">出典：JETRO 政府公共調達データベース / 調達ポータル（GEPS） · <a href="https://github.com/kkoch5t2/data-platform" target="_blank" rel="noreferrer">GitHub ↗</a></footer></body></html>
