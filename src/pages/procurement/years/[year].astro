---
import records from '../../../data/procurements'; import '../../../styles/detail.css';
export function getStaticPaths(){const years=[...new Set(records.map(r=>(r.noticeDate||'').slice(0,4)).filter(Boolean))];return years.map(year=>({params:{year},props:{year}}));}
const {year}=Astro.props;const rows=records.filter(r=>(r.noticeDate||'').startsWith(year));const awards=rows.filter(r=>r.awardAmount);const total=awards.reduce((a,r)=>a+r.awardAmount,0);const oku=(v)=>(v/100000000).toFixed(v>=1000000000?1:2)+'億円';
const metaDescription=`${year}年の公共調達データを、案件数・発注機関・確認済み落札額から見られる年別データページです。`;
---
<html lang="ja"><head><link rel="icon" type="image/svg+xml" href="/favicon.svg"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="description" content={metaDescription}><meta property="og:description" content={metaDescription}><meta property="og:type" content="website"><meta name="twitter:card" content="summary"><title>{year}年 公共調達 | DATLUME</title></head><body><header><div class="wrap"><div class="nav"><a class="brand" href="/" aria-label="DATLUME" style="display:inline-flex;align-items:center;gap:10px;text-decoration:none;color:#fff"><img src="/favicon.svg" alt="" width="24" height="24" style="display:block;width:24px;height:24px;filter:brightness(0) invert(1)"><span style="font-family:'Segoe UI Variable','Avenir Next','Helvetica Neue',system-ui,sans-serif;font-size:19px;font-weight:750;letter-spacing:.16em;line-height:1">DATLUME</span></a><a class="back" href="/procurement/years/">年度一覧</a></div><div class="hero"><div class="eyebrow">Year</div><h1>{year}年</h1><p>{year}年に収録対象となった公共調達データ。</p></div></div></header><main class="wrap"><div class="stats"><div class="card"><div class="label">収録レコード</div><div class="value">{rows.length}</div></div><div class="card"><div class="label">確認済み落札総額</div><div class="value">{total?oku(total):'—'}</div></div><div class="card"><div class="label">金額確認済み</div><div class="value">{awards.length}</div></div></div><section class="card table-card section"><div class="table-head"><h2>案件一覧</h2></div><div style="overflow-x:auto"><table><thead><tr><th>日付</th><th>発注機関</th><th>案件</th><th>落札企業</th><th>金額</th></tr></thead><tbody>{rows.slice(0,200).map(r=><tr><td>{r.noticeDate}</td><td>{r.agency}</td><td class="title"><a href={r.sourceUrl}>{r.title}</a></td><td>{r.winnerName||'—'}</td><td>{r.awardAmount?new Intl.NumberFormat('ja-JP').format(r.awardAmount)+'円':'—'}</td></tr>)}</tbody></table></div></section></main><footer class="wrap">出典：JETRO 政府公共調達データベース / 調達ポータル（GEPS） ・ <a href="/about-data/#procurement">収録範囲と集計上の注意</a> · <a href="https://github.com/kkoch5t2/data-platform" target="_blank" rel="noreferrer">GitHub ↗</a></footer></body></html>
