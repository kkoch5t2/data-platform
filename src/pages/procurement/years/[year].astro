---
import records from '../../../data/procurements';
import '../../../styles/detail.css';
export function getStaticPaths(){const years=[...new Set(records.map(r=>(r.noticeDate||'').slice(0,4)).filter(Boolean))];return years.map(year=>({params:{year},props:{year}}));}
const {year}=Astro.props;
const rows=records.filter(r=>(r.noticeDate||'').startsWith(year)).sort((a,b)=>(b.noticeDate||'').localeCompare(a.noticeDate||''));
const awards=rows.filter(r=>r.awardAmount),total=awards.reduce((a,r)=>a+(r.awardAmount||0),0),avg=awards.length?total/awards.length:0;
const oku=v=>(v/100000000).toFixed(v>=1000000000?1:2)+'億円',fmt=v=>new Intl.NumberFormat('ja-JP').format(v||0);
const marketSlugs={'IT・デジタル':'it-digital','建設・土木':'construction','医療・福祉':'healthcare','研究・調査・コンサル':'research-consulting','教育・研修':'education','交通・物流':'transport-logistics','施設管理・清掃':'facility-management','広報・広告・制作':'communications','エネルギー・環境':'energy-environment','食品・給食':'food','科学・研究機器':'science-equipment','出版・情報資料':'publishing-information','化学・素材':'chemicals-materials','衣類・装備品':'apparel-equipment','機械・設備':'machinery-equipment','製造・製作':'manufacturing','人材・業務委託':'outsourcing-staffing','事務・BPO':'admin-bpo','情報サービス':'information-services','法務・登記':'legal-registration','賃貸借・リース':'leasing','公告・手続':'notices-procedures','一般物品・備品':'goods'};
const techSlugs={'生成AI':'generative-ai','クラウド':'cloud','セキュリティ':'security','ネットワーク':'network','システム開発':'system-development','データ':'data','IT機器':'it-hardware'};
const marketCounts=new Map(),techCounts=new Map(),agencyCounts=new Map();
for(const r of rows){const c=r.category||'その他';marketCounts.set(c,(marketCounts.get(c)||0)+1);if(r.agency)agencyCounts.set(r.agency,(agencyCounts.get(r.agency)||0)+1);if(r.isIt)for(const t of r.tags||[])techCounts.set(t,(techCounts.get(t)||0)+1)}
const markets=[...marketCounts].filter(([name,count])=>marketSlugs[name]&&count>=10).sort((a,b)=>b[1]-a[1]);
const technologies=[...techCounts].filter(([name,count])=>techSlugs[name]&&count>=10).sort((a,b)=>b[1]-a[1]);
const topAgency=[...agencyCounts].sort((a,b)=>b[1]-a[1]).slice(0,10),maxAgency=Math.max(...topAgency.map(([,v])=>v),1);
const canonical=`https://datlume.com/procurement/years/${year}/`;
const metaDescription=`${year}年の公共調達データを、案件数・発注機関・分野・IT技術カテゴリ・確認済み落札額から見られる年別データページです。`;
const jsonLd={"@context":"https://schema.org","@type":"Dataset","name":`${year}年 公共調達データ`,"description":metaDescription,"url":canonical,"temporalCoverage":year,"creator":{"@type":"Organization","name":"DATLUME"},"isBasedOn":["JETRO 政府公共調達データベース","調達ポータル（GEPS）"]};
---
<html lang="ja"><head><link rel="icon" type="image/svg+xml" href="/favicon.svg"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="description" content={metaDescription}><link rel="canonical" href={canonical}><meta property="og:title" content={`${year}年 公共調達データ | DATLUME`}><meta property="og:description" content={metaDescription}><meta property="og:type" content="website"><meta property="og:url" content={canonical}><meta name="twitter:card" content="summary"><script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script><title>{year}年 公共調達データ | DATLUME</title></head><body>
<header><div class="wrap"><div class="nav"><a class="brand" href="/" aria-label="DATLUME" style="display:inline-flex;align-items:center;gap:10px;text-decoration:none;color:#fff"><img src="/favicon.svg" alt="" width="24" height="24" style="display:block;width:24px;height:24px;filter:brightness(0) invert(1)"><span style="font-family:'Segoe UI Variable','Avenir Next','Helvetica Neue',system-ui,sans-serif;font-size:19px;font-weight:750;letter-spacing:.16em;line-height:1">DATLUME</span></a><a class="back" href="/procurement/years/">年度一覧</a></div><div class="hero"><div class="eyebrow">Year</div><h1>{year}年 公共調達</h1><p>{year}年に収録した公共調達を、分野・技術・発注機関・確認済み落札額から見る。</p></div></div></header>
<main class="wrap"><div class="stats"><div class="card"><div class="label">収録レコード</div><div class="value">{fmt(rows.length)}件</div></div><div class="card"><div class="label">確認済み落札総額</div><div class="value">{total?oku(total):'—'}</div></div><div class="card"><div class="label">平均落札額</div><div class="value">{avg?oku(avg):'—'}</div></div></div>
<div class="data-note">確認済み落札額は金額を取得できた案件のみの集計です。収録範囲は主に国・政府機関・独立行政法人で、全国自治体を網羅していません。 <a href="/about-data/#procurement">データ仕様 →</a></div>
{markets.length>0&&<section class="card section"><h2>{year}年を分野から見る</h2><div class="links">{markets.map(([name,count])=><a class="linkchip" href={`/procurement/years/${year}/markets/${marketSlugs[name]}/`}>{name} <span>({fmt(count)}件)</span></a>)}</div></section>}
{technologies.length>0&&<section class="card section"><h2>{year}年の公共ITを技術から見る</h2><div class="links">{technologies.map(([name,count])=><a class="linkchip" href={`/procurement/years/${year}/technologies/${techSlugs[name]}/`}>{name} <span>({fmt(count)}件)</span></a>)}</div></section>}
<section class="card section"><h2>主な発注機関</h2>{topAgency.map(([name,val])=><div class="barrow"><div>{name}</div><div class="track"><div class="bar" style={`width:${val/maxAgency*100}%`}></div></div><div class="amount">{fmt(val)}件</div></div>)}</section>
<section class="card table-card section"><div class="table-head"><h2>案件一覧</h2><div class="note">新しい順 / 最大200件</div></div><table><thead><tr><th>日付</th><th>発注機関</th><th>案件</th><th>落札企業</th><th>金額</th></tr></thead><tbody>{rows.slice(0,200).map(r=><tr><td>{r.noticeDate}</td><td>{r.agency}</td><td class="title"><a href={r.sourceUrl}>{r.title}</a></td><td>{r.winnerName||'—'}</td><td>{r.awardAmount?fmt(r.awardAmount)+'円':'—'}</td></tr>)}</tbody></table></section>
<div class="links"><a class="linkchip" href="/procurement/markets/">分野一覧</a><a class="linkchip" href="/procurement/technologies/">技術カテゴリ一覧</a><a class="linkchip" href="/procurement/">ダッシュボード</a></div></main><footer class="wrap">出典：JETRO 政府公共調達データベース / 調達ポータル（GEPS） ・ <a href="/about-data/#procurement">収録範囲と集計上の注意</a> · <a href="https://github.com/kkoch5t2/data-platform" target="_blank" rel="noreferrer" style="display:inline-flex;align-items:center;gap:5px"><img src="/brand/github.svg" alt="" width="14" height="14" style="display:block;width:14px;height:14px">GitHub ↗</a> · <a href="https://utility-tools-jp.com/" target="_blank" rel="noreferrer" style="display:inline-flex;align-items:center;gap:5px"><img src="/brand/utility-tools.ico" alt="" width="14" height="14" style="display:block;width:14px;height:14px;border-radius:3px">無料WEB便利ツール集 ↗</a></footer></body></html>
