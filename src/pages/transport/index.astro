---
import fs from 'node:fs';
const meta = JSON.parse(fs.readFileSync('public/data/transport/index.json', 'utf8'));
---
<!doctype html><html lang="ja"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width"><link rel="icon" type="image/svg+xml" href="/favicon.svg"><link rel="canonical" href="https://datlume.com/transport/">
<title>公共交通データ｜駅別乗降客数・地域の交通手段・鉄道利用 | DATLUME</title><meta name="description" content="全国の駅別乗降客数を検索し、2011～2024年度の推移を比較。市区町村の通勤・通学手段、都道府県別のバス利用、全国の鉄道旅客数も確認できます。">
<style is:global>
:root{color-scheme:light;--ink:#142033;--muted:#58677c;--line:#e1e7ef;--bg:#f4f6f9;--blue:#1769e0;--nav:#0e1b2e}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.6 system-ui,-apple-system,"Noto Sans JP",sans-serif}a{color:var(--blue)}button,input,select{font:inherit}button,select{cursor:pointer}button:disabled{cursor:default;opacity:.45}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #66a2fb;outline-offset:2px}.wrap{width:min(1200px,calc(100% - 32px));margin:auto}header{background:var(--nav);color:white;padding:18px 0 25px}.top{display:flex;align-items:center;justify-content:space-between;gap:16px}.brand{display:flex;align-items:center;gap:10px;color:white;font-size:18px;font-weight:750;letter-spacing:.16em;text-decoration:none}.brand img{filter:brightness(0) invert(1)}.links{display:flex;gap:16px}.links a{color:#d3dff0;font-size:12px;text-decoration:none}.hero{margin-top:25px}.hero h1{font-size:32px;letter-spacing:-.04em;line-height:1.3;margin:0 0 7px}.hero p{margin:0;color:#c7d4e6;font-size:13px}.tabs{display:flex;border-bottom:1px solid var(--line);gap:6px;margin:18px 0}.tabs button{border:0;border-bottom:3px solid transparent;background:none;color:var(--muted);font-weight:750;padding:12px 16px;white-space:nowrap}.tabs button[aria-selected=true]{color:var(--blue);border-bottom-color:var(--blue)}[hidden]{display:none!important}main{padding-bottom:45px}.card{background:white;border:1px solid var(--line);border-radius:12px;padding:18px;min-width:0}.filters{display:grid;grid-template-columns:2fr 1.4fr 1.4fr 1fr;gap:12px}.field label{display:block;font-size:12px;font-weight:650;color:var(--muted);margin-bottom:5px}.field input,.field select{width:100%;min-width:0;height:42px;border:1px solid #cbd5e1;border-radius:7px;padding:0 10px;background:white;color:var(--ink)}.toolbar{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin:12px 0;font-size:12px;color:var(--muted)}.toolbar label{display:flex;align-items:center;gap:6px}.toolbar input{width:18px;height:18px}.station-layout{display:grid;grid-template-columns:360px minmax(0,1fr);gap:14px;align-items:start}.results{padding:0;overflow:hidden}.result-heading{padding:13px 15px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);font-size:12px}.result-heading select{border:0;background:white;font-size:12px;max-width:160px}.result{display:block;width:100%;text-align:left;border:0;border-bottom:1px solid var(--line);background:white;color:var(--ink);padding:12px 15px}.result[aria-pressed=true]{background:#eef5ff;box-shadow:inset 3px 0 var(--blue)}.result:hover{background:#f4f8fd}.result-top{display:flex;justify-content:space-between;gap:12px;font-weight:750}.result-top strong{font-size:14px;text-align:right}.result small{display:block;margin-top:4px;color:var(--muted);font-size:11px}.pager{display:flex;align-items:center;justify-content:space-between;padding:12px;gap:6px}.btn{border:1px solid #ced8e6;border-radius:7px;padding:8px 12px;color:var(--blue);background:white;text-decoration:none;display:inline-block;font-size:12px}.empty{padding:24px 16px;color:var(--muted)}.detail-head{display:flex;justify-content:space-between;gap:12px;align-items:start}h2{font-size:20px;line-height:1.4;margin:0 0 5px}h3{font-size:16px;margin:0 0 4px}.sub{color:var(--muted);font-size:12px;margin:0 0 12px;line-height:1.7}.selected-tag{font-size:11px;color:var(--blue);font-weight:700}.actions{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}.metrics{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:18px 0;padding:14px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.metrics small{font-size:11px;color:var(--muted)}.metrics strong{display:block;font-size:27px;line-height:1.4;font-variant-numeric:tabular-nums}.metrics span{font-size:11px;color:var(--muted)}.comparison{display:grid;grid-template-columns:minmax(0,1fr) 180px;gap:10px}.chart{height:320px;min-width:0}.note{font-size:11px;line-height:1.8;color:var(--muted);margin:10px 0}.table-wrap{overflow-x:auto}table{border-collapse:collapse;width:100%;font-size:12px}th,td{padding:9px 10px;border-bottom:1px solid var(--line);text-align:left}th{color:var(--muted);font-weight:650}.num{text-align:right;font-variant-numeric:tabular-nums}details{margin-top:16px;font-size:12px}summary{cursor:pointer;color:var(--blue);font-weight:650;min-height:30px}.source{margin-top:20px;border-top:1px solid var(--line);padding-top:12px;font-size:11px;color:var(--muted);line-height:1.8}.regional-controls{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.regional-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:14px;margin-top:14px}.regional-grid .chart{height:450px}.section-gap{margin-top:14px}.status{font-size:12px;color:var(--muted);min-height:20px}.status:empty{display:none}.error{color:#b42318;font-size:13px}.period-buttons{display:flex;gap:6px}.period-buttons .btn[aria-pressed=true]{background:var(--blue);color:white;border-color:var(--blue)}.national-top{display:flex;justify-content:space-between;gap:15px;align-items:center}.national-kpis{margin:15px 0;display:grid;grid-template-columns:1fr 1fr;gap:15px}.national-kpis strong{display:block;font-size:28px}.rail-chart{height:380px}footer{font-size:11px;color:var(--muted);padding:20px 0 30px}.map-link{white-space:nowrap}
@media(max-width:900px){.station-layout{grid-template-columns:310px minmax(0,1fr)}.filters{grid-template-columns:1fr 1fr}.comparison{grid-template-columns:1fr}.regional-controls{grid-template-columns:1fr 1fr}.regional-grid{grid-template-columns:1fr}}@media(max-width:660px){.wrap{width:calc(100% - 24px)}.top{align-items:start}.links{gap:10px}.links a{font-size:11px}.hero{margin-top:20px}.hero h1{font-size:27px}.tabs{gap:0;margin:12px 0}.tabs button{padding:11px 8px;flex:1;font-size:12px}.filters{gap:10px;padding:14px}.filters .field:first-child{grid-column:1/-1}.station-layout{display:flex;flex-direction:column}.station-layout>.card{width:100%}.results{order:2}.detail{order:1}.station-layout.searching .results{order:0}.card{padding:14px}.results{padding:0}.metrics strong{font-size:23px}.detail-head{flex-wrap:wrap}.actions{justify-content:flex-start}.chart{height:285px}.regional-grid .chart{height:410px}.regional-controls{gap:10px}.national-top{align-items:start;flex-direction:column}.national-kpis strong{font-size:23px}.rail-chart{height:310px}.note{font-size:11px}th,td{padding:8px 6px}.metrics{margin:12px 0;padding:12px 0}}
</style></head><body>
<header><div class="wrap"><div class="top"><a class="brand" href="/" aria-label="DATLUME"><img src="/favicon.svg" width="24" height="24" alt=""><span>DATLUME</span></a><nav class="links" aria-label="関連ページ"><a href="/regional/">地域データ</a><a href="/about-data/">出典・定義</a></nav></div><div class="hero"><h1><span aria-hidden="true">🚆</span> 公共交通データ</h1><p>駅の利用はどう変わった？ 電車・バス・車、地域ごとの違いを比較。</p></div></div></header>
<main class="wrap"><nav class="tabs" role="tablist" aria-label="公共交通のテーマ"><button id="tab-stations" role="tab" aria-selected="true" aria-controls="panel-stations">駅を探す</button><button id="tab-regions" role="tab" aria-selected="false" aria-controls="panel-regions">地域を比較</button><button id="tab-national" role="tab" aria-selected="false" aria-controls="panel-national">全国の推移</button></nav>
<p id="load-error" class="error" role="alert" hidden></p>
<section id="panel-stations" role="tabpanel" aria-labelledby="tab-stations">
<div class="card filters"><div class="field"><label for="station-search">駅名・路線名で検索</label><input id="station-search" type="search" placeholder="新宿、山手線など" autocomplete="off"></div><div class="field"><label for="operator">運営会社</label><select id="operator"><option value="">すべての会社</option></select></div><div class="field"><label for="line">路線</label><select id="line"><option value="">すべての路線</option></select></div><div class="field"><label for="station-year">表示年度</label><select id="station-year">{Array.from({length:14},(_,i)=>2024-i).map(y=><option value={y}>{y}年度</option>)}</select></div></div>
<div class="toolbar"><span id="station-count" role="status">駅データを読み込み中…</span><label><input id="show-missing" type="checkbox">非公開・データなしの駅も表示</label></div>
<div class="station-layout"><section class="card results" aria-label="駅の検索結果"><div class="result-heading"><strong>駅別乗降客数</strong><select id="station-sort" aria-label="検索結果の並び順"><option value="usage">利用者数が多い順</option><option value="growth">前年からの増加率順</option><option value="name">駅名順</option></select></div><div id="station-results"></div><div class="pager"><button id="result-prev" class="btn">前へ</button><span id="result-page" class="sub" style="margin:0"></span><button id="result-next" class="btn">次へ</button></div></section>
<section class="card detail" aria-label="選択した駅"><div class="detail-head"><div><div class="selected-tag">選択中の駅</div><h2 id="station-name">駅を選択</h2><p id="station-description" class="sub"></p></div><div class="actions"><button id="share" class="btn">リンクをコピー</button><button id="station-csv" class="btn">CSV</button></div></div><p id="share-status" class="status" role="status"></p>
<div class="metrics" aria-live="polite"><div><small id="station-value-label">1日あたりの乗降客数</small><strong id="station-value">—</strong><span id="station-value-meta"></span></div><div><small>前年度からの変化</small><strong id="station-change">—</strong><span id="station-change-meta"></span></div></div>
<div class="comparison"><div class="field"><label for="station-compare">比較する駅（検索条件内）</label><select id="station-compare"><option value="">比較なし</option></select></div><div class="field"><label for="station-chart-mode">グラフの表示</label><select id="station-chart-mode"><option value="count">乗降客数（人／日）</option><option value="index">2019年度＝100</option></select></div></div><div id="station-chart" class="chart" role="img" aria-label="駅別乗降客数の年度別推移"></div><p id="station-chart-note" class="note"></p><a id="station-map" class="map-link btn" href="https://maps.gsi.go.jp/" target="_blank" rel="noreferrer">地理院地図で場所を見る ↗</a>
<details><summary>年度別の数値・原典の備考を見る</summary><div class="table-wrap"><table><thead><tr><th>年度</th><th class="num">乗降客数（人／日）</th><th>備考</th></tr></thead><tbody id="station-history"></tbody></table></div></details>
<div class="source">出典：<a href={meta.sources.stations.page} target="_blank" rel="noreferrer">国土交通省「国土数値情報・駅別乗降客数」↗</a>（CC BY 4.0）を加工。2011〜2024年度。会社・路線ごとの原典値で、同名駅の合計や実人数ではありません。原典の集計範囲・算出方法に差があるため、会社間比較は目安です。重複記載の行はランキングから除外し、欠損を0人にしません。</div></section></div>
</section>
<section id="panel-regions" role="tabpanel" aria-labelledby="tab-regions" hidden><div class="card"><h2>通勤・通学に何を使う？</h2><p class="sub">2020年国勢調査。15歳以上の通勤者・通学者を、住んでいる地域で比較します。</p><div class="regional-controls"><div class="field"><label for="pref-a">地域 A・都道府県</label><select id="pref-a"></select></div><div class="field"><label for="area-a">地域 A・市区町村</label><select id="area-a"></select></div><div class="field"><label for="pref-b">地域 B・都道府県</label><select id="pref-b"></select></div><div class="field"><label for="area-b">地域 B・市区町村</label><select id="area-b"></select></div></div></div>
<div class="regional-grid"><section class="card"><h3>交通手段の割合</h3><p id="commute-sub" class="sub"></p><div id="commute-chart" class="chart" role="img" aria-label="地域別の通勤通学手段の割合比較"></div><details><summary>全17区分の人数を見る</summary><div class="table-wrap"><table><thead><tr><th>交通手段</th><th class="num" id="area-a-label">地域 A</th><th class="num" id="area-b-label">地域 B</th></tr></thead><tbody id="commute-table"></tbody></table></div></details><p class="note">分母は不詳を含む通勤者・通学者の総数。「電車のみ」と「電車＋バス」は別区分です。日常のすべての移動や、現在の利用率を表すものではありません。</p></section>
<section class="card"><h3 id="bus-title">乗合バスの年間利用</h3><p class="sub">都道府県（支局）別の輸送人員。住民の人数ではなく延べ輸送回数です。</p><div class="field"><label for="bus-pref">比較する都道府県</label><select id="bus-pref"></select></div><div class="metrics"><div><small>選択地域の年間輸送人員</small><strong id="bus-value">—</strong><span id="bus-value-meta"></span></div><div><small>全国に占める割合</small><strong id="bus-share">—</strong><span>同年度の全国計との比較</span></div></div><div id="bus-chart" class="chart" role="img" aria-label="都道府県別の乗合バス年間輸送人員ランキング"></div><details><summary>全都道府県の数値を見る</summary><div class="table-wrap"><table><thead><tr><th>都道府県</th><th class="num">輸送人員（千人）</th></tr></thead><tbody id="bus-table"></tbody></table></div></details><p class="note">乗合バスは一般乗合・高速乗合を含み、貸切バスを除きます。北海道は7支局の公表値を合計。千人単位の丸めにより全国計との和に差がある場合があります。輸送実績は調査対象の支局で区分されます。</p></section></div>
<div class="source">出典：<a href={meta.sources.commute.page} target="_blank" rel="noreferrer">総務省「2020年国勢調査」第17-2表 ↗</a>、<a href={meta.sources.bus.page} target="_blank" rel="noreferrer">国土交通省「自動車輸送統計年報」第4-2表 ↗</a>を加工。国勢調査の不詳は明示し、単独利用と併用を二重加算しません。</div></section>
<section id="panel-national" role="tabpanel" aria-labelledby="tab-national" hidden><section class="card"><div class="national-top"><div><h2>全国の鉄道利用はどう変わった？</h2><p id="rail-sub" class="sub"></p></div><div class="period-buttons" aria-label="鉄道の集計期間"><button id="rail-monthly" class="btn" aria-pressed="true">月次</button><button id="rail-annual" class="btn" aria-pressed="false">年度</button></div></div><div class="national-kpis" aria-live="polite"><div><small id="rail-period">最新月</small><strong id="rail-value">—</strong></div><div><small id="rail-change-label">前年同月比</small><strong id="rail-change">—</strong></div></div><div id="rail-chart" class="chart rail-chart" role="img" aria-label="全国の鉄道旅客数量の推移"></div><p class="note">JR旅客会社とJR以外の民鉄を表示。人員は延べ輸送人員で、利用した人の実人数ではありません。月次は原表の直近13か月、年度は原表の2017年度以降を収録します。月報の値を使用し、速報と混ぜません。</p><details><summary>原表の数値を見る</summary><div class="table-wrap"><table><thead><tr><th>期間</th><th class="num">全国（千人）</th><th class="num">JR（千人）</th><th class="num">JR以外（千人）</th></tr></thead><tbody id="rail-table"></tbody></table></div></details><div class="source">出典：<a href={meta.sources.rail.page} target="_blank" rel="noreferrer">国土交通省「鉄道輸送統計調査」第2-1表 ↗</a>を加工。月次と年度の値を同じグラフに混ぜません。</div></section></section>
</main><footer class="wrap">DATLUME — 日本の公開データを、比較できる形に。 · <a href="/">ホーム</a> · データ取得：{meta.generatedAt.slice(0,10)}</footer>
<script>import '../../scripts/transport';</script>
</body></html>
