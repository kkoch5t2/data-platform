    .category-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:9px}.category-card{border:1px solid #edf0f4;border-radius:13px;padding:13px 14px;background:#fbfcfe}.category-card-head{display:flex;justify-content:space-between;gap:10px;align-items:center;font-size:11px;font-weight:850}.category-card-head b{font-size:12px}.category-track{height:5px;background:#edf1f6;border-radius:99px;overflow:hidden;margin-top:10px}.category-bar{height:100%;background:linear-gradient(90deg,#1769e0,#79aaf0);border-radius:99px}.candidate-label{font-size:9px;color:#8a4b00;background:#fff4db;border:1px solid #f3d59a;border-radius:999px;padding:4px 7px;vertical-align:middle;white-space:nowrap}.reason-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.reason-card{border:1px solid #e7ebf0;border-radius:15px;padding:17px;background:linear-gradient(180deg,#fff,#fbfcfe)}.reason-meta{display:flex;justify-content:space-between;gap:8px;align-items:center}.category-pill,.mini-badge{display:inline-flex;align-items:center;border:1px solid #e4e9f0;background:#f7f9fc;border-radius:999px;padding:3px 7px;font-size:9px;font-weight:800;color:#475467}.reason-change{font-size:11px;font-weight:900}.reason-card h3{font-size:17px;margin:12px 0 7px;letter-spacing:-.02em}.reason-card>p{font-size:11px;line-height:1.7;color:#475467;margin:0 0 12px}.news-links{display:grid;gap:6px}.news-links a{display:block;border-top:1px solid #eef1f5;padding-top:7px;font-size:10.5px;line-height:1.5;text-decoration:none;color:#344054}.news-links a:hover{color:var(--blue)}.news-links a span{display:block;font-size:8.5px;color:var(--muted);font-weight:850;margin-bottom:2px}.wiki-link{display:inline-flex;margin-top:11px;font-size:9.5px;color:var(--blue);font-weight:850;text-decoration:none}.category-filters{display:flex;gap:6px;flex-wrap:wrap;margin-top:11px}.category-filter{border:1px solid var(--line);background:#f8fafc;color:#475467;border-radius:999px;padding:6px 9px;font:inherit;font-size:9.5px;font-weight:800;cursor:pointer}.category-filter span{margin-left:4px;color:#98a2b3}.category-filter.active{background:var(--soft);border-color:#b8d5fa;color:#1257b8}.trend-badge{background:#fff8e8;border-color:#f4dfb5}.rank-note{display:flex;align-items:center;gap:5px;flex-wrap:wrap}.weekly-title small{display:block;color:var(--muted);font-size:8.5px;margin-top:2px}

    .youtube-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.youtube-card{display:grid;grid-template-columns:minmax(210px,.9fr) minmax(0,1.1fr);gap:14px;padding:13px;border:1px solid #e7ebf0;border-radius:15px;background:linear-gradient(180deg,#fff,#fbfcfe)}.youtube-thumb,.youtube-frame{width:100%;aspect-ratio:16/9;border:0;border-radius:11px;background:#101828;overflow:hidden}.youtube-thumb{position:relative;padding:0;cursor:pointer}.youtube-thumb img{width:100%;height:100%;display:block;object-fit:cover}.youtube-play{position:absolute;inset:0;display:grid;place-items:center}.youtube-play span{width:46px;height:32px;border-radius:9px;background:#000c;color:#fff;display:grid;place-items:center;font-size:15px;padding-left:2px}.youtube-copy{min-width:0;display:flex;flex-direction:column}.youtube-topic{font-size:9px;font-weight:900;color:var(--red);letter-spacing:.02em}.youtube-copy h3{font-size:13px;line-height:1.45;margin:6px 0 7px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.youtube-copy h3 a{text-decoration:none}.youtube-copy h3 a:hover{color:var(--blue)}.youtube-meta{font-size:9.5px;line-height:1.55;color:var(--muted);margin-top:auto}.youtube-meta b{color:#475467}.youtube-note{font-size:9px;color:var(--muted);line-height:1.55;margin-top:7px}
    @media(max-width:900px){.youtube-grid{grid-template-columns:1fr}.reason-grid{grid-template-columns:1fr}.kpis{grid-template-columns:1fr 1fr}.spotlight{grid-template-columns:1fr 1fr}.topic-card:first-child{grid-column:1/-1}.rank-row{grid-template-columns:44px minmax(0,1fr) 88px 74px}.rank-row .avg,.rank-row .spark{display:none}.pulse-grid{overflow-x:auto;grid-template-columns:repeat(14,44px);justify-content:start}.rising-grid{grid-template-columns:1fr}.weekly-row{grid-template-columns:34px minmax(0,1fr) 90px}.weekly-track,.weekly-best{display:none}}
    @media(max-width:640px){.youtube-card{grid-template-columns:1fr}.category-grid{grid-template-columns:1fr 1fr}.category-filters{flex-wrap:nowrap;overflow-x:auto;padding-bottom:3px}.category-filter{white-space:nowrap;flex:0 0 auto}.wrap{width:min(100% - 24px,1180px)}header{padding-bottom:48px}.nav{align-items:flex-start;flex-direction:column}.navlinks{width:100%;overflow-x:auto;flex-wrap:nowrap;justify-content:flex-start;margin-left:0;padding-bottom:2px}.navlinks a{white-space:nowrap;flex:0 0 auto}.hero{padding-top:44px}.hero h1{font-size:43px}.kpis{grid-template-columns:1fr 1fr}.kpi{padding:15px}.value{font-size:22px}.spotlight{grid-template-columns:1fr}.topic-card:first-child{grid-column:auto}.topic-card{min-height:156px}.topic-card:first-child .topic-title{font-size:25px}.section{padding:16px}.section-head{align-items:flex-start;flex-direction:column;gap:5px}.tabs{align-items:stretch}.search{order:2;margin-left:0;width:100%}.rank-row{grid-template-columns:34px minmax(0,1fr) 76px;gap:7px;padding:12px 0}.rank-row .rank-delta{display:none}.rank-title a{font-size:12px}.weekly-row{grid-template-columns:30px minmax(0,1fr) 82px}.rising-card{grid-template-columns:40px 1fr auto;padding:13px}.rise-rank{width:34px;height:34px}.rise-value{font-size:14px}}
  </style>
<link rel="stylesheet" href="/brand/footer.css?v=20261010-2"></head>
<body>
<header>
  <div class="wrap">
    <nav class="nav"><a class="brand" href="/" aria-label="DATLUME" style="display:inline-flex;align-items:center;gap:10px;text-decoration:none;color:#fff"><img src="/favicon.svg" alt="" width="24" height="24" style="display:block;width:24px;height:24px;filter:brightness(0) invert(1)"><span style="font-family:'Segoe UI Variable','Avenir Next','Helvetica Neue',system-ui,sans-serif;font-size:19px;font-weight:750;letter-spacing:.16em;line-height:1">DATLUME</span></a><div class="navlinks"><a href="/">トップ</a><a href="/topics/"><span aria-hidden="true">🔥</span> 話題のトピック</a><a href="/listed-companies/"><span aria-hidden="true">📈</span> 上場企業</a><a href="/unlisted-companies/"><span aria-hidden="true">🏢</span> 未上場企業</a><a href="/economy-prices/"><span aria-hidden="true">💴</span> 経済・物価</a><a href="/about-data/">データについて</a></div></nav>
    <section class="hero">
      <div class="eyebrow">Japanese Wikipedia / Pageview Trends</div>
      <h1><span aria-hidden="true">🔥</span> 話題のトピック</h1>
      <p>日本語版Wikipediaで「いま何が読まれているか」を、総合ランキング・急上昇・週間の強さから見るダッシュボードです。ニュースやSNSとは違う、百科事典を読みに行く人の関心の動きを可視化します。</p>
      <div class="hero-meta"><span class="hero-pill">最新データ {fmtDate(data.latestDate)}</span><span class="hero-pill">{fmt(data.summary?.categoryCount)}カテゴリに自動分類</span><span class="hero-pill">背景候補 {fmt(strongReasonTopics.length)}件</span>{youtubeItems.length > 0 && <span class="hero-pill">YouTube関連 {fmt(youtubeItems.length)}件</span>}<span class="hero-pill">Wikimedia公式Pageviews API</span></div>
    </section>
  </div>
</header>
<main class="wrap">
  <section class="kpis" aria-label="最新トレンド概要">
    <div class="card kpi"><div class="label">いま最も読まれている</div><div class="value" style="font-size:20px">{leader?.article || '—'}</div><div class="sub">{leader ? `${fmt(leader.views)} PV / 1位` : 'データなし'}</div></div>
    <div class="card kpi"><div class="label">上位100記事の閲覧数</div><div class="value">{fmt(data.summary?.latestTop100Views)}</div><div class="sub">{fmtDate(data.latestDate)} / 特殊ページ除外後</div></div>
    <div class="card kpi"><div class="label">TOP20 新着</div><div class="value">{fmt(data.summary?.newEntriesTop20)}件</div><div class="sub">前日のTOP100圏外 → 今日TOP20</div></div>
    <div class="card kpi"><div class="label">最大の急上昇</div><div class="value" style="font-size:18px">{biggestRiser?.article || '—'}</div><div class="sub">{biggestRiser ? `前日比 ${fmtPct(biggestRiser.viewChangePct)}` : '比較可能なデータなし'}</div></div>
  </section>

  <section class="section card">
    <div class="section-head"><div><h2>いま読まれている話題</h2><p>最新日の上位3トピック。クリックすると日本語版Wikipediaを開きます。</p></div><span class="label">{fmtDate(data.latestDate)}</span></div>
    <div class="spotlight">
      {top.slice(0,3).map((x) => <a class="card topic-card" href={x.url} target="_blank" rel="noreferrer" style="text-decoration:none"><div class="topic-rank">#{x.rank} · {x.category?.emoji} {x.category?.label}</div><div class="topic-title">{x.article}</div><div class="topic-meta"><span>{fmt(x.views)} PV · {x.trend?.emoji} {x.trend?.label}</span><span class:list={["delta", x.isNew ? "new" : trendClass(x.rankChange)]}>{rankLabel(x)}</span></div></a>)}
    </div>
  </section>

  <section class="section card">
    <div class="section-head"><div><h2>カテゴリ別の話題</h2><p>Wikipediaカテゴリ・概要とWikidataの構造化情報を組み合わせて自動分類。上位100記事の構成です。</p></div><span class="label">TOP 100</span></div>
    <div class="category-grid">
      {categories.map((c) => <div class="category-card"><div class="category-card-head"><span>{c.emoji} {c.label}</span><b>{c.count}件</b></div><div class="category-track"><div class="category-bar" style={`width:${Math.max(4,c.count/maxCategory*100)}%`}></div></div></div>)}
    </div>
  </section>

  {reasonTopics.length > 0 && <section class="section card reason-section">
    <div class="section-head"><div><h2>なぜ急上昇？ <span class="candidate-label">背景候補</span></h2><p>急上昇日と同時期の関連ニュースを照合。ニュースが原因だと断定せず、時期が重なる報道だけを手掛かりとして表示します。</p></div><span class="label">Google News RSS</span></div>
    <div class="reason-grid">
      {reasonTopics.map((x) => <article class="reason-card">
        <div class="reason-meta"><span class="category-pill">{x.category?.emoji} {x.category?.label}</span><span class:list={["reason-change", trendClass(x.viewChangePct)]}>前日比 {fmtPct(x.viewChangePct)}</span></div>
        <h3>{x.article}</h3>
        <p>{x.reason?.summary}</p>
        <div class="news-links">{x.reason?.items?.slice(0,2).map((n) => <a href={n.url} target="_blank" rel="noreferrer"><span>{n.source}</span>{n.title}</a>)}</div>
        <a class="wiki-link" href={x.url} target="_blank" rel="noreferrer">Wikipediaを見る ↗</a>
      </article>)}
    </div>
  </section>}

  {youtubeItems.length > 0 && <section class="section card youtube-section">
    <div class="section-head"><div><h2>YouTubeでも注目</h2><p>Wikipedia急上昇上位10件をYouTube Data APIで照合。直近7日・日本向け・埋め込み可能で、動画タイトルにトピック名を含む候補から再生数上位を1本表示します。</p></div><span class="label">最終照合 {youtubeUpdated} JST</span></div>
    <div class="youtube-grid">
      {youtubeItems.map((x) => <article class="youtube-card">
        <button class="youtube-thumb" type="button" data-youtube-play data-video-id={x.videoId} aria-label={`${x.title} を再生`}>
          <img src={`https://i.ytimg.com/vi/${x.videoId}/hqdefault.jpg`} data-youtube-thumb data-video-id={x.videoId} alt="" loading="lazy" decoding="async">
          <span class="youtube-play" aria-hidden="true"><span>▶</span></span>
        </button>
        <div class="youtube-copy">
          <div class="youtube-topic">Wikipedia急上昇 #{x.topicRank} · {x.topic}</div>
          <h3><a href={x.url} target="_blank" rel="noreferrer">{x.title}</a></h3>
          <div class="youtube-meta"><b>{x.channelTitle}</b><br>{fmt(x.views)} 回視聴 · {x.publishedAt ? new Date(x.publishedAt).toLocaleDateString('ja-JP', { timeZone: 'Asia/Tokyo', month: 'numeric', day: 'numeric' }) : '公開日不明'}</div>
          <div class="youtube-note">関連動画候補であり、Wikipedia閲覧増加の原因やDATLUMEによる推奨を示すものではありません。</div>
        </div>
      </article>)}
    </div>
  </section>}

  <section class="section card">
    <div class="section-head"><div><h2>14日間の閲覧ボリューム</h2><p>各日の上位100記事のPV合計。全Wikipedia閲覧数ではありません。</p></div><span class="label">{fmtShortDate(data.window?.from)} → {fmtShortDate(data.window?.to)}</span></div>
    <div class="pulse-grid" aria-label="上位100記事の日別閲覧数">
      {daily.map((x) => <div class="pulse-day" title={`${x.date} ${fmt(x.top100Views)} PV / 1位 ${x.leader}`}><span class="pulse-value">{(x.top100Views/10000).toFixed(0)}万</span><div class="pulse-track"><div class="pulse-bar" style={`height:${Math.max(3,(Number(x.top100Views)||0)/maxDaily*100)}%`}></div></div><span class="pulse-date">{fmtShortDate(x.date)}</span></div>)}
    </div>
  </section>

  <section class="section card">
    <div class="section-head"><div><h2>トピックランキング</h2><p>総合・急上昇・週間を切り替えて確認できます。</p></div></div>
    <div class="tabs" role="tablist" aria-label="ランキング切替">
      <button class="tab active" type="button" role="tab" aria-selected="true" data-tab="overall">総合ランキング</button>
      <button class="tab" type="button" role="tab" aria-selected="false" data-tab="rising">急上昇</button>
      <button class="tab" type="button" role="tab" aria-selected="false" data-tab="weekly">週間</button>
      <input class="search" id="topic-search" type="search" placeholder="総合ランキングを検索" aria-label="トピック検索">
    </div>
    <div class="category-filters" id="category-filters" aria-label="カテゴリで絞り込み">
      <button type="button" class="category-filter active" data-category-filter="" aria-pressed="true">すべて</button>
      {categories.map((c) => <button type="button" class="category-filter" data-category-filter={c.key} aria-pressed="false">{c.emoji} {c.label}<span>{c.count}</span></button>)}
    </div>

    <div class="panel" data-panel="overall" style="margin-top:14px">
      <div class="rank-list" id="overall-list">
        {top.map((x) => {
          const vals = x.history?.map((h) => Number(h.views) || 0) || [];
          const max = Math.max(1, ...vals);
          return <div class="rank-row" data-title={x.article.toLowerCase()} data-category={x.category?.key || 'other'}>
            <div class="rank-no">{x.rank}</div>
            <div class="rank-title"><a href={x.url} target="_blank" rel="noreferrer">{x.article}</a><div class="rank-note"><span class="mini-badge">{x.category?.emoji} {x.category?.label}</span><span class="mini-badge trend-badge">{x.trend?.emoji} {x.trend?.label}</span><span>7日TOP100入り {x.daysInTop100}日</span></div></div>
            <div class="num">{fmt(x.views)} PV</div>
            <div class:list={["rank-delta", x.isNew ? "new" : trendClass(x.rankChange)]}>{rankLabel(x)}</div>
            <div class:list={["num","avg",trendClass(x.vsAverage7Pct)]}>{fmtPct(x.vsAverage7Pct)}</div>
            <div class="spark" aria-label="7日閲覧推移">{vals.map((v) => <i style={`height:${v ? Math.max(8,v/max*100) : 2}%`}></i>)}</div>
          </div>;
        })}
      </div>
    </div>

    <div class="panel" data-panel="rising" hidden style="margin-top:14px">
      <div class="rising-grid">
        {rising.map((x, i) => <div class="card rising-card"><div class="rise-rank">{i+1}</div><div class="rise-title"><a href={x.url} target="_blank" rel="noreferrer">{x.article}</a><div>{x.category?.emoji} {x.category?.label} · 現在 #{x.rank} / {fmt(x.views)} PV / 前日 {x.previousRank ? `#${x.previousRank}` : '圏外'}</div></div><div class="rise-value">{fmtPct(x.viewChangePct)}</div></div>)}
      </div>
    </div>

    <div class="panel" data-panel="weekly" hidden style="margin-top:14px">
      <div class="weekly-list">
        {weekly.map((x, i) => <div class="weekly-row"><div class="weekly-rank">{i+1}</div><div class="weekly-title"><a href={x.url} target="_blank" rel="noreferrer">{x.article}</a><small>{x.category?.emoji} {x.category?.label}</small></div><div class="weekly-track"><div class="weekly-bar" style={`width:${Math.max(2,x.totalViews/maxWeekly*100)}%`}></div></div><div class="weekly-total">{fmt(x.totalViews)} PV</div><div class="weekly-best">最高 #{x.bestRank}</div></div>)}
      </div>
    </div>
  </section>

  <aside class="card note">
    <strong>このページの読み方：</strong> 「話題」は日本語版Wikipediaの閲覧動向を指し、日本全体の検索トレンド・SNS投稿量・世論を直接示すものではありません。メインページ、検索などの特殊ページはランキングから除外しています。急上昇は前日に3,000PV以上あった記事の前日比から算出し、週間は直近7日の日別上位データを合算しています。カテゴリはWikipedia/Wikidataの公開メタデータから自動分類します。「なぜ急上昇？」は急上昇日の前後に見つかった関連報道を背景候補として示すもので、ニュースが閲覧増加の原因だと断定するものではありません。「YouTubeでも注目」は急上昇上位10件と直近の埋め込み可能動画を機械的に照合した関連候補で、閲覧増加の原因や内容の正確性、DATLUMEによる推奨を示しません。動画はクリックするまでYouTubeプレーヤーを読み込みません。データ更新にはWikimedia側の集計遅延があるため、取得できた最新日を自動採用します。<br>出典：<a class="source-link" href="https://doc.wikimedia.org/generated-data-platform/aqs/analytics-api/reference/page-views.html" target="_blank" rel="noreferrer">Wikimedia Analytics API - Pageviews ↗</a> / 最終生成 {generated} JST
  </aside>
</main>
<SiteFooter>DATLUME · <a href="/">トップへ</a> · <a href="/about-data/">データについて</a></SiteFooter>
<script>
  const tabs = Array.from(document.querySelectorAll('[data-tab]'));
  const panels = Array.from(document.querySelectorAll('[data-panel]'));
  const search = document.getElementById('topic-search');
  const categoryFilters = document.getElementById('category-filters');
  const categoryButtons = Array.from(document.querySelectorAll('[data-category-filter]'));
  let activeCategory = '';
  const applyOverallFilter = () => {
    const q = search?.value.trim().toLowerCase() || '';
    document.querySelectorAll('#overall-list .rank-row').forEach((row) => {
      const titleMatch = !q || (row.dataset.title || '').includes(q);
      const categoryMatch = !activeCategory || row.dataset.category === activeCategory;
      row.style.display = titleMatch && categoryMatch ? '' : 'none';
    });
  };
  tabs.forEach((tab) => tab.addEventListener('click', () => {
    const key = tab.dataset.tab;
    tabs.forEach((x) => { x.classList.toggle('active', x === tab); x.setAttribute('aria-selected', x === tab ? 'true' : 'false'); });
    panels.forEach((panel) => panel.hidden = panel.dataset.panel !== key);
    if (search) search.style.visibility = key === 'overall' ? 'visible' : 'hidden';
    if (categoryFilters) categoryFilters.style.display = key === 'overall' ? 'flex' : 'none';
  }));
  categoryButtons.forEach((button) => button.addEventListener('click', () => {
    activeCategory = button.dataset.categoryFilter || '';
    categoryButtons.forEach((x) => { const on = x === button; x.classList.toggle('active', on); x.setAttribute('aria-pressed', on ? 'true' : 'false'); });
    applyOverallFilter();
  }));
  search?.addEventListener('input', applyOverallFilter);
  document.querySelectorAll('img[data-youtube-thumb]').forEach((img) => {
    const fallback = () => {
      const videoId = img.dataset.videoId || '';
      if (!/^[A-Za-z0-9_-]{11}$/.test(videoId)) { img.hidden = true; return; }
      if (img.dataset.fallback === 'mq') { img.hidden = true; return; }
      img.dataset.fallback = 'mq';
      img.src = `https://i.ytimg.com/vi/${videoId}/mqdefault.jpg`;
    };
    img.addEventListener('error', fallback);
    if (img.complete && !img.naturalWidth) fallback();
  });
  document.querySelectorAll('[data-youtube-play]').forEach((button) => button.addEventListener('click', () => {
    const videoId = button.dataset.videoId || '';
    if (!/^[A-Za-z0-9_-]{11}$/.test(videoId)) return;
    const frame = document.createElement('iframe');
    frame.className = 'youtube-frame';
    frame.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0`;
    frame.title = button.getAttribute('aria-label') || 'YouTube video player';
    frame.loading = 'lazy';
    frame.referrerPolicy = 'strict-origin-when-cross-origin';
    frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    frame.allowFullscreen = true;
    button.replaceWith(frame);
  }));
</script>
</body>
</html>
