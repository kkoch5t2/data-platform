---
import fs from 'node:fs';
import path from 'node:path';

const dataPath = path.join(process.cwd(), 'public/data/wikipedia-topics.json');
const data = JSON.parse(fs.readFileSync(dataPath, 'utf8'));
const fmt = (v) => new Intl.NumberFormat('ja-JP').format(Number(v) || 0);
const fmtPct = (v) => v == null ? '—' : `${v > 0 ? '+' : ''}${Number(v).toFixed(1)}%`;
const fmtDate = (v) => v ? new Date(`${v}T00:00:00Z`).toLocaleDateString('ja-JP', { timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric' }) : '—';
const fmtShortDate = (v) => v ? new Date(`${v}T00:00:00Z`).toLocaleDateString('ja-JP', { timeZone: 'UTC', month: 'numeric', day: 'numeric' }) : '—';
const generated = data.generatedAt ? new Date(data.generatedAt).toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo' }) : '—';
const top = data.top || [];
const rising = data.rising || [];
const weekly = data.weekly || [];
const daily = data.daily || [];
const leader = top[0];
const biggestRiser = rising[0];
const maxDaily = Math.max(1, ...daily.map((x) => Number(x.top100Views) || 0));
const maxWeekly = Math.max(1, ...weekly.map((x) => Number(x.totalViews) || 0));
const trendClass = (v) => v == null ? 'flat' : v > 0 ? 'up' : v < 0 ? 'down' : 'flat';
const rankLabel = (x) => x.isNew ? 'NEW' : x.rankChange == null ? '—' : x.rankChange > 0 ? `↑ ${x.rankChange}` : x.rankChange < 0 ? `↓ ${Math.abs(x.rankChange)}` : '→';
---
<!doctype html>
<html lang="ja">
<head>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width">
  <meta name="description" content="日本語版Wikipediaの閲覧数から、いま読まれている話題・急上昇・週間トピックを可視化するDATLUMEの話題ダッシュボード。">
  <link rel="canonical" href="https://datlume.com/topics/">
  <meta property="og:url" content="https://datlume.com/topics/">
  <meta property="og:title" content="話題のトピック | DATLUME">
  <meta property="og:description" content="日本語版Wikipediaの閲覧動向から、いま注目されている話題をランキングと推移で見る。">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary">
  <title>話題のトピック | 日本語版Wikipedia閲覧トレンド | DATLUME</title>
  <style>
    :root{color-scheme:light;--ink:#142033;--muted:#667085;--line:#e4e9f0;--bg:#f4f6f9;--card:#fff;--nav:#0e1b2e;--blue:#1769e0;--soft:#eef5ff;--green:#087f5b;--red:#c2415d;--amber:#b46b00}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Noto Sans JP",sans-serif}a{color:inherit}.wrap{width:min(1180px,calc(100% - 32px));margin:auto}
    header{background:var(--nav);color:#fff;padding:20px 0 66px}.nav{display:flex;align-items:center;justify-content:space-between;gap:18px}.navlinks{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end;margin-left:auto}.navlinks a{font-size:12px;color:#d9e4f4;border:1px solid #ffffff29;border-radius:999px;padding:8px 11px;text-decoration:none}.hero{padding-top:62px}.eyebrow{font-size:11px;font-weight:850;letter-spacing:.15em;color:#8ebdff;text-transform:uppercase;margin-bottom:15px}.hero h1{font-size:clamp(44px,7vw,76px);letter-spacing:-.055em;line-height:1;margin:0 0 18px}.hero p{margin:0;color:#c7d3e4;line-height:1.8;font-size:15px;max-width:790px}.hero-meta{display:flex;gap:8px;flex-wrap:wrap;margin-top:22px}.hero-pill{border:1px solid #ffffff2f;background:#ffffff12;border-radius:999px;padding:8px 11px;font-size:11px;color:#e8eef8}
    main.wrap{margin-top:18px;padding-bottom:72px}.card{background:#fff;border:1px solid var(--line);border-radius:18px}.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.kpi{padding:18px 19px}.label{font-size:10.5px;color:var(--muted);font-weight:800;letter-spacing:.02em}.value{font-size:27px;font-weight:880;letter-spacing:-.035em;margin-top:6px;line-height:1.08}.sub{font-size:10.5px;color:var(--muted);margin-top:6px;line-height:1.5}.section{margin-top:14px;padding:20px}.section-head{display:flex;align-items:end;justify-content:space-between;gap:14px;margin-bottom:15px}.section-head h2{font-size:19px;margin:0;letter-spacing:-.02em}.section-head p{font-size:10.5px;color:var(--muted);margin:3px 0 0;line-height:1.55}
    .spotlight{display:grid;grid-template-columns:1.25fr .95fr .95fr;gap:12px}.topic-card{position:relative;min-height:176px;padding:20px;overflow:hidden}.topic-card:first-child{background:linear-gradient(145deg,#0f2747,#163b68);color:#fff;border-color:#1d4678}.topic-rank{font-size:11px;font-weight:900;letter-spacing:.08em;color:var(--blue)}.topic-card:first-child .topic-rank{color:#9ec7ff}.topic-title{font-size:23px;font-weight:900;letter-spacing:-.035em;line-height:1.25;margin-top:15px;word-break:break-word}.topic-card:first-child .topic-title{font-size:30px}.topic-meta{position:absolute;left:20px;right:20px;bottom:18px;display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:11px}.topic-card:not(:first-child) .topic-meta{color:var(--muted)}.delta{font-weight:850}.up{color:var(--green)}.down{color:var(--red)}.flat{color:var(--muted)}.new{color:var(--blue)}
    .pulse-grid{display:grid;grid-template-columns:repeat(14,minmax(28px,1fr));gap:7px;align-items:end;height:168px;padding:8px 0 2px}.pulse-day{display:flex;flex-direction:column;align-items:center;justify-content:flex-end;gap:5px;height:100%}.pulse-track{height:124px;width:100%;max-width:44px;display:flex;align-items:flex-end;background:#f0f3f7;border-radius:8px;overflow:hidden}.pulse-bar{width:100%;background:linear-gradient(180deg,#6fa7f0,#1769e0);border-radius:7px 7px 0 0;min-height:3px}.pulse-date{font-size:9px;color:var(--muted);white-space:nowrap}.pulse-value{font-size:9px;font-weight:800;color:#475467;white-space:nowrap}
    .tabs{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.tab{border:1px solid var(--line);background:#fff;border-radius:999px;padding:9px 13px;font-size:11px;font-weight:850;color:#475467;cursor:pointer}.tab.active{background:var(--nav);border-color:var(--nav);color:#fff}.search{margin-left:auto;width:min(260px,100%);border:1px solid var(--line);background:#fff;border-radius:10px;padding:9px 11px;font:inherit;font-size:12px;color:var(--ink);outline:none}.search:focus{border-color:#9bc2f5;box-shadow:0 0 0 3px #1769e012}.panel[hidden]{display:none!important}
    .rank-list{display:grid;gap:0}.rank-row{display:grid;grid-template-columns:52px minmax(0,1.7fr) 110px 90px 96px 112px;gap:10px;align-items:center;padding:13px 4px;border-bottom:1px solid #eef1f5}.rank-row:last-child{border-bottom:0}.rank-no{font-size:15px;font-weight:900;color:#344054;text-align:center;font-variant-numeric:tabular-nums}.rank-title{min-width:0}.rank-title a{font-size:13px;font-weight:800;text-decoration:none}.rank-title a:hover{color:var(--blue)}.rank-note{font-size:9.5px;color:var(--muted);margin-top:3px}.num{text-align:right;font-size:11px;font-weight:780;font-variant-numeric:tabular-nums}.rank-delta{text-align:center;font-size:10.5px;font-weight:900}.spark{display:flex;align-items:end;gap:2px;height:30px;justify-content:flex-end}.spark i{display:block;width:7px;min-height:2px;border-radius:2px 2px 0 0;background:#8db8ef}.spark i:last-child{background:var(--blue)}
    .rising-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.rising-card{padding:15px 16px;display:grid;grid-template-columns:46px 1fr auto;gap:12px;align-items:center}.rise-rank{width:38px;height:38px;border-radius:10px;background:var(--soft);color:var(--blue);display:grid;place-items:center;font-size:12px;font-weight:900}.rise-title a{font-size:13px;font-weight:850;text-decoration:none}.rise-title div{font-size:9.5px;color:var(--muted);margin-top:4px}.rise-value{text-align:right;font-size:16px;font-weight:900;color:var(--green)}
    .weekly-list{display:grid;gap:8px}.weekly-row{display:grid;grid-template-columns:38px minmax(0,1.3fr) minmax(120px,1fr) 92px 72px;gap:10px;align-items:center}.weekly-rank{font-size:12px;font-weight:900;text-align:center}.weekly-title a{font-size:12px;font-weight:800;text-decoration:none}.weekly-track{height:10px;background:#eef1f5;border-radius:99px;overflow:hidden}.weekly-bar{height:100%;background:linear-gradient(90deg,#1769e0,#75a8ee);border-radius:99px}.weekly-total,.weekly-best{font-size:10.5px;text-align:right;font-weight:800;font-variant-numeric:tabular-nums}.note{margin-top:14px;padding:17px 19px;font-size:11px;line-height:1.75;color:#475467}.note strong{color:var(--ink)}.source-link{color:var(--blue);font-weight:800;text-decoration:none}footer{border-top:1px solid var(--line);padding:28px 0 44px;color:var(--muted);font-size:11px;line-height:1.8}
    @media(max-width:900px){.kpis{grid-template-columns:1fr 1fr}.spotlight{grid-template-columns:1fr 1fr}.topic-card:first-child{grid-column:1/-1}.rank-row{grid-template-columns:44px minmax(0,1fr) 88px 74px}.rank-row .avg,.rank-row .spark{display:none}.pulse-grid{overflow-x:auto;grid-template-columns:repeat(14,44px);justify-content:start}.rising-grid{grid-template-columns:1fr}.weekly-row{grid-template-columns:34px minmax(0,1fr) 90px}.weekly-track,.weekly-best{display:none}}
    @media(max-width:640px){.wrap{width:min(100% - 24px,1180px)}header{padding-bottom:48px}.nav{align-items:flex-start;flex-direction:column}.navlinks{width:100%;overflow-x:auto;flex-wrap:nowrap;justify-content:flex-start;margin-left:0;padding-bottom:2px}.navlinks a{white-space:nowrap;flex:0 0 auto}.hero{padding-top:44px}.hero h1{font-size:43px}.kpis{grid-template-columns:1fr 1fr}.kpi{padding:15px}.value{font-size:22px}.spotlight{grid-template-columns:1fr}.topic-card:first-child{grid-column:auto}.topic-card{min-height:156px}.topic-card:first-child .topic-title{font-size:25px}.section{padding:16px}.section-head{align-items:flex-start;flex-direction:column;gap:5px}.tabs{align-items:stretch}.search{order:2;margin-left:0;width:100%}.rank-row{grid-template-columns:34px minmax(0,1fr) 76px;gap:7px;padding:12px 0}.rank-row .rank-delta{display:none}.rank-title a{font-size:12px}.weekly-row{grid-template-columns:30px minmax(0,1fr) 82px}.rising-card{grid-template-columns:40px 1fr auto;padding:13px}.rise-rank{width:34px;height:34px}.rise-value{font-size:14px}}
  </style>
</head>
<body>
<header>
  <div class="wrap">
    <nav class="nav"><a class="brand" href="/" aria-label="DATLUME" style="display:inline-flex;align-items:center;gap:10px;text-decoration:none;color:#fff"><img src="/favicon.svg" alt="" width="24" height="24" style="display:block;width:24px;height:24px;filter:brightness(0) invert(1)"><span style="font-family:'Segoe UI Variable','Avenir Next','Helvetica Neue',system-ui,sans-serif;font-size:19px;font-weight:750;letter-spacing:.16em;line-height:1">DATLUME</span></a><div class="navlinks"><a href="/">トップ</a><a href="/topics/">話題のトピック</a><a href="/listed-companies/">上場企業</a><a href="/unlisted-companies/">未上場企業</a><a href="/economy-prices/">経済・物価</a><a href="/about-data/">データについて</a></div></nav>
    <section class="hero">
      <div class="eyebrow">Japanese Wikipedia / Pageview Trends</div>
      <h1>話題のトピック</h1>
      <p>日本語版Wikipediaで「いま何が読まれているか」を、総合ランキング・急上昇・週間の強さから見るダッシュボードです。ニュースやSNSとは違う、百科事典を読みに行く人の関心の動きを可視化します。</p>
      <div class="hero-meta"><span class="hero-pill">最新データ {fmtDate(data.latestDate)}</span><span class="hero-pill">14日間を比較</span><span class="hero-pill">Wikimedia公式Pageviews API</span></div>
    </section>
  </div>
</header>
<main class="wrap">
  <section class="kpis" aria-label="最新トレンド概要">
    <div class="card kpi"><div class="label">いま最も読まれている</div><div class="value" style="font-size:20px">{leader?.article || '—'}</div><div class="sub">{leader ? `${fmt(leader.views)} PV / 1位` : 'データなし'}</div></div>
    <div class="card kpi"><div class="label">上位100記事の閲覧数</div><div class="value">{fmt(data.summary?.latestTop100Views)}</div><div class="sub">{fmtDate(data.latestDate)} / 特殊ページ除外後</div></div>
    <div class="card kpi"><div class="label">TOP20 新着</div><div class="value">{fmt(data.summary?.newEntriesTop20)}件</div><div class="sub">前日のTOP100圏外 → 今日TOP20</div></div>
    <div class="card kpi"><div class="label">最大の急上昇</div><div class="value" style="font-size:18px">{biggestRiser?.article || '—'}</div><div class="sub">{biggestRiser ? `前日比 ${fmtPct(biggestRiser.viewChangePct)}` : '比較可能なデータなし'}</div></div>
  </section>

  <section class="section card">
    <div class="section-head"><div><h2>いま読まれている話題</h2><p>最新日の上位3トピック。クリックすると日本語版Wikipediaを開きます。</p></div><span class="label">{fmtDate(data.latestDate)}</span></div>
    <div class="spotlight">
      {top.slice(0,3).map((x) => <a class="card topic-card" href={x.url} target="_blank" rel="noreferrer" style="text-decoration:none"><div class="topic-rank">#{x.rank}</div><div class="topic-title">{x.article}</div><div class="topic-meta"><span>{fmt(x.views)} PV</span><span class:list={["delta", x.isNew ? "new" : trendClass(x.rankChange)]}>{rankLabel(x)}</span></div></a>)}
    </div>
  </section>

  <section class="section card">
    <div class="section-head"><div><h2>14日間の閲覧ボリューム</h2><p>各日の上位100記事のPV合計。全Wikipedia閲覧数ではありません。</p></div><span class="label">{fmtShortDate(data.window?.from)} → {fmtShortDate(data.window?.to)}</span></div>
    <div class="pulse-grid" aria-label="上位100記事の日別閲覧数">
      {daily.map((x) => <div class="pulse-day" title={`${x.date} ${fmt(x.top100Views)} PV / 1位 ${x.leader}`}><span class="pulse-value">{(x.top100Views/10000).toFixed(0)}万</span><div class="pulse-track"><div class="pulse-bar" style={`height:${Math.max(3,(Number(x.top100Views)||0)/maxDaily*100)}%`}></div></div><span class="pulse-date">{fmtShortDate(x.date)}</span></div>)}
    </div>
  </section>

  <section class="section card">
    <div class="section-head"><div><h2>トピックランキング</h2><p>総合・急上昇・週間を切り替えて確認できます。</p></div></div>
    <div class="tabs" role="tablist" aria-label="ランキング切替">
      <button class="tab active" type="button" role="tab" aria-selected="true" data-tab="overall">総合ランキング</button>
      <button class="tab" type="button" role="tab" aria-selected="false" data-tab="rising">急上昇</button>
      <button class="tab" type="button" role="tab" aria-selected="false" data-tab="weekly">週間</button>
      <input class="search" id="topic-search" type="search" placeholder="総合ランキングを検索" aria-label="トピック検索">
    </div>

    <div class="panel" data-panel="overall" style="margin-top:14px">
      <div class="rank-list" id="overall-list">
        {top.map((x) => {
          const vals = x.history?.map((h) => Number(h.views) || 0) || [];
          const max = Math.max(1, ...vals);
          return <div class="rank-row" data-title={x.article.toLowerCase()}>
            <div class="rank-no">{x.rank}</div>
            <div class="rank-title"><a href={x.url} target="_blank" rel="noreferrer">{x.article}</a><div class="rank-note">7日TOP100入り {x.daysInTop100}日</div></div>
            <div class="num">{fmt(x.views)} PV</div>
            <div class:list={["rank-delta", x.isNew ? "new" : trendClass(x.rankChange)]}>{rankLabel(x)}</div>
            <div class:list={["num","avg",trendClass(x.vsAverage7Pct)]}>{fmtPct(x.vsAverage7Pct)}</div>
            <div class="spark" aria-label="7日閲覧推移">{vals.map((v) => <i style={`height:${v ? Math.max(8,v/max*100) : 2}%`}></i>)}</div>
          </div>;
        })}
      </div>
    </div>

    <div class="panel" data-panel="rising" hidden style="margin-top:14px">
      <div class="rising-grid">
        {rising.map((x, i) => <div class="card rising-card"><div class="rise-rank">{i+1}</div><div class="rise-title"><a href={x.url} target="_blank" rel="noreferrer">{x.article}</a><div>現在 #{x.rank} / {fmt(x.views)} PV / 前日 {x.previousRank ? `#${x.previousRank}` : '圏外'}</div></div><div class="rise-value">{fmtPct(x.viewChangePct)}</div></div>)}
      </div>
    </div>

    <div class="panel" data-panel="weekly" hidden style="margin-top:14px">
      <div class="weekly-list">
        {weekly.map((x, i) => <div class="weekly-row"><div class="weekly-rank">{i+1}</div><div class="weekly-title"><a href={x.url} target="_blank" rel="noreferrer">{x.article}</a></div><div class="weekly-track"><div class="weekly-bar" style={`width:${Math.max(2,x.totalViews/maxWeekly*100)}%`}></div></div><div class="weekly-total">{fmt(x.totalViews)} PV</div><div class="weekly-best">最高 #{x.bestRank}</div></div>)}
      </div>
    </div>
  </section>

  <aside class="card note">
    <strong>このページの読み方：</strong> 「話題」は日本語版Wikipediaの閲覧動向を指し、日本全体の検索トレンド・SNS投稿量・世論を直接示すものではありません。メインページ、検索などの特殊ページはランキングから除外しています。急上昇は前日に3,000PV以上あった記事の前日比から算出し、週間は直近7日の日別上位データを合算しています。データ更新にはWikimedia側の集計遅延があるため、取得できた最新日を自動採用します。<br>出典：<a class="source-link" href="https://doc.wikimedia.org/generated-data-platform/aqs/analytics-api/reference/page-views.html" target="_blank" rel="noreferrer">Wikimedia Analytics API - Pageviews ↗</a> / 最終生成 {generated} JST
  </aside>
</main>
<footer><div class="wrap">DATLUME · <a href="/">トップへ</a> · <a href="/about-data/">データについて</a> · <a href="https://github.com/kkoch5t2/data-platform" target="_blank" rel="noreferrer" style="display:inline-flex;align-items:center;gap:5px"><img src="/brand/github.svg" alt="" width="14" height="14" style="display:block;width:14px;height:14px">GitHub ↗</a> · <a href="/privacy/">プライバシーポリシー</a></div></footer>
<script>
  const tabs = Array.from(document.querySelectorAll('[data-tab]'));
  const panels = Array.from(document.querySelectorAll('[data-panel]'));
  const search = document.getElementById('topic-search');
  tabs.forEach((tab) => tab.addEventListener('click', () => {
    const key = tab.dataset.tab;
    tabs.forEach((x) => { x.classList.toggle('active', x === tab); x.setAttribute('aria-selected', x === tab ? 'true' : 'false'); });
    panels.forEach((panel) => panel.hidden = panel.dataset.panel !== key);
    if (search) search.style.visibility = key === 'overall' ? 'visible' : 'hidden';
  }));
  search?.addEventListener('input', () => {
    const q = search.value.trim().toLowerCase();
    document.querySelectorAll('#overall-list .rank-row').forEach((row) => {
      row.style.display = !q || (row.dataset.title || '').includes(q) ? '' : 'none';
    });
  });
</script>
</body>
</html>
