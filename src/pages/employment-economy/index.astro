---
import fs from 'node:fs';import path from 'node:path';
const data=JSON.parse(fs.readFileSync(path.join(process.cwd(),'public/data/employment-economy-2026.json'),'utf8'));
const records=data.records;
const defs={
  annualPay:{field:'estimatedAnnualCashThousandYen',label:'推計年収',unit:'万円',scale:.1,year:data.wageYear},
  monthlyPay:{field:'monthlyCashSalaryThousandYen',label:'月額賃金',unit:'万円',scale:.1,year:data.wageYear},
  bonus:{field:'annualBonusThousandYen',label:'年間賞与',unit:'万円',scale:.1,year:data.wageYear},
  jobRatio:{field:'jobOpeningRatio',label:'有効求人倍率（参考）',unit:'倍',scale:1,year:2023},
  income:{field:'incomePerCapitaThousandYen',label:'1人当たり県民所得',unit:'万円',scale:.1,year:2021},
  gdp:{field:'gdpMillionYen',label:'県内総生産',unit:'兆円',scale:1e-6,year:2021},
  employees:{field:'employees',label:'民営従業者数',unit:'万人',scale:1e-4,year:2021},
  establishments:{field:'establishments',label:'民営事業所数',unit:'万所',scale:1e-4,year:2021},
  infoShare:{field:'infoEmployeeShare',label:'情報通信業の従業者比率',unit:'%',scale:1,year:2021},
  constructionShare:{field:'constructionEmployeeShare',label:'建設業の従業者比率',unit:'%',scale:1,year:2021},
  manufacturingShare:{field:'manufacturingEmployeeShare',label:'製造業の従業者比率',unit:'%',scale:1,year:2021},
  retailShare:{field:'retailEmployeeShare',label:'卸売・小売業の従業者比率',unit:'%',scale:1,year:2021},
  medicalShare:{field:'medicalEmployeeShare',label:'医療・福祉の従業者比率',unit:'%',scale:1,year:2021}
};
const jsonLd={"@context":"https://schema.org","@type":"Dataset","name":"都道府県別 雇用・賃金・地域経済データ","description":"47都道府県の賃金、年齢別賃金、求人、県民所得、県内総生産、事業所、従業者を比較できるデータセット。","url":"https://datlume.com/employment-economy/","creator":{"@type":"Organization","name":"DATLUME"}};
