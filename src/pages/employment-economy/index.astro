<script id="employment-data" type="application/json" set:html={JSON.stringify({records,defs,ageBands:data.ageBands})}></script><script>
import * as echarts from 'echarts';
const {records,defs,ageBands}=JSON.parse(document.getElementById('employment-data').textContent);const byName=new Map(records.map(r=>[r.prefecture,r]));const nf=new Intl.NumberFormat('ja-JP',{maximumFractionDigits:2});
const pref=document.getElementById('pref'),compare=document.getElementById('compare'),overviewMetric=document.getElementById('overview-metric'),age=document.getElementById('age'),ageMetric=document.getElementById('age-metric'),economyMetric=document.getElementById('economy-metric'),industryMetric=document.getElementById('industry-metric'),wageHistoryMetric=document.getElementById('wage-history-metric');
const chartCache={};function chart(id){return chartCache[id]||(chartCache[id]=echarts.init(document.getElementById(id)))}function fmt(v,u=''){return v==null||!Number.isFinite(Number(v))?'—':nf.format(Number(v))+u}function ageDatum(r,b){return(r?.ageWages||[]).find(x=>x.ageBand===b)||null}function metricValue(r,key){const d=defs[key],x=r?.[d.field];return x==null?null:Number(x)*d.scale}
function rankOption(key,titleId){const d=defs[key],rows=records.filter(r=>metricValue(r,key)!=null).map(r=>({name:r.prefecture,value:metricValue(r,key)})).sort((a,b)=>b.value-a.value);if(titleId)document.getElementById(titleId).textContent=d.label+' 都道府県ランキング';return{tooltip:{trigger:'item',formatter:p=>p.name+'<br><b>'+fmt(p.value,d.unit)+'</b>'},grid:{left:82,right:72,top:10,bottom:24},xAxis:{type:'value',show:false},yAxis:{type:'category',inverse:true,data:rows.slice(0,20).map(x=>x.name)},series:[{type:'bar',data:rows.slice(0,20).map(x=>x.value),barWidth:12,label:{show:true,position:'right',fontSize:10,formatter:p=>fmt(p.value,d.unit)}}]}}
function comparisonOption(items,aName,bName){const hasB=!!bName;const categories=items.map(x=>x[0]);const aData=[],bData=[];for(const [label,a,b,u] of items){const av=Number(a),bv=Number(b),okA=Number.isFinite(av),okB=hasB&&Number.isFinite(bv),max=Math.max(okA?Math.abs(av):0,okB?Math.abs(bv):0,1);aData.push({value:okA?Math.abs(av)/max*100:0,raw:okA?av:null,unit:u,label});if(hasB)bData.push({value:okB?Math.abs(bv)/max*100:0,raw:okB?bv:null,unit:u,label})}const series=[{name:'A · '+aName,type:'bar',barWidth:14,barGap:'35%',itemStyle:{color:'#1769e0',borderRadius:[0,7,7,0]},data:aData,label:{show:true,position:'right',fontSize:10,fontWeight:700,color:'#344054',formatter:p=>fmt(p.data.raw,p.data.unit)}}];if(hasB)series.push({name:'B · '+bName,type:'bar',barWidth:14,itemStyle:{color:'#087f5b',borderRadius:[0,7,7,0]},data:bData,label:{show:true,position:'right',fontSize:10,fontWeight:700,color:'#344054',formatter:p=>fmt(p.data.raw,p.data.unit)}});return{animationDuration:350,tooltip:{trigger:'axis',axisPointer:{type:'shadow'},formatter:params=>params.map(p=>`${p.marker}${p.seriesName}<br><b>${fmt(p.data.raw,p.data.unit)}</b>`).join('<br>')},legend:{top:0,left:0,itemWidth:10,itemHeight:10,textStyle:{fontSize:10,color:'#667085'}},grid:{left:108,right:82,top:44,bottom:18},xAxis:{type:'value',min:0,max:100,show:false},yAxis:{type:'category',inverse:true,data:categories,axisTick:{show:false},axisLine:{show:false},axisLabel:{fontSize:11,fontWeight:700,color:'#344054'}},series}}
function renderOverview(){const a=byName.get(pref.value),b=compare.value?byName.get(compare.value):null;document.getElementById('overview-pay').textContent=fmt(a.estimatedAnnualCashThousandYen*.1,'万円');document.getElementById('overview-job').textContent=fmt(a.jobOpeningRatio,'倍');document.getElementById('overview-income').textContent=fmt(a.incomePerCapitaThousandYen*.1,'万円');document.getElementById('overview-employees').textContent=fmt(a.employees/1e4,'万人');const k=overviewMetric.value,d=defs[k];document.getElementById('overview-rank-sub').textContent=d.year+'年 / 47都道府県';chart('overview-ranking').setOption(rankOption(k,'overview-rank-title'),true);chart('overview-comparison').setOption(comparisonOption([['推計年収',a.estimatedAnnualCashThousandYen*.1,b?.estimatedAnnualCashThousandYen*.1,'万円'],['求人倍率',a.jobOpeningRatio,b?.jobOpeningRatio,'倍'],['県民所得/人',a.incomePerCapitaThousandYen*.1,b?.incomePerCapitaThousandYen*.1,'万円'],['情報通信業比率',a.infoEmployeeShare,b?.infoEmployeeShare,'%']],a.prefecture,b?.prefecture),true)}
function renderAge(){const a=byName.get(pref.value),b=compare.value?byName.get(compare.value):null,aa=ageDatum(a,age.value),bb=ageDatum(b,age.value);document.getElementById('age-kpi-age').textContent=age.value;document.getElementById('age-compare-sub').textContent=age.value+'のA/B比較';document.getElementById('age-pay').textContent=fmt(aa?.estimatedAnnualCashThousandYen*.1,'万円');document.getElementById('age-monthly').textContent=fmt(aa?.monthlyCashSalaryThousandYen*.1,'万円');document.getElementById('age-bonus').textContent=fmt(aa?.annualBonusThousandYen*.1,'万円');document.getElementById('age-tenure').textContent=fmt(aa?.averageTenureYears,'年');const field=ageMetric.value==='monthly'?'monthlyCashSalaryThousandYen':ageMetric.value==='bonus'?'annualBonusThousandYen':'estimatedAnnualCashThousandYen',label=ageMetric.value==='monthly'?'月額賃金':ageMetric.value==='bonus'?'年間賞与':'推計年収';const rr=records.map(r=>({name:r.prefecture,value:(ageDatum(r,age.value)?.[field]??null)*.1})).filter(x=>Number.isFinite(x.value)).sort((a,b)=>b.value-a.value);document.getElementById('age-rank-title').textContent=age.value+' '+label+' 都道府県ランキング';chart('age-ranking').setOption({tooltip:{trigger:'item',formatter:p=>p.name+'<br><b>'+fmt(p.value,'万円')+'</b>'},grid:{left:82,right:72,top:10,bottom:24},xAxis:{type:'value',show:false},yAxis:{type:'category',inverse:true,data:rr.slice(0,20).map(x=>x.name)},series:[{type:'bar',data:rr.slice(0,20).map(x=>x.value),barWidth:12,label:{show:true,position:'right',fontSize:10,formatter:p=>fmt(p.value,'万円')}}]},true);chart('age-comparison').setOption(comparisonOption([['推計年収',aa?.estimatedAnnualCashThousandYen*.1,bb?.estimatedAnnualCashThousandYen*.1,'万円'],['月額賃金',aa?.monthlyCashSalaryThousandYen*.1,bb?.monthlyCashSalaryThousandYen*.1,'万円'],['年間賞与',aa?.annualBonusThousandYen*.1,bb?.annualBonusThousandYen*.1,'万円'],['平均勤続',aa?.averageTenureYears,bb?.averageTenureYears,'年']],a.prefecture,b?.prefecture),true);const series=[{name:a.prefecture,type:'line',smooth:.18,symbolSize:7,lineStyle:{width:3},data:ageBands.map(x=>[x,(ageDatum(a,x)?.estimatedAnnualCashThousandYen??null)*.1])}];if(b)series.push({name:b.prefecture,type:'line',smooth:.18,symbolSize:7,lineStyle:{width:3},data:ageBands.map(x=>[x,(ageDatum(b,x)?.estimatedAnnualCashThousandYen??null)*.1])});chart('age-wage').setOption({tooltip:{trigger:'axis',valueFormatter:v=>fmt(v,'万円')},legend:{top:0},grid:{left:62,right:20,top:42,bottom:58},xAxis:{type:'category',data:ageBands,axisLabel:{rotate:28}},yAxis:{type:'value',scale:true,axisLabel:{formatter:v=>nf.format(v)+'万'}},series},true)}
function renderJobs(){const a=byName.get(pref.value),b=compare.value?byName.get(compare.value):null,latest=a.jobTrend.at(-1)||{};document.getElementById('jobs-ratio').textContent=fmt(a.jobOpeningRatio,'倍');document.getElementById('jobs-openings').textContent=fmt(latest.jobOpenings,'人');document.getElementById('jobs-seekers').textContent=fmt(latest.jobSeekers,'人');document.getElementById('jobs-working-age').textContent=fmt(a.workingAgeShare,'%');chart('jobs-ranking').setOption(rankOption('jobRatio'),true);const series=[{name:a.prefecture,type:'line',smooth:.18,symbolSize:7,lineStyle:{width:3},data:a.jobTrend.map(x=>[x.year,x.jobOpeningRatio])}];if(b)series.push({name:b.prefecture,type:'line',smooth:.18,symbolSize:7,lineStyle:{width:3},data:b.jobTrend.map(x=>[x.year,x.jobOpeningRatio])});chart('job-trend').setOption({tooltip:{trigger:'axis',valueFormatter:v=>fmt(v,'倍')},legend:{top:0},grid:{left:50,right:18,top:42,bottom:38},xAxis:{type:'value',min:2012,max:2023,interval:2,axisLabel:{formatter:v=>String(v)}},yAxis:{type:'value',scale:true},series},true)}
function renderEconomy(){const a=byName.get(pref.value),b=compare.value?byName.get(compare.value):null;document.getElementById('economy-income').textContent=fmt(a.incomePerCapitaThousandYen*.1,'万円');document.getElementById('economy-gdp').textContent=fmt(a.gdpMillionYen/1e6,'兆円');document.getElementById('economy-employees').textContent=fmt(a.employees/1e4,'万人');document.getElementById('economy-establishments').textContent=fmt(a.establishments/1e4,'万所');chart('economy-ranking').setOption(rankOption(economyMetric.value,'economy-rank-title'),true);chart('economy-comparison').setOption(comparisonOption([['県民所得/人',a.incomePerCapitaThousandYen*.1,b?.incomePerCapitaThousandYen*.1,'万円'],['県内総生産',a.gdpMillionYen/1e6,b?.gdpMillionYen/1e6,'兆円'],['従業者',a.employees/1e4,b?.employees/1e4,'万人'],['事業所',a.establishments/1e4,b?.establishments/1e4,'万所']],a.prefecture,b?.prefecture),true)}
function renderIndustry(){const a=byName.get(pref.value),b=compare.value?byName.get(compare.value):null;const fields=[['建設業','constructionEmployees'],['製造業','manufacturingEmployees'],['情報通信業','infoEmployees'],['卸売・小売','retailEmployees'],['宿泊・飲食','hospitalityEmployees'],['医療・福祉','medicalEmployees']];document.getElementById('industry-title').textContent='産業別従業者数';const series=[{name:'A · '+a.prefecture,type:'bar',barWidth:14,itemStyle:{color:'#1769e0',borderRadius:[0,7,7,0]},data:fields.map(([,f])=>(a?.[f]||0)/1e4),label:{show:true,position:'right',fontSize:10,fontWeight:700,color:'#344054',formatter:p=>fmt(p.value,'万人')}}];if(b)series.push({name:'B · '+b.prefecture,type:'bar',barWidth:14,itemStyle:{color:'#087f5b',borderRadius:[0,7,7,0]},data:fields.map(([,f])=>(b?.[f]||0)/1e4),label:{show:true,position:'right',fontSize:10,fontWeight:700,color:'#344054',formatter:p=>fmt(p.value,'万人')}});chart('industry-bars').setOption({animationDuration:350,tooltip:{trigger:'axis',axisPointer:{type:'shadow'},valueFormatter:v=>fmt(v,'万人')},legend:{top:0,left:0,itemWidth:10,itemHeight:10,textStyle:{fontSize:10,color:'#667085'}},grid:{left:86,right:82,top:44,bottom:22},xAxis:{type:'value',axisLabel:{fontSize:9,color:'#98a2b3',formatter:v=>nf.format(v)+'万'},splitLine:{lineStyle:{color:'#eef2f6'}}},yAxis:{type:'category',inverse:true,data:fields.map(x=>x[0]),axisTick:{show:false},axisLine:{show:false},axisLabel:{fontSize:11,fontWeight:700,color:'#344054'}},series},true);chart('industry-ranking').setOption(rankOption(industryMetric.value,'industry-rank-title'),true)}
let wageHistoryData=null;async function renderWageHistory(){const el=document.getElementById('wage-history-chart');if(!wageHistoryData){document.getElementById('wage-history-note').textContent='長期データを読み込み中…';try{const res=await fetch('/data/employment-wage-history.json');if(!res.ok)throw new Error('fetch');wageHistoryData=await res.json()}catch(e){document.getElementById('wage-history-note').textContent='長期データを読み込めませんでした';return}}const field=wageHistoryMetric.value,idx=wageHistoryData.fields.indexOf(field),unit=field==='estimatedAnnualCashThousandYen'?'万円':field==='monthlyCashSalaryThousandYen'?'万円':'万円',scale=.1;const rec=name=>wageHistoryData.records.find(r=>r.prefecture===name);const mk=name=>({name,type:'line',smooth:.16,symbolSize:7,lineStyle:{width:3},data:(rec(name)?.values||[]).map(v=>[v[0],v[idx]==null?null:Number(v[idx])*scale])});const series=[mk(pref.value)];if(compare.value)series.push(mk(compare.value));chart('wage-history-chart').setOption({tooltip:{trigger:'axis',valueFormatter:v=>fmt(v,unit)},legend:{top:0},grid:{left:62,right:22,top:44,bottom:38},xAxis:{type:'value',min:wageHistoryData.years[0],max:wageHistoryData.years.at(-1),interval:1,axisLabel:{formatter:v=>String(v)}},yAxis:{type:'value',scale:true,axisLabel:{formatter:v=>nf.format(v)+'万'}},series},true);document.getElementById('wage-history-note').textContent=wageHistoryData.years[0]+'〜'+wageHistoryData.years.at(-1)+'年 / 厚生労働省 賃金構造基本統計調査 / 過去データはこのタブを開いた時だけ取得'}
const renderers={overview:renderOverview,age:renderAge,'wage-history':renderWageHistory,jobs:renderJobs,economy:renderEconomy,industry:renderIndustry};let activeTab='overview';function setTab(tab,{sync=true}={}){if(!renderers[tab])tab='overview';activeTab=tab;document.querySelectorAll('.tab').forEach(b=>b.setAttribute('aria-selected',String(b.dataset.tab===tab)));document.querySelectorAll('.tab-panel').forEach(p=>p.hidden=p.dataset.panel!==tab);requestAnimationFrame(()=>{renderers[tab]();Object.values(chartCache).forEach(c=>c.resize())});if(sync)syncUrl()}function syncUrl(){const q=new URLSearchParams();q.set('tab',activeTab);q.set('pref',pref.value);if(compare.value)q.set('compare',compare.value);if(activeTab==='overview')q.set('metric',overviewMetric.value);if(activeTab==='age'){q.set('age',age.value);q.set('metric',ageMetric.value)}if(activeTab==='wage-history')q.set('metric',wageHistoryMetric.value);if(activeTab==='economy')q.set('metric',economyMetric.value);if(activeTab==='industry')q.set('metric',industryMetric.value);history.replaceState(null,'','?'+q.toString())}function restore(){const q=new URLSearchParams(location.search);if(!q.get('pref')&&[...pref.options].some(o=>o.value==='東京都'))pref.value='東京都';for(const [el,k] of [[pref,'pref'],[compare,'compare'],[age,'age']]){const v=q.get(k);if(v&&[...el.options].some(o=>o.value===v))el.value=v}const tab=q.get('tab')||'overview',m=q.get('metric');if(tab==='overview'&&m&&[...overviewMetric.options].some(o=>o.value===m))overviewMetric.value=m;if(tab==='age'&&m&&[...ageMetric.options].some(o=>o.value===m))ageMetric.value=m;if(tab==='wage-history'&&m&&[...wageHistoryMetric.options].some(o=>o.value===m))wageHistoryMetric.value=m;if(tab==='economy'&&m&&[...economyMetric.options].some(o=>o.value===m))economyMetric.value=m;if(tab==='industry'&&m&&[...industryMetric.options].some(o=>o.value===m))industryMetric.value=m;activeTab=tab}function normalizeComparison(){if(compare.value&&compare.value===pref.value)compare.value=''}restore();normalizeComparison();for(const b of document.querySelectorAll('.tab'))b.addEventListener('click',()=>setTab(b.dataset.tab));for(const el of [pref,compare,overviewMetric,age,ageMetric,wageHistoryMetric,economyMetric,industryMetric])el.addEventListener('change',()=>{normalizeComparison();renderers[activeTab]();syncUrl()});setTab(activeTab,{sync:false});window.addEventListener('resize',()=>Object.values(chartCache).forEach(c=>c.resize()));
</script></body></html>
