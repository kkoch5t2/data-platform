---
import fs from 'node:fs';import path from 'node:path';
const data=JSON.parse(fs.readFileSync(path.join(process.cwd(),'public/data/employment-economy-2026.json'),'utf8'));
const records=data.records;
const metricDefs={
  annualPay:{field:'estimatedAnnualCashThousandYen',label:'推計年収',unit:'万円',scale:.1,year:data.wageYear},
  monthlyPay:{field:'monthlyCashSalaryThousandYen',label:'月額賃金',unit:'万円',scale:.1,year:data.wageYear},
  bonus:{field:'annualBonusThousandYen',label:'年間賞与',unit:'万円',scale:.1,year:data.wageYear},
  jobRatio:{field:'jobOpeningRatio',label:'有効求人倍率（参考）',unit:'倍',scale:1,year:2023},
  income:{field:'incomePerCapitaThousandYen',label:'1人当たり県民所得',unit:'万円',scale:.1,year:2021},
  gdp:{field:'gdpMillionYen',label:'県内総生産',unit:'兆円',scale:1/1e6,year:2021},
  employees:{field:'employees',label:'民営従業者数',unit:'万人',scale:1/10000,year:2021},
  establishments:{field:'establishments',label:'民営事業所数',unit:'万所',scale:1/10000,year:2021},
  infoShare:{field:'infoEmployeeShare',label:'情報通信業の従業者比率',unit:'%',scale:1,year:2021}
};
const jsonLd={"@context":"https://schema.org","@type":"Dataset","name":"都道府県別 雇用・賃金・地域経済データ","description":"47都道府県の賃金、求人、県民所得、県内総生産、事業所、従業者を比較できるデータセット。","url":"https://datlume.pages.dev/employment-economy/","creator":{"@type":"Organization","name":"DATLUME"}};
---
<!doctype html><html lang="ja"><head><link rel="icon" type="image/svg+xml" href="/favicon.svg"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="description" content="47都道府県の平均賃金・推計年収、求人倍率、県民所得、GDP、事業所・従業者を比較。厚生労働省・統計センターの公式データを可視化。"><link rel="canonical" href="https://datlume.pages.dev/employment-economy/"><meta property="og:title" content="雇用・賃金・地域経済 | DATLUME"><meta property="og:description" content="都道府県別の賃金、求人、所得、GDP、産業構造を横断比較。"><meta property="og:type" content="website"><meta name="twitter:card" content="summary"><script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script><title>都道府県別 平均賃金・求人・地域経済 | DATLUME</title><style>
:root{--ink:#142033;--muted:#667085;--line:#e4e9f0;--bg:#f4f6f9;--card:#fff;--nav:#0e1b2e;--blue:#1769e0;--green:#087f5b}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,system-ui,-apple-system,"Noto Sans JP",sans-serif}.wrap{width:min(1240px,calc(100% - 32px));margin:auto}a{color:inherit}header{background:var(--nav);color:#fff;padding:20px 0 56px}.nav{display:flex;justify-content:space-between;align-items:center;gap:18px}.navlinks{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end;margin-left:auto}.navlinks a{font-size:12px;color:#d9e4f4;border:1px solid #ffffff2a;border-radius:999px;padding:7px 11px;text-decoration:none}.hero{margin-top:42px}.hero h1{font-size:clamp(38px,5.5vw,68px);letter-spacing:-.05em;margin:0 0 14px}.hero p{color:#c7d3e4;line-height:1.8;max-width:840px}.brand{text-decoration:none}main{margin-top:-26px;padding-bottom:68px}.card{background:#fff;border:1px solid var(--line);border-radius:16px}.controls{padding:16px;display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px}.control label{display:block;color:var(--muted);font-size:11px;font-weight:750;margin-bottom:6px}.control select{width:100%;height:42px;border:1px solid #d9dee7;border-radius:9px;background:#fff;padding:0 10px;font:inherit}.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:12px}.kpi{padding:17px;min-width:0}.kpi-label{font-size:11px;color:var(--muted)}.kpi-value{font-size:clamp(20px,2.4vw,28px);font-weight:820;margin-top:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.kpi-sub{font-size:10.5px;color:var(--muted);margin-top:4px;line-height:1.45}.grid{display:grid;grid-template-columns:1.45fr 1fr;gap:12px;margin-top:12px}.chart-card{padding:18px}.chart-card h2{font-size:16px;margin:0}.chart-sub{font-size:10.5px;color:var(--muted);margin:3px 0 8px}.chart{height:400px}.lower{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px}.industry-list{padding:18px}.industry-list h2{font-size:16px;margin:0 0 12px}.industry-row{display:grid;grid-template-columns:minmax(115px,1fr) 2fr 70px;gap:10px;align-items:center;margin:10px 0;font-size:12px}.track{height:8px;background:#edf1f6;border-radius:99px;overflow:hidden}.bar{height:100%;background:var(--blue);border-radius:99px}.amount{text-align:right;color:var(--muted)}.note{font-size:11px;color:var(--muted);line-height:1.75;margin-top:12px}.link-section{margin-top:28px}.link-section h2{font-size:20px}.link-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}.link-grid a{background:#fff;border:1px solid var(--line);border-radius:10px;padding:11px;text-decoration:none;font-size:12px;font-weight:700}.link-grid a:hover{border-color:#9abcf0;color:var(--blue)}footer{padding:26px 0 46px;color:var(--muted);font-size:11px}@media(max-width:900px){.controls{grid-template-columns:1fr 1fr}.grid,.lower{grid-template-columns:1fr}.chart{height:350px}.link-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:720px){.nav{display:block}.navlinks{margin-top:14px;overflow:auto;flex-wrap:nowrap;justify-content:flex-start;margin-left:0}.navlinks a{white-space:nowrap}.kpis{grid-template-columns:1fr 1fr}.controls{grid-template-columns:1fr}}@media(max-width:480px){.wrap{width:min(100% - 24px,1240px)}.link-grid{grid-template-columns:repeat(2,1fr)}.industry-row{grid-template-columns:105px 1fr 58px}.chart{height:320px}}
</style></head><body><header><div class="wrap"><div class="nav"><a class="brand" href="/" aria-label="DATLUME" style="display:inline-flex;align-items:center;gap:10px;text-decoration:none;color:#fff"><img src="/favicon.svg" alt="" width="24" height="24" style="display:block;width:24px;height:24px;filter:brightness(0) invert(1)"><span style="font-family:'Segoe UI Variable','Avenir Next','Helvetica Neue',system-ui,sans-serif;font-size:19px;font-weight:750;letter-spacing:.16em;line-height:1">DATLUME</span></a><div class="navlinks"><a href="/procurement/">公共調達</a><a href="/realestate/">不動産・暮らし</a><a href="/regional/">都道府県トレンド</a><a href="/about-data/">データについて</a><a href="https://github.com/kkoch5t2/data-platform" target="_blank" rel="noreferrer">GitHub ↗</a></div></div><div class="hero"><h1>雇用・賃金・地域経済</h1><p>平均賃金、求人倍率、県民所得、GDP、事業所・従業者。47都道府県の「働く」と「地域経済」を同じ画面で比べます。</p></div></div></header><main class="wrap">
<section class="card controls"><div class="control"><label for="pref">都道府県 A</label><select id="pref">{records.map(r=><option value={r.prefecture}>{r.prefecture}</option>)}</select></div><div class="control"><label for="compare">都道府県 B</label><select id="compare"><option value="">比較なし</option>{records.map(r=><option value={r.prefecture}>{r.prefecture}</option>)}</select></div><div class="control"><label for="metric">全国ランキング指標</label><select id="metric">{Object.entries(metricDefs).map(([key,d])=><option value={key}>{d.label}（{d.year}）</option>)}</select></div></section>
<section class="kpis"><div class="card kpi"><div id="pay-label" class="kpi-label">推計年収</div><div id="pay-value" class="kpi-value">—</div><div class="kpi-sub">2025年 / 月額賃金×12＋年間賞与</div></div><div class="card kpi"><div class="kpi-label">有効求人倍率（参考）</div><div id="job-value" class="kpi-value">—</div><div class="kpi-sub">2023年 / 有効求人数÷有効求職者数</div></div><div class="card kpi"><div class="kpi-label">1人当たり県民所得</div><div id="income-value" class="kpi-value">—</div><div class="kpi-sub">2021年</div></div><div class="card kpi"><div class="kpi-label">民営従業者数</div><div id="employee-value" class="kpi-value">—</div><div class="kpi-sub">2021年</div></div></section>
<section class="grid"><div class="card chart-card"><h2 id="rank-title">都道府県ランキング</h2><div id="rank-sub" class="chart-sub">—</div><div id="ranking" class="chart"></div></div><div class="card chart-card"><h2>有効求人倍率の推移</h2><div class="chart-sub">2012〜2023年 / 参考値</div><div id="job-trend" class="chart"></div></div></section>
<section class="lower"><div class="card industry-list"><h2 id="industry-title">産業別従業者構成</h2><div id="industry"></div></div><div class="card industry-list"><h2>比較サマリー</h2><div id="comparison"></div></div></section>
<div class="note"><strong>推計年収</strong>は「きまって支給する現金給与額×12＋年間賞与その他特別給与額」をDATLUMEで計算した参考値で、個人の年収や世帯所得を示すものではありません。賃金は一般労働者の都道府県別集計です。県民所得・GDP・事業所・従業者は指標ごとに収録年が異なります。 <a href="/about-data/#employment-economy">出典と注意点 →</a></div>
<section class="link-section"><h2>指標から見る</h2><div class="link-grid"><a href="/employment-economy/indicators/annual-pay/">推計年収</a><a href="/employment-economy/indicators/monthly-pay/">月額賃金</a><a href="/employment-economy/indicators/bonus/">年間賞与</a><a href="/employment-economy/indicators/job-opening-ratio/">求人倍率</a><a href="/employment-economy/indicators/income-per-capita/">1人当たり県民所得</a><a href="/employment-economy/indicators/gdp/">県内総生産</a><a href="/employment-economy/indicators/employees/">従業者数</a><a href="/employment-economy/indicators/establishments/">事業所数</a><a href="/employment-economy/indicators/info-share/">情報通信業比率</a></div></section>
<section class="link-section"><h2>都道府県から見る</h2><div class="link-grid">{records.map(r=><a href={`/employment-economy/prefectures/${encodeURIComponent(r.prefecture)}/`}>{r.prefecture}</a>)}</div></section>
</main><footer class="wrap">出典：厚生労働省 賃金構造基本統計調査 / 統計センター SSDSE · <a href="https://github.com/kkoch5t2/data-platform" target="_blank" rel="noreferrer">GitHub ↗</a></footer>
<script id="employment-data" type="application/json" set:html={JSON.stringify({records,metricDefs})}></script>
<script>
import * as echarts from 'echarts';
const {records,metricDefs}=JSON.parse(document.getElementById('employment-data').textContent);
const pref=document.getElementById('pref'),compare=document.getElementById('compare'),metric=document.getElementById('metric');const ranking=echarts.init(document.getElementById('ranking')),jobTrend=echarts.init(document.getElementById('job-trend'));const nf=new Intl.NumberFormat('ja-JP',{maximumFractionDigits:2});const byName=new Map(records.map(r=>[r.prefecture,r]));
function val(r,d){const x=r?.[d.field];return x==null?null:Number(x)*d.scale}function fmt(x,unit=''){return x==null?'—':nf.format(x)+unit}function row(label,a,b,unit=''){return `<div class="industry-row"><div>${label}</div><div class="track"><div class="bar" style="width:${Math.min(100,Math.max(0,b?Number(a)/Number(b)*100:0))}%"></div></div><div class="amount">${fmt(a,unit)}</div></div>`}
function draw(){const a=byName.get(pref.value),b=compare.value?byName.get(compare.value):null,d=metricDefs[metric.value];document.getElementById('pay-label').textContent=pref.value+' / 推計年収';document.getElementById('pay-value').textContent=fmt(a.estimatedAnnualCashThousandYen*.1,'万円');document.getElementById('job-value').textContent=fmt(a.jobOpeningRatio,'倍');document.getElementById('income-value').textContent=fmt(a.incomePerCapitaThousandYen*.1,'万円');document.getElementById('employee-value').textContent=fmt(a.employees/10000,'万人');
const rr=records.filter(r=>val(r,d)!=null).map(r=>({name:r.prefecture,value:val(r,d)})).sort((x,y)=>y.value-x.value);document.getElementById('rank-title').textContent=d.label+' 都道府県ランキング';document.getElementById('rank-sub').textContent=d.year+'年 / 47都道府県';ranking.setOption({tooltip:{trigger:'item',formatter:p=>p.name+'<br><b>'+fmt(p.value,d.unit)+'</b>'},grid:{left:82,right:72,top:10,bottom:24},xAxis:{type:'value',show:false},yAxis:{type:'category',inverse:true,data:rr.slice(0,20).map(x=>x.name)},series:[{type:'bar',data:rr.slice(0,20).map(x=>x.value),barWidth:12,label:{show:true,position:'right',fontSize:10,formatter:p=>fmt(p.value,d.unit)}}]},true);
const series=[{name:a.prefecture,type:'line',smooth:.18,symbolSize:7,lineStyle:{width:3},data:a.jobTrend.map(x=>[x.year,x.jobOpeningRatio])}];if(b)series.push({name:b.prefecture,type:'line',smooth:.18,symbolSize:7,lineStyle:{width:3},data:b.jobTrend.map(x=>[x.year,x.jobOpeningRatio])});jobTrend.setOption({tooltip:{trigger:'axis',valueFormatter:v=>fmt(v,'倍')},legend:{top:0},grid:{left:50,right:18,top:42,bottom:38},xAxis:{type:'value',min:2012,max:2023,interval:2,axisLabel:{formatter:v=>String(v)}},yAxis:{type:'value',scale:true},series},true);
const inds=[['建設業',a.constructionEmployees],['製造業',a.manufacturingEmployees],['情報通信業',a.infoEmployees],['卸売・小売',a.retailEmployees],['宿泊・飲食',a.hospitalityEmployees],['医療・福祉',a.medicalEmployees]];const max=Math.max(...inds.map(x=>x[1]||0),1);document.getElementById('industry-title').textContent=a.prefecture+' / 産業別従業者数';document.getElementById('industry').innerHTML=inds.map(([l,v])=>row(l,v/10000,max/10000,'万人')).join('');
const comparison=[['推計年収',a.estimatedAnnualCashThousandYen*.1,b?.estimatedAnnualCashThousandYen*.1,'万円'],['求人倍率',a.jobOpeningRatio,b?.jobOpeningRatio,'倍'],['県民所得/人',a.incomePerCapitaThousandYen*.1,b?.incomePerCapitaThousandYen*.1,'万円'],['情報通信業比率',a.infoEmployeeShare,b?.infoEmployeeShare,'%']];document.getElementById('comparison').innerHTML=comparison.map(([l,av,bv,u])=>`<div class="industry-row"><div>${l}</div><div>${pref.value}: <b>${fmt(av,u)}</b>${b?`<br>${b.prefecture}: <b>${fmt(bv,u)}</b>`:''}</div><div class="amount"></div></div>`).join('');
const q=new URLSearchParams();q.set('pref',pref.value);if(compare.value)q.set('compare',compare.value);q.set('metric',metric.value);history.replaceState(null,'','?'+q.toString())}
function restore(){const q=new URLSearchParams(location.search);for(const [el,k] of [[pref,'pref'],[compare,'compare'],[metric,'metric']]){const v=q.get(k);if(v&&[...el.options].some(o=>o.value===v))el.value=v}if(!q.get('pref')&&[...pref.options].some(o=>o.value==='東京都'))pref.value='東京都'}restore();for(const el of [pref,compare,metric])el.addEventListener('change',draw);draw();window.addEventListener('resize',()=>{ranking.resize();jobTrend.resize()});
</script></body></html>
