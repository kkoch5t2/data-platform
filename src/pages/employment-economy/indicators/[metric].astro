---
import fs from 'node:fs';import path from 'node:path';import '../../../styles/detail.css';
const DEFS={
'annual-pay':{field:'estimatedAnnualCashThousandYen',label:'推計年収',unit:'万円',scale:.1,year:2025,desc:'きまって支給する現金給与額×12＋年間賞与その他特別給与額をDATLUMEで計算した参考値'},
'monthly-pay':{field:'monthlyCashSalaryThousandYen',label:'月額賃金',unit:'万円',scale:.1,year:2025,desc:'一般労働者のきまって支給する現金給与額'},
'bonus':{field:'annualBonusThousandYen',label:'年間賞与',unit:'万円',scale:.1,year:2025,desc:'一般労働者の年間賞与その他特別給与額'},
'job-opening-ratio':{field:'jobOpeningRatio',label:'有効求人倍率（参考）',unit:'倍',scale:1,year:2023,desc:'月間有効求人数÷月間有効求職者数をDATLUMEで計算した参考値'},
'income-per-capita':{field:'incomePerCapitaThousandYen',label:'1人当たり県民所得',unit:'万円',scale:.1,year:2021,desc:'県民所得を人口で除した地域経済指標'},
'gdp':{field:'gdpMillionYen',label:'県内総生産',unit:'兆円',scale:1e-6,year:2021,desc:'県内総生産額（平成27年基準）'},
'employees':{field:'employees',label:'民営従業者数',unit:'万人',scale:1e-4,year:2021,desc:'民営事業所の従業者数'},
'establishments':{field:'establishments',label:'民営事業所数',unit:'万所',scale:1e-4,year:2021,desc:'民営事業所数'},
'info-share':{field:'infoEmployeeShare',label:'情報通信業の従業者比率',unit:'%',scale:1,year:2021,desc:'民営従業者に占める情報通信業従業者の割合'}
};
export function getStaticPaths(){const metrics=['annual-pay','monthly-pay','bonus','job-opening-ratio','income-per-capita','gdp','employees','establishments','info-share'];return metrics.map(metric=>({params:{metric}}));}
const {metric}=Astro.params;const def=DEFS[metric];const d=JSON.parse(fs.readFileSync(path.join(process.cwd(),'public/data/employment-economy-2026.json'),'utf8'));const rows=d.records.filter(r=>r[def.field]!=null).map(r=>({...r,_value:Number(r[def.field])*def.scale})).sort((a,b)=>b._value-a._value);const fmt=v=>new Intl.NumberFormat('ja-JP',{maximumFractionDigits:2}).format(v??0);const canonical=`https://datlume.pages.dev/employment-economy/indicators/${metric}/`;const metaDescription=`${def.year}年の都道府県別${def.label}ランキング。47都道府県を公式統計ベースで比較できます。`;const jsonLd={"@context":"https://schema.org","@type":"Dataset","name":`${def.year}年 都道府県別 ${def.label}ランキング`,"description":def.desc,"url":canonical,"creator":{"@type":"Organization","name":"DATLUME"}};
---
<html lang="ja"><head><link rel="icon" type="image/svg+xml" href="/favicon.svg"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="description" content={metaDescription}><link rel="canonical" href={canonical}><meta property="og:title" content={`都道府県別 ${def.label}ランキング（${def.year}年） | DATLUME`}><meta property="og:description" content={metaDescription}><meta property="og:type" content="website"><meta name="twitter:card" content="summary"><script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script><title>都道府県別 {def.label}ランキング（{def.year}年） | DATLUME</title></head><body>
<header><div class="wrap"><div class="nav"><a class="brand" href="/" aria-label="DATLUME" style="display:inline-flex;align-items:center;gap:10px;text-decoration:none;color:#fff"><img src="/favicon.svg" alt="" width="24" height="24" style="display:block;width:24px;height:24px;filter:brightness(0) invert(1)"><span style="font-family:'Segoe UI Variable','Avenir Next','Helvetica Neue',system-ui,sans-serif;font-size:19px;font-weight:750;letter-spacing:.16em;line-height:1">DATLUME</span></a><a class="back" href="/employment-economy/">雇用・賃金・地域経済へ戻る</a></div><div class="hero"><div class="eyebrow">Ranking</div><h1>{def.label}</h1><p>{def.year}年の47都道府県を比較。{def.desc}。</p></div></div></header><main class="wrap"><div class="data-note">指標ごとに統計年・定義が異なります。推計・参考値はDATLUME側で計算しています。 <a href="/about-data/#employment-economy">出典と注意点 →</a></div><section class="card table-card section"><div class="table-head"><h2>都道府県ランキング</h2><div class="note">{rows.length}都道府県 / {def.year}年</div></div><table><thead><tr><th>順位</th><th>都道府県</th><th>{def.label}</th></tr></thead><tbody>{rows.map((r,i)=><tr><td>{i+1}</td><td class="title"><a href={`/employment-economy/prefectures/${encodeURIComponent(r.prefecture)}/`}>{r.prefecture}</a></td><td>{fmt(r._value)}{def.unit}</td></tr>)}</tbody></table></section><div class="links"><a class="linkchip" href="/employment-economy/">比較ダッシュボード</a><a class="linkchip" href="/employment-economy/indicators/annual-pay/">推計年収</a><a class="linkchip" href="/employment-economy/indicators/job-opening-ratio/">求人倍率</a><a class="linkchip" href="/employment-economy/indicators/income-per-capita/">県民所得</a></div></main><footer class="wrap">出典：厚生労働省 賃金構造基本統計調査 / 統計センター SSDSE · <a href="https://github.com/kkoch5t2/data-platform" target="_blank" rel="noreferrer">GitHub ↗</a></footer></body></html>
