---
import fs from 'node:fs';import path from 'node:path';import '../../../styles/detail.css';
export function getStaticPaths(){const d=JSON.parse(fs.readFileSync(path.join(process.cwd(),'public/data/employment-economy-2026.json'),'utf8'));return d.records.map(r=>({params:{prefecture:r.prefecture},props:{row:r,wageYear:d.wageYear}}));}
const {row,wageYear}=Astro.props;const pref=row.prefecture;const fmt=v=>new Intl.NumberFormat('ja-JP',{maximumFractionDigits:2}).format(v??0);const man=v=>v==null?'—':fmt(v/1000)+'万円';const canonical=`https://datlume.com/employment-economy/prefectures/${encodeURIComponent(pref)}/`;
const metaDescription=`${pref}の平均賃金・年齢別賃金・推計年収、求人倍率、1人当たり県民所得、県内総生産、事業所・従業者数を公式統計からまとめたデータページです。`;
const industries=[['建設業',row.constructionEmployees],['製造業',row.manufacturingEmployees],['情報通信業',row.infoEmployees],['卸売・小売',row.retailEmployees],['宿泊・飲食',row.hospitalityEmployees],['医療・福祉',row.medicalEmployees]];const maxIndustry=Math.max(...industries.map(x=>x[1]||0),1);
const jsonLd={"@context":"https://schema.org","@type":"Dataset","name":`${pref} 雇用・賃金・地域経済データ`,"description":metaDescription,"url":canonical,"spatialCoverage":pref,"creator":{"@type":"Organization","name":"DATLUME"}};
---
<html lang="ja"><head><link rel="icon" type="image/svg+xml" href="/favicon.svg"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="description" content={metaDescription}><link rel="canonical" href={canonical}><meta property="og:title" content={`${pref}の平均賃金・求人・地域経済 | DATLUME`}><meta property="og:description" content={metaDescription}><meta property="og:type" content="website"><meta name="twitter:card" content="summary"><script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script><title>{pref}の平均賃金・求人・地域経済 | DATLUME</title></head><body>
<header><div class="wrap"><div class="nav"><a class="brand" href="/" aria-label="DATLUME" style="display:inline-flex;align-items:center;gap:10px;text-decoration:none;color:#fff"><img src="/favicon.svg" alt="" width="24" height="24" style="display:block;width:24px;height:24px;filter:brightness(0) invert(1)"><span style="font-family:'Segoe UI Variable','Avenir Next','Helvetica Neue',system-ui,sans-serif;font-size:19px;font-weight:750;letter-spacing:.16em;line-height:1">DATLUME</span></a><a class="back" href="/employment-economy/">雇用・賃金・地域経済へ戻る</a></div><div class="hero"><div class="eyebrow">Employment / Economy</div><h1>{pref}</h1><p>賃金、求人、所得、GDP、産業別従業者から、地域の「働く」を見る。</p></div></div></header>
<main class="wrap"><div class="stats"><div class="card"><div class="label">推計年収*</div><div class="value">{row.estimatedAnnualCashThousandYen!=null?fmt(row.estimatedAnnualCashThousandYen/10)+'万円':'—'}</div></div><div class="card"><div class="label">有効求人倍率（参考）</div><div class="value">{row.jobOpeningRatio!=null?fmt(row.jobOpeningRatio)+'倍':'—'}</div></div><div class="card"><div class="label">1人当たり県民所得</div><div class="value">{row.incomePerCapitaThousandYen!=null?fmt(row.incomePerCapitaThousandYen/10)+'万円':'—'}</div></div></div>
<div class="data-note">* 推計年収は{wageYear}年の「きまって支給する現金給与額×12＋年間賞与その他特別給与額」をDATLUMEで計算した参考値です。県民所得・GDP等は2021年、求人倍率は2023年の収録値です。 <a href="/about-data/#employment-economy">詳しい出典・注意点 →</a></div>
<section class="card section"><h2>賃金データ（{wageYear}年）</h2><div class="barrow"><div>月額賃金</div><div class="track"><div class="bar" style="width:75%"></div></div><div class="amount">{row.monthlyCashSalaryThousandYen!=null?fmt(row.monthlyCashSalaryThousandYen/10)+'万円':'—'}</div></div><div class="barrow"><div>所定内給与</div><div class="track"><div class="bar" style="width:68%"></div></div><div class="amount">{row.monthlyScheduledSalaryThousandYen!=null?fmt(row.monthlyScheduledSalaryThousandYen/10)+'万円':'—'}</div></div><div class="barrow"><div>年間賞与</div><div class="track"><div class="bar" style="width:55%"></div></div><div class="amount">{row.annualBonusThousandYen!=null?fmt(row.annualBonusThousandYen/10)+'万円':'—'}</div></div><div class="barrow"><div>平均年齢</div><div class="track"><div class="bar" style="width:60%"></div></div><div class="amount">{fmt(row.averageAge)}歳</div></div><div class="barrow"><div>平均勤続年数</div><div class="track"><div class="bar" style="width:50%"></div></div><div class="amount">{fmt(row.averageTenureYears)}年</div></div></section>
<section class="card table-card section"><div class="table-head"><h2>年齢階級別の賃金（{wageYear}年）</h2><div class="note">一般労働者・男女計・企業規模10人以上</div></div><table><thead><tr><th>年齢階級</th><th>月額賃金</th><th>所定内給与</th><th>年間賞与</th><th>推計年収*</th></tr></thead><tbody>{(row.ageWages||[]).map(x=><tr><td>{x.ageBand}</td><td>{x.monthlyCashSalaryThousandYen!=null?fmt(x.monthlyCashSalaryThousandYen/10)+'万円':'—'}</td><td>{x.monthlyScheduledSalaryThousandYen!=null?fmt(x.monthlyScheduledSalaryThousandYen/10)+'万円':'—'}</td><td>{x.annualBonusThousandYen!=null?fmt(x.annualBonusThousandYen/10)+'万円':'—'}</td><td>{x.estimatedAnnualCashThousandYen!=null?fmt(x.estimatedAnnualCashThousandYen/10)+'万円':'—'}</td></tr>)}</tbody></table></section>
<section class="card section"><h2>地域経済</h2><table><tbody><tr><th>県内総生産（2021）</th><td>{row.gdpMillionYen!=null?fmt(row.gdpMillionYen/1e6)+'兆円':'—'}</td></tr><tr><th>県民所得（2021）</th><td>{row.prefecturalIncomeMillionYen!=null?fmt(row.prefecturalIncomeMillionYen/1e6)+'兆円':'—'}</td></tr><tr><th>1人当たり県民所得（2021）</th><td>{row.incomePerCapitaThousandYen!=null?fmt(row.incomePerCapitaThousandYen/10)+'万円':'—'}</td></tr><tr><th>民営事業所数（2021）</th><td>{fmt(row.establishments)}所</td></tr><tr><th>民営従業者数（2021）</th><td>{fmt(row.employees)}人</td></tr><tr><th>生産年齢人口比率（2024）</th><td>{fmt(row.workingAgeShare)}%</td></tr></tbody></table></section>
<section class="card section"><h2>産業別従業者（2021）</h2>{industries.map(([name,val])=><div class="barrow"><div>{name}</div><div class="track"><div class="bar" style={`width:${(val||0)/maxIndustry*100}%`}></div></div><div class="amount">{fmt(val)}人</div></div>)}</section>
<section class="card table-card section"><div class="table-head"><h2>有効求人倍率の推移</h2><div class="note">参考値</div></div><table><thead><tr><th>年</th><th>有効求人倍率</th><th>有効求人数</th><th>有効求職者数</th></tr></thead><tbody>{[...row.jobTrend].reverse().map(x=><tr><td>{x.year}</td><td>{x.jobOpeningRatio!=null?fmt(x.jobOpeningRatio)+'倍':'—'}</td><td>{fmt(x.jobOpenings)}</td><td>{fmt(x.jobSeekers)}</td></tr>)}</tbody></table></section>
<div class="links"><a class="linkchip" href="/employment-economy/indicators/annual-pay/">推計年収ランキング</a><a class="linkchip" href="/employment-economy/indicators/job-opening-ratio/">求人倍率ランキング</a><a class="linkchip" href="/employment-economy/">47都道府県を比較</a></div></main><footer class="wrap">出典：厚生労働省 賃金構造基本統計調査 / 統計センター SSDSE · <a href="https://github.com/kkoch5t2/data-platform" target="_blank" rel="noreferrer">GitHub ↗</a></footer></body></html>
