---
import fs from 'node:fs';
import path from 'node:path';
const data=JSON.parse(fs.readFileSync(path.join(process.cwd(),'public/data/regional-trends-2026.json'),'utf8'));
const latest=Math.max(...data.years);
const latestRows=data.records.filter((r)=>r.year===latest);
const fmt=(v)=>new Intl.NumberFormat('ja-JP').format(v||0);
---
<!doctype html><html lang="ja"><head><link rel="icon" type="image/svg+xml" href="/favicon.svg"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="description" content="47都道府県の人口、高齢化、人口移動、求人、住宅着工、宿泊、地価などを2012〜2023年の推移で比較。"><link rel="canonical" href="https://datlume.pages.dev/regional/"><title>都道府県トレンド | DATLUME</title><style>
:root{--ink:#142033;--muted:#667085;--line:#e4e9f0;--bg:#f4f6f9;--card:#fff;--nav:#0e1b2e;--blue:#1769e0}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,system-ui,-apple-system,"Noto Sans JP",sans-serif}.wrap{width:min(1240px,calc(100% - 32px));margin:auto}header{background:var(--nav);color:#fff;padding:20px 0 54px}.nav{display:flex;justify-content:space-between;align-items:center;gap:18px}.navlinks{display:flex;gap:8px;flex-wrap:wrap}.navlinks a{font-size:12px;color:#d9e4f4;border:1px solid #ffffff2a;border-radius:999px;padding:7px 11px;text-decoration:none}.hero{margin-top:42px}.hero h1{font-size:clamp(36px,5vw,64px);letter-spacing:-.05em;margin:0 0 14px}.hero p{color:#c7d3e4;line-height:1.8;max-width:780px}.brand{text-decoration:none}main{margin-top:-26px;padding-bottom:64px}.card{background:#fff;border:1px solid var(--line);border-radius:16px}.controls{padding:16px;display:grid;grid-template-columns:1fr 1fr;gap:12px}.control label{display:block;color:var(--muted);font-size:11px;font-weight:700;margin-bottom:6px}.control select{width:100%;height:42px;border:1px solid #d9dee7;border-radius:9px;background:#fff;padding:0 10px;font:inherit}.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:12px}.kpi{padding:17px}.kpi-label{font-size:11px;color:var(--muted)}.kpi-value{font-size:24px;font-weight:800;margin-top:5px}.grid{display:grid;grid-template-columns:1.6fr 1fr;gap:12px;margin-top:12px}.chart-card{padding:18px}.chart-card h2{font-size:16px;margin:0 0 10px}.chart{height:390px}.pref-list{margin-top:28px}.pref-list h2{font-size:20px}.pref-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:8px}.pref-grid a{background:#fff;border:1px solid var(--line);border-radius:10px;padding:11px;text-decoration:none;font-size:12px;font-weight:700}.pref-grid a:hover{border-color:#9abcf0;color:var(--blue)}.note{font-size:11px;color:var(--muted);line-height:1.7;margin-top:12px}footer{padding:26px 0 46px;color:var(--muted);font-size:11px}@media(max-width:800px){.nav{display:block}.navlinks{margin-top:14px;overflow:auto;flex-wrap:nowrap}.navlinks a{white-space:nowrap}.controls{grid-template-columns:1fr}.kpis{grid-template-columns:1fr 1fr}.grid{grid-template-columns:1fr}.pref-grid{grid-template-columns:repeat(3,1fr)}.chart{height:320px}}@media(max-width:460px){.wrap{width:min(100% - 24px,1240px)}.kpis{grid-template-columns:1fr 1fr}.pref-grid{grid-template-columns:repeat(2,1fr)}}
</style></head><body><header><div class="wrap"><div class="nav"><a class="brand" href="/" aria-label="DATLUME" style="display:inline-flex;align-items:center;gap:10px;text-decoration:none;color:#fff"><img src="/favicon.svg" alt="" width="24" height="24" style="display:block;width:24px;height:24px;filter:brightness(0) invert(1)"><span style="font-family:'Segoe UI Variable','Avenir Next','Helvetica Neue',system-ui,sans-serif;font-size:19px;font-weight:750;letter-spacing:.16em;line-height:1">DATLUME</span></a><div class="navlinks"><a href="/procurement/">公共調達</a><a href="/realestate/">不動産・防災・暮らし</a><a href="/about-data/">データについて</a><a href="https://github.com/kkoch5t2/data-platform" target="_blank" rel="noreferrer">GitHub ↗</a></div></div><div class="hero"><h1>都道府県トレンド</h1><p>人口、高齢化、人口移動、求人、住宅着工、宿泊、地価などを、47都道府県×12年の公式統計で比較します。</p></div></div></header><main class="wrap"><section class="card controls"><div class="control"><label for="pref">都道府県</label><select id="pref">{data.prefectures.map((p)=><option value={p}>{p}</option>)}</select></div><div class="control"><label for="metric">指標</label><select id="metric"><option value="population">総人口</option><option value="elderlyRate">高齢化率</option><option value="netMigration">人口純移動</option><option value="jobOpeningRatio">求人倍率（参考）</option><option value="housingStarts">新設住宅着工戸数</option><option value="hotelNights">延べ宿泊者数</option><option value="foreignStayShare">外国人宿泊比率</option><option value="residentialLandPrice">住宅地平均価格</option></select></div></section><section class="kpis"><div class="card kpi"><div class="kpi-label">最新年</div><div class="kpi-value">{latest}年</div></div><div class="card kpi"><div class="kpi-label">都道府県</div><div class="kpi-value">47</div></div><div class="card kpi"><div class="kpi-label">時系列</div><div class="kpi-value">12年</div></div><div class="card kpi"><div class="kpi-label">レコード</div><div class="kpi-value">{fmt(data.records.length)}</div></div></section><section class="grid"><div class="card chart-card"><h2 id="trend-title">推移</h2><div id="trend" class="chart"></div></div><div class="card chart-card"><h2 id="ranking-title">最新年ランキング</h2><div id="ranking" class="chart"></div></div></section><div class="note">出典：独立行政法人 統計センター「SSDSE-B-2026（県別推移）」。「求人倍率（参考）」は月間有効求人数÷月間有効求職者数を当サイトで計算した参考値です。指標ごとに元統計の時点・定義が異なります。</div><section class="pref-list"><h2>指標から見る</h2><div class="pref-grid"><a href="/regional/indicators/population/">総人口</a><a href="/regional/indicators/elderly-rate/">高齢化率</a><a href="/regional/indicators/net-migration/">人口純移動</a><a href="/regional/indicators/job-opening-ratio/">求人倍率（参考）</a><a href="/regional/indicators/housing-starts/">住宅着工</a><a href="/regional/indicators/hotel-nights/">宿泊者数</a><a href="/regional/indicators/foreign-stay-share/">外国人宿泊比率</a><a href="/regional/indicators/land-price/">住宅地価格</a></div></section><section class="pref-list"><h2>都道府県から見る</h2><div class="pref-grid">{data.prefectures.map((p)=><a href={`/regional/prefectures/${encodeURIComponent(p)}/`}>{p}</a>)}</div></section></main><footer class="wrap">DATLUME — 日本の公開データを、比較できる形に。 · <a href="https://github.com/kkoch5t2/data-platform" target="_blank" rel="noreferrer">GitHub ↗</a></footer><script define:vars={{latestRows, records:data.records}}>
import * as echarts from 'echarts';
const metrics={population:['総人口','人'],elderlyRate:['高齢化率','%'],netMigration:['人口純移動','人'],jobOpeningRatio:['求人倍率（参考）','倍'],housingStarts:['新設住宅着工戸数','戸'],hotelNights:['延べ宿泊者数','人泊'],foreignStayShare:['外国人宿泊比率','%'],residentialLandPrice:['住宅地平均価格','円/㎡']};
const pref=document.getElementById('pref'),metric=document.getElementById('metric');const trend=echarts.init(document.getElementById('trend'));const ranking=echarts.init(document.getElementById('ranking'));const fmt=(v)=>new Intl.NumberFormat('ja-JP',{maximumFractionDigits:2}).format(v??0);
function draw(){const key=metric.value,[label,unit]=metrics[key];const rows=records.filter(r=>r.prefecture===pref.value).sort((a,b)=>a.year-b.year);document.getElementById('trend-title').textContent=pref.value+' / '+label+'の推移';trend.setOption({tooltip:{trigger:'axis',valueFormatter:v=>fmt(v)+unit},grid:{left:66,right:20,top:22,bottom:44},xAxis:{type:'category',data:rows.map(r=>r.year)},yAxis:{type:'value',axisLabel:{formatter:v=>fmt(v)}},series:[{type:'line',smooth:.2,data:rows.map(r=>r[key]),symbolSize:7,lineStyle:{width:3},areaStyle:{opacity:.06}}]},true);const rank=latestRows.filter(r=>r[key]!=null).sort((a,b)=>b[key]-a[key]).slice(0,15);document.getElementById('ranking-title').textContent=String(Math.max(...latestRows.map(r=>r.year)))+'年 / '+label+' TOP15';ranking.setOption({tooltip:{trigger:'item',formatter:p=>p.name+'<br><b>'+fmt(p.value)+unit+'</b>'},grid:{left:75,right:55,top:10,bottom:18},xAxis:{type:'value',show:false},yAxis:{type:'category',inverse:true,data:rank.map(r=>r.prefecture)},series:[{type:'bar',data:rank.map(r=>r[key]),barWidth:12,label:{show:true,position:'right',fontSize:10,formatter:p=>fmt(p.value)}}]},true)}pref.addEventListener('change',draw);metric.addEventListener('change',draw);draw();window.addEventListener('resize',()=>{trend.resize();ranking.resize()});
</script></body></html>
