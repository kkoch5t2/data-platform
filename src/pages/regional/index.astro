---
import fs from 'node:fs';
import path from 'node:path';
const data=JSON.parse(fs.readFileSync(path.join(process.cwd(),'public/data/regional-trends-2026.json'),'utf8'));
const latest=Math.max(...data.years);
const latestRows=data.records.filter((r)=>r.year===latest);
---
<!doctype html>
<html lang="ja">
<head>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width">
  <meta name="description" content="47都道府県の長期推移に加え、1,700超の市区町村を人口、高齢化、単身世帯、人口移動などで比較。">
  <link rel="canonical" href="https://datlume.com/regional/">
  <title>都道府県別推移 | DATLUME</title>
  <style>
    :root{--ink:#142033;--muted:#667085;--line:#e4e9f0;--bg:#f4f6f9;--card:#fff;--nav:#0e1b2e;--blue:#1769e0}
    *{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,system-ui,-apple-system,"Noto Sans JP",sans-serif}.wrap{width:min(1240px,calc(100% - 32px));margin:auto}a{color:inherit}
    header{background:var(--nav);color:#fff;padding:20px 0 54px}.nav{display:flex;justify-content:space-between;align-items:center;gap:18px}.navlinks{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end;margin-left:auto}.navlinks a{font-size:12px;color:#d9e4f4;border:1px solid #ffffff2a;border-radius:999px;padding:7px 11px;text-decoration:none}.hero{margin-top:42px}.hero h1{font-size:clamp(36px,5vw,64px);letter-spacing:-.05em;margin:0 0 14px}.hero p{color:#c7d3e4;line-height:1.8;max-width:820px}.brand{text-decoration:none}
    main.wrap{margin-top:18px;padding-bottom:64px}.card{background:#fff;border:1px solid var(--line);border-radius:16px}.controls{padding:16px;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.control{min-width:0}.control label{display:block;color:var(--muted);font-size:11px;font-weight:700;margin-bottom:6px}.control select{width:100%;height:42px;border:1px solid #d9dee7;border-radius:9px;background:#fff;padding:0 10px;font:inherit;font-size:13px}
    .kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:12px}.kpi{padding:17px;min-width:0}.kpi-label{font-size:11px;color:var(--muted)}.kpi-value{font-size:clamp(20px,2.4vw,28px);font-weight:800;margin-top:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.kpi-sub{font-size:10.5px;color:var(--muted);margin-top:4px;line-height:1.45}.kpi-value.up{color:#067647}.kpi-value.down{color:#b42318}
    .grid{display:grid;grid-template-columns:1.55fr 1fr;gap:12px;margin-top:12px}.chart-card{padding:18px}.chart-head{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:8px}.chart-card h2{font-size:16px;margin:0}.chart-sub{font-size:10.5px;color:var(--muted);margin-top:3px}.chart{height:410px}
    .history-card{margin-top:12px;padding:18px}.history-head{display:flex;justify-content:space-between;gap:16px;align-items:center}.history-head h2{font-size:17px;margin:0}.history-head p{font-size:11px;color:var(--muted);line-height:1.65;margin:5px 0 0}.load-btn{border:0;border-radius:10px;background:var(--nav);color:#fff;padding:10px 14px;font:inherit;font-size:12px;font-weight:800;cursor:pointer;white-space:nowrap}.history-tools{display:flex;gap:10px;flex-wrap:wrap;margin:14px 0 4px}.history-tools select{height:38px;border:1px solid #d9dee7;border-radius:9px;background:#fff;padding:0 10px;font:inherit;font-size:12px}.history-chart{height:380px}.history-status{font-size:11px;color:var(--muted);margin-top:10px}.insight-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:12px}.insight{padding:15px 16px}.insight strong{display:block;font-size:13px}.insight span{display:block;color:var(--muted);font-size:11px;line-height:1.55;margin-top:5px}
    .pref-list{margin-top:28px}.pref-list h2{font-size:20px}.pref-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:8px}.pref-grid a{background:#fff;border:1px solid var(--line);border-radius:10px;padding:11px;text-decoration:none;font-size:12px;font-weight:700}.pref-grid a:hover{border-color:#9abcf0;color:var(--blue)}.note{font-size:11px;color:var(--muted);line-height:1.7;margin-top:12px}footer{padding:26px 0 46px;color:var(--muted);font-size:11px}
    @media(max-width:900px){.controls{grid-template-columns:1fr 1fr}.grid{grid-template-columns:1fr}.chart{height:350px}.insight-grid{grid-template-columns:1fr 1fr}}
    @media(max-width:800px){.nav{display:block}.navlinks{margin-top:14px;overflow:auto;flex-wrap:nowrap;justify-content:flex-start;margin-left:0}.navlinks a{white-space:nowrap}.kpis{grid-template-columns:1fr 1fr}.pref-grid{grid-template-columns:repeat(3,1fr)}}
    @media(max-width:520px){.history-head{align-items:flex-start;flex-direction:column}.load-btn{width:100%}.history-tools{display:grid;grid-template-columns:1fr 1fr}.history-tools select{width:100%}.history-chart{height:320px}.wrap{width:min(100% - 24px,1240px)}.controls{grid-template-columns:1fr}.kpis{grid-template-columns:1fr 1fr}.insight-grid{grid-template-columns:1fr}.pref-grid{grid-template-columns:repeat(2,1fr)}.chart{height:330px}}

.navlinks,.tabs,.view-tabs{scrollbar-width:none;-ms-overflow-style:none}.navlinks::-webkit-scrollbar,.tabs::-webkit-scrollbar,.view-tabs::-webkit-scrollbar{display:none}
</style>
</head>
<body>
<header><div class="wrap"><div class="nav"><a class="brand" href="/" aria-label="DATLUME" style="display:inline-flex;align-items:center;gap:10px;text-decoration:none;color:#fff"><img src="/favicon.svg" alt="" width="24" height="24" style="display:block;width:24px;height:24px;filter:brightness(0) invert(1)"><span style="font-family:'Segoe UI Variable','Avenir Next','Helvetica Neue',system-ui,sans-serif;font-size:19px;font-weight:750;letter-spacing:.16em;line-height:1">DATLUME</span></a><div class="navlinks"><a href="/procurement/">国・自治体の案件</a><a href="/realestate/">不動産・暮らし</a><a href="/regional/">都道府県別推移</a><a href="/employment-economy/">雇用・賃金</a><a href="/business-industry/">企業・産業</a><a href="/listed-companies/">上場企業</a><a href="/economy-prices/">経済・物価</a><a href="/energy/">エネルギー</a><a href="/about-data/">データについて</a></div></div><div class="hero"><h1>都道府県別推移</h1><p>都道府県の長期推移と、市区町村の人口・高齢化・世帯・人口移動を同じページで比較します。</p></div></div></header>
<main class="wrap">
  <section class="card controls">
    <div class="control"><label for="pref">都道府県 A</label><select id="pref">{data.prefectures.map((p)=><option value={p}>{p}</option>)}</select></div>
    <div class="control"><label for="compare">都道府県 B</label><select id="compare"><option value="">比較なし</option>{data.prefectures.map((p)=><option value={p}>{p}</option>)}</select></div>
    <div class="control"><label for="metric">指標</label><select id="metric"><option value="population">総人口</option><option value="elderlyRate">高齢化率</option><option value="netMigration">人口純移動</option><option value="jobOpeningRatio">求人倍率（参考）</option><option value="housingStarts">新設住宅着工戸数</option><option value="hotelNights">延べ宿泊者数</option><option value="foreignStayShare">外国人宿泊比率</option><option value="residentialLandPrice">住宅地平均価格</option></select></div>
    <div class="control"><label for="rank-mode">ランキング</label><select id="rank-mode"><option value="latest">最新値が高い順</option><option value="change-up">期間で増えた順</option><option value="change-down">期間で減った順</option></select></div>
  </section>
  <section class="kpis">
    <div class="card kpi"><div id="a-label" class="kpi-label">都道府県 A</div><div id="a-value" class="kpi-value">—</div><div id="a-change" class="kpi-sub">—</div></div>
    <div class="card kpi"><div id="b-label" class="kpi-label">都道府県 B</div><div id="b-value" class="kpi-value">—</div><div id="b-change" class="kpi-sub">比較する都道府県を選択</div></div>
    <div class="card kpi"><div class="kpi-label">都道府県平均</div><div id="avg-value" class="kpi-value">—</div><div id="avg-meta" class="kpi-sub">—</div></div>
    <div class="card kpi"><div class="kpi-label">A − 都道府県平均</div><div id="avg-diff" class="kpi-value">—</div><div id="avg-diff-meta" class="kpi-sub">—</div></div>
  </section>
  <section class="grid">
    <div class="card chart-card"><div class="chart-head"><div><h2 id="trend-title">推移比較</h2><div class="chart-sub">破線は47都道府県の単純平均</div></div></div><div id="trend" class="chart"></div></div>
    <div class="card chart-card"><div class="chart-head"><div><h2 id="ranking-title">ランキング</h2><div id="ranking-sub" class="chart-sub">—</div></div></div><div id="ranking" class="chart"></div></div>
  </section>
  <section class="card history-card">
    <div class="history-head"><div><h2>市区町村を比べる</h2><p>SSDSE-A-2026の1,741市区町村。人口、高齢化、単身世帯、転入転出、自然増減を必要なときだけ読み込み、全国または都道府県内で比較します。</p></div><button id="municipal-load" class="load-btn" type="button">市区町村データを読み込む</button></div>
    <div id="municipal-body" hidden>
      <div class="history-tools"><select id="municipal-pref"><option value="">全国</option></select><select id="municipal-metric"><option value="population">総人口</option><option value="elderlyRate">高齢化率</option><option value="singleHouseholdRate">単身世帯率</option><option value="netMigration">転入超過・転出超過</option><option value="naturalChange">出生−死亡</option><option value="foreignRate">外国人人口比率</option></select><select id="municipal-order"><option value="desc">高い順</option><option value="asc">低い順</option></select></div>
      <div id="municipal-chart" class="history-chart"></div><div id="municipal-status" class="history-status"></div>
    </div>
  </section>
  <section class="card history-card">
    <div class="history-head"><div><h2>人口移動を、1954年から見る</h2><p>総務省「住民基本台帳人口移動報告」の長期時系列。必要なときだけ読み込むので、通常表示の通信量は増やしません。</p></div><button id="migration-load" class="load-btn" type="button">長期データを読み込む</button></div>
    <div id="migration-body" hidden>
      <div class="history-tools"><select id="migration-metric"><option value="netMigration">転入超過</option><option value="inMigration">転入</option><option value="outMigration">転出</option></select><select id="migration-from"><option value="1954">1954年〜</option><option value="1990">1990年〜</option><option value="2010">2010年〜</option></select></div>
      <div id="migration-chart" class="history-chart"></div><div id="migration-status" class="history-status"></div>
    </div>
  </section>
  <section class="insight-grid">
    <div class="card insight"><strong>人口減少を見る</strong><span>「総人口」→「期間で減った順」で、2012年から最新年までの人口減少率を比較できます。</span></div>
    <div class="card insight"><strong>地価上昇を見る</strong><span>「住宅地平均価格」→「期間で増えた順」で、住宅地価格の上昇率を比較できます。</span></div>
    <div class="card insight"><strong>平均との差を見る</strong><span>選択した都道府県Aの最新値と47都道府県の単純平均との差を上のカードに表示します。</span></div>
  </section>
  <div class="note">出典：独立行政法人 統計センター「SSDSE-B-2026（県別推移）」。都道府県平均は各年の収録値の単純平均です。「求人倍率（参考）」は月間有効求人数÷月間有効求職者数を当サイトで計算した参考値です。指標ごとに元統計の時点・定義が異なります。</div>
  <section class="pref-list"><h2>指標から見る</h2><div class="pref-grid"><a href="/regional/indicators/population/">総人口</a><a href="/regional/indicators/elderly-rate/">高齢化率</a><a href="/regional/indicators/net-migration/">人口純移動</a><a href="/regional/indicators/job-opening-ratio/">求人倍率（参考）</a><a href="/regional/indicators/housing-starts/">住宅着工</a><a href="/regional/indicators/hotel-nights/">宿泊者数</a><a href="/regional/indicators/foreign-stay-share/">外国人宿泊比率</a><a href="/regional/indicators/land-price/">住宅地価格</a></div></section>
  <section class="pref-list"><h2>都道府県から見る</h2><div class="pref-grid">{data.prefectures.map((p)=><a href={`/regional/prefectures/${encodeURIComponent(p)}/`}>{p}</a>)}</div></section>
</main>
<footer class="wrap">DATLUME — 日本の公開データを、比較できる形に。 · <a href="https://github.com/kkoch5t2/data-platform" target="_blank" rel="noreferrer" style="display:inline-flex;align-items:center;gap:5px"><img src="/brand/github.svg" alt="" width="14" height="14" style="display:block;width:14px;height:14px">GitHub ↗</a> · <a href="https://utility-tools-jp.com/" target="_blank" rel="noreferrer" style="display:inline-flex;align-items:center;gap:5px"><img src="/brand/utility-tools.ico" alt="" width="14" height="14" style="display:block;width:14px;height:14px;border-radius:3px">無料WEB便利ツール集 ↗</a></footer>
<script id="regional-data" type="application/json" set:html={JSON.stringify({latestRows,records:data.records,latest})}></script>
<script>
import * as echarts from 'echarts';
const {latestRows,records,latest}=JSON.parse(document.getElementById('regional-data').textContent);
const defs={
  population:{label:'総人口',unit:'人',change:'percent',digits:0},
  elderlyRate:{label:'高齢化率',unit:'%',change:'point',digits:2},
  netMigration:{label:'人口純移動',unit:'人',change:'absolute',digits:0},
  jobOpeningRatio:{label:'求人倍率（参考）',unit:'倍',change:'absolute',digits:3},
  housingStarts:{label:'新設住宅着工戸数',unit:'戸',change:'percent',digits:0},
  hotelNights:{label:'延べ宿泊者数',unit:'人泊',change:'percent',digits:0},
  foreignStayShare:{label:'外国人宿泊比率',unit:'%',change:'point',digits:2},
  residentialLandPrice:{label:'住宅地平均価格',unit:'円/㎡',change:'percent',digits:0}
};
const pref=document.getElementById('pref'),compare=document.getElementById('compare'),metric=document.getElementById('metric'),rankMode=document.getElementById('rank-mode');
const trend=echarts.init(document.getElementById('trend')),ranking=echarts.init(document.getElementById('ranking'));
let migrationData=null,migrationChart=null;
const migrationLoad=document.getElementById('migration-load'),migrationBody=document.getElementById('migration-body'),migrationMetric=document.getElementById('migration-metric'),migrationFrom=document.getElementById('migration-from');
let municipalData=null,municipalChart=null;
const municipalLoad=document.getElementById('municipal-load'),municipalBody=document.getElementById('municipal-body'),municipalPref=document.getElementById('municipal-pref'),municipalMetric=document.getElementById('municipal-metric'),municipalOrder=document.getElementById('municipal-order'),municipalStatus=document.getElementById('municipal-status');
const municipalDefs={population:{label:'総人口',unit:'人',digits:0,yearKey:'population'},elderlyRate:{label:'高齢化率',unit:'%',digits:1,yearKey:'population'},singleHouseholdRate:{label:'単身世帯率',unit:'%',digits:1,yearKey:'households'},netMigration:{label:'転入超過・転出超過',unit:'人',digits:0,yearKey:'migration'},naturalChange:{label:'出生−死亡',unit:'人',digits:0,yearKey:'vital'},foreignRate:{label:'外国人人口比率',unit:'%',digits:2,yearKey:'population'}};
const nfmt=new Intl.NumberFormat('ja-JP',{maximumFractionDigits:2});
const valid=v=>v!==null&&v!==undefined&&Number.isFinite(Number(v));
const fmt=(v,unit='')=>valid(v)?nfmt.format(Number(v))+unit:'—';
const fmtMetric=(v,def)=>valid(v)?new Intl.NumberFormat('ja-JP',{maximumFractionDigits:def.digits??2}).format(Number(v))+def.unit:'—';
const signed=(v,digits=1)=>!valid(v)?'—':(Number(v)>0?'+':'')+new Intl.NumberFormat('ja-JP',{minimumFractionDigits:digits,maximumFractionDigits:digits}).format(Number(v));
const rowsFor=name=>records.filter(r=>r.prefecture===name).sort((a,b)=>a.year-b.year);
const mean=vals=>{const xs=vals.filter(valid).map(Number);return xs.length?xs.reduce((a,b)=>a+b,0)/xs.length:null};
const avgAt=(year,key)=>mean(records.filter(r=>r.year===year).map(r=>r[key]));
function firstLast(rows,key){const xs=rows.filter(r=>valid(r[key]));return xs.length?[xs[0],xs.at(-1)]:[null,null]}
function changeFor(rows,key,def){const [first,last]=firstLast(rows,key);if(!first||!last)return null;const a=Number(first[key]),b=Number(last[key]);if(def.change==='percent')return a?((b-a)/Math.abs(a))*100:null;return b-a}
function changeLabel(value,def){if(!valid(value))return '変化を計算できません';if(def.change==='percent')return signed(value)+'%';if(def.change==='point')return signed(value,2)+'pt';return signed(value,def.digits??0)+def.unit}
function setTone(el,v){el.classList.remove('up','down');if(v>0)el.classList.add('up');if(v<0)el.classList.add('down')}
function setState(){const q=new URLSearchParams();q.set('pref',pref.value);if(compare.value)q.set('compare',compare.value);q.set('metric',metric.value);q.set('rank',rankMode.value);history.replaceState(null,'','?'+q.toString())}
function restoreState(){const q=new URLSearchParams(location.search);for(const [el,key] of [[pref,'pref'],[compare,'compare'],[metric,'metric'],[rankMode,'rank']]){const v=q.get(key);if(v&&[...el.options].some(o=>o.value===v))el.value=v}if(!q.get('pref')&&[...pref.options].some(o=>o.value==='東京都'))pref.value='東京都'}
function rankingRows(key,def,mode){if(mode==='latest')return latestRows.filter(r=>valid(r[key])).map(r=>({name:r.prefecture,value:Number(r[key])})).sort((a,b)=>b.value-a.value).slice(0,15);const xs=[];for(const name of [...new Set(records.map(r=>r.prefecture))]){const v=changeFor(rowsFor(name),key,def);if(valid(v))xs.push({name,value:Number(v)})}xs.sort((a,b)=>mode==='change-down'?a.value-b.value:b.value-a.value);return xs.slice(0,15)}
function draw(){
  const key=metric.value,def=defs[key],aRows=rowsFor(pref.value),bRows=compare.value?rowsFor(compare.value):[];
  const years=[...new Set(records.map(r=>r.year))].sort((a,b)=>a-b);
  const avgSeries=years.map(y=>avgAt(y,key));
  const aLatest=aRows.findLast(r=>valid(r[key])),bLatest=bRows.findLast(r=>valid(r[key]));
  const average=avgAt(latest,key),aChange=changeFor(aRows,key,def),bChange=changeFor(bRows,key,def),diff=aLatest&&valid(average)?Number(aLatest[key])-Number(average):null;
  document.getElementById('a-label').textContent=pref.value+' / '+def.label;
  document.getElementById('a-value').textContent=aLatest?fmtMetric(aLatest[key],def):'—';
  document.getElementById('a-change').textContent='期間変化 '+changeLabel(aChange,def);
  document.getElementById('b-label').textContent=(compare.value||'都道府県 B')+' / '+def.label;
  document.getElementById('b-value').textContent=bLatest?fmtMetric(bLatest[key],def):'—';
  document.getElementById('b-change').textContent=compare.value?'期間変化 '+changeLabel(bChange,def):'比較する都道府県を選択';
  document.getElementById('avg-value').textContent=fmtMetric(average,def);
  document.getElementById('avg-meta').textContent=key==='netMigration'?latest+'年 / 都道府県間の転入超過は全国で相殺':latest+'年 / 47都道府県の単純平均';
  const diffEl=document.getElementById('avg-diff');diffEl.textContent=def.change==='point'?signed(diff,2)+'pt':signed(diff,def.digits??0)+def.unit;setTone(diffEl,diff||0);
  document.getElementById('avg-diff-meta').textContent=pref.value+'の最新値との差';
  const series=[{name:pref.value,type:'line',smooth:.18,data:aRows.map(r=>[r.year,r[key]]),symbolSize:7,lineStyle:{width:3}}];
  if(compare.value)series.push({name:compare.value,type:'line',smooth:.18,data:bRows.map(r=>[r.year,r[key]]),symbolSize:7,lineStyle:{width:3}});
  series.push({name:'都道府県平均',type:'line',data:years.map((y,i)=>[y,avgSeries[i]]),symbol:'none',lineStyle:{type:'dashed',width:2}});
  document.getElementById('trend-title').textContent=def.label+'の推移比較';
  trend.setOption({tooltip:{trigger:'axis',valueFormatter:v=>fmtMetric(v,def)},legend:{top:0},grid:{left:70,right:22,top:48,bottom:42},xAxis:{type:'value',min:Math.min(...years),max:Math.max(...years),interval:2,axisLabel:{formatter:v=>String(v)}},yAxis:{type:'value',scale:true,axisLabel:{formatter:v=>new Intl.NumberFormat('ja-JP',{maximumFractionDigits:def.digits??2}).format(v)}},series},true);
  const rr=rankingRows(key,def,rankMode.value);const changeMode=rankMode.value!=='latest';
  const rankLabel=rankMode.value==='latest'?'最新値が高い順':rankMode.value==='change-up'?'期間で増えた順':'期間で減った順';
  document.getElementById('ranking-title').textContent=def.label+' / '+rankLabel;
  document.getElementById('ranking-sub').textContent=changeMode?Math.min(...records.map(r=>r.year))+'→'+latest+'年':'最新収録年 '+latest+'年';
  ranking.setOption({tooltip:{trigger:'item',formatter:p=>p.name+'<br><b>'+(changeMode?changeLabel(p.value,def):fmtMetric(p.value,def))+'</b>'},grid:{left:82,right:66,top:10,bottom:18},xAxis:{type:'value',show:false},yAxis:{type:'category',inverse:true,data:rr.map(r=>r.name)},series:[{type:'bar',data:rr.map(r=>r.value),barWidth:12,label:{show:true,position:'right',fontSize:10,formatter:p=>changeMode?changeLabel(p.value,def):fmtMetric(p.value,def)}}]},true);
  setTone(document.getElementById('a-value'),0);setState();
}
function drawMigration(){if(!migrationData||!migrationChart)return;const idx={inMigration:1,outMigration:2,netMigration:3}[migrationMetric.value],from=Number(migrationFrom.value);const rec=name=>migrationData.records.find(r=>r.prefecture===name);const mk=(name)=>{const r=rec(name);return{name,type:'line',showSymbol:false,smooth:.12,lineStyle:{width:2.5},data:(r?.values||[]).filter(v=>v[0]>=from&&v[idx]!==null).map(v=>[v[0],v[idx]])}};const series=[mk(pref.value)];if(compare.value)series.push(mk(compare.value));migrationChart.setOption({tooltip:{trigger:'axis',valueFormatter:v=>nfmt.format(v)+'人'},legend:{top:0},grid:{left:64,right:22,top:48,bottom:42},xAxis:{type:'value',min:from,max:migrationData.years.at(-1),axisLabel:{formatter:v=>String(v)}},yAxis:{type:'value',scale:true,axisLabel:{formatter:v=>nfmt.format(v)}},series},true);document.getElementById('migration-status').textContent=migrationData.years[0]+'〜'+migrationData.years.at(-1)+'年 / 日本人移動者 / 都道府県別（一部の古い年度は原表欠損）';}
async function loadMigration(){if(migrationData){migrationBody.hidden=false;drawMigration();return}migrationLoad.disabled=true;migrationLoad.textContent='読み込み中…';try{const r=await fetch('/data/regional-migration-history.json');if(!r.ok)throw new Error('取得失敗');migrationData=await r.json();migrationBody.hidden=false;migrationChart=echarts.init(document.getElementById('migration-chart'));migrationLoad.textContent='読み込み済み';drawMigration()}catch(e){migrationLoad.disabled=false;migrationLoad.textContent='再読み込み';document.getElementById('migration-status').textContent='長期データを読み込めませんでした'} }
migrationLoad.addEventListener('click',loadMigration);migrationMetric.addEventListener('change',drawMigration);migrationFrom.addEventListener('change',drawMigration);
function drawMunicipal(){
  if(!municipalData||!municipalChart)return;
  const key=municipalMetric.value,def=municipalDefs[key],nationwide=!municipalPref.value;
  let rows=municipalData.records.filter(r=>nationwide||r.prefecture===municipalPref.value).filter(r=>valid(r[key]));
  rows.sort((a,b)=>municipalOrder.value==='asc'?Number(a[key])-Number(b[key]):Number(b[key])-Number(a[key]));
  const shown=rows.slice(0,20),labels=shown.map(r=>nationwide?r.prefecture+' '+r.municipality:r.municipality);
  municipalChart.setOption({tooltip:{trigger:'item',formatter:p=>p.name+'<br><b>'+fmtMetric(p.value,def)+'</b>'},grid:{left:nationwide?150:112,right:82,top:14,bottom:24},xAxis:{type:'value',show:false},yAxis:{type:'category',inverse:true,data:labels,axisLabel:{fontSize:11,width:nationwide?138:100,overflow:'truncate'}},series:[{type:'bar',data:shown.map(r=>Number(r[key])),barWidth:13,label:{show:true,position:'right',fontSize:10,formatter:p=>fmtMetric(p.value,def)}}]},true);
  const year=municipalData.years?.[def.yearKey];
  municipalStatus.textContent=(municipalPref.value||'全国')+' / '+fmt(rows.length)+'市区町村 / '+def.label+' / '+year+'年値 / 上位20件を表示';
}
async function loadMunicipal(){
  if(municipalData){municipalBody.hidden=false;drawMunicipal();return}
  municipalLoad.disabled=true;municipalLoad.textContent='読み込み中…';
  try{
    const r=await fetch('/data/municipality-stats-2026.json');if(!r.ok)throw new Error('取得失敗');municipalData=await r.json();
    const prefs=[...new Set(municipalData.records.map(r=>r.prefecture))].sort((a,b)=>a.localeCompare(b,'ja'));
    for(const name of prefs){const o=document.createElement('option');o.value=name;o.textContent=name;municipalPref.appendChild(o)}
    municipalBody.hidden=false;municipalChart=echarts.init(document.getElementById('municipal-chart'));municipalLoad.textContent='読み込み済み';drawMunicipal();
  }catch(e){municipalLoad.disabled=false;municipalLoad.textContent='再読み込み';municipalStatus.textContent='市区町村データを読み込めませんでした'}
}
municipalLoad.addEventListener('click',loadMunicipal);municipalPref.addEventListener('change',drawMunicipal);municipalMetric.addEventListener('change',drawMunicipal);municipalOrder.addEventListener('change',drawMunicipal);
function normalizeComparison(){if(compare.value&&compare.value===pref.value)compare.value=''}restoreState();normalizeComparison();for(const el of [pref,compare,metric,rankMode])el.addEventListener('change',()=>{normalizeComparison();draw();drawMigration()});draw();window.addEventListener('resize',()=>{trend.resize();ranking.resize();migrationChart?.resize();municipalChart?.resize()});
</script>
</body></html>
