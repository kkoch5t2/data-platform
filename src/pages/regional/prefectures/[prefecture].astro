---
import fs from 'node:fs';import path from 'node:path';
export function getStaticPaths(){const d=JSON.parse(fs.readFileSync(path.join(process.cwd(),'public/data/regional-trends-2026.json'),'utf8'));return d.prefectures.map((p)=>({params:{prefecture:p}}));}
const {prefecture}=Astro.params;const d=JSON.parse(fs.readFileSync(path.join(process.cwd(),'public/data/regional-trends-2026.json'),'utf8'));const rows=d.records.filter((r)=>r.prefecture===prefecture).sort((a,b)=>a.year-b.year);const latest=rows.at(-1);const first=rows[0];const fmt=(v)=>new Intl.NumberFormat('ja-JP',{maximumFractionDigits:2}).format(v??0);const pct=(a,b)=>b?((a-b)/b*100):null;const popChange=pct(latest.population,first.population);const landChange=pct(latest.residentialLandPrice,first.residentialLandPrice);
---
<!doctype html><html lang="ja"><head><link rel="icon" type="image/svg+xml" href="/favicon.svg"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="description" content={`${prefecture}の人口、高齢化率、人口移動、求人、住宅着工、宿泊、地価などの推移を公式統計で確認。`}><link rel="canonical" href={`https://datlume.com/regional/prefectures/${encodeURIComponent(prefecture)}/`}><title>{prefecture}の人口・地価・求人・宿泊推移 | DATLUME</title><style>:root{--ink:#142033;--muted:#667085;--line:#e4e9f0;--bg:#f4f6f9;--nav:#0e1b2e}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,system-ui,-apple-system,"Noto Sans JP",sans-serif}.wrap{width:min(980px,calc(100% - 32px));margin:auto}header{background:var(--nav);color:#fff;padding:20px 0 52px}.brand img{height:30px}.back{color:#c7d3e4;font-size:12px}.nav{display:flex;justify-content:space-between}.hero{margin-top:38px}.hero h1{font-size:clamp(32px,5vw,54px);margin:0 0 12px}.hero p{color:#c7d3e4}main.wrap{margin-top:18px;padding-bottom:60px}.card{background:#fff;border:1px solid var(--line);border-radius:16px}.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.kpi{padding:16px}.label{font-size:11px;color:var(--muted)}.value{font-size:22px;font-weight:800;margin-top:5px}.section{margin-top:14px;padding:20px}.section h2{font-size:19px;margin:0 0 12px}table{width:100%;border-collapse:collapse}th,td{padding:11px;border-bottom:1px solid #eef1f5;font-size:12px;text-align:right}th:first-child,td:first-child{text-align:left}.links{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}.links a{background:#fff;border:1px solid var(--line);padding:9px 12px;border-radius:9px;text-decoration:none;font-size:12px}@media(max-width:700px){.kpis{grid-template-columns:1fr 1fr}.section{overflow:auto}table{min-width:760px}}</style></head><body><header><div class="wrap"><div class="nav"><a class="brand" href="/" aria-label="DATLUME" style="display:inline-flex;align-items:center;gap:10px;text-decoration:none;color:#fff"><img src="/favicon.svg" alt="" width="24" height="24" style="display:block;width:24px;height:24px;filter:brightness(0) invert(1)"><span style="font-family:'Segoe UI Variable','Avenir Next','Helvetica Neue',system-ui,sans-serif;font-size:19px;font-weight:750;letter-spacing:.16em;line-height:1">DATLUME</span></a><a class="back" href="/regional/">都道府県別推移へ戻る</a><a class="back" href="https://github.com/kkoch5t2/data-platform" target="_blank" rel="noreferrer">GitHub ↗</a></div><div class="hero"><h1>{prefecture}のデータ推移</h1><p>{first.year}〜{latest.year}年の人口・高齢化・人口移動・雇用・住宅・観光・地価をまとめて確認。</p></div></div></header><main class="wrap"><section class="kpis"><div class="card kpi"><div class="label">総人口</div><div class="value">{fmt(latest.population)}人</div></div><div class="card kpi"><div class="label">高齢化率</div><div class="value">{fmt(latest.elderlyRate)}%</div></div><div class="card kpi"><div class="label">人口変化</div><div class="value">{popChange==null?'—':`${popChange>0?'+':''}${popChange.toFixed(1)}%`}</div></div><div class="card kpi"><div class="label">住宅地価格変化</div><div class="value">{landChange==null?'—':`${landChange>0?'+':''}${landChange.toFixed(1)}%`}</div></div></section><section class="card section"><h2>年次データ</h2><table><thead><tr><th>年</th><th>人口</th><th>高齢化率</th><th>純移動</th><th>求人倍率*</th><th>住宅着工</th><th>宿泊者数</th><th>住宅地価格</th></tr></thead><tbody>{[...rows].reverse().map((r)=><tr><td>{r.year}</td><td>{fmt(r.population)}</td><td>{fmt(r.elderlyRate)}%</td><td>{fmt(r.netMigration)}</td><td>{fmt(r.jobOpeningRatio)}</td><td>{fmt(r.housingStarts)}</td><td>{fmt(r.hotelNights)}</td><td>{fmt(r.residentialLandPrice)}</td></tr>)}</tbody></table><p style="font-size:11px;color:#667085;line-height:1.7">* 求人倍率は月間有効求人数÷月間有効求職者数を当サイトで計算した参考値。出典：統計センター SSDSE-B-2026。</p></section><div class="links"><a href="/regional/">47都道府県を比較</a><a href="/about-data/#regional">データ仕様を見る</a></div></main></body></html>
