---
import SiteNavigation from '../../../components/SiteNavigation.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
---
<!doctype html><html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><link rel="icon" type="image/svg+xml" href="/favicon.svg"><link rel="canonical" href="https://datlume.com/regional/weather/"><meta name="description" content="気象庁の過去の気象データ。全国の観測所を市区町村から探し、気温と降水量の日別・月別推移を比較。"><title>観測所別の気温・降水量 | DATLUME</title>
<style>
:root{--ink:#142033;--muted:#64748b;--line:#e1e7f0;--blue:#1769e0;--nav:#0e1b2e}*{box-sizing:border-box}body{margin:0;background:#f4f6f9;color:var(--ink);font-family:Inter,system-ui,-apple-system,"Noto Sans JP",sans-serif}a{color:inherit}.wrap{width:min(1180px,calc(100% - 32px));margin:auto}header{background:var(--nav);color:#fff;padding:20px 0 50px}.top{display:flex;justify-content:space-between;gap:18px;align-items:center}.brand{text-decoration:none;font-size:19px;font-weight:750;letter-spacing:.16em}.links{display:flex;gap:8px;flex-wrap:wrap}.links a{font-size:12px;text-decoration:none;border:1px solid #ffffff35;border-radius:999px;padding:7px 11px;color:#dae4f3}.hero{margin-top:44px}.hero h1{font-size:clamp(34px,5vw,60px);letter-spacing:-.05em;margin:0 0 12px}.hero p{color:#c8d4e4;line-height:1.75;max-width:800px;margin:0}.eyebrow{font-size:12px;color:#91bfff;font-weight:700;margin-bottom:10px}main{padding:18px 0 70px}.card{background:white;border:1px solid var(--line);border-radius:16px}.controls{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;padding:18px}.controls label{display:block;font-size:11px;color:var(--muted);font-weight:700;margin-bottom:6px}.controls select{width:100%;height:42px;border:1px solid #d8e0e9;border-radius:9px;background:#fff;padding:0 9px;color:var(--ink);font:inherit;font-size:13px}.help{font-size:11px;color:var(--muted);margin:6px 0 0}.kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:12px 0}.kpi{padding:18px;min-width:0}.kpi small{color:var(--muted);font-size:11px}.kpi strong{display:block;font-size:clamp(20px,2.5vw,29px);margin:7px 0}.kpi span{font-size:11px;color:var(--muted);line-height:1.5}.chart-card{padding:18px;min-width:0}.chart-card h2{margin:0;font-size:17px}.chart-card p{font-size:11px;color:var(--muted);margin:5px 0 12px;line-height:1.6}.chart{height:440px}.note{font-size:12px;line-height:1.8;color:#526278;margin:18px 0}.note a{color:var(--blue)}footer{font-size:11px;color:var(--muted);padding-bottom:42px}
@media(max-width:850px){.controls{grid-template-columns:1fr 1fr}.links{overflow:auto;flex-wrap:nowrap}.links a{white-space:nowrap}}@media(max-width:520px){.wrap{width:calc(100% - 24px)}.top{align-items:flex-start;flex-direction:column}.hero{margin-top:32px}.hero h1 span{display:block}.controls{grid-template-columns:1fr}.kpis{grid-template-columns:1fr 1fr;gap:8px}.kpi{padding:13px}.kpi strong{font-size:20px}.chart{height:340px}.chart-card{padding:14px}}
</style><link rel="stylesheet" href="/brand/footer.css?v=20261010-2"><link rel="stylesheet" href="/brand/navigation.css?v=20261011-1"><script src="/brand/navigation.js?v=20261011-1" defer></script></head><body>
<header><div class="wrap"><SiteNavigation /><div class="datlume-context" aria-label="ページ内メニュー"><a href="/regional/stays/">宿泊旅行統計</a></div><div class="hero"><div class="eyebrow">気象庁 · 過去の気象データ</div><h1>気温と雨を、<span>観測所ごとに。</span></h1><p>全国の観測地点の日別・月別データを比較できます。市区町村は観測所の所在地を探すための絞り込みです。表示値は観測地点のもので、市区町村全域の平均値ではありません。</p></div></div></header>
<main class="wrap"><section class="card controls" aria-label="表示条件">
<div><label for="pref">都道府県</label><select id="pref"></select></div><div><label for="city">観測所のある市区町村</label><select id="city"></select><p class="help" id="city-help"></p></div><div><label for="station">観測所 A</label><select id="station"></select></div>
<div><label for="compare">観測所 B</label><select id="compare"><option value="">比較なし</option></select></div><div><label for="metric">指標</label><select id="metric"><option value="temperature">平均気温（℃）</option><option value="rainfall">降水量の合計（mm）</option></select></div><div><label for="period">集計期間</label><select id="period"><option value="daily">日別（直近約1年）</option><option value="monthly">月別（2015年以降）</option></select></div>
</section><section class="kpis"><div class="card kpi"><small id="a-label">観測所 A</small><strong id="a-value">読み込み中</strong><span id="a-date">—</span></div><div class="card kpi"><small id="b-label">観測所 B</small><strong id="b-value">—</strong><span id="b-date">比較する観測所を選択</span></div><div class="card kpi"><small>観測地点</small><strong id="location">—</strong><span id="coverage">—</span></div></section>
<section class="card chart-card"><h2 id="trend-title">観測所の推移</h2><p>正常値のみ表示。欠測や品質が不足する日は線をつなぎません。</p><div id="trend" class="chart" role="img" aria-label="気象庁観測所の気温と降水量の推移"></div></section>
<p class="note" id="source-note">出典：<a href="https://www.data.jma.go.jp/risk/obsdl/" target="_blank" rel="noreferrer">気象庁「過去の気象データ・ダウンロード」</a>、<a href="https://www.jma.go.jp/jma/kishou/know/amedas/ame_master.zip" target="_blank" rel="noreferrer">観測所一覧</a>。観測所の所在地を市区町村に対応付けています。観測所がない市区町村や所在地を特定できない観測所は市区町村フィルターに出ません。日別は直近約1年、月別は2015年以降。品質情報8（正常値）のみ掲載し、欠測・準正常値は補完しません。観測環境・地点移転による均質性の変化に注意してください。</p>
</main><SiteFooter>DATLUME — 日本の公開データを、比較できる形に。 · <a href="/regional/">都道府県別推移へ戻る</a></SiteFooter>
<script>
import * as echarts from 'echarts';
const $=id=>document.getElementById(id),pref=$('pref'),city=$('city'),station=$('station'),compare=$('compare'),metric=$('metric'),period=$('period'),chart=echarts.init($('trend'));
const query=new URLSearchParams(location.search),cache=new Map(),fmt=new Intl.NumberFormat('ja-JP',{maximumFractionDigits:1});
let index,records=[];
const opts=(el,items,selected)=>{el.replaceChildren(...items.map(([value,label])=>{const o=document.createElement('option');o.value=value;o.textContent=label;return o}));if(selected&&[...el.options].some(o=>o.value===selected))el.value=selected};
const active=()=>index.stations.filter(s=>s.prefecture===pref.value);
function cities(preferred){const list=active(),keys=[...new Map(list.filter(s=>s.municipalityCode).map(s=>[s.municipalityCode,s.municipality])).entries()].sort((a,b)=>a[1].localeCompare(b[1],'ja'));opts(city,[['','全観測所'],...keys],preferred);$('city-help').textContent=keys.length+'市区町村に観測所あり。所在地未特定の地点は「全観測所」で表示。'}
function stations(preferred,other){const list=active().filter(s=>!city.value||s.municipalityCode===city.value),labels=list.map(s=>[s.id,s.name+(city.value?'':' · '+(s.municipality||'所在地未特定'))]);opts(station,labels,preferred);opts(compare,[['','比較なし'],...labels],other);if(compare.value===station.value)compare.value=''}
async function load(){const codes=[...new Set([station.value,compare.value].filter(Boolean).map(id=>index.stations.find(s=>s.id===id)?.regionCode))];for(const code of codes){if(!cache.has(code)){const response=await fetch('/data/weather/'+code+'.json');if(!response.ok)throw new Error('観測所データを読み込めません');cache.set(code,await response.json())}}records=codes.flatMap(code=>cache.get(code).records);draw()}
function draw(){const byId=new Map(records.map(s=>[s.id,s])),key=metric.value,offset=key==='temperature'?0:1,unit=key==='temperature'?'℃':'mm',axis=period.value==='daily'?index.days:index.months;
const value=row=>row?.[offset]??null,display=v=>v==null?'—':fmt.format(v)+unit;
const info=(id,prefix)=>{const s=byId.get(id),data=s?.[period.value]||[];let last=-1;for(let i=data.length-1;i>=0;i--)if(value(data[i])!=null){last=i;break}$(prefix+'-label').textContent=s?s.name+' / '+(key==='temperature'?'平均気温':'降水量'):'観測所 B';$(prefix+'-value').textContent=last<0?'—':display(value(data[last]));$(prefix+'-date').textContent=!id?'比較する観測所を選択':last<0?'正常値なし':axis[last]+(last===axis.length-1?'':'（直近の正常値）');return s};
const a=info(station.value,'a');info(compare.value,'b');$('location').textContent=a?(a.municipality||a.prefecture)+' · '+a.name:'—';$('coverage').textContent=a?(a.address||'所在地の市区町村未特定')+' / '+a.lat.toFixed(3)+'°N, '+a.lon.toFixed(3)+'°E':'—';
$('trend-title').textContent=(key==='temperature'?'平均気温':'降水量の合計')+' / '+(period.value==='daily'?'日別':'月別')+'推移';
const series=[station.value,compare.value].filter(Boolean).map((id,n)=>{const s=byId.get(id);return {name:s?.name||id,type:'line',showSymbol:false,connectNulls:false,lineStyle:{width:n?2:3},data:(s?.[period.value]||[]).map(value)}});
chart.setOption({tooltip:{trigger:'axis',valueFormatter:display},legend:{top:0},grid:{left:65,right:20,top:46,bottom:70},dataZoom:[{type:'inside'},{type:'slider',bottom:12,height:20}],xAxis:{type:'category',data:axis,axisLabel:{hideOverlap:true}},yAxis:{type:'value',name:unit,scale:key==='temperature',axisLabel:{formatter:v=>fmt.format(v)}},series},true);
const q=new URLSearchParams({pref:pref.value,station:station.value,metric:key,period:period.value});if(city.value)q.set('city',city.value);if(compare.value)q.set('compare',compare.value);history.replaceState(null,'','?'+q)}
async function refresh(){try{await load()}catch(error){$('a-value').textContent='読み込み失敗';$('a-date').textContent=error.message}}
(async()=>{try{const response=await fetch('/data/weather/index.json');if(!response.ok)throw new Error('観測所一覧を読み込めません');index=await response.json();const prefs=[...new Set(index.stations.map(s=>s.prefecture))].sort((a,b)=>a.localeCompare(b,'ja'));opts(pref,prefs.map(p=>[p,p]),query.get('pref')||'東京都');cities(query.get('city'));stations(query.get('station')||active().find(s=>s.name==='東京')?.id,query.get('compare'));for(const [el,key] of [[metric,'metric'],[period,'period']])if(query.get(key)&&[...el.options].some(o=>o.value===query.get(key)))el.value=query.get(key);$('source-note').append(' '+index.stationCount.toLocaleString('ja-JP')+'観測所収録、所在地を確認できた'+index.municipalityMappedCount.toLocaleString('ja-JP')+'観測所。最終日 '+index.days.at(-1)+'。');await refresh()}catch(error){$('a-value').textContent='読み込み失敗';$('a-date').textContent=error.message}})();
pref.addEventListener('change',()=>{cities('');stations('','');refresh()});city.addEventListener('change',()=>{stations('','');refresh()});station.addEventListener('change',()=>{if(compare.value===station.value)compare.value='';refresh()});compare.addEventListener('change',refresh);metric.addEventListener('change',draw);period.addEventListener('change',draw);window.addEventListener('resize',()=>chart.resize());
</script></body></html>
