---
import SiteNavigation from '../../../components/SiteNavigation.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import fs from 'node:fs';
import path from 'node:path';
const data=JSON.parse(fs.readFileSync(path.join(process.cwd(),'public/data/lodging-statistics.json'),'utf8'));
const latest=data.months.at(-1);
---
<!doctype html><html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><link rel="icon" type="image/svg+xml" href="/favicon.svg"><link rel="canonical" href="https://datlume.com/regional/stays/"><meta name="description" content="観光庁の宿泊旅行統計。全国・47都道府県の月次宿泊者数と客室稼働率を比較。"><title>宿泊旅行統計 | DATLUME</title>
<style>
:root{--ink:#142033;--muted:#667085;--line:#e1e7f0;--blue:#1769e0;--nav:#0e1b2e}*{box-sizing:border-box}body{margin:0;background:#f4f6f9;color:var(--ink);font-family:Inter,system-ui,-apple-system,"Noto Sans JP",sans-serif}a{color:inherit}.wrap{width:min(1180px,calc(100% - 32px));margin:auto}
header{background:var(--nav);color:white;padding:20px 0 50px}.top{display:flex;justify-content:space-between;gap:18px;align-items:center}.brand{text-decoration:none;font-size:19px;font-weight:750;letter-spacing:.16em}.links{display:flex;gap:8px;flex-wrap:wrap}.links a{font-size:12px;text-decoration:none;border:1px solid #ffffff35;border-radius:999px;padding:7px 11px;color:#dae4f3}.hero{margin-top:44px}.hero h1{font-size:clamp(34px,5vw,60px);letter-spacing:-.05em;margin:0 0 12px}.hero p{color:#c8d4e4;line-height:1.75;max-width:760px;margin:0}.eyebrow{font-size:12px;color:#91bfff;font-weight:700;margin-bottom:10px}
main{padding:18px 0 70px}.card{background:white;border:1px solid var(--line);border-radius:16px}.controls{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;padding:18px}.controls label{display:block;font-size:11px;color:var(--muted);font-weight:700;margin-bottom:6px}.controls select{width:100%;height:42px;border:1px solid #d8e0e9;border-radius:9px;background:white;padding:0 9px;color:var(--ink);font:inherit;font-size:13px}.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:12px 0}.kpi{padding:18px;min-width:0}.kpi small{color:var(--muted);font-size:11px}.kpi strong{display:block;font-size:clamp(21px,2.6vw,30px);margin:7px 0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.kpi span{font-size:11px;color:var(--muted);line-height:1.5}.grid{display:grid;grid-template-columns:1.5fr 1fr;gap:12px}.chart-card{padding:18px;min-width:0}.chart-card h2{margin:0;font-size:17px}.chart-card p{font-size:11px;color:var(--muted);margin:5px 0 12px;line-height:1.5}.chart{height:420px}.note{font-size:12px;line-height:1.8;color:#526278;margin:18px 0}.note a{color:var(--blue)}footer{font-size:11px;color:var(--muted);padding-bottom:42px}
@media(max-width:850px){.grid{grid-template-columns:1fr}.controls{grid-template-columns:1fr 1fr}.kpis{grid-template-columns:1fr 1fr}.links{overflow:auto;flex-wrap:nowrap}.links a{white-space:nowrap}}@media(max-width:520px){.wrap{width:calc(100% - 24px)}.top{align-items:flex-start;flex-direction:column}.hero{margin-top:32px}.hero h1 span{display:block}.controls{grid-template-columns:1fr}.kpis{gap:8px}.kpi{padding:13px}.kpi strong{font-size:22px}.chart{height:330px}.chart-card{padding:14px}}
</style><link rel="stylesheet" href="/brand/footer.css?v=20261010-2"><link rel="stylesheet" href="/brand/navigation.css?v=20261011-3"><script src="/brand/navigation.js?v=20261011-3" defer></script></head><body>
<header><div class="wrap"><SiteNavigation /><div class="datlume-context" aria-label="ページ内メニュー"><a href="/regional/projections/">将来人口</a></div><div class="hero"><div class="eyebrow">観光庁 · 宿泊旅行統計調査</div><h1>宿泊の動きを、<span>月ごとに。</span></h1><p>全国と47都道府県の延べ宿泊者数、外国人宿泊者数、客室稼働率。2011年から{latest.slice(0,4)}年{Number(latest.slice(5))}月までを比較します。</p></div></div></header>
<main class="wrap">
<section class="card controls" aria-label="表示条件"><div><label for="pref">地域 A</label><select id="pref">{data.prefectures.map(p=><option value={p}>{p}</option>)}</select></div><div><label for="compare">地域 B</label><select id="compare"><option value="">比較なし</option>{data.prefectures.map(p=><option value={p}>{p}</option>)}</select></div><div><label for="metric">指標</label><select id="metric"><option value="total">延べ宿泊者数</option><option value="foreign">外国人延べ宿泊者数</option><option value="foreignShare">外国人宿泊比率</option><option value="occupancy">客室稼働率</option></select></div><div><label for="period">表示期間</label><select id="period"><option value="36">過去3年</option><option value="12">過去1年</option><option value="all">全期間</option></select></div></section>
<section class="kpis"><div class="card kpi"><small id="a-label">地域 A</small><strong id="a-value">—</strong><span id="a-yoy">—</span></div><div class="card kpi"><small id="b-label">地域 B</small><strong id="b-value">—</strong><span id="b-yoy">—</span></div><div class="card kpi"><small>全国 / 同月</small><strong id="national-value">—</strong><span id="national-yoy">—</span></div><div class="card kpi"><small>最新データ</small><strong>{latest.slice(0,4)}年{Number(latest.slice(5))}月</strong><span>最新年の値は速報を含みます</span></div></section>
<section class="grid"><div class="card chart-card"><h2 id="trend-title">月次推移</h2><p>月ごとの値。前年同月比はカードに表示します。</p><div id="trend" class="chart" role="img" aria-label="宿泊統計の月次推移"></div></div><div class="card chart-card"><h2 id="rank-title">都道府県ランキング</h2><p id="rank-note">最新月の上位15都道府県</p><div id="ranking" class="chart" role="img" aria-label="都道府県の宿泊統計ランキング"></div></div></section>
<p class="note">出典：<a href={data.sourceUrl} target="_blank" rel="noreferrer">観光庁「宿泊旅行統計調査」</a>の<a href={data.workbookUrl} target="_blank" rel="noreferrer">推移表（Excel）</a>。延べ宿泊者数は人泊、客室稼働率は％です。外国人宿泊比率は外国人延べ宿泊者数÷延べ宿泊者数を当サイトで算出。2025年まで確報、最新年の月次値は速報・第2次速報を含み、改定される場合があります。施設規模に関する調査対象は2010年に拡大したため、2011年以降を表示します。欠損は補完しません。</p>
</main><SiteFooter>DATLUME — 日本の公開データを、比較できる形に。 · <a href="/regional/">都道府県別推移へ戻る</a></SiteFooter>
<script id="lodging-data" type="application/json" set:html={JSON.stringify({months:data.months,records:data.records})}></script>
<script>
import * as echarts from 'echarts';
const {months,records}=JSON.parse(document.getElementById('lodging-data').textContent),map=new Map(records.map(r=>[r.prefecture,r.values])),names=records.slice(1).map(r=>r.prefecture),latest=months.length-1;
const pref=document.getElementById('pref'),compare=document.getElementById('compare'),metric=document.getElementById('metric'),period=document.getElementById('period'),trend=echarts.init(document.getElementById('trend')),ranking=echarts.init(document.getElementById('ranking'));
const defs={total:{name:'延べ宿泊者数',unit:'人泊'},foreign:{name:'外国人延べ宿泊者数',unit:'人泊'},foreignShare:{name:'外国人宿泊比率',unit:'%'},occupancy:{name:'客室稼働率',unit:'%'}},fmt=new Intl.NumberFormat('ja-JP',{maximumFractionDigits:1});
function val(row,key){if(!row)return null;if(key==='foreignShare')return row[0]&&row[2]!=null?Math.round(row[2]/row[0]*1000)/10:null;return row[{total:0,foreign:2,occupancy:3}[key]]}
function display(v,key){return v==null?'—':fmt.format(v)+defs[key].unit}
function detail(name,key){const rows=map.get(name),v=val(rows?.[latest],key),prev=latest>=12?val(rows[latest-12],key):null;let yoy='前年同月の値なし';if(v!=null&&prev!=null){const delta=key==='occupancy'||key==='foreignShare'?v-prev:prev?(v/prev-1)*100:null;yoy=delta==null?'前年同月比を算出できません':'前年同月'+(delta>=0?'+':'')+fmt.format(delta)+(key==='occupancy'||key==='foreignShare'?'ポイント':'%')}return [display(v,key),yoy]}
function draw(){const key=metric.value,def=defs[key],from=period.value==='all'?0:Math.max(0,months.length-Number(period.value)),labels=months.slice(from),a=pref.value,b=compare.value;
for(const [prefix,name] of [['a',a],['b',b],['national','全国']]){const [v,yoy]=name?detail(name,key):['—','比較する地域を選択'];document.getElementById(prefix+'-value').textContent=v;document.getElementById(prefix+'-yoy').textContent=yoy;if(prefix!=='national')document.getElementById(prefix+'-label').textContent=name?name+' / '+def.name:'地域 B'}
document.getElementById('trend-title').textContent=def.name+'の月次推移';const series=[a,b].filter(Boolean).map((name,i)=>({name,type:'line',showSymbol:false,connectNulls:false,smooth:.12,lineStyle:{width:i?2:3},data:map.get(name).slice(from).map(row=>val(row,key))}));
trend.setOption({tooltip:{trigger:'axis',valueFormatter:v=>display(v,key)},legend:{top:0},grid:{left:68,right:18,top:45,bottom:53},dataZoom:[{type:'inside'}],xAxis:{type:'category',data:labels,axisLabel:{formatter:v=>v.slice(2).replace('-','/'),hideOverlap:true}},yAxis:{type:'value',scale:true,axisLabel:{formatter:v=>fmt.format(v)}},series},true);
const ranked=names.map(name=>({name,value:val(map.get(name)[latest],key)})).filter(r=>r.value!=null).sort((x,y)=>y.value-x.value).slice(0,15);document.getElementById('rank-title').textContent=def.name+' / 上位15都道府県';document.getElementById('rank-note').textContent=months[latest].replace('-','年')+'月の公表値';
ranking.setOption({tooltip:{trigger:'item',formatter:p=>p.name+'<br>'+display(p.value,key)},grid:{left:78,right:70,top:8,bottom:18},xAxis:{type:'value',show:false},yAxis:{type:'category',inverse:true,data:ranked.map(r=>r.name),axisLabel:{fontSize:11}},series:[{type:'bar',barWidth:13,data:ranked.map(r=>r.value),label:{show:true,position:'right',fontSize:10,formatter:p=>display(p.value,key)}}]},true);
const q=new URLSearchParams();q.set('pref',a);if(b)q.set('compare',b);q.set('metric',key);q.set('period',period.value);history.replaceState(null,'','?'+q)}
const query=new URLSearchParams(location.search);for(const [el,key] of [[pref,'pref'],[compare,'compare'],[metric,'metric'],[period,'period']]){const value=query.get(key);if(value&&[...el.options].some(o=>o.value===value))el.value=value}if(!query.has('pref'))pref.value='東京都';if(compare.value===pref.value)compare.value='';
for(const el of [pref,compare,metric,period])el.addEventListener('change',()=>{if(compare.value===pref.value)compare.value='';draw()});draw();window.addEventListener('resize',()=>{trend.resize();ranking.resize()});
</script></body></html>
