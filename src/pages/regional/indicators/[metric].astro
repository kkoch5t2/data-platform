---
import fs from 'node:fs';import path from 'node:path';
const METRICS={
'population':{field:'population',label:'総人口',unit:'人',desc:'都道府県別の総人口'},
'elderly-rate':{field:'elderlyRate',label:'高齢化率',unit:'%',desc:'65歳以上人口が総人口に占める割合'},
'net-migration':{field:'netMigration',label:'人口純移動',unit:'人',desc:'転入者数から転出者数を差し引いた参考値'},
'job-opening-ratio':{field:'jobOpeningRatio',label:'求人倍率（参考）',unit:'倍',desc:'月間有効求人数÷月間有効求職者数の参考値'},
'housing-starts':{field:'housingStarts',label:'新設住宅着工戸数',unit:'戸',desc:'新設住宅の着工戸数'},
'hotel-nights':{field:'hotelNights',label:'延べ宿泊者数',unit:'人泊',desc:'延べ宿泊者数'},
'foreign-stay-share':{field:'foreignStayShare',label:'外国人宿泊比率',unit:'%',desc:'延べ宿泊者数に占める外国人延べ宿泊者数の参考割合'},
'land-price':{field:'residentialLandPrice',label:'住宅地平均価格',unit:'円/㎡',desc:'住宅地の標準価格（平均価格）'}};
export function getStaticPaths(){const metrics=['population','elderly-rate','net-migration','job-opening-ratio','housing-starts','hotel-nights','foreign-stay-share','land-price'];return metrics.map(metric=>({params:{metric}}));}
const {metric}=Astro.params;const info=METRICS[metric];const field=info.field;const d=JSON.parse(fs.readFileSync(path.join(process.cwd(),'public/data/regional-trends-2026.json'),'utf8'));const latest=Math.max(...d.years);const rows=d.records.filter((r)=>r.year===latest&&r[field]!=null).sort((a,b)=>b[field]-a[field]);const fmt=(v)=>new Intl.NumberFormat('ja-JP',{maximumFractionDigits:2}).format(v??0);const jsonLd={"@context":"https://schema.org","@type":"Dataset","name":`${latest}年 都道府県別 ${info.label}`,"description":info.desc,"url":`https://datlume.pages.dev/regional/indicators/${metric}/`,"creator":{"@type":"Organization","name":"独立行政法人 統計センター"},"isBasedOn":"https://www.nstac.go.jp/use/literacy/ssdse/"};
---
<!doctype html><html lang="ja"><head><link rel="icon" type="image/svg+xml" href="/favicon.svg"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="description" content={`${latest}年の都道府県別${info.label}ランキングと、各都道府県の時系列データ。`}><link rel="canonical" href={`https://datlume.pages.dev/regional/indicators/${metric}/`}><title>都道府県別 {info.label}ランキング（{latest}年） | DATLUME</title><script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script><style>:root{--ink:#142033;--muted:#667085;--line:#e4e9f0;--bg:#f4f6f9;--nav:#0e1b2e;--blue:#1769e0}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,system-ui,-apple-system,"Noto Sans JP",sans-serif}.wrap{width:min(920px,calc(100% - 32px));margin:auto}header{background:var(--nav);color:#fff;padding:20px 0 52px}.nav{display:flex;justify-content:space-between}.nav a{color:#c7d3e4;font-size:12px}.hero{margin-top:36px}.hero h1{font-size:clamp(30px,5vw,50px);margin:0 0 10px}.hero p{color:#c7d3e4;line-height:1.7}main{margin-top:-22px;padding-bottom:60px}.card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:18px}.summary{display:flex;gap:24px;flex-wrap:wrap}.summary b{font-size:22px}.summary span{display:block;color:var(--muted);font-size:11px;margin-top:4px}table{width:100%;border-collapse:collapse;margin-top:14px}th,td{padding:11px;border-bottom:1px solid #eef1f5;font-size:12px;text-align:right}th:first-child,td:first-child{text-align:left}.pref{font-weight:700;color:var(--blue);text-decoration:none}.links{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px}.links a{border:1px solid var(--line);background:#fff;border-radius:9px;padding:9px 11px;text-decoration:none;font-size:12px}@media(max-width:600px){.card{overflow:auto}table{min-width:540px}}</style></head><body><header><div class="wrap"><div class="nav"><a href="/"><img src="/datlume-logo.svg" alt="DATLUME" width="163" height="30"></a><a href="/regional/">都道府県トレンドへ戻る</a></div><div class="hero"><h1>都道府県別 {info.label}</h1><p>{latest}年の47都道府県を比較。{info.desc}。</p></div></div></header><main class="wrap"><section class="card"><div class="summary"><div><b>{rows.length}</b><span>都道府県</span></div><div><b>{latest}年</b><span>最新収録年</span></div><div><b>{fmt(rows[0]?.[field])}{info.unit}</b><span>最大値</span></div></div><table><thead><tr><th>順位</th><th>都道府県</th><th>{info.label}</th></tr></thead><tbody>{rows.map((r,i)=><tr><td>{i+1}</td><td><a class="pref" href={`/regional/prefectures/${encodeURIComponent(r.prefecture)}/`}>{r.prefecture}</a></td><td>{fmt(r[field])}{info.unit}</td></tr>)}</tbody></table></section><div class="links"><a href="/regional/">指標を切り替えて比較</a><a href="/about-data/#regional">出典・注意点</a></div></main></body></html>
