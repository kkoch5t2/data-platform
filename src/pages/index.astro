---
import summary from '../data/summary';
const fmt = (v) => new Intl.NumberFormat('ja-JP').format(v || 0);
const startYear = (summary.firstDate || '2014-03-19').slice(0,4);
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content="公共調達、不動産、地価、防災、人口、暮らしなど、日本のさまざまなデータを見やすく可視化するデータサイト。" />
  <meta property="og:title" content="データから、日本を見る。" />
  <meta property="og:description" content="公共調達、不動産、地価、防災、人口、暮らしなどを、グラフと地図で横断的に見る。" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary" />
  <title>データから、日本を見る。 | DATA</title>
  <style>
    :root{color-scheme:light;--ink:#142033;--muted:#667085;--line:#e4e9f0;--bg:#f4f6f9;--card:#fff;--nav:#0e1b2e;--blue:#1769e0;--soft:#eef5ff}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Noto Sans JP",sans-serif}a{color:inherit}.wrap{width:min(1180px,calc(100% - 32px));margin:auto}
    header{background:var(--nav);color:#fff;padding:20px 0 76px}.nav{display:flex;align-items:center;justify-content:space-between;gap:18px}.brand{font-weight:900;letter-spacing:.12em;text-decoration:none}.navlinks{display:flex;gap:9px;flex-wrap:wrap}.navlinks a{font-size:12px;color:#d9e4f4;border:1px solid #ffffff29;border-radius:999px;padding:8px 12px;text-decoration:none}.hero{padding:76px 0 20px}.eyebrow{font-size:11px;font-weight:850;letter-spacing:.15em;color:#8ebdff;text-transform:uppercase;margin-bottom:16px}.hero h1{font-size:clamp(42px,7vw,82px);letter-spacing:-.055em;line-height:.98;margin:0 0 22px;max-width:900px}.hero p{font-size:17px;line-height:1.85;color:#c7d3e4;max-width:760px;margin:0}.hero-actions{display:flex;gap:10px;margin-top:28px;flex-wrap:wrap}.hero-actions a{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 16px;border-radius:11px;text-decoration:none;font-size:13px;font-weight:800}.primary{background:#fff;color:var(--nav)}.secondary{border:1px solid #ffffff36;color:#fff}
    main{margin-top:-34px;padding-bottom:72px}.intro-card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:20px 22px;display:grid;grid-template-columns:repeat(3,1fr);gap:0}.metric{padding:4px 20px;border-left:1px solid var(--line)}.metric:first-child{border-left:0;padding-left:0}.metric-label{font-size:11px;color:var(--muted);font-weight:750}.metric-value{font-size:28px;font-weight:850;letter-spacing:-.03em;margin-top:5px}.metric-sub{font-size:11px;color:var(--muted);margin-top:3px}
    .section{padding-top:48px}.section-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:16px}.section-head h2{margin:0;font-size:25px;letter-spacing:-.03em}.section-head p{margin:0;color:var(--muted);font-size:12px;line-height:1.6}.data-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.data-card{position:relative;overflow:hidden;background:#fff;border:1px solid var(--line);border-radius:18px;padding:26px;text-decoration:none;min-height:250px;transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease}.data-card:hover{transform:translateY(-2px);box-shadow:0 14px 34px #10182812;border-color:#cfd8e6}.card-tag{display:inline-flex;align-items:center;gap:6px;background:var(--soft);color:#185fb9;border-radius:999px;padding:6px 9px;font-size:10px;font-weight:850;letter-spacing:.04em}.data-card h3{font-size:27px;letter-spacing:-.035em;margin:18px 0 10px}.data-card p{margin:0;color:var(--muted);line-height:1.75;font-size:13px;max-width:500px}.card-meta{position:absolute;left:26px;right:26px;bottom:24px;display:flex;justify-content:space-between;gap:12px;align-items:center;font-size:11px;color:var(--muted)}.open{font-weight:850;color:var(--blue)}
    .future{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.future-card{background:#f8fafc;border:1px dashed #d5dce7;border-radius:14px;padding:18px}.future-card b{font-size:14px}.future-card span{display:block;font-size:11px;color:var(--muted);margin-top:5px;line-height:1.5}.note{background:#eef3f8;border-radius:14px;padding:18px 20px;color:#475467;font-size:12px;line-height:1.8}.note strong{color:var(--ink)}
    footer{border-top:1px solid var(--line);padding:28px 0 44px;color:var(--muted);font-size:11px;line-height:1.8}
    @media(max-width:760px){.wrap{width:min(100% - 24px,1180px)}header{padding-bottom:56px}.nav{align-items:flex-start;flex-direction:column}.navlinks{flex-wrap:nowrap;overflow-x:auto;width:100%;padding-bottom:3px}.navlinks a{white-space:nowrap;flex:0 0 auto}.hero{padding:54px 0 16px}.hero h1{font-size:46px}.hero p{font-size:14px}.intro-card{grid-template-columns:1fr}.metric,.metric:first-child{padding:14px 0;border-left:0;border-top:1px solid var(--line)}.metric:first-child{border-top:0}.data-grid{grid-template-columns:1fr}.data-card{min-height:260px}.section-head{align-items:flex-start;flex-direction:column;gap:6px}.future{grid-template-columns:1fr}.section{padding-top:38px}}
  </style>
</head>
<body>
<header>
  <div class="wrap">
    <nav class="nav"><a class="brand" href="/">DATA</a><div class="navlinks"><a href="#datasets">データを見る</a><a href="/procurement/">公共調達</a><a href="/realestate/">不動産・防災・暮らし</a><a href="/about-data/">データについて</a></div></nav>
    <section class="hero">
      <div class="eyebrow">Data Explorer / Japan</div>
      <h1>データから、日本を見る。</h1>
      <p>公共調達、不動産、地価、防災、人口、暮らし。分野ごとに散らばるデータを、グラフと地図で見やすくつなぎます。</p>
      <div class="hero-actions"><a class="primary" href="#datasets">データを見る</a><a class="secondary" href="/procurement/">公共調達から見る</a></div>
    </section>
  </div>
</header>
<main class="wrap">
  <section class="intro-card" aria-label="収録状況">
    <div class="metric"><div class="metric-label">公共調達</div><div class="metric-value">{fmt(summary.records)}件</div><div class="metric-sub">収録レコード</div></div>
    <div class="metric"><div class="metric-label">収録開始</div><div class="metric-value">{startYear}年</div><div class="metric-sub">公共調達データ</div></div>
    <div class="metric"><div class="metric-label">現在のデータ領域</div><div class="metric-value">2領域</div><div class="metric-sub">公共調達 / 不動産・地域</div></div>
  </section>

  <section id="datasets" class="section">
    <div class="section-head"><div><h2>データを見る</h2></div><p>テーマごとに独立して見られます。<br>裏側の収集・更新基盤は共通です。</p></div>
    <div class="data-grid">
      <a class="data-card" href="/procurement/">
        <span class="card-tag">PUBLIC PROCUREMENT</span>
        <h3>公共調達</h3>
        <p>国・独立行政法人、地方政府系の公開調達を、分野・企業・発注機関・年度・落札額から横断的に見る。</p>
        <div class="card-meta"><span>{fmt(summary.records)}件を収録</span><span class="open">開く →</span></div>
      </a>
      <a class="data-card" href="/realestate/">
        <span class="card-tag">REAL ESTATE / LIVING</span>
        <h3>不動産 × 防災 × 暮らし</h3>
        <p>地価に、防災、人口、高齢化率、治安、交通事故、病院、学校、駅などを重ね、街を複数の角度から見る。</p>
        <div class="card-meta"><span>全国の地図データ</span><span class="open">開く →</span></div>
      </a>
    </div>
  </section>

  <section class="section">
    <div class="section-head"><div><h2>これから広げる</h2></div><p>サイト名は後から決められるよう、<br>分野に依存しない構造にしています。</p></div>
    <div class="future">
      <div class="future-card"><b>企業・産業</b><span>企業統計、産業構造、市場データなど。</span></div>
      <div class="future-card"><b>経済・物価</b><span>価格、賃金、消費、地域経済など。</span></div>
      <div class="future-card"><b>雇用・人口</b><span>求人、就業、人口移動、地域比較など。</span></div>
    </div>
  </section>

  <section class="section"><div class="note"><strong>設計方針：</strong> 表側はテーマ別に分け、データ収集・更新・監視は共通基盤で運用します。まず日本のデータを充実させつつ、将来は国や地域を追加できる形にします。</div></section>
</main>
<footer><div class="wrap">公開データを中心に、各データソースの利用条件と収録範囲を明示しながら可視化します。</div></footer>
</body>
</html>
