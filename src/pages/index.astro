---
import summary from '../data/summary';
const fmt = (v) => new Intl.NumberFormat('ja-JP').format(v || 0);
const startYear = (summary.firstDate || '2014-03-19').slice(0,4);
---
<!doctype html>
<html lang="ja">
<head><link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content="公共調達、不動産、地価、防災、人口、雇用、賃金、企業・産業、上場企業、物価、エネルギーなど、日本のさまざまなデータを見やすく可視化するデータサイト。" />
  <meta name="google-adsense-account" content="ca-pub-7677179691441346" />
  <link rel="canonical" href="https://datlume.com/" />
  <meta property="og:url" content="https://datlume.com/" />
  <meta property="og:title" content="データから、日本を見る。" />
  <meta property="og:description" content="公共調達、不動産、地価、防災、人口、雇用、賃金、企業・産業、上場企業、物価、エネルギーなどを、グラフと地図で横断的に見る。" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary" />
  <title>データから、日本を見る。 | DATLUME</title>
  <style>
    :root{color-scheme:light;--ink:#142033;--muted:#667085;--line:#e4e9f0;--bg:#f4f6f9;--card:#fff;--nav:#0e1b2e;--blue:#1769e0;--soft:#eef5ff}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Noto Sans JP",sans-serif}a{color:inherit}.wrap{width:min(1180px,calc(100% - 32px));margin:auto}
    header{background:var(--nav);color:#fff;padding:20px 0 76px}.nav{display:flex;align-items:center;justify-content:space-between;gap:18px}.brand{font-weight:900;letter-spacing:.12em;text-decoration:none}.navlinks{display:flex;gap:9px;flex-wrap:wrap;justify-content:flex-end;margin-left:auto}.navlinks a{font-size:12px;color:#d9e4f4;border:1px solid #ffffff29;border-radius:999px;padding:8px 12px;text-decoration:none}.hero{padding:76px 0 20px}.eyebrow{font-size:11px;font-weight:850;letter-spacing:.15em;color:#8ebdff;text-transform:uppercase;margin-bottom:16px}.hero h1{font-size:clamp(42px,7vw,82px);letter-spacing:-.055em;line-height:.98;margin:0 0 22px;max-width:900px}.hero p{font-size:17px;line-height:1.85;color:#c7d3e4;max-width:760px;margin:0}.hero-actions{display:flex;gap:10px;margin-top:28px;flex-wrap:wrap}.hero-actions a{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 16px;border-radius:11px;text-decoration:none;font-size:13px;font-weight:800}.primary{background:#fff;color:var(--nav)}.secondary{border:1px solid #ffffff36;color:#fff}
    main.wrap{margin-top:18px;padding-bottom:72px}.intro-card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:20px 22px;display:grid;grid-template-columns:repeat(3,1fr);gap:0}.metric{padding:4px 20px;border-left:1px solid var(--line)}.metric:first-child{border-left:0;padding-left:0}.metric-label{font-size:11px;color:var(--muted);font-weight:750}.metric-value{font-size:28px;font-weight:850;letter-spacing:-.03em;margin-top:5px}.metric-sub{font-size:11px;color:var(--muted);margin-top:3px}
    .section{padding-top:48px}.section-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:16px}.section-head h2{margin:0;font-size:25px;letter-spacing:-.03em}.section-head p{margin:0;color:var(--muted);font-size:12px;line-height:1.6}.data-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.data-card{position:relative;overflow:hidden;background:#fff;border:1px solid var(--line);border-radius:18px;padding:26px;text-decoration:none;min-height:250px;transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease}.data-card:hover{transform:translateY(-2px);box-shadow:0 14px 34px #10182812;border-color:#cfd8e6}.card-tag{display:inline-flex;align-items:center;gap:6px;background:var(--soft);color:#185fb9;border-radius:999px;padding:6px 9px;font-size:10px;font-weight:850;letter-spacing:.04em}.data-card h3{font-size:27px;letter-spacing:-.035em;margin:18px 0 10px}.data-card p{margin:0;color:var(--muted);line-height:1.75;font-size:13px;max-width:500px}.card-meta{position:absolute;left:26px;right:26px;bottom:24px;display:flex;justify-content:space-between;gap:12px;align-items:center;font-size:11px;color:var(--muted)}.open{font-weight:850;color:var(--blue)}
    .future{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.future-card{background:#f8fafc;border:1px dashed #d5dce7;border-radius:14px;padding:18px}.future-card b{font-size:14px}.future-card span{display:block;font-size:11px;color:var(--muted);margin-top:5px;line-height:1.5}.note{background:#eef3f8;border-radius:14px;padding:18px 20px;color:#475467;font-size:12px;line-height:1.8}.note strong{color:var(--ink)}
    footer{border-top:1px solid var(--line);padding:28px 0 44px;color:var(--muted);font-size:11px;line-height:1.8}
    @media(max-width:760px){.wrap{width:min(100% - 24px,1180px)}header{padding-bottom:56px}.nav{align-items:flex-start;flex-direction:column}.navlinks{flex-wrap:nowrap;overflow-x:auto;width:100%;padding-bottom:3px;justify-content:flex-start;margin-left:0}.navlinks a{white-space:nowrap;flex:0 0 auto}.hero{padding:54px 0 16px}.hero h1{font-size:46px}.hero p{font-size:14px}.intro-card{grid-template-columns:1fr}.metric,.metric:first-child{padding:14px 0;border-left:0;border-top:1px solid var(--line)}.metric:first-child{border-top:0}.data-grid{grid-template-columns:1fr}.data-card{min-height:260px}.section-head{align-items:flex-start;flex-direction:column;gap:6px}.future{grid-template-columns:1fr}.section{padding-top:38px}}
  </style>
</head>
<body>
<header>
  <div class="wrap">
    <nav class="nav"><a class="brand" href="/" aria-label="DATLUME" style="display:inline-flex;align-items:center;gap:10px;text-decoration:none;color:#fff"><img src="/favicon.svg" alt="" width="24" height="24" style="display:block;width:24px;height:24px;filter:brightness(0) invert(1)"><span style="font-family:'Segoe UI Variable','Avenir Next','Helvetica Neue',system-ui,sans-serif;font-size:19px;font-weight:750;letter-spacing:.16em;line-height:1">DATLUME</span></a><div class="navlinks"><a href="#datasets">データを見る</a><a href="/procurement/">国・自治体の案件</a><a href="/realestate/">不動産・暮らし</a><a href="/regional/">都道府県別推移</a><a href="/employment-economy/">雇用・賃金</a><a href="/business-industry/">企業・産業</a><a href="/listed-companies/">上場企業</a><a href="/economy-prices/">経済・物価</a><a href="/energy/">エネルギー</a><a href="/analytics/">サイト統計</a><a href="/about-data/">データについて</a><a href="https://github.com/kkoch5t2/data-platform" target="_blank" rel="noreferrer">GitHub ↗</a></div></nav>
    <section class="hero">
      <div class="eyebrow">Data Explorer / Japan</div>
      <h1>データから、日本を見る。</h1>
      <p>国・自治体の案件、不動産、地価、防災、人口、雇用、賃金、地域経済、企業・産業、物価、エネルギー。分野ごとに散らばるデータを、グラフと地図で見やすくつなぎます。</p>
      <div class="hero-actions"><a class="primary" href="#datasets">データを見る</a><a class="secondary" href="/procurement/">国・自治体の案件から見る</a></div>
    </section>
  </div>
</header>
<main class="wrap">
  <section class="intro-card" aria-label="収録状況">
    <div class="metric"><div class="metric-label">国・自治体の案件</div><div class="metric-value">{fmt(summary.records)}件</div><div class="metric-sub">収録レコード</div></div>
    <div class="metric"><div class="metric-label">収録開始</div><div class="metric-value">{startYear}年</div><div class="metric-sub">国・自治体の案件データ</div></div>
    <div class="metric"><div class="metric-label">現在のデータ領域</div><div class="metric-value">8領域</div><div class="metric-sub">国・自治体の案件 / 不動産・暮らし / 都道府県別推移 / 雇用・賃金 / 企業・産業 / 上場企業 / 経済・物価 / エネルギー</div></div>
  </section>

  <section id="datasets" class="section">
    <div class="section-head"><div><h2>データを見る</h2></div><p>テーマごとに独立して見られます。<br>裏側の収集・更新基盤は共通です。</p></div>
    <div class="data-grid">
      <a class="data-card" href="/procurement/">
        <span class="card-tag">PUBLIC PROCUREMENT</span>
        <h3>国・自治体の案件</h3>
        <p>国・独立行政法人、地方政府系の公開調達を、分野・企業・発注機関・年度・落札額から横断的に見る。</p>
        <div class="card-meta"><span>{fmt(summary.records)}件を収録</span><span class="open">開く →</span></div>
      </a>
      <a class="data-card" href="/realestate/">
        <span class="card-tag">REAL ESTATE / LIVING</span>
        <h3>不動産・暮らし</h3>
        <p>地価に、防災、人口、高齢化率、治安、交通事故、病院、学校、駅などを重ね、街を複数の角度から見る。</p>
        <div class="card-meta"><span>全国の地図データ</span><span class="open">開く →</span></div>
      </a>
      <a class="data-card" href="/regional/">
        <span class="card-tag">PREFECTURE TRENDS</span>
        <h3>都道府県別推移</h3>
        <p>人口、高齢化、人口移動、求人、住宅着工、宿泊、地価などを、47都道府県×12年で比較する。</p>
        <div class="card-meta"><span>47都道府県 / 2012〜2023年</span><span class="open">開く →</span></div>
      </a>
      <a class="data-card" href="/employment-economy/">
        <span class="card-tag">EMPLOYMENT / ECONOMY</span>
        <h3>雇用・賃金</h3>
        <p>平均賃金、推計年収、求人倍率、県民所得、GDP、事業所・従業者から、47都道府県の「働く」を比べる。</p>
        <div class="card-meta"><span>47都道府県 / 賃金2025年</span><span class="open">開く →</span></div>
      </a>
      <a class="data-card" href="/business-industry/">
        <span class="card-tag">BUSINESS / INDUSTRY</span>
        <h3>企業・産業</h3>
        <p>民営事業所、従業者、主要産業の構成比から、地域ごとの企業活動と産業構造を比較する。</p>
        <div class="card-meta"><span>47都道府県 / 2021年</span><span class="open">開く →</span></div>
      </a>
      <a class="data-card" href="/listed-companies/">
        <span class="card-tag">LISTED COMPANIES / FINANCIALS</span>
        <h3>上場企業</h3>
        <p>日本の上場企業を、売上・利益・資産・キャッシュフロー・給与などの公開データから1社ずつ分かりやすく見る。</p>
        <div class="card-meta"><span>JPX × EDINET</span><span class="open">開く →</span></div>
      </a>
      <a class="data-card" href="/economy-prices/">
        <span class="card-tag">ECONOMY / PRICES</span>
        <h3>経済・物価</h3>
        <p>食料、住居、光熱水道などの地域物価を比較し、生活費換算や物価調整後の賃金まで生活者目線で見る。</p>
        <div class="card-meta"><span>47都道府県 / 2025年</span><span class="open">開く →</span></div>
      </a>
      <a class="data-card" href="/energy/">
        <span class="card-tag">ENERGY / HOUSEHOLD</span>
        <h3>エネルギー</h3>
        <p>電気代、ガス代、灯油などの家計負担を地域比較し、価格水準や日本の電力需給・電源構成まで見る。</p>
        <div class="card-meta"><span>47都道府県庁所在市 / 家計2025年</span><span class="open">開く →</span></div>
      </a>
    </div>
  </section>

  <section class="section"><div class="note"><strong>設計方針：</strong> 表側はテーマ別に分け、データ収集・更新・監視は共通基盤で運用します。まず日本のデータを充実させつつ、将来は国や地域を追加できる形にします。</div></section>
</main>
<footer><div class="wrap">公開データを中心に、各データソースの利用条件と収録範囲を明示しながら可視化します。 · <a href="https://github.com/kkoch5t2/data-platform" target="_blank" rel="noreferrer" style="display:inline-flex;align-items:center;gap:5px"><img src="/brand/github.svg" alt="" width="14" height="14" style="display:block;width:14px;height:14px">GitHub ↗</a> · <a href="https://utility-tools-jp.com/" target="_blank" rel="noreferrer" style="display:inline-flex;align-items:center;gap:5px"><img src="/brand/utility-tools.ico" alt="" width="14" height="14" style="display:block;width:14px;height:14px;border-radius:3px">無料WEB便利ツール集 ↗</a> · <a href="/privacy/">プライバシーポリシー</a></div></footer>
</body>
</html>
