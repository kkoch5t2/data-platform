---
import SiteNavigation from '../../components/SiteNavigation.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import RealestateHistory from '../../components/RealestateHistory.astro';
import fs from 'node:fs';
import path from 'node:path';
const housing2023=JSON.parse(fs.readFileSync(path.join(process.cwd(),'public/data/housing-land-2023.json'),'utf8'));
const housingNational=housing2023.national;
const transactions=JSON.parse(fs.readFileSync(path.join(process.cwd(),'public/data/realestate-transactions.json'),'utf8'));
const tradeNational=transactions.national.segments;
const tradeUsesApi=transactions.acquisition==='official-api-XIT001';
const nf=(v)=>new Intl.NumberFormat('ja-JP',{maximumFractionDigits:2}).format(v??0);
const money=(v)=>v==null?'—':new Intl.NumberFormat('ja-JP',{maximumFractionDigits:1}).format(v/10000)+'万円';
const unitMoney=(v)=>v==null?'—':new Intl.NumberFormat('ja-JP',{maximumFractionDigits:0}).format(v)+'円/㎡';
---
<!doctype html>
<html lang="ja">
<head><link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content="全国の地価、実取引価格、不動産、防災、人口、2023年住宅ストック、治安、交通事故、病院、学校、駅、飲食店を地図で重ねて見る地域データマップ。" />
  <link rel="canonical" href="https://datlume.com/realestate/" />
  <meta property="og:url" content="https://datlume.com/realestate/" />
  <meta property="og:title" content="不動産・暮らし | DATLUME" />
  <meta property="og:description" content="地価・実取引価格・防災・人口・住宅ストック・治安・交通事故・生活施設を、同じ地図で比較。" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary" />
  <title>不動産・暮らし | DATLUME</title>
  <link rel="stylesheet" href="/vendor/maplibre-6.11.1/maplibre-gl.css" />
  <style is:global>
    :root{--ink:#142033;--muted:#667085;--line:#e4e9f0;--bg:#f4f6f9;--nav:#0e1b2e;--blue:#1769e0}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Noto Sans JP",sans-serif}.wrap{width:min(1440px,calc(100% - 28px));margin:auto}a{color:inherit}header{background:var(--nav);color:white;padding:16px 0}.nav{display:flex;justify-content:space-between;align-items:center;gap:16px}.brand{font-weight:850;letter-spacing:.05em;text-decoration:none}.navlinks{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end;margin-left:auto}.navlinks a{font-size:12px;color:#d9e4f4;text-decoration:none;border:1px solid #ffffff28;padding:7px 10px;border-radius:999px}
    .intro{padding:24px 0 14px}.housing-summary,.trade-summary{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:0 0 12px}.housing-card,.trade-card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:13px 14px}.trade-card{border-top:3px solid #4f46e5}.housing-card small,.trade-card small{display:block;color:var(--muted);font-size:10px;font-weight:750}.housing-card b,.trade-card b{display:block;font-size:22px;letter-spacing:-.03em;margin-top:4px}.housing-card span,.trade-card span{display:block;color:var(--muted);font-size:9px;margin-top:3px}.trade-head{display:flex;align-items:end;justify-content:space-between;gap:12px;margin:4px 0 8px}.trade-head h2{font-size:15px;margin:0}.trade-head p{font-size:10px;color:var(--muted);margin:0;text-align:right}.intro h1{font-size:clamp(28px,4vw,48px);letter-spacing:-.04em;margin:0 0 8px}.intro p{margin:0;color:var(--muted);line-height:1.7}.dashboard{display:grid;grid-template-columns:310px minmax(0,1fr);gap:12px;padding-bottom:40px}.panel,.map-card{background:#fff;border:1px solid var(--line);border-radius:16px}.panel{padding:16px;align-self:start}.map-card{align-self:start}.panel-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px}.panel-head h2{font-size:14px;margin:0}.panel-toggle{display:none;border:1px solid #d9dee7;background:#fff;color:var(--ink);border-radius:9px;padding:8px 11px;font:inherit;font-size:11px;font-weight:800;cursor:pointer}.group{border-top:1px solid #edf0f4;padding-top:14px;margin-top:14px}.group:first-of-type{border-top:0;padding-top:0;margin-top:0}.label{display:block;font-size:11px;font-weight:750;color:var(--muted);margin-bottom:7px}select{width:100%;height:40px;border:1px solid #d9dee7;border-radius:9px;background:#fff;padding:0 10px}.layer{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:9px 0}.layer span{font-size:13px}.keydot{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:7px;vertical-align:-1px;box-shadow:0 0 0 1px #ffffff,0 0 0 2px #cfd6df}.keygrad{display:inline-block;width:30px;height:10px;border-radius:999px;margin-right:7px;vertical-align:-1px;box-shadow:0 0 0 1px #cfd6df}.color-key{font-size:11px;color:#475467;line-height:1.6}.color-key .row{display:flex;align-items:center;gap:7px;margin:5px 0}.color-key .swatch{width:12px;height:12px;border-radius:50%;flex:0 0 auto}.color-key .grad{width:48px;height:10px;border-radius:999px;flex:0 0 auto}.toggle{appearance:none;width:42px;height:24px;border-radius:999px;background:#d0d5dd;position:relative;cursor:pointer;transition:.2s}.toggle:after{content:"";width:18px;height:18px;border-radius:50%;background:#fff;position:absolute;top:3px;left:3px;transition:.2s;box-shadow:0 1px 3px #0003}.toggle:checked{background:var(--blue)}.toggle:checked:after{left:21px}
    .history-btn{width:100%;border:0;border-radius:9px;background:var(--nav);color:#fff;padding:10px 12px;font:inherit;font-size:12px;font-weight:800;cursor:pointer}.history-mini{margin-top:10px;padding:10px;background:#f8fafc;border:1px solid #edf0f4;border-radius:10px}.history-mini svg{display:block;width:100%;height:110px}.history-caption{font-size:10px;color:var(--muted);line-height:1.5;margin-top:5px}.kpis{display:grid;grid-template-columns:1fr 1fr;gap:8px}.kpi{background:#f8fafc;border:1px solid #edf0f4;border-radius:11px;padding:10px}.kpi b{display:block;font-size:18px;margin-top:4px}.kpi small{color:var(--muted)}.note{font-size:11px;color:var(--muted);line-height:1.65}.map-card{overflow:hidden;position:relative}.map-toolbar{display:flex;justify-content:space-between;gap:10px;align-items:center;padding:12px 14px;border-bottom:1px solid var(--line)}.map-toolbar strong{font-size:13px}.map-toolbar span{font-size:11px;color:var(--muted)}#map{height:72vh;min-height:560px}.legend{position:absolute;right:12px;bottom:28px;z-index:3;background:#fffffff2;border:1px solid #dfe4eb;border-radius:10px;padding:10px 11px;font-size:10px;box-shadow:0 6px 22px #10182818}.legend div{display:flex;align-items:center;gap:6px;margin:4px 0}.dot{width:11px;height:11px;border-radius:50%;display:inline-block}.loading{position:absolute;inset:55px 0 0;z-index:4;background:#ffffffd9;display:grid;place-items:center;font-weight:750;color:#475467}.maplibregl-popup-content{border-radius:12px;padding:12px 14px;min-width:240px}.popup-title{font-weight:800;margin-bottom:7px}.popup-price{font-size:20px;font-weight:850}.popup-meta{font-size:11px;color:#667085;line-height:1.6;margin-top:5px}.map-fallback{height:100%;min-height:560px;display:grid;place-content:center;gap:8px;padding:28px;text-align:center;background:linear-gradient(145deg,#f8fafc,#eef3f8);color:#475467}.map-fallback strong{font-size:18px;color:#142033}.map-fallback span{max-width:520px;font-size:12px;line-height:1.75}.map-card.map-unavailable #map,.map-card.map-unavailable .map-fallback{height:360px;min-height:360px}.map-card.map-unavailable .legend{display:none}
    @media(max-width:900px){.housing-summary,.trade-summary{grid-template-columns:1fr 1fr}.dashboard{grid-template-columns:1fr}.panel{display:grid;grid-template-columns:1fr 1fr;gap:12px}.panel-head{grid-column:1/-1}.group{margin:0;padding:0;border:0}.note{grid-column:1/-1}#map{height:68vh;min-height:500px}}@media(max-width:560px){.housing-card b,.trade-card b{font-size:18px}.trade-head{align-items:flex-start;flex-direction:column}.trade-head p{text-align:left}.wrap{width:calc(100% - 16px)}.nav{align-items:flex-start;flex-direction:column}.navlinks{justify-content:flex-start;margin-left:0}.panel{display:block}.panel-toggle{display:block}.panel.mobile-collapsed>:not(.panel-head){display:none}.panel.mobile-collapsed .panel-head{margin-bottom:0}.group{border-top:1px solid #edf0f4;padding-top:12px;margin-top:12px}.legend{display:none}#map{min-height:520px}.map-card.map-unavailable #map,.map-card.map-unavailable .map-fallback{height:300px;min-height:300px}}

.realestate-content{padding-top:18px}
.navlinks,.tabs,.view-tabs{scrollbar-width:none;-ms-overflow-style:none}.navlinks::-webkit-scrollbar,.tabs::-webkit-scrollbar,.view-tabs::-webkit-scrollbar{display:none}
.hazard-status{padding:10px 14px;border-bottom:1px solid var(--line);background:#f8fafc;font-size:11px;line-height:1.6;overflow-wrap:anywhere}.hazard-status strong{font-size:12px}.hazard-status [data-state="failed"]{color:#b42318}.hazard-status p{margin:5px 0 0;color:var(--muted)}.hazard-status button{margin-top:6px;padding:5px 9px;border:1px solid #d9dee7;border-radius:7px;background:white;font:inherit;cursor:pointer}.hazard-status button:disabled{opacity:.5;cursor:default}
</style>
<link rel="stylesheet" href="/brand/footer.css?v=20261010-2"><link rel="stylesheet" href="/brand/navigation.css?v=20261011-3"><script src="/brand/navigation.js?v=20261011-3" defer></script></head>
<body>
<header><div class="wrap">
  <SiteNavigation />
  <section class="hero intro"><h1><span aria-hidden="true">🏠</span> 街を、価格だけで選ばない。</h1><p>公示地価だけでなく実際の取引価格、防災、人口、高齢化率、2023年の空き家・持ち家・住宅タイプ、人口移動、治安、交通事故、病院、学校、駅、飲食店を重ねて、街をいろいろな角度から見られます。</p></section>
</div></header>
<main class="wrap realestate-content">
  <section class="housing-summary" aria-label="2023年住宅ストック全国サマリー">
    <div class="housing-card"><small>全国の総住宅数</small><b>{nf(housingNational.totalHousing)}戸</b><span>2023年10月</span></div>
    <div class="housing-card"><small>全国の空き家率</small><b>{nf(housingNational.vacantHouseRate)}%</b><span>空き家 {nf(housingNational.vacantHouses)}戸</span></div>
    <div class="housing-card"><small>全国の持ち家率</small><b>{nf(housingNational.ownerOccupiedRate)}%</b><span>居住世帯のある住宅</span></div>
    <div class="housing-card"><small>全国の共同住宅率</small><b>{nf(housingNational.apartmentRate)}%</b><span>1,059自治体を地図比較</span></div>
  </section>
  <div class="trade-head"><h2>実際の取引価格を見る</h2><p>国土交通省 不動産情報ライブラリ / {transactions.periodLabel} / 中央値</p></div>
  <section class="trade-summary" aria-label="不動産取引価格全国サマリー">
    <div class="trade-card"><small>住宅系の取引件数</small><b>{nf(transactions.publishedResidentialRecords)}件</b><span>土地・土地+建物・中古マンション等</span></div>
    <div class="trade-card"><small>土地の取引価格</small><b>{money(tradeNational.land.medianTradePrice)}</b><span>{unitMoney(tradeNational.land.medianUnitPrice)} / {nf(tradeNational.land.count)}件</span></div>
    <div class="trade-card"><small>土地+建物の取引価格</small><b>{money(tradeNational.house.medianTradePrice)}</b><span>延床面積中央値 {nf(tradeNational.house.medianFloorArea)}㎡ / {nf(tradeNational.house.count)}件</span></div>
    <div class="trade-card"><small>中古マンション等の取引価格</small><b>{money(tradeNational.condo.medianTradePrice)}</b><span>{unitMoney(tradeNational.condo.medianUnitPrice)} / {nf(tradeNational.condo.count)}件</span></div>
  </section>
  <RealestateHistory />
  <section class="dashboard">
    <aside id="filters-panel" class="panel">
      <div class="panel-head"><h2>表示条件</h2><button id="filters-toggle" class="panel-toggle" type="button" aria-expanded="true">条件を閉じる</button></div>
      <div class="group"><label class="label" for="prefecture">都道府県</label><select id="prefecture"><option value="">全国</option></select></div>
      <div class="group"><label class="label" for="price-dataset">地価データ</label><select id="price-dataset"><option value="landPrice">地価公示（2026）</option><option value="landSurvey">都道府県地価調査（2026）</option></select><label class="layer"><span><i class="keydot" style="background:#1769e0"></i>地価地点</span><input id="layer-price" class="toggle" type="checkbox" checked /></label></div>
      <div class="group"><span class="label">不動産・防災</span>
        <label class="layer"><span><i class="keygrad" style="background:linear-gradient(90deg,#fff7bc,#fed98e,#fc9272,#e34a9a,#c06bd8)"></i>洪水浸水想定</span><input id="layer-flood" class="toggle" type="checkbox" checked /></label>
        <label class="layer"><span><i class="keygrad" style="background:linear-gradient(90deg,#fff7bc,#fed98e,#fc9272,#e34a9a,#c06bd8)"></i>津波浸水想定</span><input id="layer-tsunami" class="toggle" type="checkbox" /></label>
        <label class="layer"><span><i class="keygrad" style="background:linear-gradient(90deg,#f1d42b 0 50%,#bd0026 50% 100%)"></i>土砂災害（土石流）</span><input id="layer-sediment" class="toggle" type="checkbox" /></label>
      </div>
      <div class="group"><label class="label" for="stat-layer">地域統計</label><select id="stat-layer">
        <option value="">表示しない</option><option value="tradeLand">土地 実取引㎡単価</option><option value="tradeHouse">土地+建物 実取引価格</option><option value="tradeCondo">中古マンション 実取引㎡単価</option><option value="population">人口</option><option value="elderly">高齢化率</option><option value="single">単身世帯率</option><option value="migration">転入超過・転出超過</option><option value="vacancy">空き家率（2023）</option><option value="otherVacancy">賃貸・売却用等を除く空き家率</option><option value="owner">持ち家率（2023）</option><option value="apartment">共同住宅率（2023）</option><option value="oldHousing">1980年以前住宅率</option><option value="crime">犯罪率</option><option value="accident">交通事故</option>
      </select></div>
      <div class="group"><span class="label">施設・生活</span>
        <label class="layer"><span><i class="keydot" style="background:#0ea5e9"></i>病院（2020）</span><input id="layer-hospital" class="toggle" type="checkbox" /></label>
        <label class="layer"><span><i class="keydot" style="background:#8b5cf6"></i>学校（2023）</span><input id="layer-school" class="toggle" type="checkbox" /></label>
        <label class="layer"><span><i class="keydot" style="background:#059669"></i>駅（2025）</span><input id="layer-station" class="toggle" type="checkbox" /></label>
        <label class="layer"><span><i class="keydot" style="background:#f59e0b"></i>飲食店（OSM・拡大時）</span><input id="layer-restaurant" class="toggle" type="checkbox" /></label>
      </div>
      <div class="group"><span class="label">色の見方</span><div class="color-key">
        <div class="row"><i class="swatch" style="background:#1769e0"></i><span>青：地価地点</span></div>
        <div class="row"><i class="grad" style="background:linear-gradient(90deg,#fff7bc,#fed98e,#fc9272,#e34a9a,#c06bd8)"></i><span>洪水：浸水浅 ↗ 深</span></div>
        <div class="row"><i class="grad" style="background:linear-gradient(90deg,#fff7bc,#fed98e,#fc9272,#e34a9a,#c06bd8)"></i><span>津波：浸水浅 ↗ 深</span></div>
        <div class="row"><i class="grad" style="background:linear-gradient(90deg,#f1d42b 0 50%,#bd0026 50% 100%)"></i><span>土砂災害：警戒区域 ↗ 特別警戒区域</span></div>
        <div class="row"><i class="swatch" style="background:#ef4444"></i><span>赤：交通事故</span></div>
        <div class="row"><i class="swatch" style="background:#0ea5e9"></i><span>水色：病院</span></div>
        <div class="row"><i class="swatch" style="background:#8b5cf6"></i><span>紫：学校</span></div>
        <div class="row"><i class="swatch" style="background:#059669"></i><span>緑：駅</span></div>
        <div class="row"><i class="swatch" style="background:#f59e0b"></i><span>橙：飲食店</span></div>
        <div class="row"><i class="grad" style="background:linear-gradient(90deg,#eef2ff,#818cf8,#4338ca)"></i><span>土地 実取引㎡単価：薄藍 ↗ 濃藍</span></div>
        <div class="row"><i class="grad" style="background:linear-gradient(90deg,#fff1f2,#fb7185,#be123c)"></i><span>土地+建物 実取引価格：薄桃 ↗ 濃赤</span></div>
        <div class="row"><i class="grad" style="background:linear-gradient(90deg,#ecfeff,#22d3ee,#0e7490)"></i><span>中古マンション 実取引㎡単価：薄水 ↗ 濃青</span></div>
        <div class="row"><i class="grad" style="background:linear-gradient(90deg,#e5e7eb,#111827)"></i><span>人口：薄灰 ↗ 濃灰</span></div>
        <div class="row"><i class="grad" style="background:linear-gradient(90deg,#86efac,#fde047,#fb923c,#dc2626)"></i><span>高齢化率：緑 ↗ 赤</span></div>
        <div class="row"><i class="grad" style="background:linear-gradient(90deg,#ede9fe,#c4b5fd,#7c3aed)"></i><span>単身世帯率：薄紫 ↗ 濃紫</span></div>
        <div class="row"><i class="grad" style="background:linear-gradient(90deg,#c026d3,#e5e7eb,#16a34a)"></i><span>人口移動：転出超過 ↗ 転入超過</span></div>
        <div class="row"><i class="grad" style="background:linear-gradient(90deg,#ccfbf1,#5eead4,#0f766e)"></i><span>空き家率：薄青緑 ↗ 濃青緑</span></div>
        <div class="row"><i class="grad" style="background:linear-gradient(90deg,#e0f2fe,#38bdf8,#075985)"></i><span>持ち家率：薄水色 ↗ 濃水色</span></div>
        <div class="row"><i class="grad" style="background:linear-gradient(90deg,#fef3c7,#f59e0b,#92400e)"></i><span>共同住宅率：薄黄 ↗ 茶</span></div>
        <div class="row"><i class="grad" style="background:linear-gradient(90deg,#fde68a,#f97316,#dc2626)"></i><span>犯罪率：黄 ↗ 赤</span></div>
      </div></div>
      <div class="group"><span id="current-price-label" class="label">表示中の地価公示</span><div class="kpis"><div class="kpi"><small>地点数</small><b id="kpi-count">—</b></div><div class="kpi"><small>中央値</small><b id="kpi-median">—</b></div></div></div>
      <div class="group"><span class="label">地価の推移</span><button id="price-history-load" class="history-btn" type="button">2020〜2026を見る</button><div id="price-history-mini" class="history-mini" hidden><svg id="price-history-svg" viewBox="0 0 280 110" preserveAspectRatio="none" aria-label="地価推移"></svg><div id="price-history-caption" class="history-caption"></div></div></div>
      <p class="note">洪水・津波・土砂災害は外部配信のタイルです。色が表示されない場所は安全を意味しません。「配信データなし」は提供元から画像が返らない状態で、未整備・対象外・一時的な配信欠落の区別はできません。「画像取得済み」も安全を示す判定ではありません。住所ごとの確認は自治体のハザードマップをご覧ください。各レイヤーは出典年度が異なります。実取引価格は不動産情報ライブラリの{transactions.periodLabel}を自治体別に集計し、地図では各種類5件以上の地域だけ表示します。住宅指標は令和5年住宅・土地統計調査（2023年10月、1,059自治体）。人口・世帯は2020年、出生・死亡は2023年、転入・転出は2024年。犯罪率は2025年の刑法犯認知件数を2024年人口で割った都道府県単位の参考値。交通事故は2024年の警察庁事故データを約1kmグリッドに集約しています。</p>
    </aside>
    <div class="map-card">
      <div class="map-toolbar"><strong>全国 不動産・防災・暮らしデータマップ</strong><span id="map-status">データを読み込み中</span></div>
      <div class="hazard-status" aria-label="表示範囲の防災画像の取得状況">
        <strong>防災レイヤーの表示状況</strong>
        <div id="hazard-status-flood" data-state="loading">洪水：読み込み前</div>
        <div id="hazard-status-tsunami" data-state="off">津波：非表示</div>
        <div id="hazard-status-sediment" data-state="off">土石流：非表示</div>
        <button id="hazard-retry" type="button" disabled>表示中の防災画像を再取得</button>
        <p>表示状況は画像の取得結果です。色がない場所も安全とは判断できません。 <a href="https://disaportal.gsi.go.jp/" target="_blank" rel="noreferrer">公式ハザードマップで確認 ↗</a></p>
      </div>
      <div id="map"></div><div id="loading" class="loading">全国25,000地点の地価データを読み込み中…</div>
      <div id="legend" class="legend"><strong>地価地点</strong><div><i class="dot" style="background:#1769e0"></i>青：地点をクリックすると価格を表示</div></div>
    </div>
  </section>
</main>
<script is:inline type="module">
