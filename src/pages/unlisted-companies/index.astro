---
import fs from 'node:fs';
import path from 'node:path';
const base=path.join(process.cwd(),'public/data/company-registry');
const summary=JSON.parse(fs.readFileSync(path.join(base,'summary.json'),'utf8'));
const dataset=JSON.parse(fs.readFileSync(path.join(base,'unlisted-index.json'),'utf8'));
const rows=dataset.records||[];
const nameGroups=JSON.parse(fs.readFileSync(path.join(base,'name-groups.json'),'utf8')).records||[];
const PREFECTURE_ORDER=['北海道','青森県','岩手県','宮城県','秋田県','山形県','福島県','茨城県','栃木県','群馬県','埼玉県','千葉県','東京都','神奈川県','新潟県','富山県','石川県','福井県','山梨県','長野県','岐阜県','静岡県','愛知県','三重県','滋賀県','京都府','大阪府','兵庫県','奈良県','和歌山県','鳥取県','島根県','岡山県','広島県','山口県','徳島県','香川県','愛媛県','高知県','福岡県','佐賀県','長崎県','熊本県','大分県','宮崎県','鹿児島県','沖縄県'];
const prefectures=new Map();
for(const row of rows){if(row.prefecture)prefectures.set(row.prefecture,(prefectures.get(row.prefecture)||0)+1)}
const topPrefectures=[...prefectures.entries()].sort((a,b)=>b[1]-a[1]).slice(0,12);
const topNames=nameGroups.slice(0,6);
const fmt=(n)=>new Intl.NumberFormat('ja-JP').format(n||0);
const money=(n)=>{const a=Math.abs(n||0);if(a>=1e12)return `${(n/1e12).toLocaleString('ja-JP',{maximumFractionDigits:1})}兆円`;if(a>=1e8)return `${(n/1e8).toLocaleString('ja-JP',{maximumFractionDigits:1})}億円`;if(a>=1e4)return `${(n/1e4).toLocaleString('ja-JP',{maximumFractionDigits:0})}万円`;return `${fmt(n)}円`};
---
<!doctype html><html lang="ja"><head><link rel="icon" type="image/svg+xml" href="/favicon.svg"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="description" content="国税庁の法人基本情報を検索し、法人番号まで確認できる公共調達実績を表示。国税庁法人番号公表サイト、EDINET、DATLUME公共調達データを統合。"><link rel="canonical" href="https://datlume.com/unlisted-companies/"><meta property="og:title" content="未上場企業分析 | DATLUME"><meta property="og:description" content="公開データから未上場会社の基本情報と公共調達実績を見る。"><meta property="og:type" content="website"><meta name="twitter:card" content="summary"><title>未上場企業分析｜法人情報・公共調達実績を検索 | DATLUME</title>
<style is:global>
:root{--ink:#111827;--muted:#667085;--line:#e4e9f0;--bg:#f4f6f9;--nav:#091827;--blue:#1769e0;--soft:#eef5ff;--green:#087f5b}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Hiragino Kaku Gothic ProN","Yu Gothic","Noto Sans JP",sans-serif}.wrap{width:min(1240px,calc(100% - 32px));margin:auto}a{color:inherit}header{background:var(--nav);color:#fff;padding:20px 0 66px}.nav{display:flex;align-items:center;gap:16px}.brand{display:inline-flex;align-items:center;gap:10px;text-decoration:none}.navlinks{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end;margin-left:auto}.navlinks a{font-size:11px;color:#d7e1ee;border:1px solid #ffffff25;border-radius:999px;padding:7px 10px;text-decoration:none}.hero{padding-top:50px}.eyebrow{font-size:11px;color:#87b8ff;letter-spacing:.16em;font-weight:850}.hero h1{font-size:clamp(38px,6vw,70px);letter-spacing:-.055em;line-height:1.02;margin:10px 0 16px}.hero p{max-width:850px;margin:0;color:#c7d3e4;line-height:1.9;font-size:15px}.hero-meta{display:flex;gap:8px;flex-wrap:wrap;margin-top:20px}.hero-meta span{border:1px solid #ffffff26;border-radius:999px;padding:7px 10px;font-size:11px;color:#e1eaf5}
main{padding:18px 0 70px}.stats{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.card{background:#fff;border:1px solid var(--line);border-radius:16px}.stat{padding:16px 18px}.stat span{font-size:10px;color:var(--muted);font-weight:800}.stat b{display:block;font-size:25px;letter-spacing:-.04em;margin-top:5px}.stat small{display:block;color:var(--muted);font-size:10px;margin-top:4px}.section{margin-top:16px}.section-head{display:flex;align-items:end;justify-content:space-between;gap:14px;margin-bottom:10px}.section-head h2{margin:0;font-size:20px}.section-head p{margin:0;color:var(--muted);font-size:11px;line-height:1.6}.search-card{padding:16px}.controls{display:grid;grid-template-columns:1.5fr .7fr .7fr .7fr;gap:10px}.control label{display:block;font-size:10px;font-weight:800;color:var(--muted);margin-bottom:5px}.control input,.control select{width:100%;height:43px;border:1px solid #d8dee8;border-radius:10px;background:#fff;padding:0 12px;font:inherit;font-size:13px}.search-meta{display:flex;justify-content:space-between;gap:10px;margin-top:12px;font-size:10px;color:var(--muted)}
</style></head><body>
<style is:global>
.company-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:12px}.company-card{display:block;background:#fff;border:1px solid var(--line);border-radius:13px;padding:14px;text-decoration:none;min-height:112px;transition:.15s ease}.company-card:hover{border-color:#b9c8dc;transform:translateY(-1px);box-shadow:0 8px 24px #1018280d}.company-top{display:flex;justify-content:space-between;gap:8px}.corp{font-size:9px;font-weight:900;color:var(--blue);background:var(--soft);padding:4px 7px;border-radius:6px}.place{font-size:9px;color:var(--muted)}.finance-tag{display:inline-block;margin-top:8px;background:#e9f8f1;color:#087f5b;border-radius:999px;padding:3px 7px;font-size:8px;font-weight:900}.company-card h3{font-size:15px;margin:12px 0 6px;line-height:1.4}.company-card .sub{font-size:10px;color:var(--muted)}.company-card .open-link{font-size:10px;font-weight:800;color:var(--blue);margin-top:10px}.more-btn{display:none;margin:14px auto 0;border:1px solid #d8dee8;border-radius:10px;background:#fff;padding:10px 18px;font:inherit;font-weight:800;font-size:11px;cursor:pointer}
.rank-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.rank-card{display:block;padding:15px;text-decoration:none}.rank-card .rank{font-size:10px;color:var(--blue);font-weight:900}.rank-card h3{font-size:14px;margin:8px 0 10px;line-height:1.4}.rank-card .value{font-size:19px;font-weight:900;letter-spacing:-.03em}.rank-card .sub{font-size:10px;color:var(--muted);margin-top:4px}.rank-note{font-size:11px;color:var(--muted);margin-top:10px}.rank-note summary{cursor:pointer;width:max-content;color:var(--blue);font-weight:700}.rank-note p{max-width:720px;line-height:1.7;margin:6px 0 0}.pref-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:8px}.pref{border:1px solid var(--line);background:#fff;border-radius:11px;padding:11px;cursor:pointer;text-align:left}.pref b{display:block;font-size:12px}.pref span{display:block;font-size:10px;color:var(--muted);margin-top:3px}.quality{padding:16px;display:grid;grid-template-columns:1fr 1fr;gap:14px}.quality h3{margin:0 0 6px;font-size:14px}.quality p{font-size:11px;line-height:1.8;color:var(--muted);margin:0}.source-note{font-size:10px;line-height:1.8;color:var(--muted);padding:14px 2px}footer{padding:26px 0 45px;border-top:1px solid var(--line);font-size:10px;color:var(--muted)}
@media(max-width:980px){.company-grid,.rank-grid{grid-template-columns:1fr 1fr}.pref-grid{grid-template-columns:repeat(4,1fr)}}@media(max-width:720px){.wrap{width:min(100% - 24px,1240px)}.nav{display:block}.navlinks{margin:14px 0 0;overflow-x:auto;flex-wrap:nowrap;justify-content:flex-start;scrollbar-width:none}.navlinks a{white-space:nowrap}.hero{padding-top:42px}.stats{grid-template-columns:1fr 1fr}.controls{grid-template-columns:1fr}.company-grid,.rank-grid{grid-template-columns:1fr}.pref-grid{grid-template-columns:1fr 1fr}.quality{grid-template-columns:1fr}.section-head{align-items:flex-start;flex-direction:column;gap:4px}}
</style>
<header><div class="wrap"><nav class="nav"><a class="brand" href="/"><img src="/favicon.svg" alt="" width="24" height="24" style="filter:brightness(0) invert(1)"><span style="font-size:19px;font-weight:750;letter-spacing:.16em">DATLUME</span></a><div class="navlinks"><a href="/">ホーム</a><a href="/unlisted-companies/"><span aria-hidden="true">🏢</span> 未上場企業</a><a href="/listed-companies/"><span aria-hidden="true">📈</span> 上場企業</a><a href="/procurement/">公共調達</a><a href="/business-industry/"><span aria-hidden="true">🏭</span> 企業・産業</a><a href="/topics/"><span aria-hidden="true">🔥</span> 話題のトピック</a><a href="/about-data/">データについて</a></div></nav><div class="hero"><div class="eyebrow">UNLISTED COMPANIES / JAPAN</div><h1><span aria-hidden="true">🏢</span> 未上場企業を、公開データで見る。</h1><p>企業の基本情報や公開財務を探し、公共調達の受注額を企業名から見られます。</p></div></div></header>
<main class="wrap">
<section class="stats"><div class="card stat"><span>掲載企業</span><b>{fmt(summary.unlistedCompanies)}社</b><small>現存する未上場企業</small></div><div class="card stat"><span>公開財務あり</span><b>{fmt(summary.unlistedFinanceCompanies||0)}社</b><small>財務CSV・決算公告を収録</small></div></section>
<section class="section"><div class="section-head"><h2>公共調達の受注額ランキング</h2><p>公開元に載った受注企業名ごとの合計です。企業の売上高ではありません。</p></div><div class="rank-grid">{topNames.map((c,i)=><a class="card rank-card" href={`/procurement/companies/${c.companyId}/`}><div class="rank">#{i+1}</div><h3>{c.name}</h3><div class="value">{money(c.awardTotal)}</div><div class="sub">{fmt(c.awardCount)}件</div></a>)}</div><details class="rank-note"><summary>このランキングの見方</summary><p>同じ名前の別会社が含まれる可能性があります。カードを開くと、受注企業名ごとの案件を確認できます。</p></details></section>
<section class="section card search-card"><div class="section-head"><div><h2>企業を探す</h2></div><p>企業名・所在地・公開財務で絞り込み</p></div><div class="controls"><div class="control"><label for="company-q">企業名 / 法人番号</label><input id="company-q" type="search" inputmode="search" placeholder="例：アクセンチュア / 法人番号"></div><div class="control"><label for="pref-filter">都道府県</label><select id="pref-filter"><option value="">すべて</option>{PREFECTURE_ORDER.filter(p=>prefectures.has(p)).map(p=><option value={p}>{p}</option>)}</select></div><div class="control"><label for="finance-filter">財務データ</label><select id="finance-filter"><option value="">すべて</option><option value="yes">公開財務あり</option><option value="csv">gBizINFO財務CSV</option><option value="statements">官報決算公告</option></select></div><div class="control"><label for="sort-filter">並び順</label><select id="sort-filter"><option value="name">企業名順</option><option value="revenue">公開財務の売上順</option></select></div></div><div class="search-meta"><span id="result-count">企業データを読み込み中…</span><span>24件ずつ表示</span></div><div id="company-grid" class="company-grid"></div><button id="more-btn" class="more-btn" type="button">さらに表示</button></section>
<section class="section"><div class="section-head"><h2>所在地から見る</h2><p>収録社数の多い都道府県</p></div><div class="pref-grid">{topPrefectures.map(([name,count])=><button class="pref" type="button" data-pref={name}><b>{name}</b><span>{fmt(count)}社 →</span></button>)}</div></section>
<section class="section card quality"><div><h3>掲載している企業</h3><p>各会社自身の上場状況で分類しています。上場企業の子会社や、以前上場していた会社も含みます。</p></div><div><h3>調達データの見方</h3><p>ランキングは受注企業名で集計しています。企業情報ページには、その会社の案件と確認できた記録だけを掲載します。</p></div></section>
<div class="source-note">出典：国税庁、JPX、EDINET、公共調達の公開データ、gBizINFO。収録範囲と集計方法は<a href="/about-data/">データについて</a>をご覧ください。</div>
</main><footer><div class="wrap">DATLUME · <a href="/listed-companies/">上場企業</a> · <a href="/procurement/">公共調達</a> · <a href="/about-data/">データについて</a> · <a href="/privacy/">プライバシーポリシー</a></div></footer>
<script>
let companies=[],filtered=[],shown=24;const q=document.getElementById('company-q'),pref=document.getElementById('pref-filter'),fin=document.getElementById('finance-filter'),sort=document.getElementById('sort-filter'),grid=document.getElementById('company-grid'),count=document.getElementById('result-count'),more=document.getElementById('more-btn');
function escapeHtml(v){return String(v??'').replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]))}
function render(reset=true){if(reset)shown=24;const text=q.value.trim().normalize('NFKC').toLocaleLowerCase('ja-JP');filtered=companies.filter(c=>{const financeOk=!fin.value||(fin.value==='yes'&&c.hasFinance)||(fin.value==='csv'&&c.financeSourceType==='finance')||(fin.value==='statements'&&c.hasFinancialStatements);return(!text||(c.name+c.corporateNumber).normalize('NFKC').toLocaleLowerCase('ja-JP').includes(text))&&(!pref.value||c.prefecture===pref.value)&&financeOk});if(sort.value==='revenue')filtered.sort((a,b)=>Number(b.latestRevenue??-Infinity)-Number(a.latestRevenue??-Infinity)||(a.name||'').localeCompare(b.name||'','ja'));else filtered.sort((a,b)=>(a.name||'').localeCompare(b.name||'','ja'));count.textContent=filtered.length.toLocaleString('ja-JP')+'社';grid.innerHTML=filtered.slice(0,shown).map(c=>`<a class="company-card" href="/unlisted-companies/${encodeURIComponent(c.corporateNumber)}/"><div class="company-top"><span class="corp">法人番号 ${escapeHtml(c.corporateNumber)}</span><span class="place">${escapeHtml(c.prefecture||'')} ${escapeHtml(c.city||'')}</span></div><h3>${escapeHtml(c.name)}</h3>${c.hasFinance?'<span class="finance-tag">'+(c.financeSourceType==='finance'?(c.hasFinancialStatements?'財務CSV + 決算公告':'財務CSV'):'決算公告')+' · '+Number(c.financePeriods||0)+'期</span>':''}<div class="open-link">企業情報を見る →</div></a>`).join('');more.style.display=shown<filtered.length?'block':'none'}
for(const el of[q,pref,fin,sort])el.addEventListener(el===q?'input':'change',()=>render(true));more.addEventListener('click',()=>{shown+=24;render(false)});document.querySelectorAll('[data-pref]').forEach(btn=>btn.addEventListener('click',()=>{pref.value=btn.dataset.pref||'';render(true);document.querySelector('.search-card')?.scrollIntoView({behavior:'smooth'})}));
fetch('/data/company-registry/unlisted-index.json').then(r=>{if(!r.ok)throw new Error('load');return r.json()}).then(data=>{companies=data.records||[];render(true)}).catch(()=>{count.textContent='企業データを読み込めませんでした';grid.innerHTML='<div class="card" style="padding:18px;color:#667085">データ読み込みに失敗しました。</div>'});
</script></body></html>
