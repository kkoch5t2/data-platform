---
import '../styles/detail.css';
import { companyPagePath, pageSize } from '../lib/procurement-company-pages';
import type { ProcurementCompany } from '../data/companies.ts';
interface Props { rows: ProcurementCompany[]; total: number; page: number; pageCount: number; }
const { rows, total, page, pageCount } = Astro.props;
const oku = (v: number) => (v / 100000000).toFixed(v >= 1000000000 ? 1 : 2) + '億円';
const start = (page - 1) * pageSize + 1;
const end = Math.min(page * pageSize, total);
---
<!doctype html>
<html lang="ja"><head>
<link rel="icon" type="image/svg+xml" href="/favicon.svg"><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="canonical" href={'https://datlume.com' + companyPagePath(page)}>
<meta name="description" content={`公共調達の受注企業名を落札額順に比較。全${total.toLocaleString('ja-JP')}社名のうち${start.toLocaleString('ja-JP')}〜${end.toLocaleString('ja-JP')}件を表示します。`}>
<meta property="og:title" content="受注企業名一覧 | DATLUME"><meta property="og:type" content="website"><meta name="twitter:card" content="summary">
<title>{page === 1 ? '受注企業名一覧' : `受注企業名一覧 ${page}ページ目`} | DATLUME</title>
<style>
.ranking-nav{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin:14px 0}
.ranking-nav a{display:inline-block;padding:9px 12px;border:1px solid #d8e2f0;border-radius:9px;background:#fff;text-decoration:none;color:#175cb8;font-size:13px;font-weight:700}
.ranking-nav a:hover{text-decoration:underline}.ranking-nav select{font:inherit;font-size:13px;padding:8px;border:1px solid #d8e2f0;border-radius:9px;max-width:200px;background:#fff}
.ranking-nav .position{color:#526175;font-size:13px}
</style></head><body>
<header><div class="wrap"><div class="nav"><a class="brand" href="/" aria-label="DATLUME" style="display:inline-flex;align-items:center;gap:10px;text-decoration:none;color:#fff"><img src="/favicon.svg" alt="" width="24" height="24" style="display:block;width:24px;height:24px;filter:brightness(0) invert(1)"><span style="font-family:'Segoe UI Variable','Avenir Next','Helvetica Neue',system-ui,sans-serif;font-size:19px;font-weight:750;letter-spacing:.16em;line-height:1">DATLUME</span></a><a class="back" href="/procurement/">公共調達へ戻る</a></div><div class="hero"><div class="eyebrow">Vendors</div><h1>受注企業名</h1><p>確認できた公共調達を正規化した社名ベースで集計。同名別法人を区別できない場合があります。</p></div></div></header>
<main class="wrap">
<section class="card table-card"><div class="table-head"><h2>社名ベースランキング</h2><div class="note">全{total.toLocaleString('ja-JP')}社名・{start.toLocaleString('ja-JP')}〜{end.toLocaleString('ja-JP')}件</div></div>
<table><thead><tr><th>受注企業名</th><th>落札件数</th><th>確認済み受注額</th></tr></thead><tbody>{rows.map(c => <tr><td class="title"><a href={`/procurement/companies/${c.id}/`}>{c.name}</a></td><td>{c.awardCount}</td><td>{oku(c.awardTotal)}</td></tr>)}</tbody></table></section>
<nav class="ranking-nav" aria-label="受注企業名一覧のページ切り替え">
{page > 1 ? <a rel="prev" href={companyPagePath(page - 1)}>前へ</a> : <span />}
<label>ページ <select id="ranking-page" aria-label="ページを選択">{Array.from({ length: pageCount }, (_, i) => i + 1).map(n => <option value={companyPagePath(n)} selected={n === page}>{n} / {pageCount}</option>)}</select></label>
<span class="position">{page} / {pageCount}</span>
{page < pageCount ? <a rel="next" href={companyPagePath(page + 1)}>次へ</a> : <span />}
</nav></main>
<footer class="wrap">出典：JETRO / 調達ポータル（GEPS） / 各自治体の公式入札・契約情報 ・ <a href="/about-data/#procurement">収録範囲と集計上の注意</a> · <a href="https://github.com/kkoch5t2/data-platform" target="_blank" rel="noreferrer">GitHub ↗</a> · <a href="/privacy/">プライバシーポリシー</a></footer>
<script>document.getElementById('ranking-page')?.addEventListener('change', event => { window.location.href = (event.target as HTMLSelectElement).value; });</script>
</body></html>
